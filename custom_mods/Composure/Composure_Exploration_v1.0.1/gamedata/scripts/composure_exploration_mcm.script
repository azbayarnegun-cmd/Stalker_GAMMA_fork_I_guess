            { id = "combat_distance", type = "track", val = 2, min = 10, max = 250, step = 5, def = 100 },
            { id = "line2", type = "line" },
            { id = "surface_outdoor_rate", type = "track", val = 2, min = 0, max = 5, step = 0.05, prec = 2, def = 0.25 },
