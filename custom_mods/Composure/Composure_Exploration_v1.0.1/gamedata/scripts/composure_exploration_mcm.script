-- Composure Exploration v1.0.1 settings.

local defaults = {
    enabled = true,
    master_loss_scale = 1.00,
    maximum_loss_per_minute = 5.00,
    exploration_floor = 50,
    entry_grace_seconds = 5,
    post_combat_hold_seconds = 30,
    combat_distance = 100,
    surface_outdoor_rate = 0.25,
    underground_rate = 0.75,
    deep_lab_rate = 1.50,
    night_add = 0.50,
    light_rain_add = 0.25,
    heavy_storm_add = 0.75,
    companion_multiplier = 0.75,
    companion_radius = 75,
    anomaly_enabled = true,
    anomaly_near_radius = 25,
    anomaly_immediate_radius = 10,
    anomaly_near_add = 0.25,
    anomaly_immediate_add = 0.50,
    anomaly_inside_add = 0.75,
    anomaly_exit_grace_seconds = 5,
    campfire_radius = 36,
    campfire_live_multiplier = 0.25,
    campfire_relief_rate = 2.00,
    campfire_max_relief_minutes = 60,
    campfire_minimum_exposure = 60,
    campfire_relief_reset_minutes = 120,
    safe_base_recovery_rate = 4.00,
    safe_base_radius = 50,
    transition_composure_scale = 0.25,
    transition_exposure_scale = 1.00,
    unsafe_sleep_exposure_multiplier = 0.50,
    night_start_hour = 20,
    night_end_hour = 6,
    debug_key = DIK_keys and DIK_keys.DIK_F7 or nil,
    debug_log = false,
}

function get_config(key)
    if ui_mcm and ui_mcm.get then
        local ok, value = pcall(ui_mcm.get, "composure_exploration/" .. key)
        if ok and value ~= nil then return value end
    end
    return defaults[key]
end

function on_mcm_load()
    return {
        id = "composure_exploration",
        sh = true,
        gr = {
            { id = "enabled", type = "check", val = 1, def = true },
            { id = "line1", type = "line" },
            { id = "master_loss_scale", type = "track", val = 2, min = 0, max = 3, step = 0.05, prec = 2, def = 1 },
            { id = "maximum_loss_per_minute", type = "track", val = 2, min = 0, max = 10, step = 0.25, prec = 2, def = 5 },
            { id = "exploration_floor", type = "track", val = 2, min = 0, max = 100, step = 1, def = 50 },
            { id = "entry_grace_seconds", type = "track", val = 2, min = 0, max = 5, step = 1, def = 5 },
