<?xml version="1.0" encoding="windows-1251" ?>
<string_table>
    <string id="ui_mcm_menu_composure_exploration"><text>Composure - Exploration</text></string>
    <string id="ui_mcm_composure_exploration_enabled"><text>Enable Exploration</text></string>
    <string id="ui_mcm_composure_exploration_enabled_desc"><text>Master switch for environmental Composure pressure and Expedition Strain.</text></string>
    <string id="ui_mcm_composure_exploration_master_loss_scale"><text>Master loss scale</text></string>
    <string id="ui_mcm_composure_exploration_master_loss_scale_desc"><text>Multiplies the final exploration-loss rate.</text></string>
    <string id="ui_mcm_composure_exploration_maximum_loss_per_minute"><text>Maximum loss per minute</text></string>
    <string id="ui_mcm_composure_exploration_maximum_loss_per_minute_desc"><text>Hard cap on exploration loss per in-game minute.</text></string>
    <string id="ui_mcm_composure_exploration_exploration_floor"><text>Exploration floor</text></string>
    <string id="ui_mcm_composure_exploration_exploration_floor_desc"><text>Exploration cannot reduce Composure below this value.</text></string>
    <string id="ui_mcm_composure_exploration_entry_grace_seconds"><text>Entry grace</text></string>
    <string id="ui_mcm_composure_exploration_entry_grace_seconds_desc"><text>Technical initialization time after loading or changing levels. No exploration loss or Exploration recovery lock is applied during this grace. Default 5 seconds.</text></string>
    <string id="ui_mcm_composure_exploration_post_combat_hold_seconds"><text>Post-combat hold</text></string>
    <string id="ui_mcm_composure_exploration_post_combat_hold_seconds_desc"><text>Seconds that exploration remains paused after damage or firing.</text></string>
    <string id="ui_mcm_composure_exploration_combat_distance"><text>Combat distance</text></string>
    <string id="ui_mcm_composure_exploration_combat_distance_desc"><text>Hostiles actively fighting the actor within this distance pause exploration pressure.</text></string>
    <string id="ui_mcm_composure_exploration_surface_outdoor_rate"><text>Surface outdoor rate</text></string>
    <string id="ui_mcm_composure_exploration_surface_outdoor_rate_desc"><text>Base Composure loss per in-game minute on surface maps.</text></string>
    <string id="ui_mcm_composure_exploration_underground_rate"><text>Underground rate</text></string>
    <string id="ui_mcm_composure_exploration_underground_rate_desc"><text>Base loss per minute in underground maps.</text></string>
    <string id="ui_mcm_composure_exploration_deep_lab_rate"><text>Deep-lab rate</text></string>
    <string id="ui_mcm_composure_exploration_deep_lab_rate_desc"><text>Base loss per minute in deep laboratories.</text></string>
    <string id="ui_mcm_composure_exploration_night_add"><text>Night addition</text></string>
    <string id="ui_mcm_composure_exploration_night_add_desc"><text>Added loss per minute at night.</text></string>
    <string id="ui_mcm_composure_exploration_light_rain_add"><text>Light-rain addition</text></string>
    <string id="ui_mcm_composure_exploration_light_rain_add_desc"><text>Added surface pressure during rain when the weather identifier is available.</text></string>
    <string id="ui_mcm_composure_exploration_heavy_storm_add"><text>Heavy-storm addition</text></string>
    <string id="ui_mcm_composure_exploration_heavy_storm_add_desc"><text>Added surface pressure during storms when the weather identifier is available.</text></string>
    <string id="ui_mcm_composure_exploration_companion_multiplier"><text>Companion multiplier</text></string>
    <string id="ui_mcm_composure_exploration_companion_multiplier_desc"><text>Final pressure multiplier while a living player-squad companion is nearby.</text></string>
    <string id="ui_mcm_composure_exploration_companion_radius"><text>Companion radius</text></string>
    <string id="ui_mcm_composure_exploration_companion_radius_desc"><text>Maximum companion-relief distance in metres.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_enabled"><text>Anomaly proximity</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_enabled_desc"><text>Enables best-effort anomaly-object scanning and the public anomaly-distance API.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_near_radius"><text>Anomaly near radius</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_near_radius_desc"><text>Outer anomaly-pressure radius in metres.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_immediate_radius"><text>Anomaly immediate radius</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_immediate_radius_desc"><text>Inner high-pressure anomaly radius in metres.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_near_add"><text>Anomaly near addition</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_near_add_desc"><text>Loss added per minute within the outer anomaly radius. Workbook default: 0.25.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_immediate_add"><text>Anomaly immediate addition</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_immediate_add_desc"><text>Loss added per minute within the inner anomaly radius.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_inside_add"><text>Inside-anomaly addition</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_inside_add_desc"><text>Loss added per minute while an integration reports the actor inside an anomaly.</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_exit_grace_seconds"><text>Anomaly exit grace</text></string>
    <string id="ui_mcm_composure_exploration_anomaly_exit_grace_seconds_desc"><text>Seconds that near pressure remains after leaving the detected radius.</text></string>
    <string id="ui_mcm_composure_exploration_campfire_radius"><text>Lit-campfire radius</text></string>
    <string id="ui_mcm_composure_exploration_campfire_radius_desc"><text>Distance in metres used for lit-campfire relief.</text></string>
    <string id="ui_mcm_composure_exploration_campfire_live_multiplier"><text>Live campfire multiplier</text></string>
    <string id="ui_mcm_composure_exploration_campfire_live_multiplier_desc"><text>Pressure multiplier while awake near a lit campfire. Default 0.25.</text></string>
    <string id="ui_mcm_composure_exploration_campfire_relief_rate"><text>Campfire relief rate</text></string>
    <string id="ui_mcm_composure_exploration_campfire_relief_rate_desc"><text>Exposure minutes removed per rested in-game minute.</text></string>
    <string id="ui_mcm_composure_exploration_campfire_max_relief_minutes"><text>Campfire relief cap</text></string>
    <string id="ui_mcm_composure_exploration_campfire_max_relief_minutes_desc"><text>Maximum exposure minutes one campfire-rest allowance can remove.</text></string>
    <string id="ui_mcm_composure_exploration_campfire_minimum_exposure"><text>Campfire exposure floor</text></string>
    <string id="ui_mcm_composure_exploration_campfire_minimum_exposure_desc"><text>A campfire cannot lower expedition exposure below this many minutes.</text></string>
    <string id="ui_mcm_composure_exploration_campfire_relief_reset_minutes"><text>Campfire allowance reset</text></string>
    <string id="ui_mcm_composure_exploration_campfire_relief_reset_minutes_desc"><text>Unsafe exploration minutes required to restore the full campfire-relief allowance.</text></string>
    <string id="ui_mcm_composure_exploration_safe_base_recovery_rate"><text>Safe-base exposure recovery</text></string>
    <string id="ui_mcm_composure_exploration_safe_base_recovery_rate_desc"><text>Exposure minutes removed per minute inside a friendly base.</text></string>
    <string id="ui_mcm_composure_exploration_safe_base_radius"><text>Safe-base radius</text></string>
    <string id="ui_mcm_composure_exploration_safe_base_radius_desc"><text>Maximum distance from a friendly base smart terrain.</text></string>
    <string id="ui_mcm_composure_exploration_transition_composure_scale"><text>Transition Composure scale</text></string>
    <string id="ui_mcm_composure_exploration_transition_composure_scale_desc"><text>Scales all Framework Composure adjustments during Unified level-transition blackout. Applies to positive and negative time-based changes. Default 0.25.</text></string>
    <string id="ui_mcm_composure_exploration_transition_exposure_scale"><text>Transition exposure scale</text></string>
    <string id="ui_mcm_composure_exploration_transition_exposure_scale_desc"><text>Expedition exposure gained during level-transition simulation. Default 1.00.</text></string>
    <string id="ui_mcm_composure_exploration_unsafe_sleep_exposure_multiplier"><text>Unsafe-sleep exposure retained</text></string>
    <string id="ui_mcm_composure_exploration_unsafe_sleep_exposure_multiplier_desc"><text>Fraction of exposure retained after sleeping away from a friendly base or lit campfire.</text></string>
    <string id="ui_mcm_composure_exploration_night_start_hour"><text>Night starts</text></string>
    <string id="ui_mcm_composure_exploration_night_start_hour_desc"><text>Game hour at which the night modifier begins.</text></string>
    <string id="ui_mcm_composure_exploration_night_end_hour"><text>Night ends</text></string>
    <string id="ui_mcm_composure_exploration_night_end_hour_desc"><text>Game hour at which the night modifier ends.</text></string>
    <string id="ui_mcm_composure_exploration_debug_key"><text>Diagnostic key</text></string>
    <string id="ui_mcm_composure_exploration_debug_key_desc"><text>Shows current profile, loss rate, exposure, and anomaly distance. Default F7.</text></string>
    <string id="ui_mcm_composure_exploration_debug_log"><text>Debug logging</text></string>
    <string id="ui_mcm_composure_exploration_debug_log_desc"><text>Writes detailed Exploration events to the X-Ray log.</text></string>
</string_table>
