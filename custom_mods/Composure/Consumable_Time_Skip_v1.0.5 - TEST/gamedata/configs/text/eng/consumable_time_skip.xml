<?xml version="1.0" encoding="windows-1251" ?>
<string_table>
    <string id="ui_mcm_menu_consumable_time_skip"><text>Consumable Time-Skip</text></string>
    <string id="ui_mcm_consumable_time_skip_enabled"><text>Enable addon</text></string>
    <string id="ui_mcm_consumable_time_skip_enabled_desc"><text>Enable real stepped time passage for registered Tier 3 consumables.</text></string>
    <string id="ui_mcm_consumable_time_skip_alcohol_enabled"><text>Strong alcohol time-skip</text></string>
    <string id="ui_mcm_consumable_time_skip_alcohol_enabled_desc"><text>Enable time passage for alcoholic drinks except beer.</text></string>
    <string id="ui_mcm_consumable_time_skip_alcohol_minutes"><text>Strong alcohol minutes</text></string>
    <string id="ui_mcm_consumable_time_skip_alcohol_minutes_desc"><text>Fixed time passed after a qualifying alcoholic drink. Beer is excluded. Default: 120.</text></string>
    <string id="ui_mcm_consumable_time_skip_allow_sheltered_event_consumables"><text>Time-skip items in event shelter</text></string>
    <string id="ui_mcm_consumable_time_skip_allow_sheltered_event_consumables_desc"><text>Allow strong alcohol, prepared tea/coffee, cigar and hand-rolled tobacco during an active emission or psy-storm while GAMMA reports the actor inside registered event cover. Exposed use remains blocked.</text></string>
    <string id="ui_mcm_consumable_time_skip_coffee_enabled"><text>Coffee / tea time-skip</text></string>
    <string id="ui_mcm_consumable_time_skip_coffee_enabled_desc"><text>Enable time passage for prepared tea and coffee.</text></string>
    <string id="ui_mcm_consumable_time_skip_coffee_minutes"><text>Coffee / tea minutes</text></string>
    <string id="ui_mcm_consumable_time_skip_coffee_minutes_desc"><text>Fixed time passed after prepared tea or coffee. Ground coffee is excluded. Default: 30.</text></string>
    <string id="ui_mcm_consumable_time_skip_tobacco_enabled"><text>Slow tobacco time-skip</text></string>
    <string id="ui_mcm_consumable_time_skip_tobacco_enabled_desc"><text>Enable time passage for hand-rolling tobacco and the Cuban cigar only.</text></string>
    <string id="ui_mcm_consumable_time_skip_tobacco_minutes"><text>Hand-rolled tobacco minutes</text></string>
    <string id="ui_mcm_consumable_time_skip_tobacco_minutes_desc"><text>Fixed time passed after hand-rolling tobacco or a Cuban cigar. Regular cigarettes are excluded. Default: 15.</text></string>
    <string id="ui_mcm_consumable_time_skip_tobacco_animation_delay"><text>Tobacco animation delay</text></string>
    <string id="ui_mcm_consumable_time_skip_tobacco_animation_delay_desc"><text>Wait after the item-use effect before beginning the blackout, allowing the smoking animation to finish. Default: 8 seconds.</text></string>
    <string id="ui_mcm_consumable_time_skip_advance_composure"><text>Advance Composure effects</text></string>
    <string id="ui_mcm_consumable_time_skip_advance_composure_desc"><text>Advance active Composure Framework modifiers, caps and recovery locks by each simulated step. Has no effect when Composure is absent.</text></string>
    <string id="ui_mcm_consumable_time_skip_step_minutes"><text>Simulation step minutes</text></string>
    <string id="ui_mcm_consumable_time_skip_step_minutes_desc"><text>World time advanced per full ALife update. Default: 3.</text></string>
    <string id="ui_mcm_consumable_time_skip_human_radius"><text>Hostile human radius</text></string>
    <string id="ui_mcm_consumable_time_skip_human_radius_desc"><text>Outdoor skips interrupt when a hostile human enters this distance in metres.</text></string>
    <string id="ui_mcm_consumable_time_skip_mutant_radius"><text>Hostile mutant radius</text></string>
    <string id="ui_mcm_consumable_time_skip_mutant_radius_desc"><text>Outdoor skips interrupt when a hostile mutant enters this distance in metres.</text></string>
    <string id="ui_mcm_consumable_time_skip_fade_seconds"><text>Fade duration</text></string>
    <string id="ui_mcm_consumable_time_skip_fade_seconds_desc"><text>Seconds used to fade into and out of the black screen.</text></string>
    <string id="ui_mcm_consumable_time_skip_settle_frames"><text>Threat-scan settle frames</text></string>
    <string id="ui_mcm_consumable_time_skip_settle_frames_desc"><text>Frames allowed for nearby entities to return online after each ALife step.</text></string>
    <string id="ui_mcm_consumable_time_skip_enclosed_uninterruptible"><text>Protected when enclosed</text></string>
    <string id="ui_mcm_consumable_time_skip_enclosed_uninterruptible_desc"><text>Check safety once at the start. Fully enclosed cover makes the skip uninterruptible.</text></string>
    <string id="ui_mcm_consumable_time_skip_interruption_disorientation"><text>Interruption disorientation</text></string>
    <string id="ui_mcm_consumable_time_skip_interruption_disorientation_desc"><text>Play the vanilla wake camera effect after an outdoor threat interrupts the skip.</text></string>
    <string id="ui_mcm_consumable_time_skip_tester_enabled"><text>Enable tester hotkey</text></string>
    <string id="ui_mcm_consumable_time_skip_tester_enabled_desc"><text>Allow a no-item exposed-location test skip.</text></string>
    <string id="ui_mcm_consumable_time_skip_tester_key"><text>Tester hotkey</text></string>
    <string id="ui_mcm_consumable_time_skip_tester_key_desc"><text>Starts the exposed-location test. Default: F10.</text></string>
    <string id="ui_mcm_consumable_time_skip_tester_minutes"><text>Tester minutes</text></string>
    <string id="ui_mcm_consumable_time_skip_tester_minutes_desc"><text>Fixed duration used by the tester hotkey.</text></string>
    <string id="ui_mcm_consumable_time_skip_debug_log"><text>Debug logging</text></string>
    <string id="ui_mcm_consumable_time_skip_debug_log_desc"><text>Write detailed start, completion, and interruption information to the log.</text></string>

