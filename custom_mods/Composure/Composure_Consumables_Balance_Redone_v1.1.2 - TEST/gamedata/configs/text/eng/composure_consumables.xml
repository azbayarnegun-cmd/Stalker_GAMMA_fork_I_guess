<?xml version="1.0" encoding="windows-1251"?>
<string_table>
    <string id="ui_mcm_menu_composure_consumables"><text>Composure Consumables</text></string>
    <string id="ui_mcm_composure_consumables_enabled"><text>Enable Consumable Effects</text></string>
    <string id="ui_mcm_composure_consumables_enabled_desc"><text>Apply spreadsheet-defined Composure effects when supported GAMMA consumables are used.</text></string>
    <string id="ui_mcm_composure_consumables_tooltips"><text>Show Consumable Stats</text></string>
    <string id="ui_mcm_composure_consumables_tooltips_desc"><text>Show a clean Composure effects block in item information. Rest remains GAMMA's own native item stat.</text></string>
    <string id="ui_mcm_composure_consumables_composure_block"><text>Composure Effects Block</text></string>
    <string id="ui_mcm_composure_consumables_composure_block_desc"><text>Show Instant, Over Time or After-effect, and Duration with clear separators. Enabled by default.</text></string>
    <string id="ui_mcm_composure_consumables_try_native_rows"><text>Experimental Native Rows</text></string>
    <string id="ui_mcm_composure_consumables_try_native_rows_desc"><text>Try runtime-added icon rows. Keep disabled with Sota UI because it registers but does not render them.</text></string>
    <string id="ui_mcm_composure_consumables_instant_scale"><text>Instant Effect Scale</text></string>
    <string id="ui_mcm_composure_consumables_instant_scale_desc"><text>Scales this addon's instant gains and losses. Default 1.00 preserves the balance table.</text></string>
    <string id="ui_mcm_composure_consumables_gradual_scale"><text>Gradual Effect Scale</text></string>
    <string id="ui_mcm_composure_consumables_gradual_scale_desc"><text>Scales this addon's timed gains and crashes. Default 1.00 preserves the balance table.</text></string>
    <string id="ui_mcm_composure_consumables_resistance_scale"><text>Loss Resistance Scale</text></string>
    <string id="ui_mcm_composure_consumables_resistance_scale_desc"><text>Scales source-specific protection. Final protection is always capped at 50%.</text></string>
    <string id="ui_mcm_composure_consumables_gain_buff_scale"><text>Gain Potency Scale</text></string>
    <string id="ui_mcm_composure_consumables_gain_buff_scale_desc"><text>Scales temporary Composure gain buffs and debuffs. Final potency is capped to plus or minus 50%.</text></string>
    <string id="ui_mcm_composure_consumables_bypass_recovery_locks"><text>Consumables Work During Danger</text></string>
    <string id="ui_mcm_composure_consumables_bypass_recovery_locks_desc"><text>Allows positive instant and gradual consumable effects while passive recovery is locked.</text></string>
    <string id="ui_mcm_composure_consumables_debug_key"><text>Diagnostics Key</text></string>
    <string id="ui_mcm_composure_consumables_debug_key_desc"><text>Print active protection, potency effects and the last consumed item. Default F8.</text></string>
    <string id="ui_mcm_composure_consumables_debug_log"><text>Diagnostic Logging</text></string>
    <string id="ui_mcm_composure_consumables_debug_log_desc"><text>Log every recognized consumable use and applied balance row.</text></string>

