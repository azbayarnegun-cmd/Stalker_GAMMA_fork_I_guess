-- Composure Combat v1.0.1 settings.

local defaults = {
    enabled = true,
    combat_distance = 150,
    grace_period = 2,
    end_inertia = 10,

    alert_rate = 0.10,
    engaged_rate = 0.20,
    overwhelmed_rate = 0.30,
    maximum_continuous_rate = 0.30,

    hit_enabled = true,
    hit_band_1 = 1.0,
    hit_band_2 = 1.5,
    hit_band_3 = 2.5,
    hit_band_4 = 3.5,
    hit_band_5 = 5.0,

    near_miss_enabled = true,
    near_miss_radius = 3.0,
    extreme_near_miss_radius = 1.0,
    near_normal_1 = 0.45,
    near_normal_2 = 0.30,
    near_normal_3 = 0.15,
    near_extreme_1 = 0.75,
    near_extreme_2 = 0.50,
    near_extreme_3 = 0.25,
    near_miss_deprogress = 3.0,

    instant_fraction = 0.30,
    deferred_duration = 30,
    instant_cap_1s = 5.0,
    instant_cap_3s = 7.5,

    recovery_lock = true,
    post_combat_delay = 15,
    rebound_enabled = true,
    rebound_delay = 20,
    rebound_percent = 1.0,
    rebound_max = 30,

    debug_key = DIK_keys.DIK_F6,
    test_mode = false,
    test_action = 0,
    forced_phase_duration = 15,
    debug_log = false,
}

function get_config(key)
    if ui_mcm then
        local value = ui_mcm.get("composure_combat/" .. key)
        if value ~= nil then return value end
    end
    return defaults[key]
end

function on_mcm_load()
    return {
        id = "composure_combat",
        sh = true,
        gr = {
            { id = "enabled", type = "check", val = 1, def = true },
            { id = "combat_distance", type = "track", val = 2,
              min = 25, max = 300, step = 5, def = 150 },
            { id = "grace_period", type = "track", val = 2,
              min = 0, max = 10, step = 0.5, prec = 1, def = 2 },
            { id = "end_inertia", type = "track", val = 2,
              min = 2, max = 30, step = 1, def = 10 },

            { id = "line1", type = "line" },

            { id = "alert_rate", type = "track", val = 2,
