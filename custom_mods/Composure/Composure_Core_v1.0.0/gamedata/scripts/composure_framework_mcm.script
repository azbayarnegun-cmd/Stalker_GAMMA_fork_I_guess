-- Composure Core v2.1 technical settings.

local defaults = {
    starting_value = 65,
    fast_interval = 0.5,
    slow_interval = 5.0,
    max_fast_dt = 2.0,
    max_slow_dt = 15.0,
    history_limit = 64,
    debug_log = false,
}

function get_config(key)
    if ui_mcm then
        local value = ui_mcm.get("composure_framework/" .. key)
        if value ~= nil then return value end
    end
    return defaults[key]
end

function on_mcm_load()
    return {
        id = "composure_framework",
        sh = true,
        gr = {
            { id = "starting_value", type = "track", val = 2,
              min = 0, max = 100, step = 1, def = 65 },
            { id = "fast_interval", type = "track", val = 2,
              min = 0.1, max = 2.0, step = 0.1, prec = 1, def = 0.5 },
            { id = "slow_interval", type = "track", val = 2,
              min = 1.0, max = 15.0, step = 1.0, prec = 1, def = 5.0 },
            { id = "max_fast_dt", type = "track", val = 2,
              min = 0.5, max = 10.0, step = 0.5, prec = 1, def = 2.0 },
            { id = "max_slow_dt", type = "track", val = 2,
              min = 5.0, max = 60.0, step = 5.0, prec = 1, def = 15.0 },
            { id = "history_limit", type = "track", val = 2,
              min = 10, max = 200, step = 1, def = 64 },
            { id = "debug_log", type = "check", val = 1, def = false },
        },
    }
end
