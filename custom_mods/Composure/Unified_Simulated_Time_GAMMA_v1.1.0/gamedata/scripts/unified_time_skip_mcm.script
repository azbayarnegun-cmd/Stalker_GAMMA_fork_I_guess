-- Unified Simulated Time - GAMMA v1.1.0 settings

local defaults = {
    master_enabled = true,
    step_minutes = 3,
    composure_integration = true,
    show_messages = true,
    debug_log = false,

    sleep_enabled = true,
    level_transition_enabled = true,
    transition_fallback_min = 60,
    transition_fallback_max = 120,

    campfire_save_enabled = true,
    campfire_require_mode = true,
    campfire_radius = 36,
    campfire_min_minutes = 15,
    campfire_max_minutes = 30,
    campfire_fade_seconds = 5,
    campfire_mute_audio = true,
    campfire_force_alife = true,

    books_enabled = false,
    anabiotic_enabled = false,
    placeable_campfire_enabled = false,
    flash_enabled = false,
    soulslike_enabled = false,
}

function get_config(key)
    if ui_mcm and ui_mcm.get then
        local ok, value = pcall(ui_mcm.get, "unified_time_skip/" .. key)
        if ok and value ~= nil then return value end
    end
    return defaults[key]
end

function on_mcm_load()
    return {
        id = "unified_time_skip",
        sh = true,
        gr = {
            { id = "master_enabled", type = "check", val = 1, def = true },
            { id = "step_minutes", type = "track", val = 2,
              min = 1, max = 10, step = 1, def = 3 },
            { id = "composure_integration", type = "check", val = 1, def = true },
            { id = "show_messages", type = "check", val = 1, def = true },
            { id = "debug_log", type = "check", val = 1, def = false },

            { id = "line1", type = "line" },
            { id = "sleep_enabled", type = "check", val = 1, def = true },
            { id = "level_transition_enabled", type = "check", val = 1, def = true },
            { id = "transition_fallback_min", type = "track", val = 2,
              min = 1, max = 360, step = 1, def = 60 },
            { id = "transition_fallback_max", type = "track", val = 2,
              min = 1, max = 360, step = 1, def = 120 },

            { id = "line2", type = "line" },
            { id = "campfire_save_enabled", type = "check", val = 1, def = true },
            { id = "campfire_require_mode", type = "check", val = 1, def = true },
            { id = "campfire_radius", type = "track", val = 2,
              min = 4, max = 100, step = 1, def = 36 },
            { id = "campfire_min_minutes", type = "track", val = 2,
              min = 1, max = 240, step = 1, def = 15 },
            { id = "campfire_max_minutes", type = "track", val = 2,
              min = 1, max = 240, step = 1, def = 30 },
            { id = "campfire_fade_seconds", type = "track", val = 2,
              min = 0.1, max = 15, step = 0.5, prec = 1, def = 5 },
            { id = "campfire_mute_audio", type = "check", val = 1, def = true },
            { id = "campfire_force_alife", type = "check", val = 1, def = true },

            { id = "line3", type = "line" },
            { id = "books_enabled", type = "check", val = 1, def = false },
            { id = "anabiotic_enabled", type = "check", val = 1, def = false },
            { id = "placeable_campfire_enabled", type = "check", val = 1, def = false },
            { id = "flash_enabled", type = "check", val = 1, def = false },
            { id = "soulslike_enabled", type = "check", val = 1, def = false },
        },
    }
end
