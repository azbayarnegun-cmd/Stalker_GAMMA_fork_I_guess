; ============================================================
;  THE WALLET, WHICH IS NOT ONE OF OURS
;
;    "an user added so the faction patches can be stored in the wallet
;     (this item cannot be removed from inventory so its good idea)"
;
;  Every section above is this mod's own. This one is the game's, and
;  that difference is the whole of how it is written.
;
;  `![cash]` WITH NO PARENT. The `!` is the override marker and it
;  merges the keys below into the section that is already there.
;  Writing `![cash]:af_base` instead - as the file that was sent did -
;  also RE-PARENTS the wallet onto the artefact base, and then goes on
;  to give it $spawn, class = II_ATTCH, kind = i_attach, a visual, a
;  mesh, activation particles and a negative power_restore_speed. That
;  is not a wallet with a pocket added; it is an artefact container
;  called Wallet, and everything in the game that asks what a wallet IS
;  - the money handling, the trade rules, and the "cannot be dropped"
;  that makes this a good idea in the first place - would be asking
;  about something else.
;
;  So: the box keys, and not one field more. No $spawn, no class, no
;  kind, no visual, no icon, no weight, no name.
;
;  AND NOTHING MORE IS NEEDED. A.is_box_sec reads one key -
;  SYS_GetParam(1, sec, "amp_box") - and the window opens on anything
;  that answers yes and is in your inventory. The class, the kind and
;  the artefact fields on the boxes above are the rig template's own
;  numbers, not requirements.
;
;  THE SQUARES AND THE WEIGHT. Twelve squares for twelve patches with
;  room to spare, and a tenth of a kilogram so it stays a wallet: WHAT
;  goes in is [amp_box_patches]'s business, and this is only how much
;  of it fits.
;
;  amp_box_stack = 99 because in this install patches ARE a thing
;  carried by the fistful - corpse loot, sold by weight of reputation -
;  so one square per faction holds the whole haul and the count plate
;  says how deep it is. It was 1 once, from before the looting habit
;  was thought about.
; ============================================================
![cash]
amp_box                                            = true
amp_box_takes                                      = patches
amp_box_snd                                        = cloth
amp_box_w                                          = 3
amp_box_h                                          = 4
amp_box_kg                                         = 0.1
amp_box_stack                                      = 99
;  AND NO WEIGHT WRITTEN ON THE ICON. Every other box says how much is
;  in it in the corner where the game would write a condition; a wallet
;  holds patches, patches weigh nothing, and a plate that says 0.0
;  whatever you put in it is the thing that plate replaced.
amp_box_wt                                         = false

[ampbox_docs]:af_base
; ------------------------------------------------------------
;  THE DOCUMENT CASE, and the only box whose window is not a grid.
;
;  amp_box_fan = true says its contents are drawn as fanned paper
;  edges with a name along each, because a paper's icon tells you
;  nothing that another paper's does not. See A.fan_lay.
;
;  ONE COLUMN, twenty-four rows. A fan IS a box that is one square
;  wide - every rule about what fits and where it goes is the boxes'
;  own, and only the size of a row and the paint on it differ.
;
;  NO WEIGHT LIMIT. A hundred sheets of paper weigh nothing worth
;  counting, and a case that refused the twenty-fifth letter on the
;  grounds of mass would be arithmetic for its own sake. Room is the
;  limit, as it is for the armour case.
