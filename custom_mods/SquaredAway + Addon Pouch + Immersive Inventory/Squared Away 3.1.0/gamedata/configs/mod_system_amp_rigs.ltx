; ============================================================
;  ARMOR MAG POUCHES - chest rig items
;
;  This file is af_magpouch_s/m/l from the installed magazine mod, with
;  ONLY the identity fields changed: section name, the three text ids,
;  the icon sheet and the grid rectangle on it. Field order, spacing,
;  every value and every commented-out line are exactly as they are in
;  the working sections - including class = II_ATTCH, which is what the
;  items that DO appear in the debug spawner carry.
;
;  Weight, cost and power_restore_speed are the template's own numbers,
;  not new ones, so nothing here differs from a section known to work
;  except the things that must.
;
;  inv_grid_scale = 2 is the one added line. The icons are drawn at
;  GRIP's resolution - a 200 x 300 px rect shown at 2 x 3 cells - and
;  without it the game reads the rect as 4 x 6 cells.
;
;  Slot (col,row) on the sheet is inv_grid_x = col*5, inv_grid_y = row*7.
; ============================================================
[amprig_bandolier]:af_base
$spawn				                               = "artefacts\af_kevlar"
kind			                               = i_attach
class				                               = II_ATTCH
amp_rig                                            = true
amp_rig_tier                                       = 1
amp_slot_2x2                                       = 1
amp_slot_3x1                                       = 0
amp_slot_2x1                                       = 1
amp_slot_1x1                                       = 3
visual                                             = dynamics\equipments\aa\kevlar
description			                               = st_amprig_bandolier_descr
inv_name			                               = st_amprig_bandolier_name
inv_name_short			                           = st_amprig_bandolier_name
inv_weight			                               = 0.9
icons_texture									   = ui\ui_amp_rigs
inv_grid_x			                               = 0
inv_grid_y			                               = 0
inv_grid_width			                           = 4
inv_grid_height			                           = 6
inv_grid_scale			                           = 2
cost				                               = 950
jump_height			                               = 0.0
;particles		                                   = artefact\af_thermal_idle
det_show_particles		                           = artefact\af_thermal_show
det_hide_particles		                           = artefact\af_thermal_hide
particles_bone			                           = joint2
af_rank				                               = 0
lights_enabled                                     = false
trail_light_color 		                           = 0.9,0.4,0.2
trail_light_range 		                           = 2.0
attach_angle_offset		                           = 1.922,1.551,-0.740   
attach_position_offset                             = 0.15,0.002,0.25
attach_bone_name		                           = bip01_r_hand
auto_attach			                               = false
health_restore_speed		                       = 0
radiation_restore_speed		                       = 0
satiety_restore_speed		                       = 0
bleeding_restore_speed		                       = 0
;hit_absorbation_sect		                       = af_kevlar_absorbation
;additional_inventory_weight	                       = 1.26
;additional_inventory_weight2	                   = 1.26
artefact_activation_seq		                       = af_activation_bold
;material = kevlar
;script_binding                                     = arti_cond_binder.bind

power_restore_speed		                           = -0.001
use1_functor                                       = zzz_armor_mag_pouches.rig_no_install
use1_action_functor                                = zzz_armor_mag_pouches.rig_no_install
belt                                               = false

tier = 1

; ------------------------------------------------------------
;  IT WEARS, AND IT IS MENDED THE WAY EVERY OTHER PIECE OF KIT IS
;
;  use_condition puts the bar on the icon and lets the engine keep
;  the number. repair_type is the whole of the repair wiring: a kit
;  declares `repair_only = ... outfit_light ...` and the game's own
;  machinery does the rest - the minimum condition it will work at,
;  the parts window, all of it. Nothing of another mod is patched,
;  and any setup that can mend a light armour can mend a rig.
;
;  outfit_light rather than a type of our own: a type nobody lists
;  is a rig no kit will touch, and this one is already served by
;  every sewing kit and cloth glue in the game.
use_condition                                      = true
repair_type                                        = outfit_light
repair_part_bonus                                  = 0.05
