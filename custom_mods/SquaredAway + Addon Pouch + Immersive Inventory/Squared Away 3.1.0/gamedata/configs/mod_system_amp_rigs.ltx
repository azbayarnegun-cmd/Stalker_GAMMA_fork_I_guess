; ============================================================
;  LEGACY SECTION NAMES - do not delete, do not add to.
;
;  Up to 1.19.0 the rigs were called amp_rig_*. They had to be renamed:
;  GAMMA's debug menu builds its Item Spawner list by walking every
;  section and throwing away any whose NAME contains "mp_" - it is
;  hunting multiplayer leftovers - and "amp_rig" contains it. The whole
;  lineup was missing from the spawner with nothing logged to say why.
;
;  A section name is what a SAVE stores. Without these eight lines, a
;  save holding an old rig cannot find its section and the game refuses
;  to load it. Each one inherits the renamed rig whole, so an old rig
;  keeps its name, icon, pockets and weight and behaves identically.
;
;  They are not in the loot tables, the craft recipes or the starting
;  kit - nothing new is ever created under these names. They exist only
;  so an existing save keeps working, and can go once no save from
;  before 1.20.0 is being played.
; ============================================================

; ------------------------------------------------------------
;  IT WEARS, AND IT IS MENDED THE WAY EVERY OTHER PIECE OF KIT IS
;
;  use_condition puts the bar on the icon and lets the engine keep
;  the number. repair_type is the whole of the repair wiring: a kit
;  declares `repair_only = ... outfit_light ...` and the game's own
;  machinery does the rest - the minimum condition it will work at,
;  the parts window, all of it. Nothing of another mod is patched,
;  and any setup that can mend a light armour can mend a rig.
;
;  outfit_light rather than a type of our own: a type nobody lists
;  is a rig no kit will touch, and this one is already served by
;  every sewing kit and cloth glue in the game.
use_condition                                      = true
repair_type                                        = outfit_light
repair_part_bonus                                  = 0.09
