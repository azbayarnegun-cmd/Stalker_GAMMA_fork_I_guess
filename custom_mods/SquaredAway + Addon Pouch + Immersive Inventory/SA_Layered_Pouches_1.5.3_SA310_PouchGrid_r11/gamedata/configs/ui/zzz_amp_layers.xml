<w>
	<layers>
		<!-- Personal-inventory-only pouch column. The script places these
		     against the live player panel and sizes them from its rectangle. -->
		<side_bg x="0" y="0" width="400" height="600" stretch="1"/>
		<side_title x="0" y="0" width="300" height="20">
			<text align="l" vert_align="c" font="letterica16" r="210" g="210" b="210" a="255"/>
		</side_title>
		<side_weight x="0" y="0" width="300" height="20">
			<text align="r" vert_align="c" font="letterica16" r="180" g="180" b="180" a="255"/>
		</side_weight>
		<side_container x="0" y="0" width="400" height="500" stretch="1"/>
		<frame x="0" y="0" width="260" height="340" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</frame>
		<button x="0" y="0" width="28" height="82" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
			<text align="c" vert_align="c" font="letterica16" r="230" g="210" b="140" a="255"/>
		</button>
		<title x="8" y="6" width="244" height="22">
			<text align="l" vert_align="c" font="letterica18" r="230" g="210" b="140" a="255"/>
		</title>
		<hint x="8" y="30" width="244" height="30">
			<text align="l" vert_align="c" font="letterica16" r="180" g="180" b="180" a="255" complex_mode="1"/>
		</hint>
		<row x="8" y="0" width="244" height="18">
			<text align="l" vert_align="c" font="letterica16" r="210" g="210" b="210" a="255"/>
		</row>
		<slot x="0" y="0" width="34" height="34" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
			<text align="c" vert_align="c" font="letterica16" r="230" g="230" b="230" a="255"/>
		</slot>
		<slot_fill x="0" y="0" width="32" height="32" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
			<text align="c" vert_align="c" font="letterica16" r="220" g="210" b="170" a="255"/>
		</slot_fill>
		<slot_icon x="0" y="0" width="30" height="30" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</slot_icon>
		<bar_bg x="0" y="0" width="28" height="4" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</bar_bg>
		<bar x="0" y="0" width="28" height="3" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</bar>
		<carrier x="0" y="0" width="18" height="18" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</carrier>
		<ghost x="0" y="0" width="34" height="34" stretch="1">
			<texture>ui_inGame2_white_rect</texture>
		</ghost>
	</layers>
</w>
