--[[
	ARMOR MAG POUCHES
	=================

	A chest rig beside the equipment. Right-click your EQUIPPED armour ->
	"Mag pouches" and it opens: a fixed row of identical pockets, one
	magazine each. Drag a magazine in and it is stored there and hidden
	from the inventory grid. Right-click a pocket to take it back out.

	WHAT CHANGED IN 0.2.0, AND WHY
	------------------------------
	0.1.x drew the magazine mod's LOADOUT - `magazine_binder.carried_mags`
	- with a slot count derived from get_loadout_size() and pockets
	grouped into small / medium / large classes with a shift-up rule
	between them. Every one of those was a moving part that had to agree
	with somebody else's arithmetic, and the layout came out wrong in a
	different way in each of three builds.

	This is now plain storage: N identical pockets, one magazine each,
	owned entirely by this file. Nothing derives a size, a count or a
	class from anywhere else. There is no rule that can disagree with
	another rule, because there is only one rule.

	IT NO LONGER DEPENDS ON THE MAGAZINE MOD AT ALL
	-----------------------------------------------
	Dropping the loadout left exactly one thing being asked of
	magazine_binder: is_magazine(). That function is, in full,
	`SYS_GetParam(1, section, "is_mag")` - a section flag any magazine
	mod sets on its own items. So it is read directly and the dependency
	is gone. Only custom_functor_autoinject is still needed, and only to
	hang the context-menu entry on the armour.

	Note this also means pouched magazines are NOT in the reload loadout
	any more. That is the point of the change: this is a place to keep
	magazines, not a view onto someone else's system.

	A POCKET IS NOT A CONTAINER
	---------------------------
	The magazine never leaves the actor's inventory - there is no engine
	container here to move it into. A pocket records an object id, and
	the inventory grid is filtered to hide the ids that are recorded. So
	the weight never changes and nothing can be duplicated or lost; the
	worst case is a pocket pointing at an object that is gone, which
	A.prune drops on sight.
--]]

-- ============================================================
-- ONE PAGE, THREE SECTIONS
--
--   "make the MAIN category in MCM be called that and
--    subcategories inside of it to be AMP and ZONEGRID + option
--    patch category WearableDevices patch."
--
-- The root of every option path this file reads. It used to be
-- ArmorMagPouches, which was its own entry in the MCM list beside
-- AmpGrid and amp_weardev; there is one entry now with a section
-- for each. The GROUP is untouched, so the move is only ever the
-- first component - which is what makes the one-off migration in
-- the MCM file a rename rather than a mapping.
-- ============================================================
local MOD   = "squared_away"
local GROUP = "amp_general"

local BAG   = "actor_bag"
local CC_ID = "amp_rig"

-- The middle column's magazine and ammo list. A second container in
-- the menu's own CC table, so everything that walks that table -
-- tooltips, scrolling, drag - finds it without being told.

-- How long a left button has to be down before it is a carry rather
-- than a click. The base class uses the same number for its own hold
-- icon; a shorter one flashes a picture every time you click a pocket.
local DRAG_MS = 100

-- What the rig calls itself when it talks to the inventory's own
-- machinery: worn gear, not rucksack. See the note on A.release_m2 for
-- why the distinction has teeth.
local EQU   = "actor_equ"

-- How many cell nodes zzz_amp.xml declares.
-- ONE definition, bumped on every build that leaves here, written to the
-- log at load and shown in the MCM page title, so "which version is
-- actually installed" is never a guess again.
--
-- There used to be a second one, left at 0.4.0, and the load line has
-- been printing 0.4.0 through five releases since. The audit now
-- compares this against meta.ini, the FOMOD and the MCM labels.
local VERSION = "3.1.0-test+Layered-1.5.3-port-r9-video-confirmed"

-- THE BUILTINS ARE PINNED. A global is a hash lookup every time it is
-- named; an upvalue is an array index. These five are named on every
-- hot path in the file - each redraw, each sync, each drag - so they
-- are read out of _G exactly once, here. Found by Priler's ALAO
-- linter, which flagged every uncached use; this one line answers
-- all of them.
local type, tostring, tonumber, pairs, ipairs
    = type, tostring, tonumber, pairs, ipairs

local MAX_SLOTS = 32

-- The rig slot, in cells. It holds one rig and it is the only slot this
-- mod owns, so it is sized like the inventory's own cells rather than
-- by eye.
local SLOT_CELLS_W = 2
local SLOT_CELLS_H = 3

-- ============================================================
-- THE MED POCKET
--
--   "can we add one 2x2 slot for every rig that is not for mags but
--    for medical items, there can be 4 1x1 items or 2 2x2 items and
--    any thing in the mix that can fit"
--
-- Two cells by two, on EVERY rig, so it is something a player can rely
-- on being there rather than a property of the rig they happened to
-- loot. Four 1x1 things, or two 2x1, or one 2x2, or any mix that fits -
-- which is what a grid means and why this is a grid and not four slots.
--
-- FIVE TO A SQUARE, whatever the section's own stack size is. A stack
-- in this game is several separate objects drawn as one cell, so a cap
-- here is a cap on how many objects stand on one square and needs no
-- arithmetic per section. Five bandages, five medkits, five of anything
-- - and a full pocket is twenty things, which is a lot of medicine and
-- still less than a bag.
-- ============================================================
-- ============================================================
-- THE STACK NUMBER'S PLATE
--
-- 18 by 10, which is what utils.xml gives it and therefore what every
-- other count in the inventory is. Written here rather than at the
-- three call sites so the three cannot drift apart, and named so that
-- somebody reading a `18` in a draw pass is not left guessing.
--
-- The WIDTH carries the aspect correction and the height does not, the
-- same as every other rectangle in this file.
-- ============================================================
local CNT_W = 18
local CNT_H = 10

-- ============================================================
-- THE BIGGEST A SLOT CAN BE, WHICH IS WHAT THE POOLS ARE SIZED TO
--
-- Four geometries: 1x1, 2x1, 3x1, 2x2 - written TALL BY WIDE, so a
-- 3x1 is three squares tall and one wide. A slot is therefore at most
-- three squares one way and two the other, and at most FOUR squares
-- occupied at once - the 2x2 with a 1x1 on every square.
--
-- Written as the arithmetic rather than as 4, because the number that
-- matters is "every square of the largest slot holding something", and
-- a fifth geometry added above should move this without anybody having
-- to remember that it exists.
-- ============================================================
local SLOT_MAX_W = 2
local SLOT_MAX_H = 3
local SLOT_MAX   = 4

local SCREEN_W = 1024
local SCREEN_H = 768

local TITLE_H = 14
local PAD = 4

-- Between pockets. Small on purpose: the rig should read as pockets
-- sitting against each other, not as a scattered set of boxes.
local GAP = 3

local DEFAULTS = {
	-- ============================================================
	-- WHICH ORDER THE THREE COLUMNS STAND IN
	--
	--   "add option in MCM to change the inventory layout to default
	--    game ... many user ask for it."
	--
	-- "default" is the game's own: the other party on the left, what
	-- you are wearing in the middle, your bag on the right. "tarkov" is
	-- the order this mod's xml is written in - equipment against the
	-- left edge, bag in the middle - which is what everybody who
	-- installed it before today has been looking at.
	--
	-- THE NEW DEFAULT IS THE GAME'S, on purpose: somebody installing an
	-- inventory mod has not asked to have their menu rearranged, and
	-- the one that surprises nobody is the one they already know.
	-- Loot files itself into a container that already holds its kind,
	-- and a drag out of a body onto an open box works at all. Both are
	-- the same feature: see A.file_loot.
	amp_loot_box  = true,

	amp_layout    = "default",

	amp_anchor_bag = true,
	amp_enable    = true,
	amp_hide_grid = true,
	amp_left      = true,
	amp_dx        = 0,
	amp_dy        = 0,

	-- The personal inventory in three columns: equipment against the
	-- left edge, the rig in the middle, the bag where it always was.
	-- Off, the menu keeps its stock layout and the rig opens beside the
	-- equipment panel as before.

	-- Magazines and ammo drawn in the middle column instead of in the
	-- bag. They do not MOVE - same items, same weight, same inventory -
	-- so turning this off simply puts them back in the bag's list.

	-- A pocket's size in GRID UNITS. A magazine's footprint is a
	-- property of whichever magazine mod is installed, not of the
	-- armour, so it lives here and not in the rig table. A magazine that
	-- does not fit is refused at the drop with its real size in the
	-- message, so the numbers to put here are never a mystery.

	-- The rig replaces the ARMOUR's loadout numbers. With this on it
	-- replaces the backpack's and the belt artefacts' as well, so the
	-- rig is the whole of what you can carry and expansion pouches are
	-- the only way to grow it. Off, backpacks and artefacts keep adding
	-- slots the rig has no pockets for - which is vanilla behaviour but
	-- means the panel no longer shows your whole loadout.
	amp_rig_is_all = true,

	-- ============================================================
	-- WHERE THE POCKETS COME FROM
	--
	-- On: an armour is just armour and grants nothing. Every pocket
	-- comes from a CHEST RIG installed onto the worn outfit - the
	-- mag_pouches mechanism the magazine mod already ships, so the
	-- gesture is the one players already know: drag the rig onto the
	-- armour, or right-click it and Install. No rig, no pockets.
	--
	-- And the rig's numbers are then taken LITERALLY. The percentages
	-- below exist because the magazine mod's outfit table is generous
	-- and had to be scaled down to make a believable chest rig; a rig
	-- item's numbers were written by whoever made the rig, for a rig,
	-- so scaling them would only make its description a lie. The caps
	-- still apply - they are a ceiling, not a balance knob.
	--
	-- Off is the old behaviour: the armour's own numbers, scaled, with
	-- an installed pouch added on top.
	-- ============================================================

	-- ============================================================
	-- WEAR FROM BEING SHOT AT, WHICH YOU CAN TURN OFF
	--
	-- The rig loses a fraction of a percent per hit. That is the part of
	-- durability people argue about, because it is the part that happens
	-- to a rig you looked after rather than one you looted - so it is a
	-- switch of its own.
	--
	-- OFF does not touch anything else: a rig off a corpse still arrives
	-- torn, torn pockets still tear, and mending still mends. Only your
	-- own fighting stops costing you.
	-- ============================================================
	amp_rig_wear = true,

	-- ============================================================
	-- THE CAPACITY KNOBS ARE GONE
	--
	-- amp_scale, amp_cap_small/med/large and amp_pouch_scale all tuned
	-- one thing: how many pockets of each size class an ARMOUR was
	-- worth, read out of the magazine mod's outfit table and scaled
	-- down. There are no size classes in 3.0 and an armour grants
	-- nothing - a rig's slots are stamped on the rig, out of
	-- l_amp_rigs.ltx - so there is no number left for them to scale.
	--
	-- THE BALANCE KNOB IS NOW THAT FILE, and it is a better one: change
	-- a slot count there and the loot tier, the recipe, the price, the
	-- tooltip and the shape diagram all follow, because they are all
	-- generated from it.
	-- ============================================================
	amp_wear_loot = true,

	-- ============================================================
	-- THE MED POCKET, AND WHETHER IT IS THE ONLY WAY TO REACH MEDICINE
	--
	-- Two switches, because they are two decisions and only one of them
	-- changes how the game plays.
	--
	--   amp_med       is there a med pocket at all. Off empties nothing
	--                 - what is in one is still in the rig and comes
	--                 straight back when it is turned on again.
	--
	--   amp_med_only  with the inventory SHUT, medicine works only if
	--                 it is in the pocket. This is the one the player
	--                 asked for and it is a real change: a bag full of
	--                 medkits is no use if you did not pack one. With
	--                 it off the pocket is a convenience and the keys
	--                 behave exactly as they always did.
	--
	-- Clicking Use on something in your own inventory is never governed
	-- by either. See A.on_item_before_use.
	-- ============================================================
	amp_med      = true,
	amp_med_only = true,

	-- ============================================================
	-- AND A GUN WITH NO MAGAZINE RELOADS OUT OF THE RIG
	--
	--   "guns that dont use magazines like self loaded shoutguns would
	--    need ammo to be put inside the rig to be loaded"
	--
	-- Pumps, self-loaders, revolvers, bolt rifles - everything the
	-- magazine mod does not handle. Their ammunition has to be in a
	-- rig slot or the reload is refused.
	--
	-- ON, because it was asked for; a switch, because it is a real
	-- change to how the game plays and somebody will want the old way.
	-- ============================================================
	amp_ammo_gate = true,

	-- How long a dragged item rests on a willing box before that box's
	-- window opens itself, in seconds. 0 switches the courtesy off.
	amp_boxhover = 2,

	-- The pocket foley: pouch fabric on every put and take, the item's
	-- own pickup voice for landing in a box. All borrowed from sounds
	-- GAMMA already ships; this mod adds no files.
	amp_sounds   = true,

	-- How loud the foley is. 1 is the files as recorded, which the
	-- first listener called "super subtle"; the knob goes to 3.
	amp_sndvol   = 1,

	-- Devices worn on the arm by the Wearable Devices pack - the
	-- bracer and whatever is mounted on it - are hidden from the bag,
	-- the same way the rig you are wearing is. Off puts them back.
	-- HOW BIG THE RIG IS DRAWN ON THE ARMOUR'S ICON, as a percentage of
	-- that icon. 100 makes it exactly as tall as the armour it is
	-- strapped to; the width follows from the rig's own footprint, and
	-- whichever axis runs out first is the one that binds, so it can
	-- never be wider than the icon either.
	--
	-- A slider rather than a constant because this is a judgement about
	-- how it LOOKS, and the first value shipped - half the icon - came
	-- back as "too small by about half". Nobody working on this from
	-- outside the game can settle that; the person looking at it can.

	-- Writes what the rig, the carried set and the grid filter each
	-- decided, every time they decide it, to the game log.
	amp_debug     = false,
}

-- Size classes, smallest first. A pocket takes its own class or
-- anything below it: a pistol magazine drops into a rifle pocket, a
-- drum drops into neither. Same shift-up direction the magazine
-- system's own counting uses.
-- TALL RANKS WITH LARGE, and is a different SHAPE. Some magazines are
-- one cell wide and three tall - extended SMG sticks, the Vepr drum -
-- and they fit nothing the rig had: too tall for a 1x2 pocket, and a
-- 2x2 drum pocket is the wrong shape rather than merely bigger. So the
-- rank ladder gained a fourth name at the same rank as large, and what
-- separates the two is the footprint below.
local CLASS = { small = 1, medium = 2, large = 3, tall = 3 }
local CLASS_NAME = { "small", "medium", "large", "tall" }
-- ============================================================
-- ONE TABLE
--
-- A function stored as a field is resolved when the call runs, so it can
-- be defined below what it reads and called from above it. A
-- `local function` can do neither.
-- ============================================================
local A = {
	open = false,

	-- ============================================================
	-- WHAT IS IN A RIG - THE 3.0 STORE
	--
	--   "everything that fits can be stored there, with the same stack
	--    sizes as in inventory"
	--
	-- Every slot of every rig is a tiny grid holding ENTRIES, and an
	-- entry is one occupied rectangle of that grid:
	--
	--     { sec = "mag_ak", r = 1, c = 1, w = 2, h = 1, ... }
	--
	-- which is the same shape a box entry has, so the boxes' packer -
	-- box_room, box_spot, box_on, box_join - does the fitting and none
	-- of it had to be written twice.
	--
	-- THERE ARE TWO OF THESE AND THERE HAS TO BE, which is the one
	-- thing about this store that is not obvious:
	--
	--   wear[slotkey]        the rig ON YOUR CHEST. Entries carry
	--                        `ids` - REAL objects, still in your
	--                        inventory, hidden from the grid. They have
	--                        to be real, because a magazine you reload
	--                        from and a bandage you press a key to use
	--                        are things the game has to be able to find.
	--
	--   hold[rigid][slotkey] a rig in your bag, a stash or on a corpse.
	--                        Entries carry `of` - a packed RECORD of
	--                        what was there, and the objects are gone.
	--                        A spare rig cannot hold real objects: they
	--                        would be loose in your inventory, weigh
	--                        their own weight and be usable out of a
	--                        rig you are not wearing.
	--
	-- Putting a rig on turns the records into objects; taking it off
	-- turns the objects back into records. That is the only place the
	-- two shapes meet, and it is one function each way.
	-- ============================================================
	wear = {},
	hold = {},

	-- ============================================================
	-- AND THE LIVE POCKETS, WHICH ARE A VIEW OF `wear`
	--
	-- A.pk[i] is the ith slot of the WORN rig as the panel draws it:
	--
	--     { key, id, cols, rows, pouch, slots, byid, mshow }
	--
	-- `slots` is not a copy - it IS wear[key], so a drop into a pocket
	-- is a drop into the save. `byid` and `mshow` are caches derived
	-- from it: id -> entry, for A.hidden, which is asked once per item
	-- per inventory refresh and must not walk the entries to answer;
	-- and a short-lived stack count for the draw.
	--
	-- Rebuilt by A.resolve_pk whenever resolve_rig runs, which is
	-- whenever the rig, its pouches or its wear change.
	--
	-- THIS LIST REPLACED THREE. There used to be `slots` and `by_id`
	-- (one magazine per pocket), `med`/`med_id`/`mstash` (the built-in
	-- med pocket) and `pmed`/`pmstash` (a med pocket per pouch slot) -
	-- three stores with three fit rules, three weight paths and three
	-- sets of save code, which is where the weight kept going missing.
	-- ============================================================
	pk = {},

	-- The quick-use gate's switches, and the object it decided should
	-- have been used instead of the one it refused. Consumed by the
	-- next update; see A.on_item_before_use.
	med_on   = DEFAULTS.amp_med,
	med_only = DEFAULTS.amp_med_only,
	med_eat  = nil,

	-- What is in hand out of a slot: { i = slot, n = entry, tg = when
	-- it was pressed }. THE ONLY DRAG THE PANEL HAS - there used to be
	-- a second, A.drag, for one magazine out of a whole pocket, which
	-- is what a pocket was when it held exactly one thing.
	pk_drag = nil,

	cc = nil, xml = nil, gui = nil,
	frame = nil, title = nil, close_st = nil,
	pk_out = nil, pk_in = nil,          -- pocket border / interior pools
	ov_ammo = nil, ov_cnt = nil, ov_bar = nil,   -- on-icon information

	org  = { 0, 0 },
	rect = nil,
	close_r = nil,
	lay  = nil,

	-- The release is decided by the press.
	ate = nil, ate2 = nil,

	-- The cell size each icon was last centred for, so a pocket that
	-- changes size can have its magazine written in again.
	cellsz = {},

	-- How big each magazine's PICTURE is, measured the moment its cell
	-- was filled. Cropping it at the top of the list changes its size,
	-- so that is the only moment the measurement means anything.
	icosz = {},

	-- What each cell was last told, so UICellItem:Update runs when the
	-- magazine in it changes rather than thirty times a second.
	cellsig = {},
	cellhl = {},
	rounds = {},

	-- Is anything of this panel currently on screen? Guards A.hide so
	-- that hiding an already-hidden rig costs nothing. hid_from/hid_ov
	-- record how far up the pooled statics were last hidden.
	shown = false,
	hid_from = nil, hid_ov = nil,

	-- The per-draw object cache. Non-nil only inside A.draw.
	oc = nil,

	-- Pinned: the rig stays open when the inventory closes, so it is
	-- there again the next time you open it. Saved with the pockets.
	pinned = false,
	pin_st = nil, pin_r = nil,

	-- Logged once, not once a frame.
	warned = nil, warned_fix = nil,

	-- The measured difference between where a cell is placed and where it
	-- actually lands, KEYED BY THE ICON'S FOOTPRINT. See A.correct.
	fix = {},

	enabled   = DEFAULTS.amp_enable,
	hide_grid = DEFAULTS.amp_hide_grid,
	left      = DEFAULTS.amp_left,
	dx = DEFAULTS.amp_dx, dy = DEFAULTS.amp_dy,
	rig_is_all = DEFAULTS.amp_rig_is_all,
	rig_wear   = DEFAULTS.amp_rig_wear,

	-- Where the current rig came from, for the log and nothing else.
	rig_src = "none",

	-- reconcile reaches code that can ask for the loadout, which resolves
	-- the rig, which reconciles.
	in_reconcile = false,

	-- The resolved rig: an array of pocket class names, plus the row
	-- structure used to draw it. Rebuilt when the armour changes.
	rig = {}, rows = {}, rig_key = nil,

	ltx = nil,
	gls_base = nil,
	rip_base = nil,
	in_room = false,

	-- The carried set as of the last reconcile. The grid filter reads it
	-- rather than asking again, so what is hidden is decided ONCE per
	-- inventory refresh and cannot change between the reconcile and the
	-- filter in the same call.
	carried_now = {},

	last_sync = 0,
	debug = false,
}

-- ============================================================
-- FORMAT IN LUA, HAND printf ONE STRING
--
-- Anomaly's printf does not understand %d. Every one of the 11,755
-- "%d"s in the log the player sent came from this file and nothing
-- else; the same log has CATHDR printing numbers correctly, because
-- that one only ever used %s. So the diagnostics that were added
-- specifically to end four rounds of guessing printed their format
-- string and threw the numbers away.
--
-- string.format is Lua's own and handles everything. Doing it here
-- means no call site has to remember, and a bad format degrades to
-- printing the format rather than to printing nothing useful.
-- ============================================================
local function fmt_safe(fmt, ...)
	local ok, msg = pcall(string.format, fmt, ...)
	return ok and msg or fmt
end

local function log(fmt, ...)
	printf("[AMP] %s", fmt_safe(fmt, ...))
end

-- Off by default and silent. Two rounds of fixes for the same two bugs
-- were reasoned out and neither landed, so this exists to be turned on
-- and read rather than guessed at again.
local dbg         -- defined once A exists
local dbg_reset

local function notify(fmt, ...)
	-- Through fmt_safe like the log, and for the reason the crash in
	-- 1.29 taught: string.format is not a safe call. A missing argument
	-- - which is what a function that falls off its own end hands it -
	-- is a hard error, and a message the player was meant to READ is a
	-- bad place to take the game down.
	local msg = fmt_safe(fmt, ...)
	log("%s", msg)
	pcall(function() actor_menu.set_msg(1, msg, 3) end)
end

-- Off by default and silent. Two rounds of fixes for the same two bugs
-- were reasoned out and neither landed, so this exists to be turned on
-- and read rather than guessed at again.
-- ============================================================
-- A DEBUG LOG THAT REPEATS ITSELF IS NOT A DEBUG LOG
--
-- reconcile runs on a 500 ms throttle whether or not anything changed,
-- and every one of those wrote a line. A player log came back with the
-- same sentence 3,636 times:
--
--   [AMP-DBG] reconcile: pockets=6 carried=6 adopted=0 released=0 dropped=0
--
-- Finding the four lines that mattered meant reading past all of it, and
-- the same flood in the console is what "spammed every nanosecond" is
-- describing. A log nobody can read is worse than no log, because it
-- costs the writing and buys nothing.
--
-- So an identical message is not written twice in a row. When something
-- finally does change, the repeat count goes out with it, which keeps
-- the one fact the flood was carrying - that it kept happening, and how
-- often - without the thousands of lines.
--
-- Compared as the FINISHED string, so two calls that differ only in a
-- number are still two different lines. That is the whole point: a
-- pocket count going 6 -> 7 is news, a pocket count staying 6 is not.
--
-- And compared PER CALL SITE, keyed on the format string - which is a
-- constant at each site - rather than against whatever was written
-- last. Comparing against the last line only works while one report is
-- flooding on its own. Two unchanging reports that interleave, and
-- reconcile and the grid filter do interleave every time the bag
-- refreshes, are never each other's previous line, so both would print
-- every round and nothing would be suppressed at all. Keyed per site,
-- each line is measured against the last thing THAT line said, and the
-- interleaving stops mattering.
--
-- The repeat count is carried on the summary line itself instead of
-- pointing at "the previous line", because with several sites running
-- the previous line printed is usually somebody else's.
-- ============================================================
local dbg_msg, dbg_rep = {}, {}

dbg_reset = function()
	dbg_msg, dbg_rep = {}, {}
end

function dbg(fmt, ...)
	if not A.debug then return end

	local msg = fmt_safe(fmt, ...)

	if msg == dbg_msg[fmt] then
		dbg_rep[fmt] = (dbg_rep[fmt] or 0) + 1
		return
	end

	local n = dbg_rep[fmt] or 0
	if n > 0 then
		printf("[AMP-DBG] (repeated %s more times) %s",
		       tostring(n), tostring(dbg_msg[fmt]))
		dbg_rep[fmt] = 0
	end

	dbg_msg[fmt] = msg
	printf("[AMP-DBG] %s", msg)
end

local function clampi(v, lo, hi)
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

-- ============================================================
-- SETTINGS
-- ============================================================

-- ============================================================
-- THE THREE COLUMNS, IN EITHER ORDER
--
-- The game writes them other-party / equipment / bag, left to right.
-- This mod's ui_inventory_16.xml writes them equipment / bag /
-- other-party. That file is read once when the menu is built and MCM
-- cannot swap files, so the option moves the windows afterwards - see
-- A.cols_apply, which is further down because it needs half this file
-- before it can measure anything.
--
-- IT SITS WITH THE OPTION READERS, which is the one place that is
-- after `local A` and before refresh_settings. refresh_settings
-- validates the stored value against it, and a local read above the
-- line that declares it is not that local at all - it is a global of
-- the same spelling, which is nil, and indexing it takes the mod down
-- on the first option change. That has happened in this file before.
-- ============================================================
local LAY_ORDER = {
	default = { "npc", "equ", "player" },
	tarkov  = { "equ", "player", "npc" },
}

-- PURE, so the arithmetic can be checked without a game running: given
-- each column's width and where the leftmost of them starts, where each
-- one goes. nil means "leave the menu alone", which is what a missing
-- window or a nonsense width has to mean - a column laid out from a nil
-- is a column off the side of the screen.
--
-- NOT A TABLE OF COORDINATES. Typed x values would be a second copy of
-- the xml, wrong the day a width changes and silently wrong at that.
-- Re-stacking the columns at their own measured widths reproduces both
-- layouts to the half unit and needs no numbers at all:
--
--     equipment 260.5      bag 382      other party 382
--
--     tarkov    equ 0        bag 260.5    other 642.5
--     default   other 0      equ 382      bag 642.5
function A.cols_for(layout, wide, left)
	local order = LAY_ORDER[layout or ""]
	if not (order and type(wide) == "table" and type(left) == "number") then
		return nil
	end

	local out, x = {}, left
	for i = 1, #order do
		local k = order[i]
		local w = wide[k]
		if type(w) ~= "number" or w <= 0 then return nil end
		out[k] = x
		x = x + w
	end
	return out
end

local function opt_in(group, id, fallback)
	if not ui_mcm then return fallback end

	local ok, v = pcall(ui_mcm.get, MOD .. "/" .. group .. "/" .. id)
	if not ok or v == nil then return fallback end
	return v
end

local function opt_get(id, fallback)
	return opt_in(GROUP, id, fallback)
end

-- ============================================================
-- THE DROP SLIDERS ARE ON THEIR OWN PAGE
--
-- MCM's path is root/subgroup/option, and the sixty-four sliders are
-- under a SECOND subgroup - which is what "add mcm subcategory" asked
-- for. Reading them through opt_get would build a path under the
-- general page, miss, and hand back the default: every slider in the
-- menu would move and nothing in the game would change, silently.
--
-- One line, and it is the whole reason this pair of functions exists.
-- ============================================================
local DROPS = "amp_drops"

local function opt_drop(id, fallback)
	return opt_in(DROPS, id, fallback)
end

-- ui_mcm.get returns BARE for a path it does not know, and a call in the
-- last argument position expands to ALL of its return values - so
-- tonumber(ui_mcm.get(p)) becomes tonumber() with no argument at all,
-- which RAISES in Lua 5.1 rather than returning nil. Assign first,
-- convert on the next line.
local function opt_num(id, fallback)
	local v = opt_get(id, fallback)
	local n = tonumber(v)
	return n or fallback
end

function A.refresh_settings()
	A.enabled   = opt_get("amp_enable", DEFAULTS.amp_enable) and true or false

	-- ONE OF THE TWO OR THE DEFAULT. MCM stores whatever it stored, and
	-- a value this file does not know would mean a menu laid out from a
	-- nil - so anything unrecognised reads as the game's own order.
	A.loot_box = opt_get("amp_loot_box", DEFAULTS.amp_loot_box) and true or false

	-- ============================================================
	-- THE DROP SLIDERS
	--
	-- Sixty-four of them, built from A.drop_opts so the menu and this
	-- read one list. Kept as a FRACTION rather than a percentage,
	-- because that is what the roll compares against and converting
	-- once here is cheaper than converting on every death.
	--
	-- CLAMPED. A number out of axr_options.ltx is a number somebody may
	-- have edited by hand, and a chance above one is a certainty that
	-- says 300 in the menu.
	-- ============================================================
	A.drop = {}
	for _, rank in ipairs(A.DROP_RANKS) do
		A.drop[rank] = { tier = {}, pouch = {} }
	end

	local opts = A.drop_opts()
	for i = 1, #opts do
		local rank, key, def = opts[i][1], opts[i][2], opts[i][3]
		local v = tonumber(opt_drop(A.drop_id(rank, key), def)) or def or 0
		if v < 0 then v = 0 elseif v > 100 then v = 100 end

		local row = A.drop[rank]
		local t = tonumber(string.match(key, "^t(%d+)$"))
		if t then
			row.tier[t] = v / 100
		else
			for k = 1, #A.DROP_PKEY do
				if A.DROP_PKEY[k] == key then row.pouch[k] = v / 100 end
			end
		end
	end

	local lay = opt_get("amp_layout", DEFAULTS.amp_layout)
	A.layout = LAY_ORDER[lay] and lay or DEFAULTS.amp_layout
	A.hide_grid = opt_get("amp_hide_grid", DEFAULTS.amp_hide_grid) and true or false
	A.left      = opt_get("amp_left", DEFAULTS.amp_left) and true or false

	-- Turned OFF with the inventory already open, nothing would put the
	-- panels back until the next time a mode started - so it is done
	-- here, on the menu this mod last moved. Turned ON, the draw pass
	-- picks it up on the next frame.
	A.dx        = clampi(opt_num("amp_dx", DEFAULTS.amp_dx), -900, 900)
	A.dy        = clampi(opt_num("amp_dy", DEFAULTS.amp_dy), -900, 900)

	-- The grid build: the rig block goes in the corner of the bag column
	-- and Zone Grid keeps the top rows clear for it.
	A.bag_anchor = opt_get("amp_anchor_bag", DEFAULTS.amp_anchor_bag) and true or false

	A.rig_is_all = opt_get("amp_rig_is_all", DEFAULTS.amp_rig_is_all) and true or false
	A.rig_wear   = opt_get("amp_rig_wear",   DEFAULTS.amp_rig_wear)   and true or false

	A.wear_loot = opt_get("amp_wear_loot", DEFAULTS.amp_wear_loot) and true or false
	A.med_on    = opt_get("amp_med",      DEFAULTS.amp_med)      and true or false
	A.med_only  = opt_get("amp_med_only", DEFAULTS.amp_med_only) and true or false
	A.ammo_gate = opt_get("amp_ammo_gate", DEFAULTS.amp_ammo_gate) and true or false
	A.boxhover  = clampi(opt_num("amp_boxhover", DEFAULTS.amp_boxhover), 0, 30)
	A.snd_on    = opt_get("amp_sounds",   DEFAULTS.amp_sounds)   and true or false
	A.sndvol    = clampi(opt_num("amp_sndvol", DEFAULTS.amp_sndvol), 0.1, 3)
	-- THE ROTATE KEY, from MCM's key binder - R unless rebound. Read
	-- as a number because that is what ui_mcm stores for a key_bind,
	-- and DIK_keys is asked at call time, never at chunk scope: the
	-- table is an engine export and this function runs long after
	-- load, where the MCM file's own header warns the chunk does not.
	A.rot_key = opt_num("amp_rot_key", (DIK_keys and DIK_keys.DIK_R) or 19)

	local was_debug = A.debug
	A.debug = opt_get("amp_debug", DEFAULTS.amp_debug) and true or false

	-- Turning Debug off and on again asks for a fresh picture of the
	-- state. Without this the memo from before the pause is still there
	-- and the first report of every kind is swallowed as a repeat of
	-- something the log no longer shows.
	if A.debug and not was_debug then dbg_reset() end

	log("settings | enabled=%s hide_grid=%s rig_is_all=%s med=%s/%s "
	    .. "ammo_gate=%s debug=%s",
	    tostring(A.enabled), tostring(A.hide_grid), tostring(A.rig_is_all),
	    tostring(A.med_on), tostring(A.med_only), tostring(A.ammo_gate),
	    tostring(A.debug))

	-- CHANGED WITH THE INVENTORY OPEN, nothing else would move the
	-- columns until the next time a mode started - Reset is what
	-- normally applies this, and the menu is not resetting while
	-- somebody is in MCM looking at the dropdown.
	pcall(A.cols_apply)

	-- A pocket size change can make a magazine no longer fit, and every
	-- one of the numbers above changes the shape of a DERIVED rig, so the
	-- resolution cache has to go rather than be compared against.
	A.rig_key = nil

	-- The same for what belongs in the middle column: is_mag can answer
	-- differently after a settings change, and a memo of the old answer
	-- would outlive it.
	A.kindmemo = {}
	A.ttl_key, A.wt_tg = nil, nil
	A.validate()
end

-- ============================================================
-- items\\amp_rigs.ltx IS NOT READ ANY MORE
--
-- It held two things: SHAPES - silhouettes of pockets, filled with
-- whatever an armour happened to carry - and hand-drawn RIGS, exactly
-- these pockets for one named section. Both spoke in size classes, and
-- both were about the armour-derived rig, which 3.0 does not have.
--
-- A rig's shape is stamped on its own section now, out of the balance
-- file, by art/mkloot.py. There is nothing left for a per-armour
-- override to override.
--
-- Gone with it: A.get_ltx, A.parse_row, A.read_rows, A.read_rig,
-- A.fill_shape, A.shape_for, A.tall_rig, SHAPE_CHAR and GAP_TOKEN.
-- ============================================================

-- ============================================================
-- WHAT SHAPE A RIG IS - THE 3.0 MODEL
--
--   "rigs can have slots that are 2x1 2x2 or 3x1 ... but what fits
--    inside is only by the icon size"
--   "and 3 slots that are 1x1"
--   "dont block the rigs slots to only mags ammo and meds. everything
--    that fits can be stored there"
--
-- A SLOT IS A TINY GRID. Four geometries and nothing else:
--
--     1x1   one cell    one small thing
--     2x1   two cells   a magazine, or two small things
--     3x1   three       a magazine AND a small thing, or three small
--     2x2   four        A DRUM, or two magazines, or four small
--
-- and what goes in one is decided by the item's own ICON FOOTPRINT.
-- There are no size classes, no `tall_large`, no drum-rig-versus-
-- stick-rig, and NO TYPE FILTER AT ALL: a rig is an extension of your
-- inventory that you can also reload and heal out of, so anything that
-- fits goes in and stacks to the ceiling it would stack to in your
-- bag.
--
-- THE COUNTS ARE STAMPED ON THE SECTION, the way amp_rig_tier is,
-- because the section is the one place this script reads a rig's
-- facts from. art/mkloot.py puts them there out of l_amp_rigs.ltx,
-- which is the balance file and stays the only place a human edits.
--
-- CANONICAL ORDER, BIGGEST FIRST. Two reasons and both matter:
-- the panel draws them in this order so every rig reads the same way
-- down the chest, and a SAVE stores contents against the slot INDEX -
-- so an order that depended on anything but the counts would move
-- somebody's magazines the day it changed.
--
-- POUCH SLOTS ARE NOT IN HERE. They are granted by what is fitted, and
-- they are appended after these by A.rig_slots_all - see there.
-- ============================================================
-- ============================================================
-- THE NAME IS TALL BY WIDE, AND THAT IS NOT A DETAIL
--
--   "3x1 tall slot can fit one mag that is 2x1 and one item that is
--    1x1"
--   "in 2x2 slot can fit 2 mags that are 2x1"
--
-- A magazine in this game is ONE cell wide and TWO tall - it stands
-- up. So "a 2x1" is two cells TALL and one WIDE, and two of them side
-- by side make the 2x2 the player described. A 3x1 is a magazine with
-- one square under it.
--
-- The first build read the names the other way round - w = 2, h = 1 -
-- and every slot came out lying on its side. Nothing fitted: the log
-- says "Nothing in the rig has room for a 1x2" for an ordinary
-- magazine, which is the mod refusing a magazine because it will not
-- lie down.
--
-- So: the FIRST number is rows, the second is columns.
-- ============================================================
local SLOT_KINDS = {
	{ key = "amp_slot_2x2", w = 2, h = 2 },
	{ key = "amp_slot_3x1", w = 1, h = 3 },
	{ key = "amp_slot_2x1", w = 1, h = 2 },
	{ key = "amp_slot_1x1", w = 1, h = 1 },
}

-- Asked on every draw and every fit test, and the answer is a property
-- of the SECTION, so it is worked out once per section per session.
A.slotmemo = A.slotmemo or {}

function A.rig_slots(sec)
	if type(sec) ~= "string" or sec == "" then return nil end

	local had = A.slotmemo[sec]
	if had ~= nil then return (had ~= false) and had or nil end

	local out = {}
	for k = 1, #SLOT_KINDS do
		local kind = SLOT_KINDS[k]
		local n = tonumber(SYS_GetParam(2, sec, kind.key)) or 0

		-- A COUNT IS A COUNT. A negative one is somebody's typo and a
		-- hundred is somebody's accident; neither should reach a draw
		-- loop that makes a window per slot.
		n = math.floor(n)
		if n < 0 then n = 0 elseif n > 16 then n = 16 end

		for _ = 1, n do
			out[#out + 1] = { w = kind.w, h = kind.h }
		end
	end

	if #out == 0 then
		-- NOT AN ERROR AND NOT A GUESS. A rig with no slots stamped on
		-- it is a rig this mod's generators have not been run for, or
		-- another mod's rig wearing our marker. Answering nil lets the
		-- caller say so once rather than drawing an empty chest.
		A.slotmemo[sec] = false
		return nil
	end

	A.slotmemo[sec] = out
	return out
end

-- How many cells a rig is, which is the one number the tiers, the
-- prices and the recipes are all derived from. Kept here beside the
-- shape so the two can never disagree.
function A.rig_cells(sec)
	local slots = A.rig_slots(sec)
	if not slots then return 0 end

	local n = 0
	for i = 1, #slots do n = n + slots[i].w * slots[i].h end
	return n
end

-- HOW MANY POUCH SLOTS A RIG HAS. Declared HERE rather than beside
-- the pouch code five hundred lines down, because a `local` is only
-- visible to what is compiled AFTER it - and a function written
-- above its declaration compiles the name as a global, which reads
-- nil for ever and says nothing.
local PSLOTS = 2

-- ============================================================
-- AND THE TWO POUCH SLOTS, WHICH ARE NOT SLOTS
--
--   "rig is not pouch slots. they have all the slots i told you AND
--    two pouch slots just like now"
--   "when pouch is slotted into pouch slot it adds:
--     small pouch one slot 2x1 / medium pouch two slots 2x1 /
--     large pouch one slot 2x2"
--
-- A pouch slot holds a POUCH. The pouch is what grants storage, and
-- what it grants is fixed by which pouch it is. No pouch grants a 3x1
-- or a 1x1: those are built into the rig, which is what stops a pouch
-- being a way to buy your way to a better rig's SHAPE rather than just
-- its size.
-- ============================================================
-- TALL BY WIDE, like SLOT_KINDS: a 2x1 is two squares tall and one
-- wide, which is a magazine standing up.
A.POUCH_GRANT = {
	af_magpouch_s = { { w = 1, h = 2 } },
	af_magpouch_m = { { w = 1, h = 2 }, { w = 1, h = 2 } },
	af_magpouch_l = { { w = 2, h = 2 } },
}

-- ============================================================
-- EVERY SLOT A RIG HAS RIGHT NOW, IN THE ORDER IT IS DRAWN
--
-- A SLOT IS NAMED, NOT NUMBERED, and this is the whole reason:
--
--     b1 b2 b3 ...   the rig's own, in canonical order
--     p1_1 p1_2      what the pouch in pouch slot 1 grants
--     p2_1           and pouch slot 2
--
-- A save stores what is in a rig against these keys. Number them
-- instead and taking a pouch OFF renumbers everything after it - so
-- pulling the small pouch out of the first slot would shuffle the
-- contents of the second one, which is a bug that only shows up on a
-- player who did the two things in the wrong order.
--
-- Names cost a string compare and make that impossible.
-- ============================================================
function A.rig_slots_all(sec, id)
	local built = A.rig_slots(sec)
	if not built then return nil end

	local out = {}
	for i = 1, #built do
		out[#out + 1] = { key = "b" .. i, w = built[i].w, h = built[i].h }
	end

	-- WHAT IS FITTED, if this rig is one we are holding pouches for. A
	-- rig with no entry has empty pouch slots, which is not an error.
	local fitted = id and A.pslot[id]
	if fitted then
		for i = 1, PSLOTS do
			local grant = A.POUCH_GRANT[fitted[i]]
			if grant then
				for j = 1, #grant do
					out[#out + 1] = { key = "p" .. i .. "_" .. j,
					                  w = grant[j].w, h = grant[j].h,
					                  pouch = i }
				end
			end
		end
	end

	return out
end

-- ============================================================
-- WOULD THIS PICTURE GO IN THAT SLOT AT ALL
--
--   "what fits inside is only by the icon size"
--   "dont block the rigs slots to only mags ammo and meds"
--
-- Geometry and nothing else. No section list, no kind check, no "is it
-- a magazine" - a rig is an extension of your inventory that you can
-- also reload and heal out of, so the only question is whether the
-- picture is small enough.
--
-- TURNED COUNTS AS FITTING. A 1x2 thing goes in a 2x1 slot on its
-- side, exactly as it does in a box, and the boxes already own the
-- key that turns it. Answering "no" here would refuse the drop before
-- the player ever got the chance to turn it.
-- ============================================================
function A.slot_takes(slot, iw, ih)
	if not (slot and iw and ih) then return false end
	if iw <= slot.w and ih <= slot.h then return true end
	if ih <= slot.w and iw <= slot.h then return true end
	return false
end

-- ...and whether the rig has any slot that could ever take it, which
-- is what a tooltip and a refusal message need. Says WHICH slot, so a
-- caller can put the thing there without asking twice.
function A.rig_takes(sec, id, isec)
	local slots = A.rig_slots_all(sec, id)
	if not slots then return nil end

	local iw, ih = A.cells(isec)
	for i = 1, #slots do
		if A.slot_takes(slots[i], iw, ih) then return slots[i], iw, ih end
	end
	return nil, iw, ih
end

-- ============================================================
-- READING AND WRITING ONE SLOT, WHICHEVER RIG IT BELONGS TO
--
-- The caller says which rig and which slot and does not care whether
-- the thing is on your chest or in your bag. That difference is real -
-- see the note on `wear` and `hold` at the top of this file - but it
-- is nobody else's business, and every place that had to know used to
-- be a place that could get it wrong.
-- ============================================================
function A.slot_worn(id)
	return A.rig_id ~= nil and id == A.rig_id
end

function A.slot_of(id, key)
	if not (id and key) then return nil end

	if A.slot_worn(id) then return A.wear[key] end
	local h = A.hold[id]
	return h and h[key] or nil
end

function A.slot_set(id, key, entries)
	if not (id and key) then return false end

	-- AN EMPTY SLOT IS NO SLOT. Left as an empty table it is a key in
	-- the save for ever, and a rig that has been emptied and taken off
	-- would still be carrying a record of nothing.
	local keep = (entries and #entries > 0) and entries or nil

	if A.slot_worn(id) then
		A.wear[key] = keep
		return true
	end

	local h = A.hold[id]
	if not h then
		if not keep then return true end
		h = {}
		A.hold[id] = h
	end

	h[key] = keep
	if not next(h) then A.hold[id] = nil end
	return true
end

-- Everything in a rig, slot by slot, for the callers that want the lot:
-- the weight, the emptying, the "is this on me" question.
function A.rig_contents(sec, id)
	local slots = A.rig_slots_all(sec, id)
	if not slots then return {} end

	local out = {}
	for i = 1, #slots do
		local t = A.slot_of(id, slots[i].key)
		if t then out[slots[i].key] = t end
	end
	return out
end

-- ============================================================
-- HOW DEEP A SQUARE STACKS, WHICH IS THE BAG'S ANSWER
--
--   "with the same stack sizes as in inventory"
--
-- Asked of Zone Grid rather than decided here, because it is decided
-- there already and two copies of a ceiling is two ceilings. With the
-- grid absent every square holds one thing, which is the old behaviour
-- and the safe direction to be wrong in.
-- ============================================================
function A.slot_cap(isec)
	if type(isec) ~= "string" or isec == "" then return 1 end

	local ok, n = pcall(function()
		return zzz_amp_grid.stack_limit(isec)
	end)

	if ok and type(n) == "number" and n >= 1 then return math.floor(n) end
	return 1
end

-- ============================================================
-- WHERE WOULD THIS GO
--
-- Walks the rig's slots in draw order and answers the first place the
-- picture will stand: which slot, and which square of it. A stack it
-- can join beats an empty square, the same way it does in a box and in
-- your bag - otherwise a second bandage starts a second pile while the
-- first one has room.
--
-- Answers the JOIN separately, because joining and standing are
-- different things to the caller: one adds to a pile, the other needs
-- a rectangle reserving.
-- ============================================================
function A.rig_spot(sec, id, isec, want_key)
	local slots = A.rig_slots_all(sec, id)
	if not slots then return nil end

	local iw, ih = A.cells(isec)
	local cap = A.slot_cap(isec)

	-- FIRST PASS: SOMEWHERE TO JOIN. Every slot is asked before any
	-- empty square is taken anywhere, or a rig with a half-full pile in
	-- the last slot would start a new one in the first.
	for i = 1, #slots do
		local s = slots[i]
		if (not want_key) or s.key == want_key then
			local t = A.slot_of(id, s.key)
			if t then
				for n = 1, #t do
					local e = t[n]
					if e and e.sec == isec and A.pile_n(e) < cap then
						return s.key, e.r, e.c, n
					end
				end
			end
		end
	end

	-- SECOND PASS: A SQUARE TO STAND ON.
	for i = 1, #slots do
		local s = slots[i]
		if (not want_key) or s.key == want_key then
			if A.slot_takes(s, iw, ih) then
				local t = A.slot_of(id, s.key) or {}

				local r, c = A.box_spot(t, s.w, s.h, iw, ih)
				if r then return s.key, r, c, nil end

				-- ...AND ON ITS SIDE, if that is the only way it goes.
				-- The slot said it would take it turned, so the square
				-- search has to try that too or the promise was empty.
				if iw ~= ih then
					r, c = A.box_spot(t, s.w, s.h, ih, iw)
					if r then return s.key, r, c, nil, true end
				end
			end
		end
	end

	return nil
end




-- Pack counts into rows, largest class first, wrapping at the grid
-- width the shapes allow. Drums start a fresh row: they are twice as wide and a rig
-- reads wrong with one wedged into the end of a rifle row.
--
-- This is the fallback for when no template matches, and the tail of
-- one that was too small.
-- ============================================================
-- PACK IT LIKE A RIG, NOT LIKE A LIST
--
-- The old packer wrapped at a fixed width and gave each class its own
-- rows, and the result beside a real chest rig was embarrassing: seven
-- pockets came out three columns wide and FOUR rows deep, a tall thin
-- ladder with the drum pouch alone at the bottom. A rig is the other
-- shape entirely - five or six columns across, two or three bands down,
-- every cell packed against its neighbours.
--
-- So the width is chosen from the total rather than fixed, biased wide,
-- and the classes tile into it in one pass instead of each starting a
-- fresh band. Nothing is ever left over, because there is no template
-- to run out of.
--
-- Order is rifle, pistol, drum: the big bank on top, the small stuff
-- under it, the drums at the bottom where dump pouches hang. A row that
-- cannot fit a two-wide drum in its last column takes the next pocket
-- that does fit, so rows stay full rather than ending in a gap.
-- ============================================================
-- ============================================================
-- HOW WIDE THE BLOCK IS, IN SQUARES
--
-- A square block of squares does not come out square on screen: the x
-- axis carries the aspect correction, about 0.75 on 16:9, so a column
-- is roughly 31 pixels against a row's 41. A block twice as wide as it
-- is tall, in squares, comes out about three to two in pixels - which
-- is the proportion a chest rig has.
--
-- SQUARES, NOT POCKETS. It used to count pockets and divide by a band
-- count, from when every pocket was the same height and a row of them
-- WAS a band. A 3x1 is three squares of one column now, so counting it
-- as "one" made the panel come out three times taller than the number
-- said.
-- ============================================================
function A.rig_width(cells)
	if cells <= 1 then return 1 end
	return clampi(math.floor(math.sqrt(cells * 2) + 0.5), 3, 8)
end


-- ============================================================
-- MAG POUCHES ATTACHED TO THE ARMOUR
--
-- The magazine mod already ships the expansion pouches this rig wanted:
-- mag_pouches.script installs an af_magpouch_* item onto an outfit and
-- adds its limits through register_loadout_bonus. Players already own
-- them.
--
-- Overriding get_loadout_slots broke that outright. The bonus provider
-- asks for the pouch's limits by SECTION STRING, and a string is not an
-- outfit, so with amp_rig_is_all on the override answered zero and an
-- installed pouch granted nothing at all.
--
-- The fix is not to special-case the provider - it is to put the pouch
-- where it belongs, in the rig. Its rows are appended to the armour's,
-- so the pockets ARE the bonus, the provider's zero is then correct
-- rather than lossy, and nothing is counted twice.
--
-- The pouch section is read from mag_pouches.pouches, and its numbers
-- from the same lookup as everything else, so a pouch added by any mod
-- works with no entry here.
-- ============================================================
-- ============================================================
-- THE RIG SLOT
--
-- The rig used to be INSTALLED on the worn outfit through mag_pouches,
-- and painted over the armour's inventory icon. Both are gone: every
-- icon pack draws armours at its own size and on its own grid, so the
-- overlay had to be fitted to whatever pack the player had, and it
-- could not be fitted to all of them at once.
--
-- A rig now sits in a slot of its own, drawn beside the equipment
-- dialog. The slot is a script-side one - Anomaly's engine slots are
-- fixed and a mod cannot add one - so it is a rectangle this mod draws,
-- hit-tests and saves, exactly like the two pouch slots inside the
-- panel. What the engine thinks is unchanged: the rig is an ordinary
-- item in your inventory, hidden from the bag list while it is worn.
--
-- Stored as an OBJECT ID rather than a section, because two rigs of the
-- same kind are two different items and taking one off has to give back
-- the one you put in.
-- ============================================================
A.rig_id = A.rig_id or nil

-- The rig you are wearing, as an object, or nil.
-- ============================================================
-- THE WORLD IS NOT THERE THE MOMENT THE SAVE IS
--
-- load_state runs before the engine has handed over the client
-- objects, and for a while afterwards level.object_by_id answers nil
-- for things that are certainly in your inventory - your worn rig
-- included.
--
-- Every "has this gone?" test in this file believed that answer. So
-- loading a save took the rig off, resolved an armour with no rig to
-- no pockets, and the re-place pass poured the whole loadout into the
-- bag. Which is exactly what was reported: the rig comes off on load
-- and the magazines are in your inventory.
--
-- So there is a warm-up window. While it is open, nothing is declared
-- gone for being unreadable - the rig stays worn, the pockets stay
-- filled, and the passes that tidy up simply do not run. Ten seconds:
-- far longer than any load, far shorter than a session, and it ends
-- early the moment the world answers.
-- ============================================================
local GRACE_MS = 10000

A.grace_from = A.grace_from or nil

function A.warm_up()
	A.grace_from = time_global()
end

-- ============================================================
-- CAN WE SEE THE WORN RIG RIGHT NOW?
--
-- BOTH questions, because they come back at different moments. On a
-- level change the object turns up first and the actor's inventory is
-- filled a little later, so there is a window where the rig reads
-- perfectly and `in_actor_inv` says no. The first version of the
-- warm-up only guarded the missing-object half, which is why the rig
-- still came off "sometimes" - the half it did not guard is the one
-- that answers on the way through.
--
-- No side effects: this is the question, not the decision.
-- ============================================================
-- ============================================================
-- ...AND ONCE A FRAME, BECAUSE IT IS ASKED A DOZEN TIMES IN ONE
--
-- Twelve calls a frame, each an engine lookup and a pcall, for an
-- answer that is a fact about the world at the moment the frame
-- started. A.fc is the cache that exists for exactly that span; the
-- once() wrapper is below it in the file, so this is two functions
-- rather than one.
-- ============================================================
-- ============================================================
-- utils_item.in_actor_inv, LOOKED UP ONCE
--
-- Two table indexes and an `and` chain, per item, per frame, on the
-- prune - for a function that is the same function for the whole
-- session. Resolved on first use rather than at load, because
-- utils_item is another file and load order is not ours to assume.
-- ============================================================
local IN_INV
local function in_inv(obj)
	if IN_INV == nil then
		IN_INV = (utils_item and utils_item.in_actor_inv) or false
	end
	if not IN_INV then return true end

	local ok, res = pcall(IN_INV, obj)
	return ok and res and true or false
end

function A.rig_readable_now()
	if not A.rig_id then return false end

	local obj = level.object_by_id(A.rig_id)
	if not obj then return false end

	if not in_inv(obj) then return false end

	return true
end

function A.rig_readable()
	if not (A.fc_on and A.once) then return A.rig_readable_now() end
	-- Keyed on the rig, so a frame in which the rig changed cannot be
	-- answered out of the one before it.
	return A.once("readable", A.rig_id, A.rig_readable_now)
end

-- Is everything this mod is holding on to readable? That - not the
-- clock - is what the window is actually waiting for.
function A.world_ready()
	if not db.actor then return false end

	if A.rig_id and not A.rig_readable() then return false end

	for i = 1, #A.pk do
		local P = A.pk[i]
		for n = 1, (P and #P.slots or 0) do
			local ids = P.slots[n].ids
			for k = 1, #ids do
				local id = ids[k]
				if not A.incoming[id] and not level.object_by_id(id) then
					return false
				end
			end
		end
	end

	return true
end

function A.warming()
	-- A rig we believe is worn and cannot see means the world is not
	-- ready, whatever the clock says and whether or not a load was
	-- noticed. Anything that tidies up is wrong while that is true -
	-- it would tidy against a rig with no pockets.
	if A.rig_id and not A.rig_readable() then return true end

	if not A.grace_from then return false end

	local now = time_global()

	-- time_global restarts on a level change, so a stamp from before it
	-- is in the future. That IS a load, so the window starts again from
	-- the new clock rather than running until one that no longer
	-- exists catches up.
	if now < A.grace_from then
		A.grace_from = now
		return true
	end

	-- A CEILING, NOT THE MEASURE. Ten seconds is how long this mod is
	-- prepared to disbelieve the world; what actually ends the window
	-- is the world answering, which is usually the same frame.
	if now - A.grace_from >= GRACE_MS then
		A.grace_from = nil
		return false
	end

	if A.world_ready() then
		A.grace_from = nil
		return false
	end

	return true
end

-- ============================================================
-- THE RIG COMES OFF WHEN THE GAME SAYS IT LEFT, AND NOT BEFORE
--
-- This used to be guessed from a failed read: no object, or not in the
-- actor's inventory, meant sold or dropped. Both of those are false
-- for a moment on every load and every level change - the objects are
-- handed over a beat after the save is read on the way in, and the
-- inventory is emptied a beat before the autosave on the way out - so
-- the rig came off by itself, sometimes.
--
-- Guessing it with a ten-second timer worked and was still a guess.
-- The engine says it outright, and this is the same pair of events the
-- magazine mod uses to forget a magazine:
--
--   actor_on_item_drop          it left your inventory - dropped,
--                               traded, put in a stash
--   server_entity_on_unregister the object was destroyed
--
-- Neither fires on a level change (the server objects survive it -
-- which is exactly why the magazine mod can delete its stored data on
-- that event and not lose everybody's magazines every time they walk
-- through a level border).
--
-- So an unreadable rig is now simply not visible YET, and this asks no
-- questions about it at all.
-- ============================================================
function A.rig_obj()
	if not A.rig_id then return nil end
	if not A.rig_readable() then return nil end

	-- NOT `A.grace_from = nil` HERE. The rig answering does not mean
	-- the world has: the magazines in its pockets can still be on their
	-- way, and closing the window on the rig's word alone would let the
	-- prune empty every pocket whose magazine had not arrived.
	-- A.warming() ends the window itself, once EVERYTHING reads.
	return level.object_by_id(A.rig_id)
end

-- It left the actor: dropped on the ground, sold, or put in a stash.
-- Taking it off is exactly right - and it takes its magazines with it,
-- the same as taking it off by hand, because that is what the rig is.
function A.on_item_drop(obj)
	if not (A.enabled and obj) then return end

	local ok, id = pcall(function() return obj:id() end)
	if not (ok and type(id) == "number") then return end

	if id == A.rig_id then
		log("rig %s left the actor - taking it off", tostring(id))
		A.strip_rig()
		return
	end

	-- A thing that left is out of its slot. Waiting for the prune to
	-- notice would leave the slot looking full until it did.
	A.pk_forget(id)
end

-- The object was destroyed. Not taken off - there is nothing left to
-- take off, and nothing to stow anything into - so the pockets are
-- simply no longer a place, and whatever was in them lands in the bag
-- through the ordinary re-place pass.
function A.on_se_unregister(se_obj)
	if not A.enabled then return end

	local id = se_obj and se_obj.id
	if type(id) ~= "number" then return end

	-- A rig that is destroyed takes its contents with it: they do not
	-- exist anywhere else. Dismantling is the one route that empties
	-- them first, and it does that before the object goes.
	if A.hold[id] then A.hold[id] = nil end
	if A.pslot[id] then A.pslot[id] = nil end
	-- And a box that is destroyed takes its contents with it, for
	-- exactly the same reason: they exist nowhere else.
	if A.boxes and A.boxes[id] then A.boxes[id] = nil end

	if id == A.rig_id then
		log("rig %s was destroyed - taking it off", tostring(id))
		A.rig_id = nil
		A.rig_key = nil
		A.open = false
		A.resolve_rig()
		return
	end

	local wk = A.win_of(id)
	if wk then A.win_close(wk, "the thing itself is gone") end

	A.pk_forget(id)
end

-- Its section, which is what the pocket counts are looked up by.
function A.rig_sec_now()
	local obj = A.rig_obj()
	if not obj then return nil end
	local ok, sec = pcall(function() return obj:section() end)
	return ok and sec or nil
end

-- ONCE A FRAME. Asked four times in one draw - by resolve_rig, by the
-- weight, by the tooltip - for a string that cannot change inside a
-- frame, and each ask was an engine lookup, a closure and a pcall.
function A.rig_sec()
	if not (A.fc_on and A.once) then return A.rig_sec_now() end
	return A.once("rigsec", A.rig_id, A.rig_sec_now)
end

-- ============================================================
-- IS THIS SECTION A RIG?
--
-- One config key, `amp_rig = true`, exactly the way is_mag reads
-- `is_mag` off a magazine. It used to be answered by the presence of
-- mag_pouches' install functor, and that key is gone now that rigs are
-- not installed onto armour - so the question needs an answer of its
-- own rather than a guess assembled from what a section happens to
-- grant.
--
-- Explicit is also what makes this extensible: an addon that wants its
-- own rig sets one line in its ltx, and needs no entry here and no
-- change to this mod.
-- ============================================================
function A.is_rig_sec(sec)
	if type(sec) ~= "string" or sec == "" then return false end
	return SYS_GetParam(1, sec, "amp_rig") and true or false
end

-- Put one on. Returns the previous occupant so a swap hands it back.
function A.wear_rig(obj)
	if not obj then return false end

	local sec = obj:section()
	if not A.is_rig_sec(sec) then
		notify("That is not a chest rig")
		return false
	end

	local id = obj:id()

	-- ------------------------------------------------------------
	-- A SWAP IS TWO EVENTS AND THE GAME SENDS ONE
	--
	-- Dragging a second rig into the slot REPLACES the first: there is
	-- no take-off, so nothing stowed the old rig's magazines, and the
	-- pockets arrived here still holding them. The re-place pass then
	-- did the obvious thing with magazines sitting in pockets of a rig
	-- that had just changed shape - it filed them into the NEW rig, and
	-- announced the ones that did not fit back into the bag.
	--
	-- The old rig's contents go into the old rig first, which is what
	-- taking it off would have done.
	-- ------------------------------------------------------------
	if A.rig_id and A.rig_id ~= id then
		A.pk_remember(A.rig_id)
	end

	A.rig_id = id
	A.rig_key = nil
	log("wearing rig %s (id %s)", tostring(sec), tostring(A.rig_id))
	A.resolve_rig()

	-- AFTER resolve_rig: the pockets have to exist before anything can
	-- be put in them. Anything that cannot go back simply does not, and
	-- stays in the bag where it already is.
	local okp, errp = pcall(A.pk_restore, A.rig_id)
	if not okp then log("!restore: %s", tostring(errp)) end

	-- The bag list is filtered on A.hidden and has just changed, so it
	-- has to be re-parsed - otherwise the rig sits in the slot AND in the
	-- inventory until something else happens to refresh it.
	-- ui_inventory.GUI directly, NOT gui_now: that helper is a local
	-- declared further down the file, so a call to it from up here
	-- compiles as a global lookup and is nil at run time.
	local g = ui_inventory and ui_inventory.GUI
	if g and g.On_Item_Update then
		pcall(function() g:On_Item_Update() end)
	end
	return true
end

-- Take it off. The object is untouched - it was in your inventory the
-- whole time and only hidden from the list - so this cannot destroy
-- anything, and the pockets empty through the ordinary prune.
-- ============================================================
-- A RIG REALLY CARRIES ITS MAGAZINES
--
-- The first version of this REMEMBERED them: the magazines went to the
-- bag and were filed back on the way in. It worked, and it was not what
-- was asked for - an unworn rig with four magazines in it should have
-- four magazines in it, not a note about four magazines.
--
-- So a magazine goes the way a fitted pouch goes: the object is
-- destroyed and what it WAS is kept against the rig. The difference is
-- that a pouch is only a section, and a magazine is a section plus the
-- rounds in it - so the rounds travel too, through the magazine
-- system's own store.
--
-- THIS IS THE PART THAT CAN LOSE SOMEBODY'S AMMUNITION, so the order is
-- strict and never varies:
--
--   taking it off   read the contents, THEN release the object. A
--                   capture that failed leaves the magazine alone.
--   putting it on   create the object, write the contents onto the new
--                   id, and only then drop the stashed copy. A create
--                   that failed leaves the stash alone.
--
-- The precedent for the transplant is the magazine mod's own
-- eject_magazine, which creates a magazine and writes its rounds onto
-- the new id the same way.
--
-- AND THE RIG IS A CONTAINER, with what that implies: sell it, drop it
-- or lose it and its contents go with it, because they do not exist
-- anywhere else. That is the trade the feature is.
--
-- THE TABLE IS A.hold, DECLARED WITH `wear` AT THE TOP. It used to be
-- A.stash here, one magazine per pocket index, beside three other
-- stores for the other things a rig turned out to hold.
-- ============================================================

-- WHICH RIGS HAVE ALREADY BEEN LOOKED AT, and which ones this mod made
-- itself. Saved: a rig that was aged once must not be aged again the
-- next time you load, and a rig you crafted must not be aged at all.
A.rolled = A.rolled or {}
A.mine   = A.mine or {}

-- What was written onto each magazine that is still on its way back,
-- kept until it arrives. It is the one copy of that magazine while the
-- engine catches up, so taking the rig off in those few frames can put
-- it back in the rig instead of dropping it on the floor of the world.
A.pending_item = A.pending_item or {}

-- Everything about a magazine that has to survive the round trip.
function A.capture_mag(obj)
	if not obj then return nil end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and type(sec) == "string") then return nil end

	local out = { sec = sec }

	-- The rounds. Copied, not referenced: the store hands back its own
	-- table and clears it when the object goes.
	local mb = magazine_binder
	if mb and type(mb.get_data) == "function" then
		local got, data = pcall(mb.get_data, obj:id())
		if got and type(data) == "table" then
			local copy = {}
			for k, v in pairs(data) do
				if type(v) == "table" then
					local inner = {}
					for i = 1, #v do inner[i] = v[i] end
					copy[k] = inner
				else
					copy[k] = v
				end
			end
			out.data = copy
		end
	end

	local got, cond = pcall(function() return obj:condition() end)
	if got and type(cond) == "number" then out.cond = cond end

	return out
end





-- ============================================================
-- AND HANDS THEM BACK WHEN IT GOES ON
--
-- A stashed magazine has no object, so it is rebuilt: create the item,
-- write the rounds onto the NEW id, file it into its pocket.
--
-- THE CLIENT OBJECT IS NOT THERE YET. alife_create_item makes the
-- server object and the engine catches up a frame or two later, so
-- everything that needs the object itself waits - A.incoming holds the
-- ids that are on their way, and the prune leaves those pockets alone
-- until they arrive or the wait runs out. Without it the pocket is
-- emptied on the very next draw, which is the bug this note exists to
-- stop being written twice.
--
-- A pocket that has gone (a smaller rig, a pouch taken off) or that no
-- longer fits keeps its stash entry instead: the magazine stays in the
-- rig rather than being poured out into the bag.
-- ============================================================
A.incoming = A.incoming or {}

-- The magazines that came out of a weapon. Read by grid_nodrop, which
-- is also what prunes it; see A.install_eject_watch for where the ids
-- come from.
A.from_gun = A.from_gun or {}

-- ============================================================
-- AND THE ONES STILL WAITING FOR A POCKET
--
--   "can we make tak so the magazine that gets unloaded from a gun
--    first goes to some fake invisible palce just for it that cannot be
--    accesed by quiick add mag to loadout ect"
--
-- WHY A FULL RIG IS STILL WRONG even though the answer is honest. The
-- magazine going INTO the gun comes out of a pocket and is not consumed
-- until the reload animation ends - `mag swap delay is 1.3` in the log.
-- So for that second and a bit its pocket is still occupied, and the
-- magazine coming OUT is asked right then whether there is room. There
-- is not. It goes to the bag, the grid lays out around it, and a moment
-- later it goes into the pocket that has just freed and the grid lays
-- out again.
--
-- The rig is full at the moment of the question and has room a moment
-- later. The answer is right; the magazine arrives too early.
--
-- SO IT WAITS, out of sight. Nothing is moved and nothing is created:
-- the magazine is in the inventory the whole time, exactly where the
-- game put it. All that is held back is whether this mod SHOWS it -
-- the same lever that already hides a magazine in a pocket. With no
-- cell anywhere it is also out of reach of the quick-add key and every
-- other gesture, because those act on the cell under the cursor.
--
-- id -> the time_global after which it stops waiting. See A.settle_held
-- for the three ways this ends.
-- ============================================================
A.held = A.held or {}

-- Six seconds, and the number is a judgement. The reload that causes
-- this is 1.3s in the log it came from, but that is a setting and a big
-- magazine takes longer. Six is past any of them and still short enough
-- that a magazine you cannot see is a blink rather than a mystery.
local HOLD_MS = 6000


-- Condition and the carried flag both need the client object, so they
-- are applied when it turns up. Called from the throttled update, which
-- runs whether or not the inventory is open.
A.pending_cond = A.pending_cond or {}

-- ============================================================
-- AND THE SAME FOR ONE THAT IS NOT GOING INTO A POCKET
--
-- A magazine tipped out of a rig - dismantled, or taken out through
-- the open-rig window - is rebuilt in the BAG. It still has to get its
-- wear back, and it still does not exist for a frame or two, but it
-- has no pocket to wait in and must not be told it is carried.
--
-- Without this the condition was written into pending_cond and nothing
-- ever read it: every magazine that came out of a rig came out brand
-- new, quietly.
-- ============================================================
A.loose = A.loose or {}

function A.loose_cond(id, cond)
	if not (id and cond) then return end
	A.pending_cond[id] = cond
	A.loose[id] = time_global() + 10000
end

function A.settle_loose()
	if not next(A.loose) then return 0 end

	local now = time_global()
	local done = 0

	for id, until_tg in pairs(A.loose) do
		local obj = level.object_by_id(id)

		if obj then
			local cond = A.pending_cond[id]
			if cond then pcall(function() obj:set_condition(cond) end) end
			A.pending_cond[id] = nil
			A.loose[id] = nil
			done = done + 1

		elseif now > until_tg then
			A.pending_cond[id] = nil
			A.loose[id] = nil
		end
	end

	return done
end

-- ============================================================
-- A MAGAZINE OUT OF YOUR GUN, WAITING FOR A POCKET
--
--   "still causes issue when rig is full"
--
-- Offered a pocket every frame, and it ends three ways so that one can
-- never be lost in here:
--
--   * a pocket frees - the ordinary case, about a second later, when
--     the magazine that went INTO the gun is finally consumed;
--   * it stops being yours - sold, dropped, loaded back into a gun -
--     and the wait goes with it;
--   * or the deadline passes and it becomes an ordinary item in the
--     bag, with a line in the log saying so.
--
-- EVERY FRAME, NOT ON THE SYNC. The pocket frees the instant the loaded
-- magazine leaves the actor; taking it on the next frame rather than
-- the next half second is the difference between "it was never in the
-- bag" and "it was in the bag for a moment". Same reason
-- settle_incoming is unthrottled, and the same cost: one `next` on an
-- empty table on nearly every frame of the game.
-- ============================================================
function A.settle_held()
	if not next(A.held) then return 0 end

	local mb = rawget(_G, "magazine_binder")
	local now = time_global()
	local done = 0

	for id, until_tg in pairs(A.held) do
		local over = false

		if A.pk_holds(id) then
			-- It has a slot. Whoever gave it one - the carry watch
			-- inside toggle_carried_mag, or the loop below on an
			-- earlier frame - there is nothing left to wait for.
			over = true
		else
			local obj = level.object_by_id(id)

			-- NOT OURS ANY MORE. Only decided when the object can
			-- actually be read: an object that is not there yet has not
			-- left the inventory, it has not arrived in it.
			local gone = false
			if obj and utils_item and utils_item.in_actor_inv then
				local ok, res = pcall(utils_item.in_actor_inv, obj)
				gone = not (ok and res)
			end

			if gone then
				over = true
			else
				-- The section from the object if it is there, and from
				-- the magazine mod's record if it is not - the same two
				-- places room_in_pouch looks, for the same reason.
				local sec = obj and obj:section()
				if not sec and mb and type(mb.get_data) == "function" then
					local got, data = pcall(mb.get_data, id)
					if got and type(data) == "table" then
						sec = data.section
					end
				end

				local i = (sec and A.is_mag(sec))
					and A.slot_put(id, sec) or nil

				if i then
					if not obj then
						A.incoming[id] = time_global() + 10000
						A.pending_item[id] = { sec = sec }
					end

					over = true
					done = done + 1
					dbg("waited -> slot %s for %s (%s)", tostring(i),
					    tostring(id), tostring(sec))

				elseif now > until_tg then
					over = true
					log("no pocket freed for the magazine out of your "
					    .. "gun - it is in your bag")
				end
			end
		end

		if over then A.held[id] = nil end
	end

	return done
end

function A.settle_incoming()
	A.settle_loose()

	if not next(A.incoming) then return 0 end

	local mb = magazine_binder
	local done = 0

	local now = time_global()

	for id, until_tg in pairs(A.incoming) do
		local obj = level.object_by_id(id)

		if obj then
			local cond = A.pending_cond[id]
			if cond then
				pcall(function() obj:set_condition(cond) end)
				A.pending_cond[id] = nil
			end

			if mb and type(mb.is_carried_mag) == "function"
				and type(mb.toggle_carried_mag) == "function"
			then
				local ok, carried = pcall(mb.is_carried_mag, id)
				if ok and not carried then
					pcall(mb.toggle_carried_mag, id)
				end
			end

			A.incoming[id] = nil
			A.pending_item[id] = nil
			done = done + 1

		elseif now > until_tg then
			-- It never arrived. Do not leave a pocket pointing at
			-- nothing for the rest of the game.
			log("!unstash: %s never arrived", tostring(id))
			A.pk_forget(id)
			A.incoming[id] = nil
			A.pending_cond[id] = nil
			A.pending_item[id] = nil
		end
	end

	return done
end

-- ============================================================
-- NO ROOM, NO TAKING IT OFF
--
--   "when i detach rig (unequip it) and there are enouch cells to fit
--    the rig but they are not free they way the rig could fit ...
--    then the items get resorted to fit that rig in and where thay
--    are is misalignet with backpack grid ... i rather have that if
--    rig cannot fit in empty space between items then it cannot be
--    removed until player moves items around to make a 2x3 empty
--    space."
--
-- The rig is HIDDEN from the bag while worn, so taking it off makes
-- it ARRIVE - and an arrival with no free rectangle of its own shape
-- is what shoved everything else around. So the question is asked
-- FIRST, of the grid, which is the one thing that knows where the
-- free rectangles are: no room means no strip, and the player is told
-- what shape to clear.
--
-- ONLY on the player's own "take off". The forced strips - the rig
-- sold, dropped, dismantled - stay unconditional, because there the
-- rig is already leaving and a refusal would strand its pockets.
-- And it FAILS OPEN on every soft edge - grid absent, grid off, no
-- window, an error - this is a courtesy, not a lock.
-- ============================================================
function A.strip_room()
	if not A.rig_id then return true end

	local sec = A.rig_sec()
	if type(sec) ~= "string" then return true end

	local Z = rawget(_G, "zzz_amp_grid")
	if not (Z and type(Z.room_for) == "function") then return true end

	local cc = A.bag_cc()
	if not cc then return true end

	local room
	local ok = pcall(function()
		room = Z.room_for(cc, A.rig_id, sec)
	end)
	-- Only an outright "no" refuses. nil is the grid declining to
	-- answer, and an error is not an answer at all.
	if not ok or room ~= false then return true end

	local w, h = A.cells(sec)
	notify("No room in the backpack for the rig - clear a %sx%s space first",
	       tostring(w or "?"), tostring(h or "?"))
	dbg("strip refused: no %sx%s free rectangle", tostring(w), tostring(h))
	return false
end

function A.strip_rig()
	if not A.rig_id then return false end

	-- BEFORE resolve_rig, which empties the pockets.
	A.pk_remember(A.rig_id)

	A.rig_id = nil
	A.rig_key = nil
	A.open = false
	A.resolve_rig()

	-- ui_inventory.GUI directly, NOT gui_now: that helper is a local
	-- declared further down the file, so a call to it from up here
	-- compiles as a global lookup and is nil at run time.
	local g = ui_inventory and ui_inventory.GUI
	if g and g.On_Item_Update then
		pcall(function() g:On_Item_Update() end)
	end
	return true
end

-- ============================================================
-- IS THERE ANYTHING TO OPEN?
--
-- No rig in the slot means no pockets, so the context entry does not
-- offer to open one and the panel does not stay up if the rig is taken
-- out while it is showing.
--
-- THE OPTION IS GONE. amp_rig_item used to switch between "a rig is an
-- item you wear" and "the armour IS the rig", and the second half of
-- that was the armour-derived path, which 3.0 deleted: with the switch
-- off, A.rows_for answered "no rig" and the panel drew nothing. An
-- option whose off position is "the feature does not work" is not an
-- option.
-- ============================================================
function A.rig_present()
	return A.rig_sec() ~= nil
end




-- ============================================================
-- THE RIG FOR ONE ARMOUR - ANY ARMOUR
--
-- resolve_rig used to be the only way to get a rig, and it always
-- resolved the EQUIPPED one. The loadout override then answered "how
-- many magazine slots does this armour give" with the worn armour's
-- numbers no matter which armour was being asked about - so every
-- outfit in the bag showed the same slot counts in its tooltip. That
-- was the report, and this file's own comment admitted it while
-- claiming the case "falls through", which it did not.
--
-- One function now answers for a given outfit, and resolve_rig is
-- simply that function asked about the worn one. They cannot disagree
-- because there is nothing left to disagree.
-- ============================================================
-- ============================================================
-- POUCH SLOTS
--
-- A rig has two 1x1 slots that take the magazine mod's own pouches,
-- and a pouch fitted to one adds its own pockets to the rig.
--
-- The pouches used to install straight onto the armour, by the same
-- mag_pouches mechanism a rig uses - which made a found pouch most of
-- the progression on its own and left nothing for the rig to be. That
-- route is closed in mod_system_zz_amp_pouches.ltx, which points their
-- use1_functor at pouch_no_install below; this is where they go now.
--
-- Keyed by the OUTFIT's id, the same key mag_pouches uses for the rig
-- itself, so taking the rig off and putting it on another armour is
-- the same question for both.
-- ============================================================

-- The functor the pouch sections are pointed at once they stop being
-- installable on armour. A precondition that is never met, so no menu
-- entry appears and the drag-onto-armour path finds nothing to do.
function pouch_no_install()
	return nil
end

-- The same, for the RIGS. A rig used to be installed onto the worn
-- outfit by exactly the mechanism this closes - mag_pouches decides
-- what is installable with one test, `use1_functor ==
-- mag_pouches.precond_install`, so pointing that key here shuts the
-- route without touching their script. The rig goes in its own slot
-- now; leaving the old route open would give two ways to wear one and
-- only one of them would grant any pockets.
function rig_no_install()
	return nil
end

-- WHAT A FITTED POUCH BELONGS TO: the rig, not the armour.
--
-- A pouch is bolted onto a chest rig. It used to be keyed by the worn
-- outfit's id because that was where the rig itself lived; now the rig
-- is an item in its own slot, so its id is the key - and swapping to a
-- different rig correctly brings that rig's own pouches with it rather
-- than whatever was on the armour.
local function outfit_id()
	return A.rig_id
end










-- ============================================================
-- TAKING ONE OUT
--
-- The LAST one put on the square, so taking one out and putting it back
-- is the same pocket in the same order. An entry with nothing left on
-- it goes, and every id above it in the array is renumbered - which is
-- why med_id is rebuilt rather than patched: a table_remove shifts
-- every entry after it and a patched index is a wrong one.
-- ============================================================
-- ============================================================
-- THE NUMBER WRITTEN ON A SQUARE - the pocket on your chest
--
-- The number the inventory would write: uses for anything that has
-- them, things for everything else. A first aid kit with three uses
-- says x3 the moment it goes in, exactly as it did in the bag -
-- because "how many items" is never the question a medkit is asked.
--
-- MEMOISED PER SQUARE. Uses live on the object, and reading them is
-- level.object_by_id + get_remaining_uses per item. The draw path
-- asks every frame; the answer changes when the square's population
-- changes (caught by the ids key) or when a quick-use eats a use
-- without changing it (caught by the 300ms window - now < at is a
-- clock restart and reopens it, the permissive way).
-- ============================================================
A.mshow = A.mshow or {}







-- ============================================================
-- AND THE SAME QUESTION, ASKED FROM OUTSIDE
--
--   "compatibility for quick action wheel mod and using meds only from
--    mag pouch"
--
-- The Quick Action Wheel's meds tab lists every med anywhere in the
-- inventory. A patch by Blako narrows it to what is actually in a
-- pocket, and to do that it needs to ask us - so this is the door it
-- knocks on, and the shape is the one every other cross-file call in
-- this mod has: a TOP-LEVEL function, because a .script is a table of
-- its own file's globals and A is a local. (2.25.4 shipped a whole MCM
-- subcategory that did not exist because that was got wrong once.)
--
-- BOTH POCKETS, because the player does not have two of these. The
-- rig's own med pocket and any med pouch in a mag pocket are one place
-- as far as "is there a bandage on me" is concerned, and the quick-use
-- gate already treats them that way - see the two calls in A.med_gate.
--
-- READ-ONLY, and asked by SECTION rather than by id, because that is
-- what a wheel has: a row is a KIND of thing, not a particular one.
--
-- NOTHING HERE DEPENDS ON THE WHEEL BEING INSTALLED. It is a function
-- that exists; if nobody calls it, it costs nothing and cannot fail.
-- The pcall the patch needs is on the OTHER side of this door, where
-- something might be missing - and that is where it is.
-- ============================================================
function amp_pocket_has(sec)
	if type(sec) ~= "string" or sec == "" then return false end
	local ok, has = pcall(function()
		return A.pk_sec_has(sec)
	end)
	if ok and has then return true end

	-- SquaredAway's QAW filter also serves fitted Layered pouches.  Those
	-- objects remain in the actor ruck but are not members of A.pk, so ask the
	-- optional addon through its public section-level ownership seam.
	local layers = rawget(_G, "zzz_amp_layers")
	if layers and type(layers.grid_has_section) == "function" then
		local ok_layer, in_layer = pcall(layers.grid_has_section, sec)
		if ok_layer and in_layer then return true end
	end
	return false
end


-- ============================================================
-- THE POCKET GENERICS - ONE SLOT'S WORTH OF BEHAVIOUR
--
--   "rigs can have slots that are 2x1 2x2 or 3x1 ... what fits inside
--    is only by the icon size"
--   "dont block the rigs slots to only mags ammo and meds. everything
--    that fits can be stored there, with the same stack sizes as in
--    inventory"
--
-- P = { key, cols, rows, slots, byid, mshow }
--
--   key    the slot's name in the save - "b3", "p1_2". See
--          A.rig_slots_all: named, never numbered.
--   cols   how wide the slot is, in squares, and
--   rows   how tall. THE WHOLE OF WHAT FITS. A 2x2 drum goes in a slot
--          that is 2 by 2; it does not go in a 3x1 row, and no keyword
--          anywhere says so - the rectangle does.
--   slots  the entries standing in it, each { sec, r, c, w, h, rot,
--          ids }. This is THE SAME TABLE the store holds under `key`,
--          not a copy, so a put here is a put in the save.
--   byid   which entry an object id is in, and
--   mshow  a short-lived count cache. Both derived from `slots`.
--
-- THREE THINGS USED TO BE HARDCODED HERE and all three are now read:
-- the pocket was always 2 by 2, it always held five of anything, and
-- it only ever took what the medpocket family named. A slot is its own
-- size, stacks as deep as your bag would, and takes anything that
-- fits.
-- ============================================================
function A.pk_new(slot, id)
	if not slot then return nil end

	-- THE STORE'S OWN TABLE, made on demand. Pointing `slots` at a copy
	-- was the first draft and it silently lost every drop: the pocket
	-- filled, the save stayed empty, and the rig came back off with
	-- nothing in it.
	local t = A.slot_of(id, slot.key)
	if not t then
		t = {}
		A.slot_set(id, slot.key, t)
		-- slot_set forgets an EMPTY list on purpose, so read back what
		-- it kept rather than assuming it kept this.
		t = A.slot_of(id, slot.key) or t
	end

	local P = { key = slot.key, id = id, cols = slot.w, rows = slot.h,
	            pouch = slot.pouch, slots = t, byid = {}, mshow = {} }
	A.pk_reindex(P)
	return P
end

-- ============================================================
-- AND TELL THE STORE THE SLOT IS EMPTY
--
-- `slots` is the store's own table, so a put or a take is already
-- saved - with ONE exception. A.slot_set deliberately forgets a slot
-- whose list is empty, so that a rig emptied and taken off does not
-- carry a record of nothing for the rest of the save. Emptying the
-- table in place cannot trigger that, because nobody called slot_set.
--
-- So every path that can take the last thing out of a slot ends here.
-- Cheap, idempotent, and the alternative is a save that slowly fills
-- with the names of slots that hold nothing.
-- ============================================================
function A.pk_sync(P)
	if not (P and P.id and P.key) then return end
	A.slot_set(P.id, P.key, P.slots)
end

-- ============================================================
-- WHAT MAY GO IN A RIG SLOT AT ALL
--
--   "dont block the rigs slots to only mags ammo and meds. everything
--    that fits can be stored there ... rigs are needed to heal and
--    reload guns but can be uses as extension of inventory if needed"
--
-- So there is no list, no family and no kind check. Two refusals are
-- left and both are the same refusal the boxes make:
--
--   a CONTAINER inside a container, and a RIG inside a rig, are stores
--   whose contents are filed against an object id. Put one inside
--   another and the inner one's contents belong to an object that has
--   been released, which is how a stash eats itself.
--
-- That is a structural rule about this mod's own storage, not a
-- judgement about what a player should carry, which is why it survives
-- "everything that fits" without contradicting it.
-- ============================================================
function A.pk_takes(sec)
	if type(sec) ~= "string" or sec == "" then
		return false, "That does not go in the rig"
	end
	if A.is_box_sec(sec) then
		return false, "A container does not go inside a rig"
	end
	if A.is_rig_sec(sec) then
		return false, "A rig does not go inside a rig"
	end
	return true
end

-- How many squares a section stands on, and whether it fits THIS slot.
-- The same reader the grid and the boxes use, so an item is the size
-- it looks.
--
-- ANYTHING BIGGER THAN THE SLOT IS REFUSED RATHER THAN SQUASHED. A 2x2
-- drum dropped into a 3x1 row would overhang the rig and could never be
-- picked up again, which is the bug the boxes had when they were made
-- smaller.
function A.pk_size(P, sec)
	local w, h = A.cells(sec)
	if not (P and w and h) then return nil end
	if w > P.cols or h > P.rows then return nil end
	return w, h
end

-- ...and the same answer AFTER the R key: turned when the hand is,
-- with a third return saying so, and only when the turned shape still
-- fits the slot at all.
--
-- IT ALSO TURNS WHAT WOULD NOT FIT UPRIGHT. A 1x2 thing does not stand
-- in a 2x1 row, but it lies down in one, and A.slot_takes already
-- promised the player it would go. Answering nil here because the
-- upright shape is too tall would break that promise at the last door.
function A.fit_turn(cols, rows, sec)
	if not (cols and rows) then return nil end
	local w, h = A.cells(sec)
	if not (w and h) then return nil end

	local up   = (w <= cols and h <= rows)
	local over = (w ~= h) and (h <= cols and w <= rows)

	if A.rot_hand and over then return h, w, true end
	if up then return w, h, nil end
	if over then return h, w, true end
	return nil
end

-- A LIVE POCKET SAYS cols/rows AND A SLOT SAYS w/h, and they are the
-- same two numbers. A.win_put was passing a slot descriptor to a
-- function that reads cols and rows, so every comparison was against
-- nil - which is not a refusal but an ERROR, inside the one path that
-- puts anything into an open rig.
function A.pk_turn(P, sec)
	if not P then return nil end
	return A.fit_turn(P.cols or P.w, P.rows or P.h, sec)
end

-- How deep one square of this slot stacks: the bag's own answer for
-- that section, so a rig is not a place where things stack differently
-- from everywhere else the player has ever put them.
local function pk_cap(sec)
	return A.slot_cap(sec)
end

local function pk_join(P, sec)
	local cap = pk_cap(sec)
	for n = 1, #P.slots do
		local e = P.slots[n]
		if e and e.sec == sec and #e.ids < cap then return n end
	end
	return nil
end

-- NOT LOCAL ANY MORE: A.pk_new calls it, and A.pk_new is written above
-- it because it is the door everything else comes in through. A local
-- read before its declaration compiles as a nil global, which is the
-- mistake PSLOTS made and this file has a note about.
function A.pk_reindex(P)
	P.mshow = {}
	P.byid = {}
	for n = 1, #P.slots do
		local e = P.slots[n]
		for i = 1, #e.ids do P.byid[e.ids[i]] = n end
	end
end

local pk_reindex = A.pk_reindex

-- IS THERE ROOM - ASKED THE WAY THE DROP ASKS IT. It used to be a
-- join test and a single-orientation square search, so it answered
-- "no room" about a pocket the drop would have found a place in on its
-- side, and a magazine ejected by a reload went to the bag past a
-- pocket that had a hole in it.
function A.pk_room(P, sec, id)
	if not A.pk_takes(sec) then return false end
	local it = A.item_of(sec, id)
	if not it then return false end
	local n, r = A.fit_land(P.cols, P.rows, P.slots, pk_cap(sec), it)
	return (n or r) and true or false
end

function A.pk_put(P, id, sec, ar, ac)
	if type(id) ~= "number" or type(sec) ~= "string" then return false end
	if P.byid[id] then return true end

	-- ONE POCKET, AND ONLY ONE. P.byid is this pocket's index, so it
	-- can only say that THIS pocket already has it; an id filed into
	-- two pockets is one object with two records, and the second one
	-- is a duplicate the moment the rig comes off. A.slot_put has
	-- always asked the whole rig and the door underneath it did not.
	if A.pk_holds(id) then return false end

	-- ...AND NOT THE ACTOR'S OWN ID, which is not the id of anything
	-- that can be in a pocket. See the note in A.pk_remember.
	local me = db.actor and db.actor:id()
	if me and id == me then
		log("!something tried to put the actor's own id in a pocket")
		return false
	end

	if not A.pk_takes(sec) then return false end

	local cap = pk_cap(sec)

	-- ============================================================
	-- ONE ANSWER, AND IT IS THE HIGHLIGHT'S
	--
	-- Three separate walks used to live here - the aimed square, then a
	-- pile to join, then any free square - each with its own idea of
	-- which way up the thing was. A.fit_land is those three, in that
	-- order, and it is what the green block on screen was drawn from,
	-- so a drop cannot land anywhere but where the player was shown.
	--
	-- It also tries the OTHER WAY UP, which is what none of the three
	-- did: a pocket with a magazine down one side has a hole one square
	-- wide and two tall, and a wide thing goes in there on its side or
	-- not at all.
	-- ============================================================
	local it = A.item_of(sec, id)
	local n, r, c, w, h, rot =
		A.fit_land(P.cols, P.rows, P.slots, cap, it, ar, ac)
	if not r then return false end

	if not n then
		P.slots[#P.slots + 1] = { sec = sec, r = r, c = c, w = w, h = h,
		                          rot = rot, ids = {} }
		n = #P.slots
	end

	local e = P.slots[n]
	e.ids[#e.ids + 1] = id
	P.byid[id] = n

	-- AND THE RECORD IT WAS BORN FROM STOPS BEING TRUE. `born` is the
	-- fallback for "the objects have not arrived yet"; the moment the
	-- pile is added to by hand it describes a different pile, and a
	-- stale one would resurrect what the player just took out.
	e.born = nil

	-- The list may have been empty a moment ago, in which case the store
	-- is not holding it yet - slot_set forgets an empty one.
	A.pk_sync(P)

	-- ============================================================
	-- AND THE MAGAZINE MOD IS TOLD, HERE, BECAUSE THIS IS THE DOOR
	--
	--   "when 2x1 mag is put into a pouch 2x2 slot first ... then
	--    nothing else can be put inside"
	--
	-- A magazine standing in a rig slot that the magazine mod is not
	-- carrying is taken back out of that slot by reconcile on the very
	-- next frame. A.slot_put told the mod; A.pk_put_all - which is what
	-- a DROP onto a pocket goes through - did not. So a magazine
	-- dropped straight onto a pocket was carried by nobody and was
	-- gone before the frame ended.
	--
	-- THE FIRST ONE ALWAYS SURVIVED, which is what made this look like
	-- a fault in one particular pocket. Reconcile has a catch-all that
	-- claims every magazine in the rig when the carried set is
	-- completely EMPTY - and an empty set is only ever true of the
	-- first magazine you put in. Every one after it was dropped.
	--
	-- So the telling belongs on the door that every road goes through
	-- rather than on one of the roads. A.carry is idempotent.
	-- ============================================================
	if A.is_mag(sec) then
		A.carry(id)

		-- AND IF IT WOULD NOT, SAY SO. The magazine mod is entitled to
		-- refuse - its ledger, its reasons - but the consequence is
		-- this pocket quietly emptying a frame later, and that has
		-- twice now been reported as a pocket that "does not work".
		local mb = rawget(_G, "magazine_binder")
		if mb and type(mb.is_carried_mag) == "function" then
			local ok, has = pcall(mb.is_carried_mag, id)
			if ok and not has then
				log("the magazine mod would not carry %s (id %s) - "
				    .. "the pocket will empty itself",
				    tostring(sec), tostring(id))
			end
		end
	end

	return true
end

-- A whole stack at once, into ONE square.
function A.pk_put_all(P, cc, idx, ar, ac)
	local objs = A.cell_objs(cc, idx)
	if #objs == 0 then return 0 end

	local first
	pcall(function() first = objs[1]:section() end)
	if type(first) ~= "string" then return 0 end

	local cap = pk_cap(first)

	local target
	if ar and ac then
		local on = A.pk_on_square(P.slots, ar, ac)
		local e0 = on and P.slots[on]
		if e0 then
			if e0.sec == first and #e0.ids < cap then target = on
			else ar, ac = nil, nil end
		end
	end
	if not (ar and ac) then target = target or pk_join(P, first) end

	local went = 0
	for i = 1, #objs do
		local id, sec
		pcall(function() id, sec = objs[i]:id(), objs[i]:section() end)
		if not (type(id) == "number" and sec == first) then break end
		local e = target and P.slots[target]
		if e and #e.ids >= cap then break end
		if not A.pk_put(P, id, sec, ar, ac) then break end
		went = went + 1
		target = target or P.byid[id]
	end
	if went > 0 then A.sfx("in") end
	return went
end

function A.pk_show(P, n)
	local e = P.slots[n]
	if not e then return 0 end

	local now = time_global()
	local m = P.mshow[n]
	if m and m.ids == #e.ids and now >= m.at and now - m.at < 300 then
		return m.val
	end

	-- ============================================================
	-- THE NUMBER THE BAG WOULD SHOW
	--
	--   "stack indicator in the rig shows ammount of items not ammount
	--    of uses/bullets like in inventory"
	--
	-- Three different numbers, and the game picks between them by what
	-- the thing IS. Cartridges count rounds - a box of 25 says 25, not
	-- 1 - medicine counts uses, and everything else counts itself. The
	-- boxes have said it this way since A.pile_show was written; the
	-- pockets counted uses and not rounds, so a rig full of ammunition
	-- said how many BOXES were in it.
	-- ============================================================
	local multi, ammo = nil, nil
	if type(IsItem) == "function" then
		local ok, r = pcall(IsItem, "multiuse", e.sec)
		if ok then multi = r end
		local oka, a = pcall(IsItem, "ammo", e.sec)
		if oka then ammo = a end
	end

	local val = 0
	if ammo then
		for i = 1, #e.ids do
			local n
			local obj = level.object_by_id(e.ids[i])
			if obj then
				local ok, r = pcall(function() return obj:ammo_get_count() end)
				if ok and type(r) == "number" then n = r end
			end
			val = val + (n or 1)
		end
	elseif multi then
		for i = 1, #e.ids do
			local u
			local obj = level.object_by_id(e.ids[i])
			if obj then
				local ok, r = pcall(function() return obj:get_remaining_uses() end)
				if ok and type(r) == "number" then u = r end
			end
			val = val + (u or 1)
		end
	else
		val = #e.ids
	end

	P.mshow[n] = { at = now, ids = #e.ids, val = val }
	return val
end

function A.pk_drop(P, id)
	local n = P.byid[id]
	if not n then return false end
	local e = P.slots[n]
	if not e then pk_reindex(P) return false end
	for i = #e.ids, 1, -1 do
		if e.ids[i] == id then table.remove(e.ids, i) end
	end
	e.born = nil
	if #e.ids == 0 then table.remove(P.slots, n) end
	pk_reindex(P)
	A.pk_sync(P)
	return true
end

function A.pk_top(P, n)
	local e = P.slots[n]
	if not (e and #e.ids > 0) then return nil end
	return e.ids[#e.ids]
end

function A.pk_count(P)
	local n = 0
	for i = 1, #P.slots do n = n + #P.slots[i].ids end
	return n
end

function A.pk_has(P, sec)
	for n = 1, #P.slots do
		local e = P.slots[n]
		if e.sec == sec and #e.ids > 0 then return true end
	end
	return false
end

function A.pk_pick(P, sec)
	for n = 1, #P.slots do
		local e = P.slots[n]
		if e.sec == sec and #e.ids > 0 then return e.ids[#e.ids] end
	end
	return nil
end

function A.pk_prune(P)
	local now = time_global()
	local gone = 0
	for e = #P.slots, 1, -1 do
		local ent = P.slots[e]
		for i = #ent.ids, 1, -1 do
			local id = ent.ids[i]
			local waiting = A.incoming[id] and now < A.incoming[id]
			if not (waiting or level.object_by_id(id)) then
				table.remove(ent.ids, i)
				gone = gone + 1
			end
		end
		if #ent.ids == 0 then table.remove(P.slots, e) end
	end
	if gone > 0 then
		pk_reindex(P)
		A.pk_sync(P)
	end
	return gone
end

-- ============================================================
-- WHICH POCKETS EXIST RIGHT NOW - ONE PER SLOT OF THE WORN RIG
--
-- This used to be one pocket per pouch slot holding a MED pouch, of
-- which there were at most two. It is now one per SLOT: the rig's own
-- 2x2 / 3x1 / 2x1 / 1x1 in canonical order, then whatever the fitted
-- pouches grant, which is exactly the order A.rig_slots_all lists
-- them in and exactly the order they are drawn in.
--
-- A.pk[i] is therefore "the ith thing drawn on the panel", and it is
-- the ONLY list the draw pass, the hit tests and the input handlers
-- walk. A.rig[i] is its shape.
--
-- Rebuilt in step with resolve_rig, which already reruns whenever the
-- rig, the fitted pouches or the wear changes, because all three are
-- in its key.
-- ============================================================
function A.pk_slot(i)
	return A.pk[i]
end

function A.pk_each(fn)
	for i = 1, #A.pk do
		local P = A.pk[i]
		if P then fn(i, P) end
	end
end

-- Is this id in ANY pocket? What A.hidden and the pruner ask.
-- WHICH POCKET INDEX holds this id. The rig-drop bridges used to read
-- A.by_id, a table that no longer exists (pockets keep P.byid now).
function A.pk_index(id)
	if type(id) ~= "number" then return nil end
	for i = 1, #A.pk do
		local P = A.pk[i]
		if P and P.byid[id] then return i end
	end
	return nil
end

function A.pk_holds(id)
	for i = 1, #A.pk do
		local P = A.pk[i]
		if P and P.byid[id] then return true end
	end
	return false
end

function A.pk_ncount(i)
	local P = A.pk[i]
	return P and A.pk_count(P) or 0
end

-- This id is gone from the world - dropped, destroyed, loaded into a
-- gun. Take it out of whichever slot believed it was there.
--
-- ONE DOOR, because the three callers used to write the same three
-- lines each against A.slots and A.by_id, and the fourth caller that
-- forgot one of them left a slot looking full for ever.
function A.pk_forget(id)
	if type(id) ~= "number" then return false end
	for i = 1, #A.pk do
		local P = A.pk[i]
		if P and P.byid[id] then
			A.pk_drop(P, id)
			return true
		end
	end
	return false
end

-- Is anything standing in a slot that POUCH SLOT i granted? What
-- unfit_pouch asks before letting a pouch out: pulling it would take
-- the slots away and leave what was in them nowhere.
function A.pouch_holds(i)
	for n = 1, #A.pk do
		local P = A.pk[n]
		if P and P.pouch == i and A.pk_count(P) > 0 then return true end
	end
	return false
end

-- ============================================================
-- THE THREE DOORS INTO THE WORN RIG
--
-- Everything that puts something in, takes something out or asks
-- whether there is room comes through here, and each of them is one
-- line of decision on top of the pocket generics:
--
--   A.slot_free   which slot would take it, if any
--   A.slot_put    put it in - a named slot and square, or anywhere
--   A.slot_pull   take the top of one pile out
--
-- A TORN SLOT IS SKIPPED, EVERY TIME. The tear is the one rule that is
-- about the slot rather than about the shape, and it lives here so
-- that no caller can forget it - which is exactly how a torn pocket
-- used to keep swallowing magazines.
--
-- AND THE CARRIED SET FOLLOWS THE MAGAZINES. A magazine in the rig is
-- a magazine the magazine mod counts as carried, and one out of it is
-- not; nothing else in a rig has a carried set to belong to.
-- ============================================================
-- ============================================================
-- THE TIGHTEST SLOT THAT WILL HAVE IT, NOT THE FIRST
--
-- The slots are drawn biggest first - 2x2, then 3x1, 2x1, 1x1 - so
-- walking them in draw order puts a rifle magazine in the drum pocket
-- of a rig that has exactly one, and the drum you were saving it for
-- then fits nowhere. The old typed model had the same rule for the
-- same reason, and it read "smallest pocket that takes this class".
--
-- SMALLEST BY AREA, ties broken by draw order, so the answer is stable
-- and a player who fills a rig twice fills it the same way.
--
-- IT IS ONLY A PREFERENCE. A slot the player POINTED AT beats it -
-- that is what `prefer` is - and if the tight ones are full the loose
-- ones are asked next, in the same order.
-- ============================================================
local function slot_order()
	local order = {}
	for i = 1, #A.pk do order[#order + 1] = i end

	table.sort(order, function(a, b)
		local pa, pb = A.pk[a], A.pk[b]
		local aa = (pa.cols or 1) * (pa.rows or 1)
		local ab = (pb.cols or 1) * (pb.rows or 1)
		if aa ~= ab then return aa < ab end
		return a < b
	end)

	return order
end

function A.slot_free(sec, prefer, id)
	if type(sec) ~= "string" then return nil end
	if not A.pk_takes(sec) then return nil end

	if prefer and A.pk[prefer] and not A.is_torn(prefer)
	   and A.pk_room(A.pk[prefer], sec, id) then
		return prefer
	end

	local order = slot_order()
	for n = 1, #order do
		local i = order[n]
		if not A.is_torn(i) and A.pk_room(A.pk[i], sec, id) then return i end
	end
	return nil
end

function A.slot_put(id, sec, prefer, ar, ac)
	if type(id) ~= "number" or type(sec) ~= "string" then return nil end
	if A.pk_holds(id) then return nil end

	local ok = A.pk_takes(sec)
	if not ok then return nil end

	-- THE AIMED SQUARE ONLY COUNTS FOR THE AIMED SLOT. Carrying (ar, ac)
	-- on to the next candidate would drop the thing at a square the
	-- player pointed at in a different pocket.
	if prefer and A.pk[prefer] and not A.is_torn(prefer) then
		if A.pk_put(A.pk[prefer], id, sec, ar, ac) then
			if A.is_mag(sec) then A.carry(id) end
			return prefer
		end
	end

	local order = slot_order()
	for n = 1, #order do
		local i = order[n]
		if i ~= prefer and not A.is_torn(i) then
			if A.pk_put(A.pk[i], id, sec) then
				if A.is_mag(sec) then A.carry(id) end
				return i
			end
		end
	end

	return nil
end

-- The TOP of pile n in slot i - the last one in, which is the one the
-- player sees on top of the stack. Hands back the id; the caller
-- decides what to do with the object.
function A.slot_pull(i, n)
	local P = A.pk[i]
	local e = P and P.slots[n]
	if not (e and #e.ids > 0) then return nil end

	local id = e.ids[#e.ids]
	A.pk_drop(P, id)
	A.uncarry(id)
	return id
end

-- ============================================================
-- BUILD THE POCKETS TO MATCH THE RIG
--
-- Every pocket points its `slots` at the STORE's own table for that
-- slot key, so there is one copy of what is in a rig and it is the one
-- the save holds. Take the rig off and the keys are still there; put
-- it back on and the same tables come back.
--
-- A TORN SLOT STILL EXISTS. It is built like any other and refuses
-- everything, because a slot that vanished when the rig wore through
-- would tell the player nothing about what mending it would give
-- back. A.hole is what the fit tests ask - see A.is_torn.
-- ============================================================
function A.resolve_pk()
	local id = A.rig_id

	for i = #A.pk, 1, -1 do A.pk[i] = nil end
	if not id then return end

	-- A.rig IS THE LIST, in the order it is drawn - see the note in
	-- A.resolve_rig. Falling back to A.rig_slots_all would be a second
	-- opinion about the order, which is the thing this exists to
	-- prevent, so a rig with no drawn slots simply has no pockets.
	local slots = A.rig
	for i = 1, #slots do
		if i > MAX_SLOTS then break end
		A.pk[i] = A.pk_new(slots[i], id)
	end
end

-- ============================================================
-- WHAT IS IN A RIG WHEN YOU TAKE IT OFF, AND WHEN YOU PUT IT ON
--
-- The two halves of one fact: a thing in a WORN rig is a real object
-- in the world, and a thing in a rig in your bag is a RECORD. The rig
-- on your chest has to hold objects, because you reload and heal out
-- of it; a rig in your bag must not, because the objects would be
-- loose in the world belonging to nothing.
--
-- So taking the rig off releases every object and writes a record
-- where it stood - box_grab and box_make, the same reader and maker
-- the boxes use - and putting it on does the reverse.
--
-- THE PLACE IS THE STORE, not a stash of its own. A.wear holds the
-- worn rig's slots by key and A.hold[id] holds an unworn one's, so
-- this is a conversion between the two forms of the SAME entry rather
-- than a move between two tables that could disagree. The old code had
-- a A.pkstash keyed by pouch slot number, which is the thing
-- A.rig_slots_all's named keys exist to stop.
-- ============================================================
function A.pk_remember(id)
	if type(id) ~= "number" then return 0 end

	local sec = A.rig_sec()
	local slots = sec and A.rig_slots_all(sec, id)
	local total = 0
	local by = {}

	for s = 1, (slots and #slots or 0) do
		local key = slots[s].key
		local t = A.slot_of(id, key)
		local out = {}

		-- ============================================================
		-- A COPY, BECAUSE RELEASING AN OBJECT REACHES BACK IN HERE
		--
		--   "if slot holds two items and rig is unequipped then one of
		--    those items gets pushed out of the rig into the inventory"
		--
		-- alife_release makes the engine fire server_entity_on_unregister,
		-- which this mod listens to, which calls A.pk_forget, which calls
		-- A.pk_drop - and A.pk_drop does `table.remove(P.slots, n)` when
		-- the square empties. **The list being walked here is that list.**
		--
		-- So a pocket holding two things released the first, the entry
		-- vanished from under the loop, the second slid down into its
		-- place, and `e = 2` read nothing. That item was never stowed
		-- AND never released: it turns up loose in your bag while the
		-- rig comes off without it.
		--
		-- It is also, at last, where "entry 2 of 1 is missing" came from
		-- - a message whose two numbers could not both be true, because
		-- the bound was read before the shrink and the count after it -
		-- and it is the same crash that ended a session on 3.0.1.
		--
		-- Everything this loop needs is copied out FIRST. The ids too:
		-- releasing one of them rewrites that list as well.
		-- ============================================================
		local ents, nents = {}, (t and #t or 0)
		for e = 1, nents do
			local src = t[e]
			if src then
				local copy = { sec = src.sec, r = src.r, c = src.c,
				               w = src.w, h = src.h, rot = src.rot,
				               born = src.born, ids = {} }
				for k = 1, #(src.ids or {}) do copy.ids[k] = src.ids[k] end
				ents[e] = copy
			end
		end

		for e = 1, nents do
			local ent = ents[e]

			-- ============================================================
			-- A HOLE IN THE LIST IS A FACT, NOT A CRASH
			--
			-- This is the LAST thing that runs before a rig leaves your
			-- hands, and everything in it exists nowhere else. A nil
			-- entry here used to be `ent.sec` on a nil - a hard crash,
			-- inside a callback the engine does not protect, on the
			-- frame the player drops a rig or quits the game.
			--
			-- The copy above is what stops it happening; this stays
			-- because a hole that was ALREADY in the store is a fact
			-- worth reading in a log rather than a crash.
			-- ============================================================
			if not ent then
				log("!rig %s slot %s: entry %d of %d was already missing "
				    .. "- skipped", tostring(id), tostring(key), e, nents)
			else

			local pile = { sec = ent.sec, of = {} }

			-- ============================================================
			-- A SQUARE IS STOWED FROM ONE SOURCE OR THE OTHER, NEVER BOTH
			--
			--   "when rig is unequipped some of it goes to inventory
			--    instead of staying in the rig"
			--
			-- The two sources are the LIVE OBJECTS the square is holding
			-- and `born`, the record it was rebuilt from a moment ago.
			-- Mixing them is what leaked: a square rebuilt into eight
			-- boxes of buckshot, of which five have been handed over and
			-- three have not, read five, stowed five, and left the other
			-- three to arrive in the bag as a present. Every off-and-on
			-- made three more.
			--
			-- So the source is chosen for the WHOLE square before
			-- anything is read. If every id answers, the objects are the
			-- truth. If any of them does not and `born` is there, the
			-- record is the truth and EVERY id it describes is destroyed
			-- - by object where there is one, and by id where the engine
			-- has not handed it over yet, which is the whole difference
			-- between the two calls.
			-- ============================================================
			local live, seen = {}, 0
			local me = db.actor and db.actor:id()

			for k = 1, (ent.ids and #ent.ids or 0) do
				local o = level.object_by_id(ent.ids[k])

				-- NOT THE ACTOR. Every session's log carries forty-odd
				-- copies of
				--
				--     CSciptEntity [actor]: cannot access class member
				--     GetCondition!   ... box_grab / pk_remember
				--
				-- which is this loop asking an object that is not an
				-- item for its condition. It is caught and costs
				-- nothing, but it means a square is holding an id that
				-- is not the id of a thing in it, and that is worth
				-- knowing about rather than reading past.
				if o and me and ent.ids[k] == me then
					log("!rig %s slot %s: square %d is holding the "
					    .. "actor's own id - ignored", tostring(id),
					    tostring(key), e)
					o = nil
				end

				live[k] = o
				if o then seen = seen + 1 end
			end

			local whole = (seen == (ent.ids and #ent.ids or 0))
			local use_born = (not whole) and type(ent.born) == "string"

			if use_born then
				-- Release through the live object when one exists, and use
				-- the server id only as the fallback. Calling both is not a
				-- no-op in SA 3.1.0: the second call emits a false
				-- "no server object" engine error after the first succeeds.
				for k = 1, #ent.ids do
					if live[k] then
						pcall(alife_release, live[k])
					else
						pcall(alife_release_id, ent.ids[k])
					end
					A.incoming[ent.ids[k]] = nil
				end

				log("rig %s slot %s: %s had %d of %d in hand - the record "
				    .. "stands and %d object(s) were destroyed with it",
				    tostring(id), tostring(key), tostring(ent.sec),
				    seen, #ent.ids, #ent.ids)
			else
				for k = 1, (ent.ids and #ent.ids or 0) do
					local obj = live[k]
					if obj then
						local rec = A.box_grab(obj)
						local one = rec and rec.of and rec.of[1]
						if one then
							local ok = pcall(function() alife_release(obj) end)

							if ok then A.pile_add(pile, one) total = total + 1 end
						else
							log("!rig %s slot %s: %s (id %s) could not be "
							    .. "read - left in your bag",
							    tostring(id), tostring(key),
							    tostring(ent.sec), tostring(ent.ids[k]))
						end
					elseif not ent.born then
						log("!rig %s slot %s: %s (id %s) is gone and there "
						    .. "is no record of it",
						    tostring(id), tostring(key),
						    tostring(ent.sec), tostring(ent.ids[k]))
					end
				end
			end

			-- ============================================================
			-- NOT ONE OF THEM WAS THERE YET
			--
			-- A rig just put on hands its records back as objects, and
			-- those objects do not exist for a frame or two - see
			-- A.incoming. Take it straight off again in that window and
			-- every id reads as nothing, the pile comes out empty, and
			-- everything in the rig is gone.
			--
			-- So the RECORD IT WAS BUILT FROM rides on the entry, and it
			-- is what is written when nothing else can be. Live objects
			-- always win; this is only ever the answer when there are
			-- none, which is exactly the window it exists for.
			-- ============================================================
			if use_born and type(ent.born) == "string" then
				-- ============================================================
				-- AND THE OBJECTS IT WAS REBUILT INTO ARE DESTROYED
				--
				--   "when i move the rig back and forth equiping it and
				--    unequping the ammo gets duped every time"
				--
				-- Exactly that, and this was it. `born` is used when not
				-- one of the entry's objects can be read - which is the
				-- frame or two after a rig goes on, when they exist as
				-- SERVER objects the engine has not handed over yet.
				-- They are not gone. They are coming.
				--
				-- So writing the record back without destroying them
				-- leaves two copies of everything: a hundred and sixty
				-- rounds filed in the rig, and eight boxes about to
				-- appear in your bag. Take the rig off and on quickly a
				-- few times and the ammunition doubles each round.
				--
				-- alife_release_id reaches a server object that has no
				-- client one, which is the whole difference between this
				-- and the release above.
				-- ============================================================
				out[#out + 1] = { sec = ent.sec, r = ent.r, c = ent.c,
				                  w = ent.w, h = ent.h, rot = ent.rot or nil,
				                  of = ent.born }

				-- COUNTED PROPERLY. `gmatch("[^|]*")` matches the empty
				-- string between two separators as well as the fields, so
				-- a pile of two counted as four and every "N thing(s)
				-- stowed" line in the log was inflated.
				local was = A.pile_unpack(ent.born, ent.sec)
				total = total + (was and #was or 1)

			elseif #pile.of == 0 and type(ent.born) == "string" then
				-- Every id answered and not one of them could be read.
				-- The record is all there is; the objects, whatever
				-- they were, are already gone.
				out[#out + 1] = { sec = ent.sec, r = ent.r, c = ent.c,
				                  w = ent.w, h = ent.h, rot = ent.rot or nil,
				                  of = ent.born }
				local was = A.pile_unpack(ent.born, ent.sec)
				total = total + (was and #was or 1)

			elseif #pile.of > 0 then
				out[#out + 1] = { sec = ent.sec, r = ent.r, c = ent.c,
				                  w = ent.w, h = ent.h, rot = ent.rot or nil,
				                  of = A.pile_pack(pile) }
			end

			end     -- if not ent / else
		end

		-- OUT OF `wear` AND INTO `hold`, in that order. Clearing the worn
		-- side first would lose the key if the write below failed.
		if #out > 0 then by[key] = out end
		A.wear[key] = nil
	end

	A.hold[id] = next(by) and by or nil

	for i = #A.pk, 1, -1 do A.pk[i] = nil end

	if total > 0 then
		log("rig %s: %d thing(s) stowed", tostring(id), total)
	end
	return total
end

function A.pk_restore(id)
	local want = id and A.hold[id]
	if not want then return 0 end

	local sec = A.rig_sec()
	local slots = sec and A.rig_slots_all(sec, id)
	if not slots then return 0 end

	local back = 0

	for s = 1, #slots do
		local sl = slots[s]
		local list = want[sl.key]
		if list then
			local t = {}

			for e = 1, #list do
				local ent = list[e]
				local of = A.pile_unpack(ent.of, ent.sec)
				-- THE STORED SHAPE, not the section's - a sideways splint
				-- was stowed as 1x2 with rot set, and recomputing from the
				-- section would stand it back up. Fall back to the upright
				-- size only if the record somehow carried none.
				local w = tonumber(ent.w) or nil
				local h = tonumber(ent.h) or nil
				local rot = ent.rot and true or nil
				if not w then w, h = A.cells(ent.sec) end
				local r, c = ent.r, ent.c
				if not (w and A.box_room(t, sl.w, sl.h, r, c, w, h)) then
					r, c = A.box_spot(t, sl.w, sl.h, w or 1, h or 1)
				end
				if r and of then
					local cap = A.slot_cap(ent.sec)
					-- `born` is the record this square is being rebuilt
					-- from, kept until the objects turn up - see the note
					-- in A.pk_remember.
					local slot = { sec = ent.sec, r = r, c = c, w = w, h = h,
					               rot = rot, born = ent.of, ids = {} }
					t[#t + 1] = slot

					-- ============================================================
					-- ONE RECORD IS NOT ONE OBJECT
					--
					--   "when equiping/unequiping the rig some of the ammo
					--    goes back to inventory"
					--
					-- CARTRIDGES. A pile MERGES them - eight boxes of
					-- buckshot are stowed as one record saying "a hundred
					-- and sixty rounds", which is the honest way to keep
					-- them - and alife_create_item hands that back as
					-- EIGHT boxes, because a box holds twenty.
					--
					-- This kept the first id and dropped the other seven.
					-- They existed, so they landed in the bag: a hundred
					-- and forty rounds walked out of the rig every time it
					-- was put on. A.box_make has returned the whole list
					-- since 1.98.4 and this was the caller that never took
					-- it.
					--
					-- AND NOTHING IS DROPPED FOR WANT OF ROOM. The old
					-- loop stopped at the stack ceiling without making the
					-- rest, which does not leave them in the bag - it
					-- means they never exist again. They are made, they go
					-- where they fit, and what does not fit is in your
					-- bag and said so.
					-- ============================================================
					local spare = 0
					for k = 1, #of do
						local rec = of[k]
						local made, nid, ids = A.box_make({ sec = ent.sec,
						    cond = rec.cond, uses = rec.uses, ammo = rec.ammo })

						if made then
							ids = ids or (nid and { nid }) or {}
							for q = 1, #ids do
								if #slot.ids < cap then
									slot.ids[#slot.ids + 1] = ids[q]
									A.incoming[ids[q]] = time_global() + 10000
									back = back + 1
								else
									spare = spare + 1
								end
							end
						end
					end

					if spare > 0 then
						log("rig %s: %d %s would not fit the square they "
						    .. "came out of - they are in your bag",
						    tostring(id), spare, tostring(ent.sec))
					end

					if #slot.ids == 0 then table.remove(t) end
				end
			end

			if #t > 0 then A.wear[sl.key] = t end
		end
	end

	A.hold[id] = nil
	A.resolve_pk()
	if back > 0 then
		log("rig %s: %d thing(s) back in the rig", tostring(id), back)
	end
	return back
end

function A.is_pouch_sec(sec)
	if type(sec) ~= "string" or sec == "" then return false end
	if not A.gls_base then return false end
	local ok, sm, m, l = pcall(A.gls_base, sec, false, false)
	if not (ok and sm) then return false end
	return (sm + m + l) > 0 and not A.is_mag(sec)
end

-- ============================================================
-- A WORN-OUT RIG CANNOT HOLD A POUCH UP
--
-- The player's rule, and it is a good one: a rig at 8% is a rag and
-- carries nothing bolted to it; at 30% one strap is still sound; only a
-- rig in decent order carries both.
--
--     under 10%   no pouch slots
--     under 50%   the first slot only
--     50% or more both
--
-- A pouch fitted to a slot that stops working STAYS IN IT. It is not
-- handed back and it is not lost - the slot is simply dead, drawn as
-- dead, and its pockets are not part of the rig until you mend it. Then
-- they come straight back with nothing to refit.
--
-- Read as "slot i needs this much", so the ladder is one table rather
-- than a chain of ifs, and the first slot is the one that survives
-- longest.
-- ============================================================
local PSLOT_NEEDS = { 0.10, 0.50 }

function A.slots_live(cond)
	if type(cond) ~= "number" then return PSLOTS end

	local n = 0
	for i = 1, PSLOTS do
		if cond >= (PSLOT_NEEDS[i] or 1) then n = n + 1 end
	end
	return n
end

-- Is slot i working on the rig being worn right now?
function A.slot_live(i)
	if type(i) ~= "number" then return false end
	return i <= A.slots_live(A.rig_cond(A.rig_obj()))
end

-- The sections fitted to this outfit's rig, in slot order.
function A.fitted(id)
	id = id or outfit_id()
	local t = id and A.pslot[id]
	if not t then return {} end
	local out = {}
	for i = 1, PSLOTS do
		if t[i] then out[#out + 1] = t[i] end
	end
	return out
end

function A.pouch_in(i, id)
	id = id or outfit_id()
	local t = id and A.pslot[id]
	return t and t[i] or nil
end

-- The ones that are actually holding, which is what grants pockets. The
-- plain A.fitted stays the whole truth - it is what hands pouches back
-- when the rig is dismantled, and a dead slot's pouch is still in there.
function A.fitted_live(id, cond)
	id = id or outfit_id()
	local t = id and A.pslot[id]
	if not t then return {} end

	-- The condition of THIS rig, not of whatever is being worn. The
	-- tooltip draws a rig lying in your bag, and answering with the worn
	-- one's wear would show a shape that rig does not have.
	if type(cond) ~= "number" then cond = A.rig_cond(A.rig_obj()) end

	local live = A.slots_live(cond)
	local out = {}
	for i = 1, math.min(PSLOTS, live) do
		if t[i] then out[#out + 1] = t[i] end
	end
	return out
end

-- Fitting consumes the item, the way installing a rig does.
function A.fit_pouch(obj, i)
	if not obj then return false end
	local sec = obj:section()

	if not A.is_pouch_sec(sec) then
		notify("Only pouches go in the rig's pouch slots")
		return false
	end

	local id = outfit_id()
	if not id then return false end

	if not (i and i >= 1 and i <= PSLOTS) then
		for n = 1, PSLOTS do
			if not A.pouch_in(n, id) then i = n break end
		end
	end
	if not i then return false end

	if A.pouch_in(i, id) then
		notify("That pouch slot is taken")
		return false
	end

	-- A dead slot takes nothing. Saying so is the whole point: a slot
	-- that silently swallowed a pouch and granted no pockets would look
	-- exactly like a bug.
	if not A.slot_live(i) then
		notify("The rig is too worn to carry that - mend it first")
		return false
	end

	A.pslot[id] = A.pslot[id] or {}
	A.pslot[id][i] = sec

	local ok = pcall(function() alife_release(obj) end)
	if not ok then log("!fit: could not release %s", tostring(sec)) end

	A.resolve_rig()
	A.sfx("in")
	return true
end

-- Taking one out hands the item back, so nothing is destroyed by
-- rearranging.
function A.unfit_pouch(i)
	local id = outfit_id()
	local sec = id and A.pouch_in(i, id)
	if not sec then return false end

	-- ============================================================
	-- A POUCH WITH ANYTHING IN IT DOES NOT COME OUT
	--
	-- EVERY pouch now, not just the med one. Under 3.0 a fitted pouch
	-- GRANTS SLOTS - one 2x1, two 2x1 or one 2x2 - and the things
	-- standing in those slots live there and nowhere else. Pull the
	-- pouch and they have no slot to be in: they would be dropped on
	-- the next resolve with nothing said, which is a trap rather than
	-- a cost.
	--
	-- So the honest answer is "empty it first", which is what the
	-- player chose for the med pouch when there was one.
	-- ============================================================
	if A.pouch_holds(i) then
		notify("Empty the pouch before taking it out")
		return false
	end

	A.pslot[id][i] = nil

	local ok, err = pcall(function() alife_create_item(sec, db.actor) end)
	if not ok then
		log("!unfit %s: %s", tostring(sec), tostring(err))
		-- It could not be handed back, so it is not taken out either.
		A.pslot[id][i] = sec
		notify("Could not take the pouch out - see the log")
		return false
	end

	A.resolve_rig()
	A.sfx("out")
	return true
end

-- ============================================================
-- BREAKING A RIG DOWN MUST NOT EAT THE POUCHES BOLTED TO IT
--
-- Fitting a pouch CONSUMES it: A.pslot remembers the section against
-- the rig's object id and the pouch object is released, so a pouch that
-- is "in" a rig does not exist in the world. A.unfit_pouch creates it
-- again, and every ordinary route a pouch leaves by goes through there.
--
-- Disassembly does not. item_parts discharges the rig and hands back
-- whatever nor_parts_list names; it has never heard of pouch slots. So
-- a rig broken down for cloth took two expansion pouches with it and
-- said nothing - a trap rather than a cost, and one this release makes
-- much easier to walk into by giving rigs a parts list worth using.
--
-- Handing them back is CONSERVATION, not a refund: the pouches came out
-- of the bag to go in. It is also why the parts list itself yields
-- cloth and hardware and never a pouch - that is what stops a rig being
-- a way to manufacture them.
--
-- ORDER MATTERS, AND SO DOES THE PARENT CHECK. The pouches go back
-- BEFORE the base call, because that call releases the object this
-- reads its id from. The base bails out with no owner, though, and a
-- bail after we had already handed the pouches back would leave the
-- player holding both them and the rig - so the one precondition it can
-- fail on is checked here first.
-- ============================================================
function A.give_back_pouches(obj)
	if not (A.enabled and obj) then return 0 end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and A.is_rig_sec(sec)) then return 0 end

	local owned = pcall(function() return obj:parent() end) and obj:parent()
	if not owned then return 0 end

	local id = obj:id()

	-- EMPTIED FIRST, and outside the pouch check below. A rig being
	-- taken apart is a rig whose contents have nowhere to go, and a
	-- stash keyed on a dead id would sit in the save for ever. The
	-- first version cleared it further down, past the early return for
	-- a rig with no pouches fitted - which is most rigs, so it almost
	-- never ran.
	--
	-- The magazines inside it are handed back rather than destroyed
	-- with it: dismantling a rig for cloth should not cost you four
	-- magazines you cannot see.
	--
	-- TAKEN OFF FIRST, and above the pouch check for the same reason
	-- the emptying is: taking a rig off is what files its magazines
	-- into it, so a rig taken apart while worn has to come off BEFORE
	-- the contents are tipped out. Doing the strip afterwards - which
	-- is where it used to live - filled the stash again on the way out,
	-- and doing it below the pouch check meant it did not happen at all
	-- for a rig with no pouches fitted, which is most of them.
	if A.rig_id == id then A.strip_rig() end
	A.spill(id)

	local t = A.pslot[id]
	if not t then return 0 end

	local given = 0
	for i = 1, PSLOTS do
		local psec = t[i]
		if psec then
			local ok2, err = pcall(function()
				alife_create_item(psec, db.actor)
			end)
			if ok2 then
				t[i] = nil
				given = given + 1
			else
				log("!dismantle: could not hand back %s: %s",
				    tostring(psec), tostring(err))
			end
		end
	end

	if given > 0 then
		log("dismantle: handed back %d pouch(es) from %s", given, tostring(sec))
		notify(given == 1 and "The pouch on that rig is back in your bag"
		                   or "The pouches on that rig are back in your bag")
	end

	if not next(t) then A.pslot[id] = nil end

	return given
end

-- The wrap. item_parts is read BARE: Anomaly's script loader is lazy, so
-- rawget answers nil for a script nothing has touched yet - the same
-- trap that has cost this mod a release once already.
-- ============================================================
-- TIP EVERYTHING OUT OF A RIG, INTO THE BAG
--
-- For the one case where the rig is going away and its contents must
-- not: it is being broken down for parts. The magazines are rebuilt in
-- the actor's inventory rather than in pockets that are about to stop
-- existing, so they come out as ordinary items.
-- ============================================================
-- ============================================================
-- TIP A RIG OUT INTO THE BAG
--
-- Every slot, every square, every item in the pile - rebuilt as a real
-- object in your inventory and the record dropped. Used when a rig is
-- taken apart, and by the one-time migration off the old save format.
--
-- A SQUARE IS A STACK. `of` is the packed pile, so five bandages in
-- one square come out as five bandages rather than one.
-- ============================================================
function A.spill(id)
	local held = id and A.hold[id]
	if not held then return 0 end

	local out = 0

	for _, t in pairs(held) do
		for e = 1, #t do
			local ent = t[e]
			local of = A.pile_unpack(ent.of, ent.sec)
			for k = 1, #(of or {}) do
				local rec = of[k]
				local made = A.box_make({ sec = ent.sec, cond = rec.cond,
				                          uses = rec.uses, ammo = rec.ammo })
				if made then
					out = out + 1
				else
					log("!spill: could not rebuild %s", tostring(ent.sec))
				end
			end
		end
	end

	A.hold[id] = nil

	if out > 0 then
		log("rig %s: %d thing(s) tipped into the bag", tostring(id), out)
		notify("%d thing%s came out of that rig", out, out == 1 and "" or "s")
	end
	return out
end

function A.install_dismantle_guard()
	local ip = item_parts
	if not (type(ip) == "table" and type(ip.disassembly_item) == "function") then
		log("no disassembly system - nothing to guard")
		return false
	end

	if A.dis_base then return true end      -- never wrap twice
	A.dis_base = ip.disassembly_item

	ip.disassembly_item = function(obj, obj_d)
		pcall(A.give_back_pouches, obj)
		return A.dis_base(obj, obj_d)
	end

	log("dismantling a rig will hand its pouches back")
	return true
end

-- ============================================================
-- THE SLOTS, PACKED THE WAY A RIG IS BUILT
--
--   "layouts are bad, now every different slot size have its own row.
--    so rigs with tall, normal and 1x1 slots have 3 rows instead of the
--    slots beeing nicley fit next to each other like they represent the
--    rig itself"
--
-- Exactly right, and it was a rule left over from 2.x: a band broke
-- whenever the HEIGHT changed, because until 3.0 every pocket was the
-- same height and a band of them was a row. With four heights that rule
-- gives four rows and a panel shaped like a list.
--
-- So the heights are the point now, not the obstacle. A band is as wide
-- as A.rig_width says and as deep as it needs to be, and each slot goes
-- at the LOWEST, then leftmost, place its own width will stand - which
-- is the packing a person does when they lay pouches out on a strap. A
-- 1x1 tucks under another 1x1 beside a 2x1; a 3x1 stands the full depth
-- of the band with the small pockets stacked next to it.
--
-- WHAT STILL BREAKS A BAND is where the slot came from: the rig's own,
-- and then one band per fitted pouch. A pouch's pockets are drawn on
-- the other side of the panel, so they cannot share a band with the
-- rig's, and two pouches stay told apart. The slots arrive in that
-- order already - the rig's, then each pouch's - so this is a run
-- boundary rather than a sort.
--
-- EACH SLOT COMES OUT WITH dx AND dy, its square inside the band. Every
-- draw reads those two rather than adding widths up as it goes, which
-- is what makes the three drawings of a rig - the panel, the open
-- window and the tooltip - agree by construction.
-- ============================================================
function A.pack_slots(slots, width)
	if not (slots and #slots > 0) then return nil end

	-- ============================================================
	-- EACH BAND IS AS WIDE AS ITS OWN CONTENTS
	--
	-- One width for the lot would be the rig's shape imposed on a
	-- pouch's two pockets, or a pouch's on the rig - and they are drawn
	-- in different parts of the panel, so there is nothing to line up
	-- between them. The runs are found first and each is measured on
	-- its own.
	-- ============================================================
	local runs, run, from = {}, nil, nil
	for i = 1, #slots do
		local mine = slots[i].pouch or false
		if not run or mine ~= from then
			run = { pouch = slots[i].pouch }
			runs[#runs + 1] = run
			from = mine
		end
		run[#run + 1] = slots[i]
	end

	local rows, band = {}, nil

	local function open(r)
		local cells = 0
		for i = 1, #r do cells = cells + r[i].w * r[i].h end

		band = { pouch = r.pouch, sky = {}, wide = width or A.rig_width(cells) }
		if band.wide < 1 then band.wide = 1 end
		for c = 1, band.wide do band.sky[c] = 0 end
		rows[#rows + 1] = band
	end

	for q = 1, #runs do
	local r = runs[q]
	open(r)
	local width = band.wide
	for i = 1, #r do
		local s = r[i]

		-- THE LOWEST PLACE IT WILL STAND, and the leftmost of those.
		-- A slot wider than the whole band is put at the left of it
		-- rather than never placed: the width comes out of a config,
		-- and a slot that can never be placed is a draw that never
		-- finishes.
		local bx, by
		for c = 1, math.max(1, width - s.w + 1) do
			local top = 0
			for q = c, math.min(width, c + s.w - 1) do
				if band.sky[q] > top then top = band.sky[q] end
			end
			if by == nil or top < by then bx, by = c, top end
		end

		s.dx, s.dy = (bx or 1) - 1, by or 0
		for q = bx or 1, math.min(width, (bx or 1) + s.w - 1) do
			band.sky[q] = s.dy + s.h
		end

		band[#band + 1] = s
	end
	end

	-- The skyline is scaffolding. Left on the row it would be walked by
	-- everything that reads a row as a list of slots.
	for r = 1, #rows do rows[r].sky, rows[r].wide = nil, nil end

	return (#rows > 0) and rows or nil
end

-- ============================================================
-- THE RIG IS THE ITEM, AND ONLY THE ITEM
--
-- Nothing about the armour is consulted. An armour with no chest rig
-- has NO slots, and that is the empty answer rather than a fallback,
-- or every armour in the game quietly keeps a default three.
--
-- THE ARMOUR-DERIVED PATH IS GONE. It read the magazine mod's own
-- per-outfit loadout table, scaled it, and filled a hand-drawn
-- silhouette with the result - three systems' worth of code for a mode
-- this mod has not shipped in since rigs became items. It could not
-- survive 3.0 anyway: it answered in size classes, and there are none.
-- ============================================================
function A.rows_for(val, sec, kind, pouch)
	if not pouch then return {}, "no rig", 0 end

	local slots = A.rig_slots_all(pouch, A.rig_id)
	if not slots then return {}, "empty rig", 0 end

	local rows = A.pack_slots(slots)
	if not rows then return {}, "empty rig", 0 end

	return rows, "rig item", 0
end

-- ============================================================
-- WHAT TO TELL THE MAGAZINE MOD, WHICH STILL COUNTS IN CLASSES
--
-- get_loadout_slots answers "how many small, medium and large pockets
-- has this loadout", and the magazine system gates carrying on it. We
-- have no classes any more, so this translates:
--
--     large    slots a 2x2 drum stands in
--     medium   how many 2x1 magazines the rig would hold if you filled
--              it with nothing else
--     small    the 1x1 squares, which is what is left for oddments
--
-- IT OVER-REPORTS ON PURPOSE, because a 2x2 counts once as a drum
-- pocket and twice as stick pockets and both are true - it just cannot
-- be both at once, and this answer has no way to say so.
--
-- That is the safe direction. The magazine mod's count is not the gate
-- any more; the GEOMETRY is, at A.rig_spot, and it is checked on every
-- road into a slot. Under-reporting would have the mod refuse a
-- magazine into a pocket the player can see is empty, which is the
-- complaint that made the tall-pocket flag count as a large slot in
-- the first place. Over-reporting only means the mod says yes and we
-- say where, which is the arrangement we want anyway.
-- ============================================================
function A.count_rows(rows)
	local n = { small = 0, medium = 0, large = 0 }

	for r = 1, #rows do
		for c = 1, #rows[r] do
			local s = rows[r][c]
			if type(s) == "table" and s.w and s.h then
				local cells = s.w * s.h
				if s.w >= 2 or s.h >= 2 then
					n.medium = n.medium + math.floor(cells / 2)
				end
				if s.w >= 2 and s.h >= 2 then n.large = n.large + 1 end
				if cells == 1 then n.small = n.small + 1 end
			end
		end
	end

	return n
end

-- What one outfit - worn or not - is worth, in slots.
function A.counts_for(val)
	local sec, kind, pouch

	if type(val) == "string" then
		sec = val
	else
		local ok, s = pcall(function() return val:section() end)
		if not ok then return nil end
		sec = s
		-- The rig is worn, not attached to the thing being asked about, so
		-- there is one answer and the object does not change it.
		pouch = A.rig_sec()
	end

	if type(sec) ~= "string" then return nil end
	kind = SYS_GetParam(0, sec, "kind")

	local rows = A.rows_for(val, sec, kind, pouch)
	return A.count_rows(rows)
end

-- Anything picked up. A rig gets its condition rolled once, here,
-- because this is the moment it becomes yours and not a moment sooner.
function A.on_item_take(obj)
	if not A.enabled then return end
	local ok = pcall(A.age_found, obj)
	if not ok then return end

	-- And whatever this mod is holding for it: a rig that came back
	-- into your hands with magazines in it weighs what they weigh.
	local okid, id = pcall(function() return obj:id() end)
	if okid then pcall(A.reweigh, id) end

	-- ============================================================
	-- ...AND THIS IS WHERE LOOT IS FILED
	--
	-- Every road into an inventory is CInventory::Take and every Take
	-- ends in OnItemTake, so a body, a stash and a thing on the ground
	-- all arrive here. LAST in this function: the weight above belongs
	-- to the object, and filing it may destroy the object.
	-- ============================================================
	pcall(A.file_loot, obj)
end

-- ============================================================
-- WEAR FROM BEING SHOT AT
--
-- The rig is an inventory item, so nothing in the game damages it for
-- us. It takes a share of what the actor takes - and a SMALL one: the
-- user asked for wear that is "mostly about looted rigs", so a serious
-- fight costs a percent or two rather than a pocket.
--
-- Only real damage, and only to the worn rig. A fall, a burn and a
-- bullet all count; radiation and thirst do not, because they do not
-- tear cloth.
--
-- ------------------------------------------------------------
-- WHAT THE ENGINE ACTUALLY HANDS THIS, which is where it went wrong
--
--   "even with rigs dont break from hits you take, thay get broken
--    when players gets radiated even a bit the whole rig goes from 100
--    to 0 in a second"
--
-- The game's own _g.script sends the callback like this:
--
--     SendScriptCallback("actor_on_before_hit", shit, bone_id, flags)
--
-- THREE arguments. This was written as
--
--     A.on_actor_hit(obj, amount, dir, who, bone)
--
-- so `amount` was bound to bone_id - A BONE NUMBER, not a quantity of
-- damage. `bone * 0.005` clears the two percent cap at bone five, so
-- every hit anywhere but the root cost the full cap; and radiation
-- arrives as a hit many times a second for as long as you are
-- irradiated, so a rig went from a hundred to nothing in about a
-- second.
--
-- The suite that covered this called it with the same made-up
-- signature, and so agreed with the code all the way down. A test
-- written from the code cannot find a mistake about the world.
-- ============================================================
-- Of the damage taken. "Very slow - mostly about looted rigs" was the
-- brief, so a solid rifle hit is a quarter of a percent.
local WEAR_PER_HIT = 0.005

-- ...AND NO MORE THAN THIS IN ANY ONE SECOND, whatever is hitting you.
--
-- THIS IS THE PART THAT IS NOT ABOUT RADIATION. The list below is a
-- list of the things I thought of; this is the floor underneath it. Any
-- source that fires a hit every frame - an anomaly, another mod,
-- something added to the game after this was written - can take one
-- percent of a rig in a second and no more, which is slow enough to
-- notice and walk out of. The bug this is guarding against was not
-- "radiation was in the wrong list"; it was that nothing anywhere put a
-- limit on how fast a rig could be destroyed.
--
-- THERE USED TO BE A PER-HIT CAP AS WELL, of two percent. It is gone:
-- one percent a second is stricter than two percent a hit in every
-- case, so the cap could never be reached and a constant nothing can
-- reach is a constant somebody will one day tune in the belief that it
-- does something. "A shotgun to the chest cannot take a pocket off in
-- one go" was what the cap was for, and this says it better.
local WEAR_PER_SEC = 0.01

-- ============================================================
-- WHAT TEARS CLOTH
--
-- Bullets, shrapnel, blast, a fall and fire. NOT radiation, NOT psy,
-- NOT acid, NOT electricity: none of them is a hole in a rig, and every
-- one of them arrives as a hit over and over for as long as you stand
-- in the thing causing it.
--
-- BUILT ON FIRST USE, never at chunk scope. `hit` is an engine class
-- and reading one while this file is still loading is how a mod fails
-- to load at all.
--
-- AND IF IT CANNOT BE READ, NOTHING WEARS. A rig that never wears is a
-- small disappointment; a rig destroyed by weather is a lost save's
-- worth of gear, and this file has just spent a release proving which
-- of those two gets reported.
-- ============================================================
local TEARS

local function tears_cloth(kind)
	if TEARS == nil then
		TEARS = false
		pcall(function()
			local t = {}
			t[hit.wound]      = true      -- bullets
			t[hit.fire_wound] = true      -- and what goes through
			t[hit.wound_2]    = true
			t[hit.explosion]  = true      -- blast and shrapnel
			t[hit.strike]     = true      -- a fall, a blow, a mutant
			t[hit.burn]       = true      -- fire
			TEARS = t
		end)
		if not TEARS then
			log("!hit types could not be read - rigs will not wear from damage")
		end
	end

	return (TEARS and kind ~= nil and TEARS[kind] == true) or false
end

-- ============================================================
-- IS THE ACTOR MENU ON SCREEN?
--
-- The whole of the difference between a deliberate click on an item in
-- your bag and a key press in a fight, and therefore the whole of what
-- decides whether the med pocket governs a use.
--
-- ui_inventory.GUI is the menu object; it exists while the menu does
-- and is asked whether it is showing. ANYTHING THIS CANNOT ANSWER IS
-- ANSWERED "OPEN", because the two mistakes do not cost the same: a
-- wrong "shut" refuses a click the player is looking at and reads as
-- medicine being broken, and a wrong "open" lets one key press through.
-- ============================================================
-- How long a draw counts for. Long enough that a stutter is not a
-- closed menu, short enough that the gate is live again within half a
-- second of the window going away - which is faster than anybody can
-- close an inventory and press a key.
local MENU_FRESH = 400

function A.menu_open()
	-- ============================================================
	-- THE DRAW SAID SO, WHICH IS THE ONLY ANSWER THAT CANNOT BE WRONG
	--
	--   "item can be put into the slot but when thay are in inventory
	--    (backpack) quickuse still works."
	--
	-- This used to ask ui_inventory.GUI:IsShown(). That object OUTLIVES
	-- the window - it is the script's inventory, not the window's
	-- visibility - and the call was wrapped in a pcall whose failure
	-- branch answered "open". So the gate stood down every single time
	-- and the whole feature did nothing, silently.
	--
	-- A.seen_at is stamped at the top of the draw, which runs only
	-- while the menu is painting. Nothing to raise, nothing to drift.
	--
	-- A CLOCK THAT WENT BACKWARDS IS A LEVEL CHANGE: time_global
	-- restarts, so a stamp from before one is in the future and would
	-- read as "always fresh" for the rest of the session.
	-- ============================================================
	local at = A.seen_at
	local now = time_global()

	if type(at) == "number" and now >= at and (now - at) < MENU_FRESH then
		return true
	end

	-- ...AND IsShown IS NOT CONSULTED AT ALL ANY MORE, not even as a
	-- second opinion that could only say yes. That object is the thing
	-- that lied: keeping it as a positive override would reproduce the
	-- exact bug this replaced, because the way it was wrong was by
	-- answering TRUE with the menu shut.
	--
	-- One signal, and it is the one that cannot be wrong: either this
	-- mod drew its panel in the last four hundred milliseconds or it
	-- did not, and it only draws while the menu is painting.
	return false
end

-- ============================================================
-- WHAT MAY BE USED, AND WHEN
--
--   "if quickuse item is not there it not triggers the use"
--
-- Called by the engine through CInventory__eat for EVERY use of
-- anything. flags.ret_value = false is the refusal.
--
-- FOUR WAYS OUT, and the order is the whole function:
--
--   1. the feature is off, or this is not something the pocket holds
--      -> not our business
--   2. the actor menu is open -> a deliberate click, never governed
--   3. the object IS in the pocket -> that is the point of the pocket
--   4. otherwise -> refused, and if the pocket holds one of these the
--      POCKET'S OWN is used instead on the next update
--
-- Step 4 is the case the engine hands us: with one bandage in the
-- pocket and twenty in the bag it may offer either, and refusing the
-- bag one outright would make the key do nothing while the pocket
-- visibly holds one.
-- ============================================================
-- ============================================================
-- WHAT THE GATE IS ABOUT: MEDICINE
--
--   "i want meds to be able to be slotted into any rig slot, but still
--    they are need to be in the rig to be quickused"
--
-- One family in items\amp_boxes.ltx - the same reader the boxes use,
-- so `kinds`, `also` and `never` all work here with no new parsing and
-- no new file. It used to decide what the MED POCKET would hold; the
-- pocket is gone and a rig slot holds anything that fits, so this now
-- decides one narrower thing: which items you must have in the rig to
-- use in a hurry.
--
-- WHY A FAMILY AND NOT A LIST IN THE CODE. What counts as medicine is
-- a judgement, it differs between installs, and it is exactly the kind
-- of thing that should be one line in a config rather than a release.
--
-- NO RULES FILE MEANS NO GATE. A rules file that did not ship should
-- leave the quick-use keys alone rather than refuse everything: a
-- feature that fails closed here would look like the keys are broken.
-- ============================================================
local GATE_FAMILY = "medpocket"

function A.gate_governs(sec)
	if type(sec) ~= "string" or sec == "" then return false end

	local rules = A.box_rules(GATE_FAMILY)
	if not rules then return false end

	for i = 1, #rules.never do
		if rules.never[i] == sec then return false end
	end
	for i = 1, #rules.also do
		if rules.also[i] == sec then return true end
	end

	local kind = SYS_GetParam(0, sec, "kind")
	if type(kind) == "string" then
		kind = kind:match("^%s*(.-)%s*$")
		for i = 1, #rules.kinds do
			if rules.kinds[i] == kind then return true end
		end
	end

	return false
end

-- ============================================================
-- THE DECISION, AS AN ANSWER
--
-- Returns TRUE when it refused, so the wrapper above itms_manager can
-- stop there and never call what is underneath it. That is the whole
-- difference between this working and what shipped in 1.91.1: writing
-- false into a flag is only a refusal if everybody downstream reads
-- the flag, and FDDA does not - it reads it once, decides to take the
-- use over, and then consumes the item with a call of its own.
-- ============================================================
function A.med_gate(obj, flags)
	if type(flags) ~= "table" then return false end
	if not (A.enabled and A.med_on and A.med_only) then return false end
	if not obj then return false end

	local id, sec
	pcall(function() id, sec = obj:id(), obj:section() end)
	if not (type(id) == "number" and type(sec) == "string") then return false end

	-- Already in a slot of the worn rig: this is exactly what the rig
	-- is for.
	if A.pk_holds(id) then return false end

	-- ============================================================
	-- THE GATE GOVERNS MEDICINE AND NOTHING ELSE
	--
	--   "i want meds to be able to be slotted into any rig slot, but
	--    still they are need to be in the rig to be quickused"
	--
	-- A rig slot takes anything that fits now, so "would a slot hold
	-- it" has stopped being the question - it is yes for almost
	-- everything you own, and a gate that answered it would stop you
	-- eating bread out of your backpack.
	--
	-- So the family in items\amp_boxes.ltx is still what decides, and
	-- it is now used for ONE thing: which items you must have in the
	-- rig to use in a hurry. Food, drink, a repair kit, an artefact -
	-- none of that is the gate's business, and it reads out of a config
	-- so that what counts as medicine is one line rather than a
	-- release.
	-- ============================================================
	if not A.gate_governs(sec) then return false end

	-- A deliberate click, in a window the player is looking at.
	if A.menu_open() then
		dbg("med gate: %s allowed - the menu is open", tostring(sec))
		return false
	end

	-- ONE LINE PER GOVERNED USE, and it is here rather than at the top
	-- because the report this fixes could not be narrowed from a log:
	-- the only line the gate ever wrote was on a path it never reached,
	-- so a log with debug on said exactly nothing about it.
	dbg("med gate: %s refused - %s in a pocket", tostring(sec),
	    A.pk_sec_has(sec) and "there is one" or "there is none")

	flags.ret_value = false

	-- ...and if the pocket holds one of these, THAT is what the press
	-- meant. Queued rather than eaten here: this is inside the engine's
	-- own use call, about this very object, and consuming a second one
	-- from underneath it is not a thing to discover in a firefight.
	local pick = A.pk_sec_pick(sec)
	if pick then
		A.med_eat = pick
		dbg("med: %s came from a pocket instead", tostring(sec))
	else
		notify("No %s in the med pocket", A.tip_name(sec) or tostring(sec))
	end

	return true
end

-- ============================================================
-- THE REGISTERED CALLBACK, WHICH IS NOW THE FALLBACK
--
-- Still registered, because with no itms_manager there is nothing to
-- wrap and this is the only door. It is the weaker of the two: by the
-- time a registered handler runs, anything that took the use over
-- ahead of it has already committed - which is exactly what FDDA does
-- and exactly what 1.91.1 could not stop.
--
-- It stands down when the wrapper is in, so one press is one decision
-- and one line in the log.
-- ============================================================
function A.on_item_before_use(obj, flags)
	if A.itm_base then return end
	A.med_gate(obj, flags)
end


-- The topmost of this section in the first slot of the worn rig that
-- has one - what the quick-use key reaches for.
function A.pk_sec_pick(sec)
	for i = 1, #A.pk do
		local P = A.pk[i]
		if P then
			local id = A.pk_pick(P, sec)
			if id then return id end
		end
	end
	return nil
end

-- Is this section in the worn rig at all? For the gate's log line, its
-- refusal, and the Quick Action Wheel's door.
function A.pk_sec_has(sec)
	for i = 1, #A.pk do
		local P = A.pk[i]
		if P and A.pk_has(P, sec) then return true end
	end
	return false
end

-- ...and the next update actually uses it. Cleared FIRST, so an object
-- that cannot be used is not retried on every frame for ever.
function A.med_settle_eat()
	local id = A.med_eat
	if not id then return false end
	A.med_eat = nil

	local obj = level.object_by_id(id)
	if not obj then return false end

	local ok = pcall(function() db.actor:eat(obj) end)
	if not ok then log("!med: could not use %s", tostring(id)) end
	return ok
end

function A.on_actor_hit(shit, bone_id, flags)
	if not (A.enabled and A.rig_wear and A.rig_id) then return end

	-- THE HIT ITSELF, read through a pcall: it is engine userdata in the
	-- game and there is no reason to trust that every caller of this
	-- callback fills every field.
	local power, kind
	pcall(function() power, kind = shit.power, shit.type end)

	if type(power) ~= "number" or power <= 0 then return end
	if not tears_cloth(kind) then return end

	-- THE SECOND'S BUDGET, before the rig is asked anything. A hit that
	-- cannot cost anything must not reach the object at all: two engine
	-- calls per hit event is a real cost when hit events arrive for
	-- everything that touches you.
	--
	-- time_global restarts on a level change, so a stamp from before one
	-- is in the future and starts a fresh second rather than locking the
	-- budget shut.
	local ms = time_global()
	if (not A.wear_at) or ms - A.wear_at >= 1000 or ms < A.wear_at then
		A.wear_at, A.wear_spent = ms, 0
	end

	local room = WEAR_PER_SEC - (A.wear_spent or 0)
	if room <= 0 then return end

	local rig = A.rig_obj()
	if not rig then return end

	local now = A.rig_cond(rig)

	local loss = power * WEAR_PER_HIT
	if loss > room then loss = room end

	local want = now - loss
	if want < 0 then want = 0 end
	if want >= now then return end

	-- WHAT WAS ACTUALLY SPENT, not what was asked for: a rig already at
	-- two percent cannot lose ten, and charging the budget for the ten
	-- would hold the ceiling shut against the next real hit.
	A.wear_spent = (A.wear_spent or 0) + (now - want)

	pcall(function() rig:set_condition(want) end)

	-- A pocket may have just torn, and the magazine in it has to go
	-- somewhere. resolve_rig re-reads the condition; validate is what
	-- moves what no longer fits.
	A.rig_key = nil
	pcall(A.resolve_rig)
end

-- ============================================================
-- A RIG OFF A CORPSE IS A PROJECT, NOT A FREE UPGRADE
--
-- This is the whole point of durability, and it is why wear from your
-- own fighting is deliberately slight: what stops you skipping the
-- ladder is that the rig you pull off a dead stalker arrives torn.
--
-- Rolled ONCE, when the object first turns up, and then it is the
-- engine's number like any other item's. A rig that has already been
-- rolled is never rolled again - A.rolled remembers, and it is saved.
--
-- The bands are by tier, because a bandit with a scrap harness has been
-- wearing it in the dirt and a Monolith carrier was looked after: a
-- cheap rig arrives nearly finished, a good one arrives worth mending.
-- ============================================================
local ROLL = {
	[1] = { 0.20, 0.55 },
	[2] = { 0.35, 0.70 },
	[3] = { 0.50, 0.85 },
}

function A.roll_cond(sec)
	local band = ROLL[A.rig_tier(A.rig_slots(sec))] or ROLL[1]
	return band[1] + math.random() * (band[2] - band[1])
end

-- ============================================================
-- WHERE IT CAME FROM IS THE QUESTION, NOT WHEN YOU GOT IT
--
--   "starting rig from new game loadout dont come at 100% durability
--    and that is just bad, same goes for rigs spawned with debug menu
--    item spawner"
--
-- Quite right, and buying one and crafting one had the same problem.
-- Every rig that arrived was aged, because the only moment the mod
-- looked was "it is in your hands now" - and that moment is the same
-- whether you pulled it off a body or the game handed it to you at the
-- start of a new life.
--
-- There IS a difference and the window is holding it. Looting a corpse
-- or a stash is the actor menu open in `loot` mode. Buying is `trade`.
-- Crafting is the workshop. The debug spawner is its own window. The
-- new game loadout is no window at all.
--
-- So: a rig that comes out of a body or a container is aged. Everything
-- else is issued kit and arrives whole.
--
-- WHAT IS NOT COVERED, said plainly rather than left to be found: a rig
-- lying loose on the ground, picked up with no window open, counts as
-- issued. Loose rigs are not something the world spawns - loot is in
-- bodies and boxes - so this is a corner rather than a hole, and it is
-- one line to change if it turns out otherwise.
-- ============================================================
function A.looting()
	local ui = rawget(_G, "ui_inventory")
	local gui = ui and ui.GUI
	if not gui then return false end

	local ok, shown = pcall(function() return gui:IsShown() end)
	if ok and shown == false then return false end

	return gui.mode == "loot"
end

-- Every rig gets ONE first sight, and this is it. After that it is the
-- engine's number like any other item's.
function A.age_found(obj)
	if not obj then return false end

	local ok, id = pcall(function() return obj:id() end)
	if not ok then return false end
	if A.rolled[id] then return false end

	local oks, sec = pcall(function() return obj:section() end)
	if not (oks and A.is_rig_sec(sec)) then return false end

	-- REMEMBERED WHATEVER HAPPENS NEXT. This is what stops a rig you
	-- crafted and left in your own stash being aged the day you take it
	-- out again - your stash is a container like any other and the
	-- window says `loot` about it.
	A.rolled[id] = true

	if not A.looting() then
		-- Issued, bought, made or spawned. Yours, and new.
		A.mine[id] = true

		local c = A.rig_cond(obj)
		if c >= 1 then return false end

		local set = pcall(function() obj:set_condition(1) end)
		if set then
			log("new rig %s (id %s) issued whole", tostring(sec), tostring(id))
		end
		return set
	end

	-- Off a body or out of a box. The MCM switch turns the whole idea
	-- off; with it off a looted rig keeps whatever it spawned with
	-- rather than being handed a fresh one.
	if not A.wear_loot then return false end
	if A.mine[id] then return false end

	-- ============================================================
	-- AND A RIG THAT ARRIVED ALREADY WORN IS LEFT AS IT IS
	--
	--   "i just picked up smersh-ak rig from a military dead npc. and
	--    its 73% durability but i think it was like 20% really damaged"
	--
	-- It was 29%, and the log has both halves next to each other:
	--
	--     saved condition for amprig_smersh 0.28999999
	--     [AMP] found rig amprig_smersh (id 30238) at 73%
	--     saved condition for amprig_smersh 0.72538286
	--
	-- TWO CONDITION SYSTEMS, and the second one won. A.drop_cond rolled
	-- 29% for that body - a master-rank army stalker, band 20-45 - and
	-- wrote it into the item's packet as it spawned. Then this
	-- function, which predates all of that, gave the rig its "first
	-- sight" roll and overwrote it with a number from a completely
	-- different ladder: ROLL is keyed by the RIG's tier and knows
	-- nothing about who was carrying it.
	--
	-- This roll exists because rigs used to arrive from loot at a
	-- hundred per cent. A rig that arrives at twenty-nine does not have
	-- that problem, and re-rolling it throws away the better answer:
	-- ours knows the rank AND the community, and this one cannot.
	--
	-- SO THE RULE IS ABOUT THE ITEM, NOT ABOUT US. Anything that
	-- arrives already worn was worn by somebody on purpose - our own
	-- death drop, another mod's loot conditioner, a hand-placed spawn -
	-- and a deliberate number is not something to improve on. Only a
	-- pristine rig gets the roll.
	--
	-- A MARK ON OUR OWN DROPS WOULD HAVE BEEN NARROWER AND WORSE. It
	-- would have to survive a save - the corpse keeps the rig until you
	-- come back for it - and it would still leave every other mod's
	-- deliberate condition being overwritten by this one.
	-- ============================================================
	local worn = A.rig_cond(obj)
	if type(worn) == "number" and worn < 0.995 then
		dbg("found rig %s (id %s) already at %d%% - left as it was",
		    tostring(sec), tostring(id), math.floor(worn * 100 + 0.5))
		return false
	end

	local c = A.roll_cond(sec)
	local set = pcall(function() obj:set_condition(c) end)
	if set then
		log("found rig %s (id %s) at %d%%", tostring(sec), tostring(id),
		    math.floor(c * 100 + 0.5))
	end
	return set
end

-- ============================================================
-- AND THE KIT YOU START WITH
--
-- The loadout is handed over before anything of this mod's is watching:
-- there is no take, so there is no first sight. This is that first
-- sight, run once per save on the first update, over everything already
-- in your hands - which on a new game is exactly the loadout, and on an
-- existing save is a rig you already own and have already been aged
-- for, so marking it seen changes nothing.
-- ============================================================
function A.claim_carried()
	local actor = db.actor
	if not (actor and A.enabled) then return 0 end

	local n = 0
	pcall(function()
		actor:iterate_inventory(function(_, o)
			-- BOTH RETURNS, not just pcall's. `pcall` answers true for
			-- "it did not throw", which every object in your inventory
			-- manages - so this counted the whole bag and called it
			-- "rigs claimed". The second value is age_found's own
			-- answer: whether it actually set a condition.
			local ok, did = pcall(A.age_found, o)
			if ok and did then n = n + 1 end
		end, actor)
	end)
	return n
end


-- ============================================================
-- WHAT A RIG IN YOUR BAG WEIGHS
--
--   "it also dont count weight of meds iside the rig"
--   "make everything weight work like for container boxes"
--
-- A rig you are not wearing holds RECORDS, and a record weighs
-- nothing to the engine because the object it describes was destroyed
-- when it went in. So this adds it back, and there is now ONE place
-- to add it back from:
--
--   A.hold[id][slotkey]   everything in every slot, and
--   A.pslot[id]           which POUCHES are fitted, which are items too
--
-- THAT IS THE FIX. It used to be four stores - the magazines, the
-- built-in med pocket, a med pocket per pouch slot, and the pouches -
-- and three of the four were added to this arithmetic one release
-- later than the store they weighed. Every "the weight is still
-- wrong" report was another store nobody had thought of here.
--
-- A SQUARE IS A STACK, not a thing. `of` is the packed pile and it has
-- one entry per item in the square, so five bandages in one square
-- weigh five bandages.
-- ============================================================
local function pile_n(of)
	if type(of) ~= "string" or of == "" then return 1 end
	local n = 1
	for _ in string.gmatch(of, ",") do n = n + 1 end
	return n
end

local function sec_kg(sec, n)
	if type(sec) ~= "string" then return 0 end
	local base = SYS_GetParam(2, sec, "inv_weight")
	if type(base) ~= "number" then return 0 end
	return base * (n or 1)
end

-- One slot's worth of records, in the shape A.pk_remember writes.
function A.slot_kg(t)
	if type(t) ~= "table" then return 0 end

	local w = 0
	for _, ent in pairs(t) do
		if type(ent) == "table" then
			w = w + sec_kg(ent.sec, pile_n(ent.of))
		end
	end
	return w
end

-- Everything a rig is carrying for us, whatever kind it is.
function A.stash_weight(id)
	if not id then return 0 end

	local w = 0

	-- EVERY SLOT, whatever the rig's shape is or has become. Walked as
	-- a map rather than through A.rig_slots_all, so a rig whose section
	-- changed shape under a mod update still weighs what it is holding
	-- instead of quietly shedding the slots that no longer exist.
	for _, t in pairs(A.hold[id] or {}) do
		w = w + A.slot_kg(t)
	end

	-- AND THE POUCHES THEMSELVES. A pouch fitted into a spare rig is an
	-- item that stopped existing exactly as a magazine does, so it left
	-- your shoulders exactly as one does.
	for _, sec in pairs(A.pslot[id] or {}) do
		w = w + sec_kg(sec, 1)
	end

	return w
end

-- ============================================================
-- AND MAKING THE GAME COUNT IT
--
--   "im puting thing into the rig and back in and the weight on my
--    character still changes"
--
-- set_weight changes the ITEM and nothing else. What you are carrying
-- is a CACHED SUM, and the engine recomputes it when the inventory
-- CHANGES - something taken, dropped, moved between ruck and belt -
-- not when a thing it already holds quietly becomes heavier.
--
-- The log said so outright, once the total was read either side of the
-- write:
--
--   rig 30238 weighs 3.75 (2.10 + 1.65 inside) | you: 35.53 -> 35.53
--   rig 30238 weighs 2.75 (2.10 + 0.65 inside) | you: 35.53 -> 35.53
--   rig 30238 weighs 3.75 (2.10 + 1.65 inside) | you: 37.18 -> 37.18
--
-- Never a change across the write. And then 35.53 to 37.18 between the
-- second line and the third: 1.65, which is exactly the rig going from
-- its SECTION weight of 2.10 to the 2.75 we had set, plus the 1.00
-- magazine that had just become a real object again. The engine had
-- been carrying the rig at its section weight the whole time and
-- picked ours up only when something else happened to make it recount.
--
-- So we make it recount. move_to_ruck on something already in the ruck
-- moves nothing and invalidates the total, which is the whole of what
-- is wanted.
--
-- ONLY SOMETHING YOU ARE CARRYING. On an object that is NOT yours this
-- call does not nudge a total, it MOVES THE THING - a rig in a stash
-- or on a corpse would be teleported into your bag by an arithmetic
-- that was only trying to add up. That guard is the one dangerous
-- thing here, which is why this is a named function with the guard
-- inside it rather than two lines copied into two callers.
--
-- AND ONLY WHEN THE NUMBER MOVED. Both callers reach this after their
-- own "nothing changed" test, so it is a few times a minute rather
-- than per frame.
-- ============================================================
function A.recount(obj)
	if not obj then return false end

	local okm, mine = pcall(function() return utils_item.in_actor_inv(obj) end)
	if not (okm and mine) then return false end

	return (pcall(function() db.actor:move_to_ruck(obj) end))
end

-- Put the number on the object. Called whenever the stash changes and
-- whenever a rig turns up that this mod has contents for.
function A.reweigh(id)
	if not id then return false end

	local obj = level.object_by_id(id)
	if not obj then return false end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and A.is_rig_sec(sec)) then return false end

	local base = SYS_GetParam(2, sec, "inv_weight")
	if type(base) ~= "number" then return false end

	local want = base + A.stash_weight(id)

	-- Only when it has actually moved, and never for the rig on your
	-- chest: that one's magazines are real objects in your inventory
	-- and are already being weighed by the engine.
	if A.rig_id == id then want = base end

	local okw, now = pcall(function() return obj:weight() end)
	if okw and type(now) == "number" and math.abs(now - want) < 0.001 then
		return false
	end

	-- ============================================================
	-- AND WHAT IT DID TO WHAT YOU ARE CARRYING
	--
	--   "im puting thing into the rig and back in and the weight on my
	--    character still changes"
	--
	-- The number on the ITEM is right - the log has it going up and
	-- down by exactly the right amount as things move in and out. What
	-- is not established is whether the engine folds that number into
	-- the actor's total at all, or only recounts on its own schedule.
	--
	-- Those two need completely different answers and nothing visible
	-- from Lua tells them apart, so the total is read either side of
	-- the write and both are logged. It is one engine call, on the rare
	-- pass where the weight actually changed, and only with Debug on.
	-- ============================================================
	local was
	pcall(function() was = db.actor:get_total_weight() end)

	local set = pcall(function() obj:set_weight(want) end)

	-- AND THE GAME IS MADE TO ADD IT UP AGAIN. See A.recount: the write
	-- above changes the item and nothing else.
	if set then A.recount(obj) end

	if set then
		local now2
		pcall(function() now2 = db.actor:get_total_weight() end)

		dbg("rig %s weighs %.2f (%.2f + %.2f inside) | you: %s -> %s",
		    tostring(id), want, base, want - base,
		    was and string.format("%.2f", was) or "?",
		    now2 and string.format("%.2f", now2) or "?")
	end
	return set
end

-- ============================================================
-- A RIG WEARS OUT, AND WHAT IT LOSES IS POCKETS
--
-- Condition is the ENGINE'S number, not one of ours: `use_condition` on
-- the section puts the bar on the icon and makes the game keep it in
-- the save, and `repair_type = outfit_light` means every sewing kit and
-- cloth glue in the game already mends one, with its own minimum
-- condition and its own parts window. Nothing of another mod is
-- patched, and nothing here has to know what a repair kit is.
--
-- WHAT DAMAGE TAKES IS THE BIG POCKETS. A drum pouch is a deep sleeve
-- with the most stitching and the most to tear; a pistol pouch is a
-- flap. So a worn rig degrades TOWARDS a cheap rig - you lose the thing
-- that made it worth carrying, and the ladder still means something
-- when you pull one off a corpse.
--
-- The steps are wide on purpose. A rig at 90% is a rig, not a fraction
-- of one; you feel this at the thresholds and nowhere else.
-- ============================================================
local TORN = {
	-- at or below this condition -> this many pockets are torn
	{ 0.80, 1 },
	{ 0.60, 2 },
	{ 0.40, 3 },
	{ 0.25, 4 },
	{ 0.10, 5 },
}

-- Which slot tears first: the BIGGEST, measured in squares, because
-- that is what the player misses most and because a rig wearing out
-- should cost you the drum pouch before it costs you a bandage
-- pocket. Reversed in the sort so the last entries are taken away.
--
-- BY AREA NOW, not by class name. A 2x2 is four squares and a 3x1 is
-- three, so they tear in that order without a table saying so - which
-- is the same trick as everything else in 3.0: the shape is the fact.
local function tear_weight(s)
	if type(s) ~= "table" then return 0 end
	return (s.w or 1) * (s.h or 1)
end

function A.rig_cond(obj)
	if not obj then return 1 end

	-- ONCE A FRAME PER OBJECT. The condition moves when you are shot at
	-- and not between two reads in one draw; the key is the object, so
	-- the rig on your chest and a rig on a tooltip get their own
	-- answers.
	if A.fc_on and A.once then
		return A.once("cond", obj, A.rig_cond_now)
	end
	return A.rig_cond_now(obj)
end

function A.rig_cond_now(obj)
	if not obj then return 1 end
	local ok, c = pcall(function() return obj:condition() end)
	if not (ok and type(c) == "number") then return 1 end
	if c < 0 then return 0 end
	if c > 1 then return 1 end
	return c
end

-- How many pockets a condition tears off.
function A.torn_count(cond)
	local n = 0
	for i = 1, #TORN do
		if cond <= TORN[i][1] then n = TORN[i][2] end
	end
	return n
end

-- WHICH pockets, by index into the flattened rig. Biggest class first,
-- and within a class the LAST one drawn - so what goes is the far end of
-- the row rather than a hole in the middle.
--
-- Pure, and given the list rather than reading A.rig, so the arithmetic
-- can be checked without a game.
function A.torn_at(flat, cond, bolted)
	local n = A.torn_count(cond)
	if n <= 0 or not flat then return {} end

	-- ============================================================
	-- A POUCH YOU BOLTED ON IS NOT PART OF THE RIG'S STITCHING
	--
	--   "when the pockets are torn and you add pouch to the rig then
	--    mags lots from pouches are torn instead or also they are torn
	--    alongside the rig pouches, sometimes if you add pouch the torn
	--    pocket goes to pouch slot and the rig slots gets fixed"
	--
	-- All three of those are one mistake. Torn pockets were chosen by
	-- index across the WHOLE flattened rig, and a fitted pouch adds its
	-- pockets to that list - so fitting one re-ran the arithmetic over a
	-- longer list and the answer moved. The rig looked mended because
	-- the tear had walked off the end of it and onto the pouch.
	--
	-- A pouch is a separate thing you strapped to a worn-out rig. It has
	-- its own condition and this rig's wear is not it, so its pockets
	-- never tear and never take a tear that belonged to the rig.
	-- ============================================================
	local order = {}
	for i = 1, #flat do
		if not (bolted and bolted[i]) then order[#order + 1] = i end
	end

	table.sort(order, function(a, b)
		local wa = tear_weight(flat[a])
		local wb = tear_weight(flat[b])
		if wa ~= wb then return wa > wb end
		return a > b
	end)

	local out = {}
	for i = 1, math.min(n, #order) do out[order[i]] = true end
	return out
end

function A.resolve_rig()
	-- ------------------------------------------------------------
	-- NOT WHILE THE WORLD IS STILL WAKING UP.
	--
	-- A rig that is worn but not yet readable resolves to no rig, no
	-- pockets - and validate then re-places every magazine into a rig
	-- that has no room, which is the bag. The last resolution stands
	-- until the object answers.
	-- ------------------------------------------------------------
	if A.rig_id and not A.rig_readable() then return end

	-- The ARMOUR still answers the non-rig-item path, where the outfit
	-- itself is what grants pockets. The RIG comes from the slot.
	local outfit = db.actor and db.actor:item_in_slot(7)
	local sec = outfit and outfit:section()
	local kind = sec and SYS_GetParam(0, sec, "kind")
	-- ONLY IN RIG-ITEM MODE. With the option off the armour itself is
	-- what grants pockets, and a rig in the slot must not be added on
	-- top of it - that would count the same gear twice.
	local pouch = A.rig_sec()

	-- The key is what the resolution DEPENDS on, so the rig is rebuilt
	-- exactly when one of those changes and not once a frame. Every
	-- setting that feeds the derivation clears the key outright rather
	-- than joining it, in refresh_settings.
	--
	-- THE FITTED POUCHES ARE PART OF IT. They feed rows_for, so leaving
	-- them out made this early-out lie: fitting one changed the answer
	-- and the key said nothing had changed, so the new pockets only
	-- appeared the next time you swapped armour.
	--
	-- AND WHAT THE CONDITION HAS DONE TO IT. Not the number - that moves
	-- every time you are shot at - but the two things derived from it:
	-- how many pockets have torn and how many pouch slots are still
	-- holding. Both change on a threshold, so a rig mended past 50%
	-- rebuilds itself and a rig worn within a band costs nothing.
	local cond = A.rig_cond(A.rig_obj())
	local key = tostring(sec) .. "|" .. tostring(kind) .. "|" .. tostring(pouch)
		.. "|" .. table.concat(A.fitted(A.rig_id), ",")
		.. "|" .. tostring(A.torn_count(cond))
		.. "|" .. tostring(A.slots_live(cond))
	if A.rig_key == key then return end
	A.rig_key = key

	local rows, src, nextra = A.rows_for(outfit, sec, kind, pouch)

	A.rig_src = src
	-- One line per resolve that names every window this panel is
	-- carrying, so "the icons are missing" can be told apart from "the
	-- cells were never built" without another round trip.
	dbg("built | pockets=%s cells=%s ovl=%s xml=%s",
		#A.rig,
		(function() local n = 0
			for _, c in pairs(A.cc and A.cc.cell or {}) do
				if c.ID then n = n + 1 end
			end
			return n
		end)(),
		(function() local n = 0
			for _ in pairs(A.ov_ammo or {}) do n = n + 1 end
			return n
		end)(),
		tostring(A.xml ~= nil))

	log("rig for %s (kind %s) from %s%s", tostring(sec), tostring(kind), src,
	    nextra > 0 and (" + pouch " .. tostring(pouch) .. " (" .. nextra .. " rows)") or "")

	-- Flattened, because a pocket is addressed by one index everywhere
	-- else: the cell pool, the saved state, the hit tests. GAPS ARE NOT
	-- POCKETS and are skipped here, so pocket indices stay contiguous
	-- however holey the drawing is - and the draw pass walks the rows in
	-- this same order, so index N here is the Nth pocket drawn.
	--
	-- AND WHERE EACH ONE CAME FROM. rows_for marks a pouch's rows as it
	-- appends them; that mark is carried down to the flat index here,
	-- because by the time anything asks "may this tear" the rows are
	-- long gone and there is only an index left.
	--
	-- A.rig[i] IS A SHAPE NOW, not a class name: { key, w, h, pouch }.
	-- Everything downstream reads .w and .h off it, and A.pk[i] is what
	-- is standing in it.
	local flat, bolted = {}, {}
	for r = 1, #rows do
		for c = 1, #rows[r] do
			local e = rows[r][c]
			if type(e) == "table" and #flat < MAX_SLOTS then
				flat[#flat + 1] = e
				if e.pouch then bolted[#flat] = true end
			end
		end
	end

	A.rows, A.rig, A.bolted = rows, flat, bolted

	-- ============================================================
	-- AND THE POCKETS ARE BUILT FROM WHAT WAS JUST DRAWN
	--
	-- A.pk[i] and A.rig[i] have to be the same slot: the draw pass, the
	-- hit tests and every input handler index them with one number.
	--
	-- They used to be built from two places - A.rig from the packed
	-- rows, A.pk from A.rig_slots_all - and they agreed only because
	-- the packer happens to preserve order. That is a promise no
	-- comment can keep: the day the packer sorts by height to make the
	-- panel shorter, every drop would land in a different slot from the
	-- one the player pointed at.
	--
	-- So resolve_pk reads A.rig, and the question cannot arise. It runs
	-- HERE, after the flatten, rather than before it.
	-- ============================================================
	A.resolve_pk()

	-- ------------------------------------------------------------
	-- AND THEN TAKE AWAY WHAT HAS TORN
	--
	-- The torn pockets are still IN A.rig - they are drawn, they just
	-- refuse everything - because a pocket that vanished would tell the
	-- player nothing about what mending the rig would give back. A.hole
	-- is what every other question asks.
	-- ------------------------------------------------------------
	A.hole = A.torn_at(flat, A.rig_cond(A.rig_obj()), bolted)

	-- ------------------------------------------------------------
	-- AND WHATEVER WAS IN ONE HAS TO LEAVE
	--
	-- The pocket just tore with a magazine in it. Emptied here and NOT
	-- placed here: reconcile adopts anything carried without a pocket
	-- into one that fits, and announces into the bag whatever fits
	-- nowhere - which is the path that already says so out loud. Doing
	-- it by hand would be a second copy of that decision.
	-- ------------------------------------------------------------
	local spilled = 0
	for i in pairs(A.hole) do
		local P = A.pk[i]
		if P and #P.slots > 0 then
			for e = #P.slots, 1, -1 do
				spilled = spilled + #(P.slots[e].ids or {})
				table.remove(P.slots, e)
			end
			A.pk_reindex(P)
			A.pk_sync(P)
		end
	end

	-- A POCKET THAT IS NOT THERE AT ALL is NOT handled here, and the
	-- first draft of this doing so was a bug. A pouch slot going dead
	-- takes its pockets off the end of the list - the same shape as
	-- swapping to a smaller rig - and reconcile already re-places what
	-- was in them and says "returned to your bag" about the rest. Doing
	-- it here as well announced a tear that had not happened.

	if spilled > 0 then
		log("rig torn: %d magazine(s) turned out of a torn pouch", spilled)
		notify("A pouch tore - what was in it is loose")
	end

	A.validate()
	A.reconcile()
end

-- Is this pocket torn? One question, asked by the fit test, the drop,
-- the draw and the hotkeys, so there is one answer.
function A.is_torn(i)
	return (A.hole and A.hole[i]) and true or false
end

-- ============================================================
-- THE RIG AND THE CARRIED SET ARE ONE SET
--
-- A magazine can enter the magazine mod's carried set without passing
-- through this panel: its own inventory context menu does it, and so
-- does the option that shifts a magazine ejected during a reload
-- straight into the loadout. Left alone, such a magazine would be
-- counted against the rig's capacity while occupying no pocket - the
-- panel would show empty space that nothing could be dropped into,
-- because room_in_pouch reads the count and not the pockets.
--
-- So: anything carried without a pocket is ADOPTED into a free one that
-- fits, and anything that fits nowhere is let go. After this runs the
-- two agree, which is what makes "the rig is your loadout" true rather
-- than merely intended.
--
-- Iteration is over a COPY - get_carried_mags copies into the table it
-- is handed - because uncarry mutates the real one.
-- ============================================================
function A.reconcile()
	if A.in_reconcile then return end

	-- The carried set is read from the magazine mod, and it is empty
	-- for the same moment the objects are. Reconciling against it while
	-- the world is waking up empties every pocket.
	if A.warming() then return end

	local mb = rawget(_G, "magazine_binder")
	if not (mb and type(mb.get_carried_mags) == "function") then return end

	A.in_reconcile = true

	-- ============================================================
	-- PRUNE FIRST. ALWAYS.
	--
	-- Loading a magazine into a weapon calls alife_release_id on it, so
	-- the pocket it came from points at an object that no longer exists.
	-- Until prune notices, this mod believes that pocket is occupied.
	--
	-- That is what made a full rig refuse the magazine the reload had
	-- just ejected: the magazine system correctly saw room - it had just
	-- dropped the loaded one from carried_mags - carried the ejected one,
	-- and then reconcile found "no free pocket" against a stale map and
	-- released it straight into the bag. The swap silently became a
	-- one-way trip.
	--
	-- Reconciling against pockets that have not been pruned is never
	-- right, so it is done here rather than at each call site, where it
	-- can be forgotten exactly once.
	-- ============================================================
	A.prune()

	local carried = {}
	if not pcall(mb.get_carried_mags, carried) then
		A.in_reconcile = false
		return
	end

	local adopted, released, dropped = 0, 0, 0

	-- ============================================================
	-- WHAT THE SAVE PUT BACK, TOLD TO THE MAGAZINE MOD, ONCE
	--
	--   "mags are getting unequipped from the rig on saveload"
	--
	-- THE BUG, AND IT WAS NEVER ABOUT TIMING. From the log that finally
	-- said it:
	--
	--   emptied pocket 2: mag_mp443_9x19_default id=29184
	--                     object=yes inv=yes carried=NO incoming=no
	--   ...and the magazine mod is carrying 0 in total
	--
	-- The magazines are there. They are in the actor's inventory. The
	-- magazine mod is carrying nothing, because nothing ever told it -
	-- A.carry is called in exactly one place in this file and that is
	-- A.put, the player dropping one in. load_state restores the map
	-- and carries none of it, so the first reconcile after every load
	-- finds pockets full of magazines that are not carried and empties
	-- all of them.
	--
	-- ONLY WHAT IS REALLY THERE. An object we cannot see, or one that
	-- is not in the actor's inventory, is not ours to claim - that is
	-- the level-change window.
	--
	-- IT CANNOT FIRE TODAY, and that is worth writing down rather than
	-- discovering twice. A.prune runs at the top of this function and
	-- drops exactly those two cases first, so every pocket still
	-- standing here already has a readable magazine in the actor's
	-- inventory. The mutations that loosen this test are caught by
	-- nothing and are retired in mut55.
	--
	-- It stays because the invariant it leans on lives in another
	-- function: today's "prune has already dealt with those" is a
	-- property of prune, and this is a statement about what this pass
	-- is willing to claim on the magazine mod's behalf. Claiming a
	-- magazine that is not there tells another mod something false.
	--
	-- WHILE IT IS CARRYING NOTHING, NOT ONCE PER LOAD. The first
	-- attempt at this was armed by the warm-up and spent on the first
	-- reconcile after it, and the debug lines showed why that is not
	-- enough: during ONE load the set was filled - `carried=2` - and
	-- then went back to zero while the level was still spawning. The
	-- one shot was spent in the good window and the clearing came
	-- after it.
	--
	-- And the magazine mod never picks them up again: every reconcile
	-- after that says `carried=0` for the rest of the session. So there
	-- is no moment to wait for. There is a STATE, and while it lasts we
	-- say the same thing again.
	--
	-- IT CONVERGES. Once told, the set is not empty, this stops
	-- happening, and everything downstream is as it always was.
	--
	-- "NOTHING AT ALL" IS THE TEST, and not "this one is missing". The
	-- emptying pass is for a magazine loaded INTO a weapon, which
	-- clears from the set synchronously - and in that case the set is
	-- not empty: the ejected magazine is in it and so is everything
	-- else on your chest. A set that is entirely empty while a rig is
	-- full is not a fact about any one magazine.
	--
	-- And the ordinary way out of a pocket is A.take, which clears the
	-- pocket first and un-carries second, so a magazine the player
	-- removes never reaches this loop at all.
	--
	-- ------------------------------------------------------------
	-- ON THE FIRST PASS, AND THE LOG IS WHY
	--
	-- The version before this one waited for the set to be empty TWICE
	-- running, to protect a player with a single magazine loading it
	-- into a weapon. The log killed that idea:
	--
	--     reconcile: pockets=2 carried=2 ... dropped=0
	--     emptied pocket 1 ... carried=NO
	--     ...and the magazine mod is carrying 0 in total
	--
	-- The set goes from two to nothing and the damage is done on the
	-- very first pass of nothing. Waiting for a second one means never
	-- acting at all - which is exactly what happened, and there is no
	-- "told it about" line anywhere in that log to show for it.
	--
	-- AND THE CASE THE WAIT WAS PROTECTING DOES NOT HAPPEN. In a whole
	-- session of that log the emptying pass fires exactly twice, both
	-- times during a load; every reload in between shows dropped=0.
	-- Prune is what catches a magazine that has gone into a weapon,
	-- because its object really does go away - so the worst this costs
	-- is that such a pocket is emptied a frame later, by prune, instead
	-- of here.
	-- ------------------------------------------------------------
	if next(carried) == nil and A.count_slots() > 0 then
		local told = 0
		A.pk_each(function(_, P)
			for e = 1, #P.slots do
				local ent = P.slots[e]
				-- ONLY MAGAZINES. The carried set is the magazine mod's
				-- and a bandage has no business in it - claiming one
				-- would tell another mod something false about an item
				-- it does not handle.
				if A.is_mag(ent.sec) then
					for k = 1, #ent.ids do
						local id = ent.ids[k]
						local obj = level.object_by_id(id)

						local inv = false
						if obj and utils_item and utils_item.in_actor_inv then
							local ok, res = pcall(utils_item.in_actor_inv, obj)
							inv = (ok and res) and true or false
						end

						if obj and inv then
							A.carry(id)
							-- Into this pass's own copy as well, or the
							-- loop below empties the pocket we have
							-- just claimed.
							carried[id] = true
							told = told + 1
						end
					end
				end
			end
		end)

		if told > 0 then
			log("the magazine mod was carrying nothing - told it about "
			    .. "%d magazine(s) in pockets", told)
		end
	end

	-- ============================================================
	-- THE CARRIED SET IS THE CONTAINER. THE RIG IS ITS VIEW.
	--
	-- A pocket holding a magazine that is no longer carried is a pocket
	-- that should be empty, and waiting for prune to notice is not good
	-- enough: loading a magazine into a weapon clears it from
	-- carried_mags SYNCHRONOUSLY, inside load_weapon, but only calls
	-- alife_release_id on the object - which is still there, still in the
	-- actor's inventory, for the rest of that frame. Prune sees a live
	-- object and keeps the pocket.
	--
	-- That is why the rig still looked full at the exact moment the
	-- ejected magazine asked for a pocket, and why it went to the bag
	-- instead of swapping. Following carried_mags closes that window
	-- because carried_mags is already correct when the question is asked.
	--
	-- It also makes the two impossible to disagree, which is the whole
	-- class of "a magazine appears in the bag for no visible reason".
	-- ============================================================
	-- A magazine the rig is handing back is NOT carried yet: it is a
	-- server object waiting for the engine, and it cannot be told it is
	-- carried until the client object exists. Without this exception
	-- reconcile emptied every pocket restore_pockets had just filled,
	-- and the magazine came back a moment later through the adopt loop
	-- below - into a different pocket, or into the bag when the rig had
	-- filled up meanwhile. Which is what "the mags end up in my
	-- inventory" looked like from the outside.
	-- ============================================================
	-- AND WHEN ONE IS EMPTIED, WHY
	--
	-- Two fixes have been shipped at "the magazines come out of my rig
	-- on a save load" and neither of them worked, because both were
	-- reasoned from when things happen rather than from what the game
	-- actually said. So this says it.
	--
	-- Every field can change the answer:
	--
	--   object=no    the magazine is gone, and emptying is correct
	--   inv=no       it exists but is not in the actor's inventory,
	--                which is the level-change window
	--   carried=no   the magazine mod, asked about THIS magazine
	--                rather than read out of a snapshot, says it is
	--                not carrying it
	--   total=0      ...and it says that about everything, which is a
	--                mod that has not restored its set yet
	--
	-- The last two want opposite fixes and have looked identical in
	-- every log so far.
	--
	-- NOT behind the debug switch. A player should not have to know
	-- there is one, and the whole point is the log that arrives without
	-- being asked for.
	-- ============================================================
	local said = 0

	-- ONLY MAGAZINES ARE FOLLOWED. Everything else in a rig is not in
	-- the carried set and never will be, so testing it against that set
	-- would empty every slot holding a bandage on every pass.
	local out = {}

	for i = 1, #A.pk do
		local P = A.pk[i]
		for e = 1, (P and #P.slots or 0) do
			local ent = P.slots[e]
			if A.is_mag(ent.sec) then
				for k = 1, #ent.ids do
					local id = ent.ids[k]
					if not carried[id] and not A.incoming[id] then
						out[#out + 1] = { P, id, i }
					end
				end
			end
		end
	end

	for q = 1, #out do
		local P, id, i = out[q][1], out[q][2], out[q][3]

		-- Eight is enough to see the shape of it and few enough that a
		-- rig emptying every frame cannot fill a log.
		if said < 8 then
			said = said + 1

			local obj = level.object_by_id(id)
			local sec = obj and obj:section() or "?"

			local inv = false
			if obj and utils_item and utils_item.in_actor_inv then
				local ok, res = pcall(utils_item.in_actor_inv, obj)
				inv = (ok and res) and true or false
			end

			local mine
			pcall(function() mine = mb.is_carried_mag(id) end)

			log("emptied slot %s: %s id=%s object=%s inv=%s "
			    .. "carried=%s incoming=%s",
			    tostring(i), tostring(sec), tostring(id),
			    obj and "yes" or "NO", inv and "yes" or "NO",
			    mine and "yes" or "NO",
			    A.incoming[id] and "yes" or "no")
		end

		A.pk_drop(P, id)
		dropped = dropped + 1
	end

	if dropped > 0 then
		local total = 0
		for _ in pairs(carried) do total = total + 1 end
		log("...and the magazine mod is carrying %s in total", tostring(total))
	end

	for id in pairs(carried) do
		if type(id) == "number" and not A.pk_holds(id) then
			local obj = level.object_by_id(id)
			local sec = obj and obj:section()
			local placed = false

			if sec and A.is_mag(sec) then
				-- The same door the drop uses, so a magazine that
				-- arrives through the keybind lands where a dragged one
				-- would.
				placed = A.slot_put(id, sec) and true or false
				if placed then adopted = adopted + 1 end
			end

			if not placed then
				A.uncarry(id)
				released = released + 1
			end
		end
	end

	-- What the grid filter will hide. Taken here so that one refresh
	-- makes one decision: the filter never asks a second time and never
	-- gets a different answer than the reconcile it followed.
	A.carried_now = carried

	A.in_reconcile = false

	if adopted > 0 or released > 0 or dropped > 0 then
		log("reconcile: %d adopted, %d released, %d pockets emptied",
		    adopted, released, dropped)
	end
	dbg("reconcile: pockets=%d carried=%d adopted=%d released=%d dropped=%d",
	    A.count_slots(), A.count_carried(), adopted, released, dropped)
end

-- ============================================================
-- A GUN WITH NO MAGAZINE RELOADS OUT OF THE RIG
--
--   "guns that dont use magazines like self loaded shoutguns would
--    need ammo to be put inside the rig to be loaded. reloading will
--    be blocked if there is no ammo in the rig."
--   "Only guns with no magazine at all"
--
-- WHICH GUNS. Not a list and not a keyword: the magazine mod already
-- decides, every frame, which weapons it handles - is_supported_weapon
-- - and a gun it does NOT handle is exactly a gun with no magazine.
-- Pumps, self-loaders, revolvers, bolt rifles. Asking it means a gun
-- added by any mod is classified the day it is added, and a gun the
-- magazine mod learns to handle stops being our business on the same
-- day.
--
-- NO MAGAZINE MOD, NO GATE. With nothing to ask, every gun would look
-- like a gun with no magazine and the rig would gate all reloading in
-- the game. Failing open is the only safe direction here.
--
-- WHY THE KEY AND NOT THE RELOAD. actor_on_weapon_reload fires when
-- the reload has already started; the only door that can refuse one is
-- on_before_key_press, whose flags.ret_value the engine reads. That is
-- the same door the magazine mod itself hooks to take reloading over
-- for the guns it does handle, so the two are doing the same thing on
-- either side of one line.
--
-- IT IS A SETTING, and it defaults ON because it was asked for. A
-- player who finds it too harsh turns it off and shotguns reload out
-- of the bag again.
-- ============================================================
function A.ammo_for(wpn)
	if not wpn then return nil end

	local sec
	pcall(function() sec = wpn:section() end)
	if type(sec) ~= "string" then return nil end

	local list = SYS_GetParam(0, sec, "ammo_class")
	if type(list) ~= "string" then return nil end

	local out = {}
	for one in list:gmatch("[^,%s]+") do out[#out + 1] = one end
	return (#out > 0) and out or nil
end

function A.rig_has_ammo_for(wpn)
	local kinds = A.ammo_for(wpn)
	if not kinds then
		-- A gun whose ammunition cannot be read is a gun this has no
		-- business refusing.
		return true
	end

	for i = 1, #kinds do
		if A.pk_sec_has(kinds[i]) then return true end
	end
	return false
end

function A.reload_gate(key, bind, dis, flags)
	if not (A.enabled and A.ammo_gate) then return end
	if type(flags) ~= "table" then return end
	-- rawget, because key_bindings is an engine table and a bare read
	-- of a name this file does not define is what the audit calls an
	-- accidental global - rightly: the day it is not there, a plain
	-- read is a crash inside a key handler.
	local kb = rawget(_G, "key_bindings")
	if not (kb and bind == kb.kWPN_RELOAD) then return end
	if not db.actor then return end

	local mb = rawget(_G, "magazine_binder")
	if not (mb and type(mb.is_supported_weapon) == "function") then return end

	local wpn
	pcall(function() wpn = db.actor:item_in_slot(db.actor:active_slot()) end)
	if not wpn then return end

	-- A gun the magazine mod handles is a gun with a magazine, and the
	-- magazines are already gated by the rig - by that mod, through
	-- room_in_pouch and the carried set. Not ours.
	local ok, handled = pcall(mb.is_supported_weapon, wpn)
	if not ok or handled then return end

	if A.rig_has_ammo_for(wpn) then return end

	flags.ret_value = false
	notify("No ammunition for that in your rig")
	dbg("reload refused: nothing in the rig for %s",
	    tostring(wpn:section()))
end

function A.on_reload()
	if not A.enabled then return end

	-- AND AGAIN NEXT FRAME. The magazine mod fires this callback before
	-- the ejected magazine is carried, so the reconcile below cannot
	-- see it yet and the throttle would hide it in the bag for half a
	-- second. See A.on_update.
	A.sync_soon = true
	local ok, err = pcall(function()
		A.resolve_rig()
		A.reconcile()
	end)
	dbg("reload | pockets=%s carried=%s%s", A.count_slots(), A.count_carried(),
	    ok and "" or " ERROR: " .. tostring(err))
end

local SYNC_MS = 500

-- ============================================================
-- THE FOLEY: EVERY POCKET ACTION MAKES ITS LITTLE NOISE
--
--   "i think the sounds will lift the enjoyment of inventory
--    management with this mod."
--
-- Nothing here ships a sound file. GAMMA already carries the right
-- ones - Mags Redux's pouch foley, seven takes of each direction so
-- it never sounds like a sample - and every item section carries its
-- own snd_on_take, the voice the game gives it on pickup. This
-- borrows both: fabric for the pockets and windows, the item's own
-- voice for landing in a box.
--
-- THROTTLED PER KIND, 150ms: a stack of twenty going into a box asks
-- box_put twenty times in one frame, and one thump is the truth of
-- what the player did. Twenty is a drum roll.
--
-- EVERY PLAY IS BEHIND pcall AND THE amp_sounds SWITCH. A missing
-- file, a missing xr_sound, a nil actor - none of them may cost the
-- action they were decorating. The sound is garnish; the move is
-- the meal.
-- ============================================================
A.sndat = A.sndat or {}

local SFX_GAP = 150

-- The one pair of hands on the tape deck: every voice below goes
-- through here, so the volume knob and the pcall armour are written
-- once. The volume is set AFTER play, which is the order the game's
-- own pickup-sound script uses - the engine takes it either way.
local function sfx_play(path)
	pcall(function()
		local s = xr_sound.get_safe_sound_object(path)
		if s then
			s:play(db.actor, 0, sound_object.s2d)
			s.volume = A.sndvol or 1
		end
	end)
end

function A.sfx(kind)
	if not A.snd_on then return end
	if not (db and db.actor) then return end

	local now = time_global()
	if A.sndat[kind] and now - A.sndat[kind] < SFX_GAP then return end
	A.sndat[kind] = now

	local path
	if kind == "in" then
		path = "mags_redux\\generic_mag_pouch_in" .. math.random(7)
	elseif kind == "out" then
		path = "mags_redux\\generic_mag_pouch_out" .. math.random(7)
	elseif kind == "shuffle" then
		-- "moving stuff in the invetory ... a quick shuffle shound" -
		-- the game's own heavy-cloth rummage, for a thing settling
		-- into a new square.
		path = "interface\\items\\inv_items_cloth_" .. math.random(2)
	elseif kind == "rotate" then
		-- NOT the shuffle: "it doesnt fit rotation, it should be more
		-- subtle and universal for any item". The game's own slot
		-- click - quiet, short, and about no material in particular.
		path = "interface\\inv_slot"
	end
	if not path then return end

	sfx_play(path)
end

-- A box put speaks with the ITEM'S voice - the same snd_on_take the
-- game plays when you pick it up, so a medkit sounds like a medkit
-- and a can of tourist's delight sounds like dinner. Sections
-- without one fall back to the pouch fabric.
function A.sfx_item(sec)
	if not A.snd_on then return end
	if not (db and db.actor) then return end

	local now = time_global()
	if A.sndat.item and now - A.sndat.item < SFX_GAP then return end
	A.sndat.item = now

	-- WHAT snd_on_take ACTUALLY IS: a TYPE - "kit", "tincan", "ammo" -
	-- not a theme and not a file. Handing it to xr_sound.set_sound_play
	-- was the first build's mistake: the call swallowed it whole,
	-- reported success, and the fallback never ran - which is why "i
	-- dont think there is sounds for items getting put into a box".
	--
	-- GAMMA's own pickup-sound script (itms_manager_snd_on_take,
	-- Oleh's) maps each type to its files, so the honest thing is to
	-- ask ITS table: same voices the game plays on pickup, and a new
	-- type in a future update is picked up for free. Read as a bare
	-- global on purpose - the script loader is lazy and rawget lies
	-- about scripts nothing has touched yet - and behind pcall, so a
	-- plain Anomaly without the script falls through to the fabric.
	local ty
	do
		local ok, r = pcall(SYS_GetParam, 0, sec, "snd_on_take")
		if ok and type(r) == "string" and r ~= "" and r ~= "nil" then
			ty = r
		end
	end

	local path
	if ty then
		pcall(function()
			local map = itms_manager_snd_on_take.snd_on_take
			local e = map and map[ty]
			-- Weapons split by their kind, exactly as that script does.
			if ty == "weapon" and map then
				local k = SYS_GetParam(0, sec, "kind")
				e = map[k or "w_rifle"] or e
			end
			if type(e) == "table" and type(e[1]) == "string" then
				if #e == 1 then
					path = e[1]
				else
					path = e[1] .. tostring(math.random(e[2], e[3]))
				end
			end
		end)
	end

	sfx_play(path or ("mags_redux\\generic_mag_pouch_in" .. math.random(7)))
end

-- ============================================================
-- A BOX IS NOT A POUCH
--
--   "i like the box opening and cloasing but the sound is more like
--    its a stiff bag more that a blastic/metal box"
--
-- Each box section says what it is made of - amp_box_snd = metal /
-- plastic / cloth in mod_system_amp_boxes.ltx - and an unmarked one
-- is plastic, because most of these are cases. The files are the
-- pickup voices of things MADE of that stuff: metal furniture for
-- the clunk of a latched steel case, the hard first-aid kit for a
-- plastic one, and the wallet keeps its fabric.
-- ============================================================
function A.sfx_case(bsec, dir)
	if not A.snd_on then return end
	if not (db and db.actor) then return end

	local now = time_global()
	if A.sndat.case and now - A.sndat.case < SFX_GAP then return end
	A.sndat.case = now

	local mat
	do
		local ok, r = pcall(SYS_GetParam, 0, bsec, "amp_box_snd")
		if ok and type(r) == "string" then mat = r end
	end

	if mat == "cloth" then
		sfx_play("mags_redux\\generic_mag_pouch_"
			.. (dir == "open" and "out" or "in") .. math.random(7))
	elseif mat == "chest" then
		-- "should be more 'chesty' sound maybe with like a click" -
		-- the game's own ammo-container foley, cut to size and
		-- SHIPPED with the mod (the first sound files it carries):
		-- the originals are four seconds of handling each.
		sfx_play(dir == "open" and "amp\\chest_open"
			or "amp\\chest_close")
	elseif mat == "metal" then
		sfx_play("interface\\items\\inv_items_metalfurniture_"
			.. math.random(2))
	else
		sfx_play(dir == "open" and "interface\\items\\inv_items_kit_1"
			or "interface\\items\\inv_items_cont_1")
	end
end

-- ============================================================
-- HOVER A BOX LONG ENOUGH AND IT OPENS ITSELF
--
--   "if item that can be put into a box gets hovered over that box
--    for at least 2sec (option in mcm to change that timer) then the
--    box window opens automaticly and gets closed when the item is
--    put inside or moved somewhere else or dropped somewhere else."
--
-- The dwell rides grid_box_wants - the drop's own gates, the same
-- answer the white glow draws from - so the window only opens for a
-- box the drop would land in. What THIS opened is remembered in
-- A.hovopen and closed when the drag ends, however it ends; a window
-- the player opened by hand is not in the table and never touched.
-- ============================================================
A.hovopen = A.hovopen or {}

function A.box_hover_tick()
	if not (A.boxhover and A.boxhover > 0) then
		A.hovbox = nil
		return
	end

	-- ui_inventory.GUI directly, NOT gui_now: that helper is a local
	-- declared further down the file, so a call from up here compiles
	-- as a global lookup and is nil at run time.
	local gui = ui_inventory and ui_inventory.GUI
	local holdk = gui and gui.item_in_hold
	local src = holdk and gui.CC and gui.CC[holdk]
	local idx = src and src.hold and src.hold.idx
	local obj
	if idx then
		pcall(function() obj = src:GetObj(idx) end)
	end

	if not obj then
		-- The drag is over - into the box, onto a square, onto the
		-- floor. Whatever this opened closes with it.
		A.hovbox = nil
		if next(A.hovopen) then
			for id in pairs(A.hovopen) do
				local k = A.win_of(id)
				if k then
					A.win_close(k, "the drag it opened for is over")
				end
			end
			A.hovopen = {}
			local g = ui_inventory and ui_inventory.GUI
			if g and g.On_Item_Update then
				pcall(function() g:On_Item_Update() end)
			end
		end
		return
	end

	-- The same question the glow asks, through the same door.
	local cc = A.bag_cc()
	local sec
	pcall(function() sec = obj:section() end)

	local bid
	if cc and holdk == cc.ID and type(sec) == "string" then
		bid = grid_box_wants(cc, sec, obj)
	end

	if type(bid) ~= "number" then
		A.hovbox = nil
		return
	end

	local now = time_global()
	if not (A.hovbox and A.hovbox.id == bid) then
		A.hovbox = { id = bid, since = now }
		return
	end

	if now - A.hovbox.since < A.boxhover * 1000 then return end

	-- Long enough. Once per hover: a player who closes it mid-drag
	-- has answered, and the dwell does not argue.
	A.hovbox.since = now + 86400000

	if A.win_of(bid) then return end       -- already open, by hand

	local box = level.object_by_id(bid)
	if box and A.win_open(box) then
		A.hovopen[bid] = true
		dbg("box: hovered open %s after %ss", tostring(bid),
		    tostring(A.boxhover))
		local g = ui_inventory and ui_inventory.GUI
		if g and g.On_Item_Update then
			pcall(function() g:On_Item_Update() end)
		end
	end
end

function A.on_update()
	if not A.enabled then return end

	-- NOT THROTTLED. A magazine handed back out of a rig has a server
	-- object and no client one yet, and until it turns up its pocket
	-- points at something the game cannot see. The check costs one
	-- `next` on an empty table, which is what it is on nearly every
	-- frame of the game.
	local ok0, err0 = pcall(A.settle_incoming)
	if not ok0 then log("!settle: %s", tostring(err0)) end

	-- ...AND THE SAME FOR A MAGAZINE WAITING OUT OF SIGHT FOR A POCKET.
	-- Unthrottled for the same reason: the pocket frees on the frame
	-- the loaded magazine is consumed, and next frame is the difference
	-- between never showing it and showing it for a moment.
	--
	-- BEFORE THE RECONCILE, WHICH COSTS ONE FRAME AND IS FINE. The
	-- reconcile below is what empties the pocket of the magazine that
	-- went into the gun, so this sees it still occupied on that frame
	-- and takes it on the next. That frame is spent HIDDEN, which is
	-- the whole point of waiting - there is nothing to see. Moving this
	-- after the reconcile would save a frame nobody can perceive and
	-- put it inside the half-second throttle, which is worse.
	local okh, errh = pcall(A.settle_held)
	if not okh then log("!held: %s", tostring(errh)) end

	-- ...AND THE MEDICINE THE QUICK-USE GATE REDIRECTED. The gate
	-- refuses a bag copy and names the pocket's own; this is where that
	-- one is actually used. Unthrottled and next to the two above: a
	-- bandage one frame late is a bandage, and a bandage half a second
	-- late is a key that did not work.
	local okm, errm = pcall(A.med_settle_eat)
	if not okm then log("!med use: %s", tostring(errm)) end

	-- The box-hover dwell, unthrottled: seconds are counted in frames,
	-- and the close must land on the frame the drag ends.
	local okb2, errb2 = pcall(A.box_hover_tick)
	if not okb2 then log("!box hover: %s", tostring(errb2)) end

	-- What is on your arm, asked of the mod that put it there.
	local okw, errw = pcall(A.wd_tick)
	if not okw then log("!wearable devices: %s", tostring(errw)) end

	local now = time_global()
	-- time_global resets across a level load, so a stamp from before the
	-- load is in the future. Zeroing it would still cost a full interval
	-- of being out of step on the frame the level changed, which is
	-- exactly when the rig most needs re-checking.
	-- A clock that went backwards is a level load, and a level load
	-- hands the objects over again a moment later - the same warm-up a
	-- save needs.
	if now < A.last_sync then
		A.last_sync = now - SYNC_MS
		A.warm_up()
	end
	-- ============================================================
	-- ...UNLESS A RELOAD HAS JUST ASKED FOR ONE
	--
	--   "when reloading the mag from the weapon goes for a sec into
	--    invetory and then back to rig and when that happens an ammo
	--    gets resorted in inventory"
	--
	-- The ejected magazine becomes carried, has no pocket, and the
	-- adopt below gives it one. The trouble is WHEN: A.on_reload runs
	-- on the magazine mod's own callback, which fires before the
	-- ejected magazine is carried, so nothing is adopted there and it
	-- waits for the next throttled sync - half a second.
	--
	-- For that half second it is an ordinary item in the bag: it
	-- appears in the inventory, the grid lays itself out around it, and
	-- then it goes into a pocket and the grid lays itself out again.
	--
	-- So a reload asks for the NEXT FRAME. Not this one - this one is
	-- too early, which is the whole problem - and not every frame,
	-- which is what dropping the throttle would cost.
	-- ============================================================
	if A.sync_soon then
		A.sync_soon = nil
	elseif now - A.last_sync < SYNC_MS then
		return
	end
	A.last_sync = now

	local ok, err = pcall(function()
		A.resolve_rig()
		A.reconcile()
	end)
	if not ok then log("!update sync failed: %s", tostring(err)) end

	-- EVERY RIG THIS MOD IS HOLDING CONTENTS FOR. On the throttle, not
	-- every frame: a weight is only wrong after something moved, and
	-- reweigh does nothing at all when the number has not changed.
	local okw, errw = pcall(A.reweigh_all)
	if not okw then log("!reweigh: %s", tostring(errw)) end
end


-- ============================================================
-- EVERY RIG WE ARE HOLDING ANYTHING FOR
--
--   "it also dont count weight of meds iside the rig"
--
-- This used to walk four stores and get one of them wrong every time
-- a fifth was added: a rig carrying nothing but bandages was never
-- visited at all, and the throttle that exists to catch a weight
-- nobody reweighed by hand could not catch it either. A rig with one
-- magazine and forty bandages was half right, which is worse - it
-- looked like it worked.
--
-- There are two now, and one of them is only the pouches: A.hold is
-- everything a rig is holding, whatever kind it is.
-- ============================================================
function A.reweigh_all()
	local seen = {}
	local function rig(id)
		if id and not seen[id] then seen[id] = true A.reweigh(id) end
	end

	for id in pairs(A.hold) do rig(id) end
	for id in pairs(A.pslot) do rig(id) end

	for id in pairs(A.boxes or {}) do A.box_reweigh(id) end
end

-- The cheap half of reconcile: empty any pocket whose magazine the
-- magazine system no longer carries. No table copy, no adoption pass -
-- one lookup per filled pocket.
--
-- This is what room_in_pouch needs and all it needs. That call happens
-- on every reload and while inventory menus are built, so running a full
-- reconcile there was work repeated far more often than anything could
-- change.
function A.sync_pockets()
	local mb = rawget(_G, "magazine_binder")
	if not (mb and type(mb.is_carried_mag) == "function") then return 0 end

	-- ONLY MAGAZINES. Everything else in a rig - meds, ammunition,
	-- oddments - has no carried set to be dropped from, and asking
	-- about one would empty the slot it was standing in.
	local n = 0
	local drop = {}

	for i = 1, #A.pk do
		local P = A.pk[i]
		for e = 1, (P and #P.slots or 0) do
			local ent = P.slots[e]
			if A.is_mag(ent.sec) then
				for k = 1, #ent.ids do
					local id = ent.ids[k]
					local ok, carried = pcall(mb.is_carried_mag, id)
					if ok and not carried then drop[#drop + 1] = { P, id } end
				end
			end
		end
	end

	for k = 1, #drop do
		A.pk_drop(drop[k][1], drop[k][2])
		A.carried_now[drop[k][2]] = nil
		n = n + 1
	end

	if n > 0 then dbg("sync_pockets emptied %d", n) end
	return n
end

function A.count_slots()
	local n = 0
	for i = 1, #A.pk do n = n + A.pk_count(A.pk[i]) end
	return n
end

function A.count_carried()
	local n = 0
	for _ in pairs(A.carried_now) do n = n + 1 end
	return n
end

-- ============================================================
-- A POCKET THAT NO LONGER EXISTS MUST NOT HOLD A MAGAZINE
--
-- Change armour and the rig changes under whatever is already in it.
-- A magazine left in a pocket that is gone - or that is now too small
-- for it - would stay hidden from the inventory grid with no way to
-- reach it, which is the worst failure this mod can produce.
-- ============================================================
-- ============================================================
-- WHEN THE RIG SHRINKS, THE BIGGEST MAGAZINES KEEP THEIR POCKETS
--
-- This used to walk the pockets in index order and drop any whose
-- pocket had gone or no longer fitted. Which magazine survived was
-- therefore decided by which pocket number it happened to be in: take
-- a mag pouch off an armour that had two large pockets, one holding a
-- drum and one holding a rifle magazine, and whether you kept the drum
-- was luck.
--
-- The rig is re-placed instead, LARGEST MAGAZINES FIRST, so a drum
-- claims a large pocket before anything smaller can sit in one; and
-- within that, each magazine still takes the smallest pocket it fits,
-- so a rifle magazine does not squat in a large pocket while a medium
-- one is free. Whatever finds no pocket goes back to the bag.
--
-- Ties break on the pocket a magazine was already in, so this is
-- deterministic and magazines keep their relative order rather than
-- shuffling every time the rig is resolved.
-- ============================================================
function A.validate()
	-- Nothing is re-placed while the world is waking up: a thing whose
	-- object cannot be read yet has no section, fits nowhere, and would
	-- be announced into a bag it never reached.
	if A.warming() then return end

	-- ------------------------------------------------------------
	-- NOTHING MOVES UNLESS SOMETHING HAS TO
	--
	-- Re-placing on every call would undo the player's own choices -
	-- dropping something on a PARTICULAR square is allowed to beat the
	-- packer, and validate runs on every resolve. So the common case,
	-- everything still standing in a slot that exists and still holds
	-- it, returns without touching a thing.
	--
	-- TWO WAYS TO BE WRONG, and only two:
	--
	--   AN ORPHANED KEY. The store still has entries under a slot name
	--   the rig no longer has - you pulled the pouch that granted it,
	--   or swapped to a rig with a different shape. Those objects are
	--   real and in your inventory with nothing holding them.
	--
	--   A SLOT THAT TORE. It is still drawn and still refuses
	--   everything, so what was in it has to leave.
	--
	-- A thing cannot stop FITTING a slot it is already in: a slot's
	-- size is fixed by its name, so if the name is still there the
	-- rectangle is the same rectangle.
	-- ------------------------------------------------------------
	local live = {}
	for i = 1, #A.pk do live[A.pk[i].key] = i end

	local loose = {}

	-- The orphans first, and they are read off `wear` rather than off
	-- the pockets - a pocket is only built for a slot the rig HAS, so
	-- an orphaned key has no pocket to be found through.
	for key, t in pairs(A.wear) do
		if not live[key] then
			for e = 1, #t do
				-- Same reason as the one in A.pk_remember: a hole is
				-- skipped rather than indexed.
				local ids = t[e] and t[e].ids or {}
				for k = 1, #ids do loose[#loose + 1] = ids[k] end
			end
			A.wear[key] = nil
		end
	end

	-- ...then anything sitting in a slot that has torn.
	for i = 1, #A.pk do
		if A.is_torn(i) then
			local P = A.pk[i]
			for e = #P.slots, 1, -1 do
				local ids = P.slots[e].ids or {}
				for k = 1, #ids do loose[#loose + 1] = ids[k] end
				table.remove(P.slots, e)
			end
			A.pk_reindex(P)
			A.pk_sync(P)
		end
	end

	if #loose == 0 then return end

	-- ------------------------------------------------------------
	-- WHAT IS LOOSE GOES BACK IN IF IT FITS ANYWHERE
	--
	-- Biggest first, because a 2x2 has one place it can go and a 1x1
	-- has twenty: placing the small things first fills the drum pocket
	-- with bandages and leaves the drum in your bag.
	--
	-- ANYTHING WAITING ON THE ENGINE IS LEFT ALONE. A thing the rig has
	-- just handed back has no client object for a frame or two, so this
	-- pass would read its section as nil, find it fits nowhere and
	-- announce that it had gone back to the bag - a thing that had not
	-- even arrived yet. That is what printed "1 magazine returned to
	-- your bag" every time you swapped rigs.
	-- ------------------------------------------------------------
	local want = {}
	for k = 1, #loose do
		local id = loose[k]
		local obj = level.object_by_id(id)
		local sec = obj and obj:section()
		if sec then
			local w, h = A.cells(sec)
			want[#want + 1] = { id = id, sec = sec, area = (w or 1) * (h or 1) }
		elseif not A.incoming[id] then
			A.uncarry(id)
		end
	end

	table.sort(want, function(x, y) return x.area > y.area end)

	local freed = 0
	for k = 1, #want do
		if not A.slot_put(want[k].id, want[k].sec) then
			A.uncarry(want[k].id)
			freed = freed + 1
		end
	end

	if freed > 0 then
		notify("%d thing%s returned to your bag", freed, freed == 1 and "" or "s")
	end
end

-- A magazine's own size class, defaulting to the smallest so an
-- unfamiliar magazine is never given a pocket it might not deserve.
function A.mag_class(sec)
	-- SHAPE OVERRULES THE LABEL. Eight magazines in the reference
	-- install are one cell wide and three tall, and the magazine mod
	-- calls six of them medium and two small - which would drop them
	-- into a 1x2 pocket they overflow by a whole cell. Anything three
	-- cells deep is large here, whatever it says about itself, and the
	-- footprint test in A.fits then sends it to a tall pocket and
	-- nowhere else.
	local _, ch = A.cells(sec)
	if (ch or 1) >= 3 then return "large" end

	local ms = SYS_GetParam(0, sec, "mag_size")
	if type(ms) ~= "string" or not CLASS[ms] then return "small" end
	return ms
end






local function gui_now()
	return ui_inventory and ui_inventory.GUI
end

-- ============================================================
-- THE PLAYER'S OWN LIST, WHATEVER THE WINDOW IS CALLING IT
--
--   "in stash the rig iventory is not present as well as the rig slot
--    ... vendor window uses base game ... i want only the player
--    inventory side to have this tarkov grid features"
--
-- ui_inventory:Reset shows a DIFFERENT container for the player's own
-- inventory depending on the mode:
--
--     inventory / loot / repair     actor_bag
--     trade                         actor_trade_bag
--
-- The rig belongs to the player, so it belongs wherever that list is.
-- Reading gui.mode and testing it against "inventory" is what kept it
-- out of the stash and the trader.
--
-- npc_bag, npc_trade, npc_trade_bag and actor_trade are the other side
-- of the window and the offer pile. Nothing here touches them.
-- ============================================================
local OUR_LISTS = { "actor_bag", "actor_trade_bag", "amp_layers_side" }

function A.ours(id)
	if id == nil then return false end
	for i = 1, #OUR_LISTS do
		if OUR_LISTS[i] == id then return true end
	end
	return false
end

-- The one that is on screen. MEASURED - IsShown - rather than worked
-- out from the mode's name, which is the rule that stopped the panel
-- forcing itself open in windows it was not in.
-- ============================================================
-- ASKED ONCE A FRAME
--
--   "when i open the inventory it goes down to like 150-160"
--
-- A steady frame writes NOTHING to the engine - every setter below is
-- memoised, and a frame where nothing moved gets through without a
-- single call. Counted, not assumed: the watcher that looked for one
-- stayed at zero.
--
-- What a frame does spend is ASKING. With an eight-pocket rig, one
-- frame called A.bag_cc thirty times, A.bag_rect twenty-seven, and
-- built thirty-nine Frects to do it. Every bag_rect is a
-- GetAbsoluteRect - an engine call - for a rectangle that cannot move
-- between the top and the bottom of one draw.
--
-- A.fc is made by A.draw and destroyed by it, the same way A.oc is.
-- OUTSIDE THE DRAW THESE ARE UNCHANGED, and that is deliberate: a hit
-- test or a drop runs when the window may have just changed under it,
-- and a remembered rectangle there would answer for the window before
-- the change. The draw is the one span in which nothing can move.
--
-- nil is an answer like any other - "there is no list of ours on
-- screen" is worth not asking twice - so it is stored as a sentinel
-- rather than as an empty slot that would ask again every time.
-- ============================================================
local NOTHING = {}

-- A SECOND KEY COMPONENT, WITHOUT BUILDING A STRING. `what` is a
-- constant name and `on` is whatever the answer depends on - the rig's
-- id, a section - so the pair is the key. Concatenating them would be
-- an allocation per lookup, which is the thing this exists to avoid.
-- ============================================================
-- A SECOND KEY COMPONENT, AND NOT ONE ALLOCATION FOR IT
--
-- `key` names the question and `on` is what the answer depends on -
-- the rig's id, the object being asked about. The two together are the
-- key, and `on` is ALSO the argument fn is called with, so a caller
-- never has to build a closure to carry it. A closure per lookup is
-- exactly the allocation this cache exists to avoid, and the first
-- version of this took one.
--
-- THE SLOT TABLES ARE KEPT AND EMPTIED, not made and thrown away. See
-- A.fc_open.
-- ============================================================
local function once(key, on, fn)
	-- TWO ARGUMENTS IS THE OLD FORM and still the common one: a
	-- question that depends on nothing but the frame.
	if fn == nil then fn, on = on, nil end

	if not A.fc_on then return fn(on) end

	local fc = A.fc
	local slot = fc[key]
	if slot == nil then slot = {} fc[key] = slot end

	local k = (on == nil) and NOTHING or on
	local had = slot[k]
	if had ~= nil then
		if had == NOTHING then return nil end
		return had
	end

	local v = fn(on)
	slot[k] = (v == nil) and NOTHING or v
	return v
end

-- Published, because A.rig_readable is written far above this line and
-- a file-local is invisible to anything declared before it.
A.once = once

-- ============================================================
-- THE FRAME CACHE IS OPENED AND CLOSED, NOT MADE AND DROPPED
--
-- It used to be `A.fc = {}` at the top of the draw and `A.fc = nil` at
-- the bottom: one table a frame, plus one per question asked. The
-- tables are kept now and emptied instead, which is the same answer
-- with no garbage - and `A.fc_on` is what "we are inside a draw" means,
-- so nothing outside one can read an answer from inside one.
-- ============================================================
A.fc = A.fc or {}

function A.fc_open()
	for k, slot in pairs(A.fc) do
		-- `metrics` is the one entry that is a PAIR rather than a set of
		-- answers: it is overwritten in place and marked stale here
		-- instead, so the two numbers never cost a table.
		if type(slot) == "table" and k ~= "metrics" then
			for j in pairs(slot) do slot[j] = nil end
		end
	end
	A.fc_metrics = nil
	A.fc_on = true
end

function A.fc_close()
	A.fc_on = false
end

function A.bag_cc()
	return once("cc", A.bag_cc_now)
end

function A.bag_cc_now()
	local gui = gui_now()
	local all = gui and gui.CC
	if not all then return nil end

	-- Not gated on cc.prof. This answers "which list is the player's",
	-- and the callers that need a WINDOW off it - the rectangle, the
	-- content - ask for one themselves. Requiring it here also made the
	-- cursor test say no on a container that was perfectly real.
	for i = 1, #OUR_LISTS do
		local cc = all[OUR_LISTS[i]]
		if cc then
			local ok, shown = pcall(function() return cc:IsShown() end)
			if ok and shown then return cc end
		end
	end
	return nil
end

-- The rig can be handled whenever the player's own inventory is what
-- is being looked at - their pack in a stash, their kit at a trader,
-- their belongings on a workbench. Not in the main menu, and not in a
-- window that has no list of theirs in it.
--
-- ui_inventory:Reset shows actor_bag for three of these and
-- actor_trade_bag for the fourth; both are the player's, so all four
-- are here. This IS a name test, unlike the docking one: what is being
-- asked is which window this is, and the window's own answer to that
-- is its name.
local EDIT_MODES = {
	inventory = true,
	loot      = true,
	trade     = true,
	repair    = true,
}

local function editing_allowed()
	local gui = gui_now()
	return gui ~= nil and EDIT_MODES[gui.mode] == true
end

function A.get_xml()
	if not A.xml then
		A.xml = CScriptXmlInit()
		A.xml:ParseFile("zzz_amp.xml")
	end
	return A.xml
end

-- ============================================================
-- IS IT A MAGAZINE?
--
-- The whole of magazine_binder.is_magazine() is this line. Reading the
-- flag directly means this mod needs no magazine mod loaded, works with
-- any of them, and cannot be broken by one renaming a function.
-- ============================================================
-- ONE ENGINE CALL PER SECTION, EVER. This is asked per entry per
-- frame by the draw and by reconcile, and the answer is a line in
-- system.ltx: it cannot change while the game is running. A.kindmemo
-- was declared for this in 1.x and then never used by anything.
function A.is_mag(sec)
	if type(sec) ~= "string" then return false end

	local had = A.kindmemo[sec]
	if had ~= nil then return had end

	local is = SYS_GetParam(1, sec, "is_mag") and true or false
	A.kindmemo[sec] = is
	return is
end

-- Footprint in grid units. inv_grid_scale is the HD Inventory Icons
-- framework: an icon drawn at twice the resolution declares scale = 2
-- and still occupies its original number of cells.
-- ============================================================
-- SECTION PARAMS ARE READ ONCE, NOT ONCE A FRAME
--
-- SYS_GetParam is not a table lookup: it walks the merged system.ltx
-- section tree and marshals a value back across into Lua. The draw pass
-- was asking for the same six or seven parameters about the same
-- fourteen magazines every single frame - 73 of them per idle frame on a
-- heavy armour, for numbers that are baked into the configs and cannot
-- change while the game is running.
--
-- So they are memoised by section, and never invalidated, because there
-- is nothing that could invalidate them. Measured cost of the three
-- caches below plus the per-frame object cache: 73 SYS_GetParam and 48
-- level.object_by_id calls per frame down to zero.
--
-- The tables are keyed by section string and bounded by the number of
-- magazine sections the game has, which is dozens.
-- ============================================================
A.memo_cells = {}
A.memo_cap = {}
A.memo_ammo = {}

-- ============================================================
-- THE HD ICON OVERRIDE IS PART OF THE ANSWER, NOT AN EXTRA
--
-- The HD Inventory Icons framework does not edit an item's section - it
-- keeps a SEPARATE ini of replacement icon geometry and the game
-- consults that ahead of the section. So for every item with an HD icon
-- SYS_GetParam reports the ORIGINAL numbers while the screen shows the
-- override's, and in a GAMMA install that is most items.
--
-- This matters here and not only for decoration: A.cells is what
-- pocket_takes measures a magazine against before letting it into a
-- pocket, so being wrong about a footprint is being wrong about what
-- fits.
--
-- Reached as a PLAIN GLOBAL. Anomaly's loader is lazy - a script is not
-- a field of _G until something asks for it through __index - so
-- rawget(_G, ...) reads nil for a framework that is installed and
-- working. This mod has already lost a release to that exact mistake.
-- ============================================================
local function icon_override_ini()
	local ok, io = pcall(function()
		return aaa_rax_icon_override_mcm
			and aaa_rax_icon_override_mcm.icon_override
	end)
	if ok and io and io.section_exist then return io end
end

-- One of the override's numbers, or nil to fall back to the section.
local function override_num(sec, key)
	local io = icon_override_ini()
	if not io then return nil end

	local ok, has = pcall(io.section_exist, io, sec)
	if not (ok and has) then return nil end

	local got, v = pcall(io.r_float_ex, io, sec, key)
	if got and tonumber(v) and tonumber(v) > 0 then return tonumber(v) end
end

function A.cells(sec)
	local m = A.memo_cells[sec]
	if m then return m[1], m[2] end

	local w = override_num(sec, "inv_grid_width")
		or SYS_GetParam(2, sec, "inv_grid_width", 1)
	local h = override_num(sec, "inv_grid_height")
		or SYS_GetParam(2, sec, "inv_grid_height", 1)
	local s = override_num(sec, "inv_grid_scale")
		or SYS_GetParam(2, sec, "inv_grid_scale", 1)

	w, h, s = tonumber(w) or 1, tonumber(h) or 1, tonumber(s) or 1
	if s <= 0 then s = 1 end

	local cw = math.max(1, math.ceil(w / s))
	local ch = math.max(1, math.ceil(h / s))

	if type(sec) == "string" then A.memo_cells[sec] = { cw, ch } end
	return cw, ch
end

-- ...AND THE SAME ANSWER FOR ONE PARTICULAR ITEM
--
--   "the rotation is not saved between inventory/rig/boxes"
--
-- A.cells answers for a SECTION: the icon as it was drawn. A thing
-- lying on its side in your bag is the same section and a different
-- shape, and every placement in this file asked the section - so a
-- turned magazine dragged into a rig arrived upright, and a wide thing
-- that only fitted on its side was refused outright.
--
-- Zone Grid owns which way up a thing is lying, so it is asked. With
-- no grid installed nothing is ever turned and the section's own
-- answer is the whole truth, which is what the fallback says.
function A.cells_for(id, sec)
	local cw, ch = A.cells(sec)
	if not id then return cw, ch end

	local ok, w, h = pcall(function()
		return zzz_amp_grid.size_for(id, sec)
	end)
	if ok and type(w) == "number" and type(h) == "number" then
		return w, h
	end
	return cw, ch
end

-- The little record every placement question is asked about: what it
-- is, and the shape it is in right now. `rot` is relative to the icon,
-- the same way an entry's rot is.
function A.item_of(sec, id)
	if type(sec) ~= "string" or sec == "" then return nil end
	local cw, ch = A.cells(sec)
	local w, h = A.cells_for(id, sec)
	return { sec = sec, w = w, h = h,
	         rot = (cw ~= ch and w ~= cw) and true or nil }
end

-- ============================================================
-- WHAT IS IN A MAGAZINE
--
-- Capacity is a section parameter, so it is always readable. Rounds and
-- ammo type live in the magazine mod's own store, so they are OPTIONAL:
-- looked up through rawget at the call, and simply not drawn when no
-- magazine mod is installed. Dropping that dependency in 0.2.0 was
-- deliberate and this does not quietly re-add it.
--
-- mag_data.loaded is a STACK OF AMMO SECTION NAMES, not counts and not
-- indices - magazine_binder pushes ammo_map[ammo_type + 1] onto it, and
-- validate_mag checks each entry against invert_table(caliber list). So
-- #loaded is the round count and the top entry names the round type.
-- ============================================================
function A.mag_info(obj)
	local sec = obj:section()

	local cap = A.memo_cap[sec]
	if not cap then
		cap = tonumber(SYS_GetParam(2, sec, "max_mag_size")) or 0
		if type(sec) == "string" then A.memo_cap[sec] = cap end
	end

	local mb = rawget(_G, "magazine_binder")
	if not mb then return nil, cap, nil end

	local ok, d = pcall(mb.get_data, obj:id())
	if not (ok and type(d) == "table" and type(d.loaded) == "table") then
		return nil, cap, nil
	end

	local n = #d.loaded
	return n, cap, (n > 0) and d.loaded[n] or nil
end

-- The short name the game shows for a round, translated. Long names are
-- cut rather than allowed to overflow the pocket they are drawn on.
function A.ammo_name(sec)
	if type(sec) ~= "string" or sec == "" then return nil end

	-- Two section reads AND a translate_string, per magazine, per frame.
	-- The answer depends on the section and the language, and neither
	-- changes while the game is running. `false` is stored for a section
	-- with no name so a miss is not looked up again every frame.
	local hit = A.memo_ammo[sec]
	if hit ~= nil then return hit or nil end

	local key = SYS_GetParam(0, sec, "inv_name_short")
		or SYS_GetParam(0, sec, "inv_name")
	if type(key) ~= "string" then A.memo_ammo[sec] = false return nil end

	local ok, txt = pcall(game.translate_string, key)
	txt = (ok and type(txt) == "string") and txt or key

	if #txt > 11 then txt = txt:sub(1, 11) end

	A.memo_ammo[sec] = txt
	return txt
end

-- ============================================================
-- THE RIG IS THE LOADOUT
--
-- get_loadout_slots(val) is a BARE function on magazine_binder's
-- namespace, and it is the single place every per-item loadout number
-- comes from: update_loadout_slots calls it once for the outfit, once
-- for the backpack, and once per belt artefact, then sums the results.
--
-- Wrapping it replaces the ARMOUR's contribution with the rig's pocket
-- counts, at exactly the layer the numbers are read - no delta
-- arithmetic, no reimplementing their summation, and room_in_pouch and
-- validate_loadout agree with the rig automatically because they read
-- the same total.
--
-- With amp_rig_is_all on, the backpack and belt artefacts are zeroed
-- too, so the rig is the whole of what you can carry. That is a
-- deliberate balance change and it is the setting that makes expansion
-- pouches the only way to grow - which is the point. Turned off, they
-- keep contributing and the rig then shows less than your real loadout.
--
-- The wrap is installed in on_game_start rather than at chunk scope:
-- the magazine mod is optional, and asking for it at load time would
-- depend on filename ordering that this file has no way to guarantee.
-- ============================================================
-- ============================================================
-- THE COPIES TAKEN BEFORE THIS MOD EXISTED
--
-- magazines.script line 19:
--
--     room_in_pouch = magazine_binder.room_in_pouch
--
-- No `local`, at CHUNK SCOPE - so it is magazines.room_in_pouch, bound
-- to whatever the function was when that file loaded, which is long
-- before on_game_start installs anything here. Sixteen of the magazine
-- system's functions are captured that way, and the reload uses those
-- copies.
--
-- So the reload's first question - "will there be room for the magazine
-- I am about to eject?" - went to the ORIGINAL, which cannot know that
-- the magazine going INTO the gun is itself sitting in a pocket that is
-- about to come free. On a full rig it answered no, `last_ejected` was
-- never set, and the ejected magazine was never offered the pocket at
-- all. That is the report: a medium magazine in a large pocket gets
-- loaded, and the one that comes out does not take the large pocket.
--
-- The second question, from inside toggle_carried_mag, DOES reach the
-- wrapper - a call made inside magazine_binder resolves through that
-- file's own namespace at call time. Hence exactly one wrapped call per
-- reload in the log, and it was the wrong one to be the only one.
--
-- Re-pointing is deliberately narrow: only fields whose value is
-- IDENTICAL to the function just wrapped, and only in namespaces that
-- are known to take copies. Nothing is renamed, nothing new is added,
-- and a file that took a true `local` copy is out of reach either way.
-- ============================================================
local CONSUMERS = {
	"magazines", "mags_patches", "mag_hud", "mag_direct_load",
	"yyy_mag_sorting", "magazines_loadout_sounds", "mags_arti_jamming_patch",
	"mag_mark_hotkeys", "mag_pouches",
}

function A.repoint(old, new, what)
	if old == nil or old == new then return end

	for _, name in ipairs(CONSUMERS) do
		local t = rawget(_G, name)
		if type(t) == "table" then
			-- Assigning to a field that already exists during a pairs()
			-- traversal is allowed; adding one is not, and none is added.
			for k, v in pairs(t) do
				if v == old then
					t[k] = new
					log("repointed %s.%s -> wrapped %s", name, tostring(k), what)
				end
			end
		end
	end
end

-- ============================================================
-- THE THREE LINES THAT SAID A RIG CARRIES NOTHING
--
--   "there is text info for how many slots the rig has but says 0 for
--    every type (this text should be fully gone)"
--
-- Not ours, and not wrong of them either. mags_patches wraps
-- ui_item.build_desc_header and, for anything that HAS loadout slots
-- and is not the armour you are wearing, prints one line per size:
--
--     if obj and magazines and has_loadout_slots(obj) then
--         ... gc("st_mag_"..k) .. slots
--
-- A rig answers yes to that question, because this mod ships its pocket
-- counts in magazines\\outfitloadouts so the rest of the magazine system
-- knows about them. And the number it prints is 0, because
-- get_loadout_slots is wrapped here and a rig that is not an outfit
-- answers "nothing" so it cannot also be counted as belt kit.
--
-- Both halves are correct on their own and the pair is nonsense on the
-- screen: three lines telling you a rig holds no magazines, above a
-- picture of its pockets.
--
-- SO THE QUESTION IS ANSWERED FALSE, AND ONLY WHILE THAT DESCRIPTION IS
-- BEING BUILT. Not always: actor_item_to_slot asks the same question to
-- decide whether to revalidate the loadout, and answering false there
-- would quietly skip work that has nothing to do with a tooltip. One
-- wrap around the description, one flag, and everything outside it is
-- left exactly as it was.
--
-- AND THE COPIES ARE RE-POINTED. mags_patches takes its own copy at
-- chunk scope - `has_loadout_slots = magazine_binder.has_loadout_slots`,
-- line 21 - so replacing the field on magazine_binder alone would
-- change nothing at all in the one file that prints the lines. This is
-- the same lesson as the reload bug, and A.repoint is what it left.
-- ============================================================
function A.install_desc_guard()
	local ui = rawget(_G, "ui_item")
	if not (ui and type(ui.build_desc_header) == "function") then
		log("no item description hook - nothing to tidy")
		return
	end

	if A.bdh_base then return end       -- never wrap twice

	local mb = rawget(_G, "magazine_binder")
	if mb and type(mb.has_loadout_slots) == "function" and not A.hls_base then
		A.hls_base = mb.has_loadout_slots
		mb.has_loadout_slots = function(val)
			if A.enabled and A.desc_rig then return false end
			return A.hls_base(val)
		end
		A.repoint(A.hls_base, mb.has_loadout_slots, "has_loadout_slots")
	end

	A.bdh_base = ui.build_desc_header

	ui.build_desc_header = function(obj, sec, str)
		if type(sec) ~= "string" and obj then
			local oks, s = pcall(function() return obj:section() end)
			sec = oks and s or sec
		end

		if not (A.enabled and type(sec) == "string" and A.is_rig_sec(sec)) then
			return A.bdh_base(obj, sec, str)
		end

		-- The flag comes off however this ends. A description that
		-- throws is a bad tooltip; a flag left set is every question
		-- about loadout slots answered wrongly for the rest of the
		-- session.
		A.desc_rig = true
		local ok, out = pcall(A.bdh_base, obj, sec, str)
		A.desc_rig = false

		if ok then return out end
		log("!description for %s: %s", tostring(sec), tostring(out))
		return str or ""
	end

	log("rig descriptions will not claim to carry no magazines")
end

function A.install_loadout_override()
	local mb = rawget(_G, "magazine_binder")
	if not (mb and type(mb.get_loadout_slots) == "function") then
		log("no magazine mod - the rig is storage only")
		return
	end

	if A.gls_base then return end       -- never wrap twice
	A.gls_base = mb.get_loadout_slots

	mb.get_loadout_slots = function(val, combine, force_outfit)
		local function out(sm, md, lg)
			if combine then return { small = sm, medium = md, large = lg } end
			return sm, md, lg
		end

		if A.enabled and val then
			local ok, is_outfit = pcall(IsOutfit, val)
			local outfit = (ok and is_outfit) or force_outfit

			if outfit then
				-- THIS armour's rig, not the worn one's. The tooltip on
				-- an outfit in the bag asks about that outfit, and it is
				-- entitled to the truth about it.
				local n = A.counts_for(val)
				if n then return out(n.small, n.medium, n.large) end

			elseif A.rig_is_all then
				return out(0, 0, 0)
			end
		end

		return A.gls_base(val, combine, force_outfit)
	end

	A.repoint(A.gls_base, mb.get_loadout_slots, "get_loadout_slots")
	log("loadout override installed")

	-- ============================================================
	-- POCKETS ARE THE CAPACITY
	--
	-- get_loadout_slots makes the rig's pocket COUNTS the loadout, which
	-- is most of the way there, but the magazine system counts by class
	-- with excess shifting UP a size - so it can answer "yes, room" for a
	-- pistol magazine when every pistol pocket is taken and only a rifle
	-- pocket is free, and disagree with the rig about which magazine goes
	-- where. Whenever the two disagree, one of them carries a magazine
	-- the other has nowhere to put, and reconcile then releases it: a
	-- magazine that flickers into the bag for no reason the player can
	-- see.
	--
	-- So the same question gets the same answer from both. The base is
	-- still asked first and its NO is still final - it knows about
	-- magazines this mod does not - but its YES additionally has to be a
	-- pocket that actually exists and actually fits.
	--
	-- Pruning first is the point of doing this here at all: this is the
	-- call the reload makes, immediately after alife_release_id has taken
	-- the loaded magazine out of the rig, and the freed pocket has to be
	-- visible by the time the ejected one asks for it.
	-- ============================================================
	if type(mb.room_in_pouch) == "function" and not A.rip_base then
		A.rip_base = mb.room_in_pouch

		mb.room_in_pouch = function(id)
			-- A.uncarry reaches toggle_carried_mag, which reaches here.
			if A.in_room or not (A.enabled and A.rig_is_all) then
				return A.rip_base(id)
			end

			A.in_room = true

			local ok, res = pcall(function()
				-- Already in a pocket. The question is asked about
				-- magazines that are ALREADY carried - by the drop path
				-- here, and by the magazine mod's own menus - and "is
				-- there a free pocket" is the wrong question for one that
				-- has its own. Answering it strictly would refuse to keep
				-- a magazine the rig is currently holding.
				if A.pk_holds(id) then return true end

				A.resolve_rig()

				-- ============================================================
				-- THE BASE FIRST, AND THIS ORDER IS THE WHOLE BUG
				--
				-- The original does not only answer the question - it
				-- PURGES escaped magazines on the way:
				--
				--     for i, mag in pairs(carried_mags) do
				--         local itm = level.object_by_id(i)
				--         if not (itm and utils_item.in_actor_inv(itm)) then
				--             carried_mags[i] = nil
				--
				-- A magazine loaded into a weapon is released, but it
				-- stays in that ledger until something runs that loop.
				-- So asking sync_pockets FIRST asked "is this still
				-- carried?" of a ledger nobody had cleaned, the answer
				-- was yes, and the pocket the magazine had just left
				-- still read as full.
				--
				-- That is exactly the moment the reload asks. With a
				-- full rig - which is the normal state - the ejected
				-- magazine then found no free pocket and went to the
				-- bag instead of back into the rig. Reported as
				-- "magazines from weapons do not go back to the rig",
				-- and it only happened when the rig was full, which is
				-- why it looked intermittent.
				--
				-- Base first, so the ledger is clean; then sync, so the
				-- pockets agree with it; then our own question.
				-- ============================================================
				-- CALLED FOR THE PURGE, NOT ONLY FOR THE ANSWER. See
				-- the note above: this is the only thing that cleans
				-- carried_mags, and the answer below depends on it
				-- having run.
				local base_says = A.rip_base(id) and true or false

				-- NOT a full reconcile: this runs inside the reload and
				-- inside menu building. All that is needed here is that a
				-- pocket whose magazine has just been loaded into the
				-- weapon reads as empty, and the purge above has just
				-- made that knowable.
				A.sync_pockets()

				local obj = level.object_by_id(id)
				local sec = obj and obj:section()

				-- ============================================================
				-- A MAGAZINE THAT DOES NOT EXIST YET IS STILL A MAGAZINE
				--
				--   "i put on a righ with just one mag inside and many
				--    slots for the unloading mag to go to and it still
				--    went to invnentory then to rig"
				--
				-- From the log, and it is not about room at all:
				--
				--   filter[idlist] ... pockets=1 carried=1 rig=15
				--   out of the gun: 37123
				--   room_in_pouch(37123) -> false      <- 14 free pockets
				--   ...one and a bit seconds...
				--   room_in_pouch(37123) -> true
				--   carried -> pocket 6 for 37123
				--
				-- eject_magazine makes the magazine with
				-- alife_create_item, which creates a SERVER object; the
				-- client object is not there for another frame or two.
				-- With no object there is no section, and this used to
				-- hand the question back to the base - which, with
				-- rig_is_all on, says false BY DESIGN, because this mod
				-- tells the game the vanilla loadout holds nothing.
				--
				-- So "I cannot see it yet" came out as "there is no
				-- room", the magazine mod believed it, and the magazine
				-- sat in the bag until the END of the reload, when the
				-- mod asks again. The gap is the reload animation, and
				-- the log prints its length: `mag swap delay is 1.3`.
				--
				-- THE SECTION IS AVAILABLE WITHOUT THE OBJECT, from the
				-- magazine mod's own record, and it is written BEFORE
				-- this is asked - timer_eject_magazine does
				-- set_mag_data(id, mag_data) at the top and calls
				-- toggle_carried_mag, which asks this, at the bottom.
				--
				-- The object first where there is one: it is the truth
				-- about what is really in the world, and get_data is a
				-- record that can outlive the thing it describes.
				-- ============================================================
				if not sec and type(mb.get_data) == "function" then
					local got, data = pcall(mb.get_data, id)
					if got and type(data) == "table" then
						sec = data.section
					end
				end

				-- Not a magazine this mod places: the original's verdict
				-- is the only one there is.
				if not (sec and A.is_mag(sec)) then return base_says end

				-- ============================================================
				-- FOR A MAGAZINE THIS MOD PLACES, THE RIG IS THE AUTHORITY
				--
				-- The original counts carried magazines BY CLASS against
				-- the loadout numbers, and shifts the excess up a class:
				--
				--     if c.medium > L.medium then
				--         c.large = c.large + c.medium - L.medium
				--
				-- That was a fair description of the rig when a pocket
				-- was only a class. It is not one now. A magazine's
				-- class comes from its shape here - a 1x3 stick counts
				-- as large and lives in a tall pocket - while the ledger
				-- still calls it medium, so mediums overflow into large
				-- and the count reads FULL while pockets sit visibly
				-- empty.
				--
				-- The symptom was two of them at once: the loadout key
				-- refusing with "could not be added to the loadout"
				-- while the rig had room, and the magazine ejected by a
				-- reload going to the bag instead of back into the rig -
				-- both are this same nil from toggle_carried_mag.
				--
				-- So the original's NO is no longer final for a
				-- magazine this mod files. It cannot be: with
				-- amp_rig_is_all on, the rig IS the loadout, and the
				-- pockets are the only honest count of it. The answer is
				-- bounded by real pockets, so it can never let in more
				-- than the rig holds.
				--
				-- ONE REFUSAL IS NOT OURS TO OVERRULE. The original
				-- opens with
				--
				--     local s = mags_storage[id] and get_size(id) or false
				--     if not s then return false end
				--
				-- which is not a capacity judgement at all - it is "I
				-- have never heard of this magazine". Overruling that
				-- one would be a lie with consequences: the very next
				-- line of toggle_carried_mag is
				--
				--     carried_mags[id] = mags_storage[id]
				--
				-- so it would file nil and report success, and the
				-- magazine would be carried by nobody. So: if the
				-- magazine system has no data for it, its NO stands.
				-- ============================================================
				if not base_says then
					local known = false
					if type(mb.get_data) == "function" then
						local got, data = pcall(mb.get_data, id)
						known = (got and data) and true or false
					end
					if not known then return false end
				end

				return A.slot_free(sec, nil, id) ~= nil
			end)

			A.in_room = false
			dbg("room_in_pouch(%s) -> %s%s", tostring(id),
			    tostring(ok and res), ok and "" or " (ERROR: " .. tostring(res) .. ")")

			-- On an error the base answer stands. Getting this wrong in
			-- the permissive direction stalls a reload; in the strict
			-- direction it silently stops magazines being kept at all.
			if not ok then return A.rip_base(id) end
			return res
		end

		A.repoint(A.rip_base, mb.room_in_pouch, "room_in_pouch")
		log("capacity override installed")
	end
end

-- ============================================================
-- A MAGAZINE GETS ITS POCKET THE MOMENT IT IS CARRIED
--
--   "on reload the mag goes to inventory and then to rig and that
--    aslo causes ammo (that the mag uses) to resort"
--
-- The magazine mod carries the ejected magazine and this mod gives it a
-- pocket on the next pass. That used to be the next half second; it is
-- now the next frame; and one frame is still one relayout of the grid
-- on the way in and another on the way out, with the ammunition sorted
-- twice in between. There is no pass left to shorten.
--
-- So stop waiting for one. toggle_carried_mag is the ONE funnel
-- through which anything becomes carried:
--
--     function toggle_carried_mag(id)
--         if carried_mags[id] then carried_mags[id] = nil return false
--         elseif room_in_pouch(id) then carried_mags[id] = ... return true end
--     end
--
-- A wrap on it hears the ejected magazine become carried INSIDE the
-- reload, before the inventory is refreshed at all. Nothing ever sees
-- it loose.
--
-- ONLY THE YES. This acts on `true` and deliberately does nothing on
-- `false`. Emptying a pocket is the half of this file that has just
-- cost five releases to settle, and it is not being moved into a wrap
-- on somebody else's function on the same day.
--
-- AND NOT OUR OWN CALLS. A.carry and A.uncarry push into the carried
-- set through this same function, so they come back through here;
-- reacting to them would be reacting to ourselves.
-- ============================================================
-- ============================================================
-- WHICH MAGAZINE CAME OUT OF THE GUN
--
--   "the mag that gets unloaded tries to go into invnetory and cant so
--    gets dropped. thats is a big issue."
--
-- eject_magazine creates the object and hands back its id:
--
--     se_mag = alife_create_item(mag_data.section, weapon:parent())
--     ...
--     return se_mag.id
--
-- so a wrap knows exactly which magazine it is, the moment it exists -
-- rather than guessing from a timer at "a magazine that turned up
-- recently". What that id is FOR is grid_nodrop, below.
--
-- A.from_gun is not cleaned up here and does not need to be: grid_nodrop
-- prunes every id whose object has gone or has left the inventory each
-- time it is asked, and a magazine that finds a pocket is in grid_keep
-- and never reaches the spill at all.
-- ============================================================
function A.install_eject_watch()
	local m = rawget(_G, "magazines")
	if not (type(m) == "table" and type(m.eject_magazine) == "function") then
		return
	end
	if A.eject_base then return end

	A.eject_base = m.eject_magazine

	m.eject_magazine = function(weapon)
		local id = A.eject_base(weapon)

		if A.enabled and type(id) == "number" then
			A.from_gun[id] = true

			-- AND IT WAITS FROM HERE, before anything can draw it. Not
			-- "if the rig is full": the rig may be full now and have
			-- room in a second, which is the whole problem, and asking
			-- here would need the section of an object that does not
			-- exist yet. A.settle_held sorts it out on the next frame
			-- and clears this the moment it has a pocket.
			if not A.pk_holds(id) then
				A.held[id] = time_global() + HOLD_MS
			end

			dbg("out of the gun: %s", tostring(id))
		end

		return id
	end

	A.repoint(A.eject_base, m.eject_magazine, "eject_magazine")
	log("a magazine out of your gun will not be put on the ground")
end

function A.install_carry_watch()
	local mb = rawget(_G, "magazine_binder")
	if not (mb and type(mb.toggle_carried_mag) == "function") then return end
	if A.tcm_base then return end

	A.tcm_base = mb.toggle_carried_mag

	mb.toggle_carried_mag = function(id)
		local res = A.tcm_base(id)

		if res ~= true or A.in_toggle or not A.enabled then return res end
		if type(id) ~= "number" or A.pk_holds(id) then return res end

		A.in_toggle = true
		pcall(function()
			local obj = level.object_by_id(id)
			local sec = obj and obj:section()

			-- THE SAME EYES AS room_in_pouch, for the same reason: the
			-- magazine is carried inside the reload, a frame or two
			-- before its object spawns. Reading only the object would
			-- put the whole delay straight back.
			if not sec and type(mb.get_data) == "function" then
				local got, data = pcall(mb.get_data, id)
				if got and type(data) == "table" then
					sec = data.section
				end
			end

			if not (sec and A.is_mag(sec)) then return end

			if not A.slot_put(id, sec) then return end

			-- AND A POCKET CLAIMED FOR SOMETHING THAT IS NOT THERE YET
			-- IS AN INCOMING ONE. Without this the next prune finds a
			-- pocket holding an id with no object and empties it. The
			-- deadline is the same ten seconds a magazine restored out
			-- of a rig gets, and settle_incoming gives up after it
			-- rather than leaving a pocket pointing at nothing.
			if not obj then
				A.incoming[id] = time_global() + 10000
				A.pending_item[id] = { sec = sec }
			end

			dbg("carried -> a slot for %s (%s)%s",
			    tostring(id), tostring(sec),
			    obj and "" or " (not spawned yet)")
		end)
		A.in_toggle = false

		return res
	end

	A.repoint(A.tcm_base, mb.toggle_carried_mag, "toggle_carried_mag")
	log("a magazine takes its pocket the moment it is carried")
end

-- Membership in the magazine system's carried set, kept one-way: this
-- mod's pockets are the authority and push into it. Never the reverse -
-- two things deciding what is carried is what made 0.1.x unfixable.
function A.carry(id)
	local mb = rawget(_G, "magazine_binder")
	if not (mb and mb.is_carried_mag and mb.toggle_carried_mag) then return end

	local ok, carried = pcall(mb.is_carried_mag, id)
	if ok and not carried then pcall(mb.toggle_carried_mag, id) end
end

function A.uncarry(id)
	local mb = rawget(_G, "magazine_binder")
	if not (mb and mb.is_carried_mag and mb.toggle_carried_mag) then return end

	local ok, carried = pcall(mb.is_carried_mag, id)
	if ok and carried then pcall(mb.toggle_carried_mag, id) end
end

-- ============================================================
-- POCKET CONTENTS
-- ============================================================


-- A pocket whose magazine has been used up, dropped, sold or destroyed
-- points at nothing. Left alone, that id would go on hiding a grid entry
-- that no longer exists - and worse, could collide with a recycled one.
function A.prune()
	-- Right after a save is loaded every object in your inventory reads
	-- as missing for a moment. Pruning against that empties the whole
	-- rig and unsets carried on every magazine in it.
	if A.warming() then return end

	-- ============================================================
	-- ONCE A FRAME, AND IT WAS RUNNING TWICE
	--
	-- A.draw_body calls this and then calls A.reconcile, which opens by
	-- calling it again - deliberately, with a note saying reconciling
	-- against unpruned pockets is never right. Both are correct and
	-- together they were two engine lookups per thing in the rig per
	-- frame where one would do. A full rig is fifty-two of them.
	--
	-- STAMPED ONLY INSIDE A DRAW. A.fc is the per-frame cache and it
	-- exists for exactly the span in which nothing can change; outside
	-- one - the reload, the keybind, a drop - this runs every time it
	-- is asked, as it always did.
	-- ============================================================
	if A.fc_on then
		if A.pruned_at == A.fstamp then return end
		A.pruned_at = A.fstamp
	end

	local out = {}

	for i = 1, #A.pk do
		local P = A.pk[i]
		for e = 1, (P and #P.slots or 0) do
			local ent = P.slots[e]
			for k = 1, #ent.ids do
				local id = ent.ids[k]
				local obj = level.object_by_id(id)
				local ok = obj ~= nil

				if ok then ok = in_inv(obj) end

				-- ON ITS WAY IN. A thing just rebuilt out of the rig has
				-- a server object and no client one for a frame or two,
				-- and emptying its square here is how it would be lost
				-- the instant it was handed back.
				if not ok and A.incoming[id] then ok = true end

				if not ok then out[#out + 1] = { P, id } end
			end
		end
	end

	for q = 1, #out do
		A.pk_drop(out[q][1], out[q][2])
		A.uncarry(out[q][2])
	end
end


-- ============================================================
-- ONE THING INTO THE WORN RIG
--
--   "dont block the rigs slots to only mags ammo and meds. everything
--    that fits can be stored there"
--
-- So there is no "only magazines go in the pouches" any more, and the
-- refusal it used to print is gone with it. What is left is the two
-- structural refusals - a container or a rig inside a rig - and "it
-- does not fit anywhere", which is a fact about the shape rather than
-- about the item.
--
-- `prefer` is the slot the cursor was over and (ar, ac) the square in
-- it, so dropping something on a PARTICULAR square puts it there;
-- with neither, the packer decides. A.slot_put handles both and skips
-- torn slots wherever they turn up.
-- ============================================================
function A.put(obj, prefer, ar, ac)
	if not obj then return false end

	local sec = obj:section()
	local id = obj:id()

	local ok, why = A.pk_takes(sec)
	if not ok then
		notify("%s", why)
		return false
	end

	if A.pk_holds(id) then return false end

	if not A.slot_put(id, sec, prefer, ar, ac) then
		local w, h = A.cells(sec)
		notify("Nothing in the rig has room for a %dx%d",
		       tonumber(w) or 1, tonumber(h) or 1)
		return false
	end

	-- A fitted item entering the worn rig is no longer owned by a
	-- Layered pouch zone. Clear that ownership after the 3.1 slot
	-- packer has accepted it; the object itself remains live.
	pcall(function()
		local layers = rawget(_G, "zzz_amp_layers")
		if layers and type(layers.remove_for_equipment) == "function" then
			layers.remove_for_equipment(id)
		elseif layers and type(layers.remove) == "function" then
			layers.remove(id)
		end
	end)
	A.sfx("in")
	return true
end

-- The top of pile `n` in slot `i`, or the top of the FIRST pile there
-- when no square is named - which is what a click on an ambiguous
-- rectangle means.
function A.take(i, n)
	local P = A.pk[i]
	if not P then return false end

	n = n or (#P.slots > 0 and 1 or nil)
	if not n then return false end

	if not A.slot_pull(i, n) then return false end
	A.sfx("out")
	return true
end



-- Is the cursor over the inventory grid? Asked of the container itself
-- rather than measured, because the bag is moved and resized by the
-- player's UI settings and any rectangle kept here would be a second
-- opinion about where it is.
function A.over_bag()
	local gui = gui_now()
	for i = 1, #OUR_LISTS do
		local cc = gui and gui.CC and gui.CC[OUR_LISTS[i]]
		local ok, over = pcall(function()
			return cc and cc:IsShown() and cc:IsCursorOverWindow()
		end)
		if ok and over then return true end
	end
	return false
end

-- ============================================================
-- GEOMETRY
--
-- THE X AXIS CARRIES AN ASPECT CORRECTION. Every horizontal measurement
-- inside a panel is multiplied by utils_xml.screen_ratio() before it is
-- drawn - roughly 0.75 on 16:9. That is the base class's convention:
-- UICellItem:Set places a cell at ((area.x * grid_size) - grid_size) *
-- ratio and sizes it w * ratio, so that a square renders square.
-- Vertical measurements are untouched.
--
-- GetCursorPosition() reports in the same space the panel ORIGIN is
-- expressed in, so the origin is 1:1 with the cursor - but everything
-- measured FROM it along x is compressed by ratio.
--
-- Nothing below re-derives a rectangle. The draw pass computes each one
-- once, in absolute cursor space, and stores it; the hit tests only read
-- what was stored. A control is clickable exactly where it is drawn.
-- ============================================================

-- TWO NUMBERS, so this keeps its own pair rather than going through
-- `once`, which answers with one. They come off the equipment
-- container and cannot change inside a frame.
function A.metrics()
	if A.fc_on and A.fc_metrics then
		local m = A.fc.metrics
		if m then return m[1], m[2] end
	end

	local gui = gui_now()
	local equ = gui and gui.CC and gui.CC["actor_equ"]

	local gs = (equ and tonumber(equ.grid_size)) or 41
	local gl = (equ and tonumber(equ.grid_line)) or 2

	-- ONE PAIR, KEPT AND OVERWRITTEN. A fresh two-element table a frame
	-- for two numbers that almost never change is the sort of garbage
	-- this cache exists to stop making.
	if A.fc_on then
		local m = A.fc.metrics
		if m then m[1], m[2] = gs, gl
		else A.fc.metrics = { gs, gl } end
		A.fc_metrics = true
	end
	return gs, gl
end

-- Pixel footprint of a w x h box, matching UICellItem:Set's arithmetic so
-- a cell and the icon the base class centres on it agree about size.
--
-- For a MANUAL cell, Set assigns neither position nor size: the
-- `area and (not self.manual)` branch cannot run, and the `elseif
-- self.st` branch cannot either, because self.st is only set for a
-- "free cell" (type(st) == "table") and a manual cell is handed the
-- container's window object. Whatever size the cell is given is what it
-- keeps - while Add_Icon sizes the ICON from inv_grid_width/height.
function A.px(w, h)
	local gs, gl = A.metrics()
	return w * gs + (w - 1) * gl, h * gs + (h - 1) * gl
end




-- wpx is the panel's width ON SCREEN, already ratio-corrected, because
-- that is what has to clear the equipment panel and fit the canvas.
-- ============================================================
--  THE PERSONAL INVENTORY LAYOUT - THE MIDDLE COLUMN
--
--  The actor menu is three panels wide and, when you are looking at
--  your own inventory, only two of them are used: the equipment block
--  in the middle, the bag on the right, and A THIRD OF THE SCREEN on
--  the left doing nothing at all. This slides the equipment block over
--  into that empty third, and gives the space it leaves behind to the
--  rig - its slot, its pockets, and later the magazines and ammo.
--
--  IT IS DONE WHEN THE MENU OPENS, NOT IN THE XML. An xml edit cannot
--  ask what the menu is being used for, and the equipment block is on
--  screen in every mode: looting a body, trading, and the mechanic's
--  window all put somebody else's inventory in that left third. Moving
--  it there in the file would park the equipment on top of the trader.
--  So the move happens per mode, only for "inventory", and is undone
--  for every other one.
--
--  THE DROP AREA MOVES WITH IT. The stock menu has an invisible window
--  over that same left third which means "dropped outside", and a drag
--  is tested against it BEFORE anything else. Left where it was, every
--  drag onto an equipment slot would have thrown the item on the
--  ground. It is moved onto the new empty column instead.
--
--  MEASURED, NOT TYPED. Every number comes from the rect the game
--  reports for the panels themselves, so it holds at any resolution
--  and under any UI overhaul - and there are several installed here,
--  each with its own coordinates. Deriving it also makes it
--  IDEMPOTENT: run twice and the second run measures the moved layout
--  and changes nothing.
-- ============================================================

-- ============================================================
-- ANCHORED TO THE BAG, FOR THE GRID BUILD
--
-- Zone Grid turns the right-hand column into a stack of sections -
-- pouches, armour, backpack - and reserves the top of it for the rig.
-- So the rig slot goes in that corner and the pockets sit beside it,
-- which is the Tarkov shape and what was asked for:
--
--     [slot] [ the rig's pockets              ]
--     [ pouches                    ]
--     [ armour                             ]
--     [ backpack                           ]
--
-- The bag's panel is the thing to measure, not the equipment dialog:
-- it is the column those sections are drawn in.
-- ============================================================
-- DOCKED IN THE BAG COLUMN, and only when there is actually a column
-- to dock in. The option on its own is not enough: with no bag panel to
-- measure - the main menu, a mode this does not run in, a harness -
-- there is nowhere to anchor, and forcing the panel open with no anchor
-- makes it a window that cannot be closed.
function A.bag_docked()
	-- AND A WINDOW THIS MOD BELONGS IN. Every container the menu owns
	-- exists in every mode and several are shown in modes that have
	-- nothing to do with an inventory, so a rectangle on its own is not
	-- enough - it would open the pockets in a window that then draws
	-- none of them, and leave them open afterwards.
	if not editing_allowed() then return false end
	return (A.bag_anchor and A.bag_rect()) and true or false
end

function A.bag_rect()
	return once("rect", A.bag_rect_now)
end

function A.bag_rect_now()
	local cc = A.bag_cc()
	if not (cc and cc.prof) then return nil end

	local ok, r = pcall(function()
		local fr = Frect():set(0, 0, 0, 0)
		cc.prof:GetAbsoluteRect(fr)
		return fr
	end)
	if not (ok and r) then return nil end
	return r
end

-- ============================================================
-- THE LIST AS THE PLAYER SEES IT, NOT AS IT IS FILED
--
-- `prof` is the WINDOW - the hole in the screen the inventory is looked
-- at through. It does not move. `st` is the CONTENT: the static the
-- scroll view carries, and the parent of every item cell in the bag. It
-- moves UP as the list is scrolled down, which is precisely what makes
-- it the right thing to hang the rig block off:
--
--   "i wanted so the slot is in scrollable space as well as the mag
--    slots from the rig, and they can go out of the visible space when
--    inventory is scrolled down, like in tarkov."
--
-- The rig block sits at the top of the CONTENT, so it scrolls with the
-- sections instead of floating above them. Zone Grid draws its section
-- borders against this same window, which is how we know the engine
-- hands it over and where it puts what is parented to it.
-- ============================================================
function A.bag_content()
	return once("content", A.bag_content_now)
end

function A.bag_content_now()
	local cc = A.bag_cc()
	if not (cc and cc.st) then return nil end

	local ok, r = pcall(function()
		local fr = Frect():set(0, 0, 0, 0)
		cc.st:GetAbsoluteRect(fr)
		return fr
	end)
	if not (ok and r) then return nil end
	return r
end

-- The line the block is cut off at: the top of the list's WINDOW, which
-- is the edge the item cells themselves disappear under. nil when the
-- block is not in a list at all - a floating panel has no edge to be
-- cut off by, and must not be cut.
-- BOTH EDGES OF THE LIST, from the one rectangle that knows them. Two
-- returns rather than two functions: they are measured together, they
-- go stale together, and a caller that reads one without the other is
-- the bug this was written to fix.
function A.clip_line()
	if not A.bag_docked() then return nil end
	local vis = A.bag_rect()
	if not vis then return nil end
	return vis.y1, vis.y2
end

-- ============================================================
-- ...AND PUTTING THEM THERE
--
-- THE TWO PASSENGERS. The upgrade panel and the drop-on-the-floor area
-- are drawn where the other party's column is, and `trash` is attached
-- to the MENU rather than to that column - the game tests it before any
-- container, so anything let go over it is thrown on the ground. Left
-- behind at the old x it turns a third of the screen into a bin.
-- ============================================================
-- Every window the MENU owns that belongs to a column, and which
-- column it belongs to. Built rather than typed out: three views times
-- three names is nine lines of near-identical text, and the ninth is
-- where the typo goes.
--
-- The upgrade panel and its overlays ride with the OTHER PARTY, because
-- that is the column the mechanic's window is drawn in.
local RIDERS = {
	{ "npc_up_dialog", "npc" },
	{ "trash",         "npc" },
}

for _, v in ipairs({ { "player", "player" },
                     { "npc",    "npc" },
                     { "npc_up", "npc" } }) do
	for _, s in ipairs({ "", "_def", "_alt" }) do
		RIDERS[#RIDERS + 1] = { v[1] .. "_faction_dialog" .. s, v[2] }
	end
end

function A.cols_apply(gui)
	gui = gui or gui_now()
	if not gui then return end

	local win = { equ = gui.equ_dialog,
	              player = gui.player_dialog,
	              npc = gui.npc_dialog }

	local wide, at = {}, {}
	local left
	for k, w in pairs(win) do
		local ok, p, ww = pcall(function()
			local q = w:GetWndPos()
			return { q.x, q.y }, w:GetWidth()
		end)
		if not (ok and p and type(ww) == "number") then return end
		at[k], wide[k] = p, ww
		if not left or p[1] < left then left = p[1] end
	end

	local want = A.cols_for(A.layout, wide, left)
	if not want then return end

	for k, w in pairs(win) do
		A.wmove(w, want[k], at[k][2])
	end

	-- ============================================================
	-- ...AND EVERYTHING ELSE THE MENU OWNS THAT BELONGS TO A COLUMN
	--
	--   "the money/player avatar/name is still in old spot"
	--
	-- DRAWN IN A COLUMN IS NOT THE SAME AS BEING A CHILD OF ONE, and
	-- only the second sort moves when the column does. The menu builds
	-- these with the column's own node - so they line up with it
	-- exactly, at the x the FILE gives it - and then hangs them on
	-- ITSELF:
	--
	--     self[ str_faction_dialog_ctrl ] = xml:InitStatic( view_node,
	--                                                       self )
	--
	-- The face, the name, the faction, the rank, the money and the
	-- trader's supply level are all children of that rectangle. So is
	-- the whole of `trash`, which is the same trap and was already
	-- fixed two lines above this - which is why this is a table now.
	-- Anything the menu owns and a column claims goes in it.
	--
	-- ctrl_faction_lst is { "_def", "_alt" }: the overlay and the spare
	-- the pack swaps in. <view>_faction_dialog is an ALIAS for _def, so
	-- one window is written twice with the same number - cheaper than
	-- finding out, since comparing two CUIStatic raises.
	-- ============================================================
	for i = 1, #RIDERS do
		local w = gui[RIDERS[i][1]]
		if w then
			pcall(function()
				A.wmove(w, want[RIDERS[i][2]], w:GetWndPos().y)
			end)
		end
	end
end

function A.origin(wpx, h)
	local gui = gui_now()
	local x, y = 0, 0

	-- THE COLUMN FIRST. With the split layout on, the equipment block
	-- is against the left edge of the screen and "to the left of the
	-- equipment", which is this mod's default side, is off the screen
	-- entirely. The column is where the rig belongs and where its slot
	-- was just drawn, so the panel opens directly under it.
	local bag = A.bag_anchor and A.bag_rect()
	local con = bag and A.bag_content()

	if bag then
		-- To the RIGHT of the rig slot, along the top of the column -
		-- and measured from the CONTENT, so it rides the scroll with
		-- the sections instead of hanging over them.
		local ratio = utils_xml.screen_ratio()
		if not (ratio and ratio > 0) then ratio = 1 end

		-- CLEAR OF THE SLOT, WHATEVER THE SLOT IS. This was 1.4 cells
		-- across, from back when the slot was one cell wide. The slot
		-- became two and the first column of pockets ended up sitting
		-- on its corner. Measured from the constant the slot is drawn
		-- with, so the two cannot drift apart again.
		local sw = A.px(SLOT_CELLS_W, 1)
		local left = (con and con.x1) or bag.x1
		x = left + sw * ratio + GAP
		y = (con and con.y1) or bag.y1

	elseif gui and gui.equ_dialog then
		local r = Frect():set(0, 0, 0, 0)
		gui.equ_dialog:GetAbsoluteRect(r)

		y = r.y1
		x = A.left and (r.x1 - wpx - 4) or (r.x2 + 4)
	end

	x = x + A.dx
	y = y + A.dy

	-- ============================================================
	-- DOCKED, IT IS ALLOWED OFF THE TOP OF THE SCREEN
	--
	-- The clamp below keeps a floating window on screen, which is right
	-- for a window and wrong for something inside a scrolling list: the
	-- block is SUPPOSED to travel up past the top, and it is hidden
	-- when it does.
	--
	-- Clamping it would also be a bug you could not see. Zone Grid asks
	-- how many rows the block stands on, and that number is measured
	-- from the content down to the bottom of the panel. Hold the panel
	-- at the top of the screen while the content keeps sliding and the
	-- gap between them grows, so the grid re-flows every frame you
	-- scroll - items moving under the cursor for no visible reason.
	-- ============================================================
	if bag then return x, y end

	local maxx, maxy = SCREEN_W - wpx, SCREEN_H - h
	if maxx < 0 then maxx = 0 end
	if maxy < 0 then maxy = 0 end

	return clampi(x, 0, maxx), clampi(y, 0, maxy)
end

local function in_rect(px, py, x, y, w, h)
	return px >= x and px < x + w and py >= y and py < y + h
end

-- ============================================================
--  ONE CURSOR READ PER FRAME, NOT ONE PER HIT TEST
--
--  Every rectangle this mod owns is hit-tested each frame - the rig
--  slot, both pouch slots, the panel, the close box, the pin, and one
--  per pocket - and each test asked the engine where the cursor was.
--  Fifteen calls a frame for an answer that cannot change within a
--  frame, each one crossing into the engine and allocating a vector.
--
--  Stamped rather than timed: the draw pass bumps the stamp once, and
--  the input handlers mark it stale before they read, so a press is
--  still tested against where the cursor was when it was pressed.
-- ============================================================
A.fstamp = A.fstamp or 0
local CURPOS = { stamp = -1, x = 0, y = 0 }

function A.cursor_dirty()
	CURPOS.stamp = -1
end

local function cursor()
	if CURPOS.stamp ~= A.fstamp then
		local ok, p = pcall(GetCursorPosition)
		if ok and p then CURPOS.x, CURPOS.y = p.x, p.y end
		CURPOS.stamp = A.fstamp
	end
	return CURPOS.x, CURPOS.y
end

local function hit(r)
	if not r then return false end
	local x, y = cursor()
	return in_rect(x, y, r[1], r[2], r[3], r[4])
end

function A.over_panel()
	return (A.open and hit(A.clip_abs(A.rect))) and true or false
end

function A.over_pin()
	return (A.open and hit(A.pin_r)) and true or false
end

function A.over_close()
	return (A.open and hit(A.close_r)) and true or false
end

-- Which pocket is under the cursor. Reads the absolute rectangle the
-- draw pass stored; it does not recompute one.
-- Put a section's inventory picture on a static, once. Memoised on the
-- window so the texture lookup is not repeated every frame - the same
-- reason the drag ghost memoises its own.
A.icon_of = A.icon_of or setmetatable({}, { __mode = "k" })

-- The source rectangle of each section's picture in its atlas, so a
-- crop can be worked out without reading system.ltx every frame.
-- false means "asked, and there is none".
A.axis_of = A.axis_of or {}

-- How much is currently cropped off the top and the bottom of each
-- icon, so the same crop twice costs nothing. Two tables rather than
-- one pair, because the memo is compared field by field and a pair
-- would be a new table every frame.
A.crop_of = A.crop_of or setmetatable({}, { __mode = "k" })
A.cropb_of = A.cropb_of or setmetatable({}, { __mode = "k" })

function A.set_icon(w, sec)
	if not (w and type(sec) == "string") then error("no icon", 0) end
	if A.icon_of[w] == sec then return end
	w:InitTexture(utils_xml.get_icons_texture(sec))
	w:SetTextureRect(Frect():set(utils_xml.get_item_axis(sec, nil, true)))
	w:SetStretchTexture(true)
	A.icon_of[w] = sec

	-- A fresh texture rect is the whole picture again, whatever the
	-- last one was cropped to. Written straight into the memo table
	-- rather than through memo(), which is declared further down this
	-- file than the icons are.
	A.crop_of[w] = 0
	A.cropb_of[w] = 0
end

-- ============================================================
-- A PICTURE CAN BE CROPPED AFTER ALL
--
--   "the rig icon in the rig slot still hides when the invnetory is
--    not fully scrolled up"
--
-- Right, and the reason given for it was only half true. An icon drawn
-- into a shorter box IS squashed - but the box is not the only thing
-- that can be made shorter. The icon is a window onto a REGION of an
-- atlas, and taking the same fraction off the top of that region as was
-- taken off the top of the box is a real crop: the picture keeps its
-- scale and loses its top edge, exactly as the list does to an item.
--
-- The source rectangle is asked for once per section and kept, because
-- get_item_axis reads system.ltx.
-- ============================================================
function A.icon_axis(sec)
	local a = A.axis_of[sec]
	if a ~= nil then return a or nil end

	local ok, x1, y1, x2, y2 = pcall(utils_xml.get_item_axis, sec, nil, true)
	if not (ok and x1 and y1 and x2 and y2) then
		A.axis_of[sec] = false
		return nil
	end

	a = { x1, y1, x2, y2 }
	A.axis_of[sec] = a
	return a
end

-- Take `cut` pixels off the top and `cutb` off the bottom of a picture
-- that is `h` pixels tall. Guarded like every other write: the same
-- crop twice costs nothing.
function A.icon_clip(w, sec, cut, cutb, h)
	if not (w and type(sec) == "string") then return end

	local ok_h = h and h > 0
	local want  = (cut  and cut  > 0 and ok_h) and cut  or 0
	local wantb = (cutb and cutb > 0 and ok_h) and cutb or 0
	if A.crop_of[w] == want and A.cropb_of[w] == wantb then return end

	local a = A.icon_axis(sec)
	if not a then return end

	local y1, y2 = a[2], a[4]
	if want > 0 then
		local frac = want / h
		if frac > 1 then frac = 1 end
		y1 = a[2] + (a[4] - a[2]) * frac
	end
	if wantb > 0 then
		local frac = wantb / h
		if frac > 1 then frac = 1 end
		y2 = a[4] - (a[4] - a[2]) * frac
	end
	if y2 < y1 then y2 = y1 end

	pcall(function() w:SetTextureRect(Frect():set(a[1], y1, a[3], y2)) end)
	A.crop_of[w], A.cropb_of[w] = want, wantb
end

-- ============================================================
-- A MAGAZINE IN A POCKET, CUT AT THE LINE
--
--   "the magazines icons that are in the rig have the same problem
--    that the rig had, the icons dissapear when the inventory is not
--    fully scrolled up"
--
-- The rig's own icon was taught to crop rather than vanish, and this is
-- the same lesson one level down. A magazine's icon is not one of this
-- mod's windows, though - it belongs to a UICellItem the game built -
-- so the numbers have to be worked out rather than remembered:
--
--   Add_Icon ends in align_to_center(ico, cell), which is the ONLY
--   placing that icon ever gets. So where it sits inside its cell is
--   arithmetic: half the difference between the cell and the icon.
--
--   The icon's own size is measured once, when the cell is filled, and
--   kept. Measuring it later would measure whatever this crop last did
--   to it.
--
-- `cut` is how much of the CELL is above the line. The icon is usually
-- inset, so it starts being cut later than the cell does, and the two
-- must not be confused.
-- ============================================================
function A.mag_clip(cell, i, sec, cw, ch, cut, cutb)
	local ico = cell and cell.ico
	if not (ico and type(sec) == "string") then return end

	local sz = A.icosz and A.icosz[i]
	if not sz then return end

	local offx = (cw - sz[1]) / 2
	local offy = (ch - sz[2]) / 2

	local icut = cut - offy
	if icut < 0 then icut = 0 end

	local ibot = (cutb or 0) - offy
	if ibot < 0 then ibot = 0 end

	-- Wholly past one line or the other. One magazine at a time, as its
	-- own pocket goes under, rather than the whole rig at once.
	if icut + ibot >= sz[2] then
		A.wshow(ico, false)
		if cell.shadow then A.wshow(cell.shadow, false) end
		return
	end

	-- The cell moved DOWN by cut, and the icon is its child, so it came
	-- with it. Moving it back up by the same amount is what keeps the
	-- part of the picture that is still on screen exactly where it was.
	local iy = offy - cut + icut

	A.icon_clip(ico, sec, icut, ibot, sz[2])
	A.wpos(ico, offx, iy)
	A.wsize(ico, sz[1], sz[2] - icut - ibot)
	A.wshow(ico, true)

	-- The drop shadow is the same picture behind the same box. Left
	-- alone it hangs above the line on its own.
	local sh = cell.shadow
	if sh then
		local on = false
		pcall(function() on = sh:IsShown() end)
		if on then
			A.icon_clip(sh, sec, icut, ibot, sz[2])
			A.wpos(sh, offx, iy)
			A.wsize(sh, sz[1], sz[2] - icut - ibot)
		end
	end
end

-- Which pouch slot the cursor is over, if any. Its own test rather than
-- a branch inside slot_at, because a pouch slot is not a pocket and
-- every caller of slot_at would otherwise have to learn the difference.
-- Is the cursor over the rig slot?
function A.rig_at()
	-- NOT gated on A.open: the slot is drawn whenever the inventory is,
	-- and its whole purpose is to be usable before the panel exists.
	if not A.rlay then return false end

	-- What is left of it after the top of the list has cut it, which is
	-- nothing at all once it has scrolled past.
	return hit(A.clip_abs(A.rlay)) and true or false
end

-- ============================================================
-- A FUNCTION THAT ANSWERS NOTHING IS NOT A FUNCTION THAT ANSWERS NIL
--
-- Falling off the end returns NO VALUES, which is not the same as
-- returning nil. Assigned - `local i = A.slot_at()` - the difference
-- never shows. Handed straight to something, it does:
--
--     tostring(A.slot_at())
--     -> bad argument #1 to 'tostring' (value expected)
--
-- and in this engine that is a crash to desktop. It cost one: with the
-- debug log on, pressing the magazine mod's loadout key while the
-- cursor was over no pocket printed the key, the pocket and the column
-- - and "the pocket" was this call, over nothing, answering nothing at
-- all. Every press of that key crashed the game.
--
-- So both hit tests end with an explicit return, and the audit now
-- refuses any call inside tostring() whose function can fall off its
-- end.
-- ============================================================
function A.pouch_at()
	if not (A.open and A.play) then return nil end
	for i = 1, #A.play do
		if hit(A.clip_abs(A.play[i])) then return i end
	end
	return nil
end


-- Which ENTRY the cursor is on, by its own rectangle rather than by
-- arithmetic on the grid: an entry is 1x1 or 2x1 or 2x2 and the
-- rectangle already knows which.
-- Which grid square of a med pocket rectangle the cursor stands on -
-- row and column, occupied or not. The pitch is the one every drawer
-- of these pockets uses: (gs+gl) per square, x scaled by ratio.
--
-- THE GRID IS PASSED IN NOW. It used to be the med pocket's fixed 2x2,
-- and there was only ever one shape of pocket for it to be. A rig slot
-- is 1x1, 2x1, 3x1 or 2x2, so the caller says which - and a cursor two
-- squares along a 3x1 row is on column three, not off the end of a
-- pocket that no longer exists.
function A.rc_in(rect, cols, rows)
	if not rect then return nil end
	cols = cols or 1
	rows = rows or 1

	local x, y = cursor()
	local gs, gl = A.metrics()
	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then ratio = 1 end

	local c = math.floor((x - rect[1]) / ((gs + gl) * ratio)) + 1
	local r = math.floor((y - rect[2]) / (gs + gl)) + 1
	if r < 1 or r > rows or c < 1 or c > cols then return nil end
	return r, c
end



-- Which entry of a pocket list is STANDING ON a square - covering it
-- with any part of itself, not merely anchored there. Works for both
-- pockets because their entries share the r,c,w,h shape.
function A.pk_on_square(t, r, c)
	for n = 1, #t do
		local e = t[n]
		if e and r >= e.r and r <= e.r + e.h - 1
		     and c >= e.c and c <= e.c + e.w - 1 then
			return n
		end
	end
	return nil
end

-- The anchor that puts a w-by-h item OVER the aimed square, exact
-- anchor first: a two-wide thing dropped on the right square of a row
-- should cover that square by extending left, not be refused because
-- its top-left corner cannot be there.
function A.pk_aim(t, cols, rows, r, c, w, h, skip)
	for r0 = r, math.max(1, r - h + 1), -1 do
		for c0 = c, math.max(1, c - w + 1), -1 do
			-- `skip` is the entry being MOVED, which must not count as
			-- being in its own way - the same rule box_room has always
			-- had, now reachable from here.
			if A.box_room(t, cols, rows, r0, c0, w, h, skip) then
				return r0, c0
			end
		end
	end
	return nil
end

-- ============================================================
-- MOVING A PILE INSIDE THE POCKET
--
--   "allow items that in the pouch to be moved to a different slot in
--    the pouch without the need to moving it to inventory and back."
--
-- Three answers, and only one of them moves anything:
--   * the pile's own square      - "put it back", the old nothing;
--   * somebody else's square     - nothing: a move is not a merge and
--                                  not a swap, and a slip onto a full
--                                  square must leave the world alone;
--   * an empty square            - the pile stands there, anchored to
--                                  COVER the aimed square (the same
--                                  covering rule the drop uses).
--
-- One body for both pockets: panel entries and window records share
-- the r,c,w,h shape, which is the whole reason med_on_square and
-- med_aim take the list as an argument.
-- ============================================================
function A.pk_shift(t, cols, rows, n, r, c)
	local e = t and t[n]
	if not (e and r and c) then return false end

	-- THE R KEY TURNS A PILE IN PLACE. With the hand turned, the
	-- pile's own square stops meaning "put it back" and starts meaning
	-- "stand it on its side here" - which is the one way to rotate
	-- something already in the pocket without a trip through the bag.
	local tw, th = A.turned(e)
	local turn = (tw ~= (e.w or 1))

	if not turn
	   and r >= e.r and r <= e.r + e.h - 1
	   and c >= e.c and c <= e.c + e.w - 1 then
		return false
	end

	-- Somebody ELSE'S square still means nothing happened; the pile's
	-- own squares are its to turn on.
	local on = A.pk_on_square(t, r, c)
	if on and on ~= n then return false end

	local ar, ac = A.pk_aim(t, cols, rows, r, c, tw, th, n)
	if not ar then return false end

	e.r, e.c = ar, ac
	if turn then e.w, e.h, e.rot = tw, th, not e.rot or nil end
	return true
end


-- WHICH SLOT, AND WHICH PILE IN IT. Two answers from one rectangle:
-- the slot is what a DROP wants, because the packer picks the square;
-- the pile is what a TAKE wants, because it has to name a thing.
--
-- The pile can be nil over an empty square of a slot that holds
-- something elsewhere, and that is a real answer rather than a
-- failure - "this slot, no pile" is exactly what dropping on an empty
-- corner means.
function A.slot_at()
	if not (A.open and A.lay) then return nil end

	for i = 1, #A.lay do
		if hit(A.clip_abs(A.lay[i])) then
			return i, A.pk_at(i)
		end
	end

	return nil
end

-- ============================================================
-- THE CONTAINER
--
-- A manual, NON-showcase container holding real objects. Not showcase,
-- deliberately: a real object gets UICellItem's condition bar, and a
-- magazine mod drives a magazine's condition from how many rounds are
-- in it - so the bar under each mag is its fill level. A section-only
-- showcase cell suppresses that bar entirely.
--
-- utils_ui.UICellContainer reads its cell nodes from OWNER.xml when
-- `manual` is set, and the owner is UIInventory, whose xml is
-- ui_inventory.xml. So the owner's xml is swapped for ours for the
-- duration of the constructor and put straight back - which is what
-- UIInventory:InitControls itself does, twice, to build its small-icon
-- and vertical-equipment variants out of separate files.
-- ============================================================
-- ============================================================
--  THE MIDDLE LIST - MAGAZINES AND AMMO
--
--  A second inventory list, in the column, holding every magazine and
--  every box of ammo the player is carrying. The mockup has them as
--  their own section between the equipment and the bag, and that is
--  what this is.
--
--  IT IS A VIEW, NOT A CONTAINER. The items do not move: they stay in
--  the actor's ruck, weigh what they weighed, and are the same objects
--  the bag was showing. All that changes is WHICH LIST DRAWS THEM -
--  they are taken out of the bag's feed and put into this one. So there
--  is nothing to save, nothing to load, no rules about what fits, and
--  no way for a magazine to end up in neither list on a bad save. Every
--  container this mod has shipped has cost a release to that class of
--  bug; this one cannot have it.
--
--  WHAT COUNTS AS "MAGAZINES AND AMMO" IS THE GAME'S OWN ANSWER.
--  system.ltx sorts the inventory tabs by `kind`, and tab 4 - the ammo
--  tab - is exactly `kind = w_ammo`. Magazines inherit the same kind
--  from the magazine mod's base section. So this list holds what that
--  tab holds, which means it holds what the player already thinks of as
--  one category, and a mod that adds a new magazine is included without
--  this file knowing it exists.
-- ============================================================

-- ANSWERED ONCE PER SECTION. This is asked for every item in the
-- rucksack every time the bag is filtered, and the answer comes out of
-- system.ltx - which cannot change while the game is running. Without
-- the memo it is one engine call per item per refresh, on a list that
-- is hundreds of items long.
A.kindmemo = A.kindmemo or {}

-- ============================================================
--  WHERE IT SITS
--
--  Under whatever the rig is using: the pouch panel when there is a rig
--  on, the rig slot alone when there is not. Both of those report an
--  absolute rect as they draw, so this reads the one that is there
--  rather than being told a number that would have to be kept in step.
-- ============================================================
-- Docked in the column there is no title bar: the background's own
-- header carries the rig's name and its pocket count, and a second
-- title under it was the panel's window furniture showing through a
-- frame that is no longer there. Everything the panel lays out reads
-- this rather than the constant, so the pockets move up with it.
local function title_h()
	if A.bag_docked() then return 0 end
	return TITLE_H
end

function A.build()
	local gui = gui_now()
	if not (gui and gui.equ_dialog and utils_ui and utils_ui.UICellContainer) then
		return nil
	end

	local saved = gui.xml
	gui.xml = A.get_xml()

	local ok, cc = pcall(function()
		return utils_ui.UICellContainer(
			CC_ID, gui, "amp:cont", "amp:cont", gui.equ_dialog, true)
	end)

	gui.xml = saved

	if not (ok and cc) then
		log("!container build failed: %s", tostring(cc))
		return nil
	end

	-- ============================================================
	-- THE BASE CLASS'S DRAG STAYS OFF
	--
	-- 1.5.0 turned it on and handed UICellContainer:On_Drag the three
	-- moments it needs - the press, a frame, the release - on the
	-- reasoning that reusing the game's own drag beats writing one. It
	-- did not work in game, and the reason it did not is the interesting
	-- part: On_Drag's set branch runs FIVE things before it records the
	-- hold, every one of them a precondition this file cannot see from
	-- here - the container's scroll view, the cell's icon being shown,
	-- the owner's item_in_hold, the hold icon built from an xml path,
	-- and a Callback round trip back through On_CC_DragDrop. Any one of
	-- them failing means the press is silently not a hold, and a test
	-- against a transcription is a test against my guess about all five.
	--
	-- So the hold is this mod's own state now: two fields and a static.
	-- The drag no longer has a way to half-work.
	-- ============================================================
	cc.disable_drag   = true
	cc.disable_scroll = true
	cc.disable_stack  = true
	cc.disable_info   = true

	-- The base class's condition bar is turned OFF and a fill bar is
	-- drawn here instead. Not because its bar is wrong, but because
	-- InitProgressBar wants background/progress child nodes whose schema
	-- this mod has no verified copy of - and three builds have already
	-- been lost to xml that could not be checked. A plain rect is
	-- something this file can be certain about.
	cc.disable_bar    = true

	-- These would reach UIInventory and set update_info every time a
	-- cell is written. The equipment, belt and quick containers disable
	-- the same pair for the same reason.
	cc.disable_callback["On_CC_Add"] = true
	cc.disable_callback["On_CC_Remove"] = true

	-- ============================================================
	-- AND NO SCROLL BAR
	--
	-- Every container the base class builds gets a scroll pad: a light
	-- 5px bar parented to the container and placed at whatever its
	-- width was AT CONSTRUCTION. This one is manual - fixed pockets, no
	-- scrolling, disable_scroll set - so the bar can never mean
	-- anything; and because the draw pass resizes the container every
	-- time the rig changes shape, "the width at construction" lands
	-- somewhere different for every rig. That is the bar turning up
	-- across the pockets on one rig and beside them on another.
	--
	-- Hidden at the source, and again in the draw pass, because
	-- On_Scroll returns early for a container with scrolling off and so
	-- never gets to hide it itself.
	-- ============================================================
	-- Raw rather than through the guarded setters, and every frame as
	-- well as here: see the note in the draw pass.
	if cc.pad then pcall(function() return cc.pad:Show(false) end) end

	return cc
end

-- ============================================================
-- DO NOT WRITE A VALUE A CONTROL ALREADY HAS
--
-- 1.2.3 stopped the draw pass RE-READING what had not changed. This
-- stops it RE-WRITING it.
--
-- Every SetWndPos and SetWndSize on a child of a scroll container makes
-- the engine mark that window dirty and re-flow its parent, which is
-- work far out of proportion to the call itself - and the panel spent
-- most of its frames setting each control to the exact position, size
-- and colour it already had. GetARGB is an engine call too, so a colour
-- that has not changed is not even built.
--
-- THIS IS DELIBERATELY NOT A DIRTY FLAG ON THE WHOLE PASS. A pass-level
-- flag has to enumerate everything the panel depends on, and anything
-- forgotten becomes "the rig silently stops updating" - the worst bug
-- this mod could ship, and one it has come close to twice. A guard at
-- the value has no such failure mode: the only thing it can skip is a
-- write that would have changed nothing.
--
-- The memo is keyed by the control and WEAK, so a level change that
-- rebuilds every window does not hold the old ones alive.
-- ============================================================
A.last = setmetatable({}, { __mode = "k" })

-- Which pouches are fitted to which outfit's rig. [outfit_id][1..2] =
-- section. Saved with the game.
A.pslot = A.pslot or {}

local function memo(w)
	local t = A.last[w]
	if not t then t = {} A.last[w] = t end
	return t
end

function A.wpos(w, x, y)
	local t = memo(w)
	if t.px == x and t.py == y then return end
	t.px, t.py = x, y
	w:SetWndPos(vector2():set(x, y))
end

-- ============================================================
-- A WINDOW SOMEBODY ELSE ALSO MOVES
--
-- The guarded setters memoise: written once, the same value is never
-- written again. That is right for a static this file made and wrong
-- for one the MENU made, because the UI pack re-applies its own layout
-- on top of ours and the memo would then describe a position the window
-- no longer has - and the correction would be skipped for being
-- "already there".
--
-- So the memo is dropped first and the write always happens. Still
-- through A.wpos: the rule is that engine writes go through one door,
-- and "this one is special" is exactly the claim that put raw
-- SetWndPos calls all over this file the first time.
-- ============================================================
function A.wmove(w, x, y)
	A.last[w] = nil
	A.wpos(w, x, y)
end

function A.wsize(w, x, y)
	local t = memo(w)
	if t.sx == x and t.sy == y then return end
	t.sx, t.sy = x, y
	w:SetWndSize(vector2():set(x, y))
end

-- ============================================================
-- A STATIC LYING ON ITS SIDE
--
-- EnableHeading and SetHeading are the engine's own texture rotation -
-- the same pair Sota's vertical weapon slots ride (heading_angle="90"
-- in its equipment xml). Both states are written on every call because
-- the statics are POOLED: the one drawing a sideways rifle this frame
-- drew an upright bandage last frame, and a pool never remembers for
-- you.
--
-- MINUS pi/2 is clockwise. UIStaticItem's rotate_pt does
-- x' = (x cos + y sin) * kx, y' = y cos - x sin, so at -pi/2 a point
-- on the quad's right (x>0) lands at y'>0 - the bottom. The top of the
-- picture ends up pointing right, which is the way a rifle turns in
-- the game this feature is borrowed from.
-- ============================================================
local ROT_RAD = -math.pi / 2

function A.wturn(w, on)
	if not w then return end
	w:EnableHeading(on and true or false)
	w:SetHeading(on and ROT_RAD or 0)
end

-- ============================================================
-- WHOLE NUMBERS ONLY, AND THE DOOR IS WHERE THAT IS ENFORCED
--
-- GetARGB is an engine call and it wants integers. A colour worked out
-- by multiplying - dimming an empty pocket, fading a bar - comes back
-- as 60.199999999999996, and the call RAISES: the draw pass dies where
-- it stands and everything it had not painted yet is simply not there.
--
-- The memo makes that worse rather than better. It writes what it is
-- about to send BEFORE sending it, so the frame that throws is
-- remembered as done and the next frame takes the early return - the
-- fault appears once, heals itself, and comes back the next time the
-- window is rebuilt. "Sometimes the icons are missing" is the shape of
-- it from outside.
--
-- Rounding at the caller is right too, and pocket_clr does. This is the
-- door, so it is where the rule lives.
-- ============================================================
local function whole(v)
	if type(v) ~= "number" then return v end
	return math.floor(v + 0.5)
end

function A.wtint(w, a, r, g, b)
	local t = memo(w)

	-- THE MEMO IS ASKED BEFORE THE ROUNDING, and again after. What is
	-- stored is always whole, so a caller handing back the same whole
	-- numbers it did last frame - which is nearly every call, nearly
	-- every frame - answers on the first test and rounds nothing. Only
	-- a colour that actually changed pays for the four calls.
	if t.ta == a and t.tr == r and t.tg == g and t.tb == b then return end

	a, r, g, b = whole(a), whole(r), whole(g), whole(b)
	if t.ta == a and t.tr == r and t.tg == g and t.tb == b then return end
	t.ta, t.tr, t.tg, t.tb = a, r, g, b
	w:SetTextureColor(GetARGB(a, r, g, b))
end

-- HOW FULL A BAR IS. Its own setter because SetProgressPos is its own
-- call - a bar is not moved or tinted into being full - and its own
-- memo because this is written once a frame like everything else here.
function A.wprog(w, v)
	local t = memo(w)
	if t.prog == v then return end
	t.prog = v
	w:SetProgressPos(v)
end

-- ...and its colour, which is SetColor and not SetTextureColor: the
-- bar tints its own progress texture.
function A.wbarclr(w, a, r, g, b)
	local t = memo(w)
	if t.ba == a and t.br == r and t.bg == g and t.bb == b then return end

	a, r, g, b = whole(a), whole(r), whole(g), whole(b)
	if t.ba == a and t.br == r and t.bg == g and t.bb == b then return end
	t.ba, t.br, t.bg, t.bb = a, r, g, b
	w:SetColor(GetARGB(a, r, g, b))
end

function A.wcolor(w, a, r, g, b)
	local t = memo(w)
	if t.ca == a and t.cr == r and t.cg == g and t.cb == b then return end

	a, r, g, b = whole(a), whole(r), whole(g), whole(b)
	if t.ca == a and t.cr == r and t.cg == g and t.cb == b then return end
	t.ca, t.cr, t.cg, t.cb = a, r, g, b
	w:SetTextColor(GetARGB(a, r, g, b))
end

-- ============================================================
-- SetText IS A TEXT WINDOW'S METHOD, NOT A STATIC'S
--
-- A CUIStatic made from a node with a <text> child does NOT answer
-- SetText - the text lives on a child control and is reached through
-- TextControl(). Only a CUITextWnd, made with InitTextWnd, answers it
-- directly. The game's own code has both forms a few lines apart
-- (UICellItem uses self.cnt:TextControl():SetText).
--
-- Calling the wrong one throws, and this memo is what made that so hard
-- to see: the string is recorded BEFORE the call, so the first draw
-- throws and every draw after it takes the early return and does not.
-- One rig would not open, the same rig a moment later would, and a
-- second window - whose memo was empty - took both of them down with
-- it. That is the whole of "sometimes it works on the third try".
-- ============================================================
function A.wtext(w, str)
	local t = memo(w)
	if t.txt == str then return end
	w:SetText(str)
	t.txt = str
end

-- The same thing for a static that carries a glyph rather than being a
-- label. Recorded after the call, for the reason above.
function A.wglyph(w, str)
	local t = memo(w)
	if t.txt == str then return end
	w:TextControl():SetText(str)
	t.txt = str
end

-- ============================================================
-- CUT IT OFF RATHER THAN LET IT RUN OUT OF THE WINDOW
--
-- CUITextWnd:SetEllipsis. Off by default, no xml attribute, and a
-- property rather than a per-frame write - but it goes through a
-- memoised setter like everything else here, because "this one is only
-- written once" is a claim about today's call site and the audit
-- checks the rule, not the claim.
-- ============================================================
function A.wcut(w, on)
	on = on and true or false
	local t = memo(w)
	if t.cut == on then return end
	t.cut = on
	w:SetEllipsis(on)
end

function A.wshow(w, on)
	on = on and true or false
	local t = memo(w)
	if t.vis == on then return end
	t.vis = on
	w:Show(on)
end

-- ============================================================
-- CUT OFF AT THE TOP OF THE LIST
--
-- The first attempt at this hid the whole rig block the instant the
-- inventory was scrolled by a single pixel, which is not what scrolling
-- looks like:
--
--   "the rig and the slots are visible only when the invnetory is
--    fully scrolled UP"
--
-- The engine cuts the item cells off at the edge of the list because
-- they are inside its scroll view. Nothing cuts these off, so they are
-- cut off here: a pocket is a plain rectangle, and a rectangle whose
-- top is above the line is drawn shorter, from the line down. That IS
-- clipping, done by hand, and it is exact.
--
-- What cannot be done that way is a TEXTURE - an icon drawn into a
-- shorter box is squashed, not cropped - so an icon goes when its own
-- box starts to be cut. One magazine at a time rather than the whole
-- rig at once.
--
-- A.clip_top is absolute; the rectangles handed in are relative to
-- A.org, which is why the line is converted rather than the rectangle.
-- Returns nil when there is nothing left to draw.
-- ============================================================
function A.clip_cut(oy)
	if not A.clip_top then return 0 end
	local cut = (A.clip_top - (A.org[2] or 0)) - oy
	if cut < 0 then return 0 end
	return cut
end

-- How much room is left below oy before the bottom of the list. nil
-- means there is no bottom to run into - a floating panel, a trade
-- window - and is deliberately not 0, because 0 would mean "no room".
function A.clip_room(oy)
	if not A.clip_bot then return nil end
	return (A.clip_bot - (A.org[2] or 0)) - oy
end

-- BOTH ENDS OF ONE RECTANGLE, which is the only way any of this should
-- be asked. Answers how much comes off the top and how much off the
-- bottom of something that starts at oy and is ch tall, or nil when
-- there is none of it between the two lines.
function A.clip_ends(oy, ch)
	local cut = A.clip_cut(oy)
	if cut >= ch then return nil end

	local h = ch - cut
	local room = A.clip_room(oy + cut)
	if room then
		if room <= 0 then return nil end
		if room < h then h = room end
	end

	return cut, ch - cut - h
end

-- WHOLLY BETWEEN THE TWO LINES. For the things that cannot be cropped
-- at all - a line of text, a three-pixel fill bar - which are shown
-- while they fit and hidden the moment either edge reaches them.
function A.clip_whole(oy, ch)
	local cut, bot = A.clip_ends(oy, ch)
	return cut == 0 and bot == 0
end

-- Place and size a rectangle, cut off at the line. Answers how much was
-- taken off the top - nil when the whole thing is above it, and the
-- caller shows nothing.
function A.wclip(w, ox, oy, cw, ch)
	local cut, bot = A.clip_ends(oy, ch)

	if not cut then
		A.wshow(w, false)
		return nil
	end

	A.wpos(w, ox, oy + cut)
	A.wsize(w, cw, ch - cut - bot)
	return cut
end

-- The same line, applied to an absolute rectangle so a hit test agrees
-- with what is on screen. A pocket you can click where it is no longer
-- drawn is the bug the first attempt had.
function A.clip_abs(r)
	if not r then return r end

	local y1, y2 = r[2], r[2] + r[4]
	if A.clip_top and A.clip_top > y1 then y1 = A.clip_top end
	if A.clip_bot and A.clip_bot < y2 then y2 = A.clip_bot end

	if y2 <= y1 then return nil end
	if y1 == r[2] and y2 == r[2] + r[4] then return r end
	return { r[1], y1, r[3], y2 - y1 }
end

-- ============================================================
-- ONE PIECE OF STATE, ONE KEY
--
-- The cell container is not a static: showing it means showing its
-- PROFILE window, which is what every item cell lives inside. The draw
-- pass wrote cc.prof directly and A.hide called the container's own
-- Show, which writes the same window from the inside - so the guard was
-- keyed on cc.prof at one end and on the container table at the other.
--
-- Two keys for one piece of state, and the consequence was exact:
-- opening the rig set cc.prof's entry to shown; closing it hid the
-- window through the container without touching that entry; reopening
-- saw "already shown" and skipped the Show. Every pocket, every title
-- and every ammo readout redrew, because those are hidden and shown
-- through the SAME object at both ends - only the magazines were gone,
-- and only until a save reload rebuilt the container and gave it a
-- fresh entry.
--
-- Both ends now go through here: one memo key, and the container's own
-- Show at both, so its hold and hover bookkeeping still happens.
--
-- THE GENERAL RULE for every guarded write: the key must be the thing
-- the engine actually stores the state on, not whatever object happened
-- to be convenient at that call site.
-- ============================================================
function A.show_cc(cc, on)
	if not (cc and cc.prof) then return end

	on = on and true or false
	local t = memo(cc.prof)
	if t.vis == on then return end
	t.vis = on
	cc:Show(on)
end

-- ============================================================
-- DRAW
-- ============================================================

-- ============================================================
-- HIDING IS DONE ONCE, NOT ONCE A FRAME
--
-- A.draw returns A.hide() on every frame the panel should not be on
-- screen, and the inventory is open for minutes at a time with the rig
-- shut. Hiding what is already hidden cost 110 engine calls a frame -
-- every pooled static, thirty times a second, to keep them in the state
-- they were already in.
--
-- A.shown is cleared here and set by the draw pass. Nothing else may
-- write it: if a static is ever shown outside A.draw, this flag stops
-- being true and the panel will not hide.
-- ============================================================
function A.hide()
	A.rect = nil
	A.lay = nil
	A.play = nil
	A.close_r, A.pin_r = nil, nil

	-- The panel going away is the hover ending. Without this the last
	-- pocket keeps its focus, and every listener keeps highlighting for
	-- a magazine that is not on screen any more.
	A.focus_follow(nil)

	if not A.shown then return end
	A.shown, A.hid_from, A.hid_ov = false, nil, nil

	-- Through A.wshow like everything else, so the memo agrees with the
	-- screen. A Show written behind its back is how a guarded setter
	-- turns into an invisible panel.
	if A.cc then A.show_cc(A.cc, false) end
	if A.frame then A.wshow(A.frame, false) end
	if A.title then A.wshow(A.title, false) end
	if A.close_st then A.wshow(A.close_st, false) end
	if A.pin_st then A.wshow(A.pin_st, false) end

	for _, w in pairs(A.pk_out or {}) do A.wshow(w, false) end
	for _, w in pairs(A.pk_gr or {}) do A.wshow(w, false) end
	for _, w in pairs(A.ps_out or {}) do A.wshow(w, false) end
	for _, w in pairs(A.ps_in or {}) do A.wshow(w, false) end
	for _, w in pairs(A.ps_ico or {}) do A.wshow(w, false) end
	for _, w in pairs(A.pk_in or {}) do A.wshow(w, false) end
	for _, w in pairs(A.ov_ammo or {}) do A.wshow(w, false) end
	for _, w in pairs(A.ov_cnt or {}) do A.wshow(w, false) end
	for _, w in pairs(A.ov_bar or {}) do A.wshow(w, false) end
end

-- ============================================================
-- HOW MUCH OF THE FRAME THIS MOD IS
--
--   "fps drop when opening inventory is massive about 50%"
--
-- A number nobody had. Every guess about what a draw costs in this
-- engine has been arithmetic on call counts, and the only honest
-- answer is a clock in the running game.
--
-- time_global is milliseconds, so ONE frame reads as 0 or 1 and means
-- nothing. Summed over 120 of them it means a great deal: sixty frames
-- a second, so 120 frames is two seconds, and a panel that is using
-- 8ms a frame reports about 960. One that is not the problem reports
-- single figures.
--
-- Debug only, and two engine calls a frame when it is on: a
-- measurement that changes what it measures is worth almost nothing.
-- ============================================================
function A.clock_in()
	if not A.debug then return nil end
	return time_global()
end

function A.clock_out(t0)
	if not (A.debug and t0) then return end

	A.ms_sum = (A.ms_sum or 0) + (time_global() - t0)
	A.ms_n = (A.ms_n or 0) + 1

	if A.ms_n >= 120 then
		log("the panel used %s ms over %s frames (%s windows made)",
		    tostring(A.ms_sum), tostring(A.ms_n),
		    tostring((A.mk[1] or 0) + (A.mk[2] or 0) + (A.mk[3] or 0)))
		A.ms_sum, A.ms_n = 0, 0
	end
end

function A.draw(bag_cc)
	local t0 = A.clock_in()

	-- A new frame: the cursor is read again on the first hit test that
	-- wants it, and once only.
	A.fstamp = (A.fstamp or 0) + 1

	-- Everything asked during this draw that cannot change during it.
	-- Cleared at the end, so nothing outside the draw ever reads an
	-- answer from inside one.
	--
	-- A.oc WAS ALLOCATED HERE TOO, and nothing has read it for a long
	-- time - a table made and thrown away every frame, with a comment
	-- above this function still describing it as the object cache.
	A.fc_open()

	-- The block is measured every frame and painted only while the top
	-- of the list is on screen. Set here and cleared immediately after,
	-- so nothing below this line inherits it - the open rig windows and
	-- the tooltip are not in the list and do not scroll with it.
	-- WHERE THE TOP OF THE LIST IS, for this frame. Everything the rig
	-- block draws is cut off at it, and it is KEPT after the draw so
	-- the hit tests further down the frame agree with what is on
	-- screen. nil when there is no list to be cut off by - a floating
	-- panel, a trade window, the open rig windows.
	local okc, top, bot = pcall(A.clip_line)
	A.clip_top = okc and top or nil
	A.clip_bot = okc and bot or nil

	local ok, err = pcall(A.draw_body, bag_cc)

	-- BEFORE THE CACHES GO. The block's rectangles have just been
	-- written and the content's top is still this frame's, which is the
	-- one moment the two belong to each other. Zone Grid reads the
	-- answer next frame, before this draw runs again.
	local okm, rows = pcall(A.measure_block)
	A.block_rows = (okm and type(rows) == "number") and rows or nil

	A.fc_close()

	-- AFTER the panel, because the list goes under whatever the panel
	-- turned out to be - and outside its pcall, because a panel that
	-- failed to draw is exactly when the list still needs putting away.

	-- LAST: the open rig is a window OVER the inventory, so it is drawn
	-- over everything the inventory has - and it is put away by hand if
	-- its own draw throws, or it would sit there with no way to close
	-- it.
	local ok3, err3 = pcall(A.win_draw)
	if not ok3 then
		log("!open rig: %s", tostring(err3))
		pcall(A.win_close_all, "the draw threw")
	end

	A.clock_out(t0)

	if not ok then error(err, 0) end
end

-- ============================================================
-- WHERE THE RIG SLOT IS, AND THEREFORE WHERE THE MED POCKET IS
--
-- In the middle column when the split layout opened one, and in the
-- equipment panel's top corner when it did not - which is what every
-- install without the split, and every mode that is not the personal
-- inventory, still gets.
--
-- A FIXED ANCHOR ON THE DIALOG rather than on the panel, so neither
-- moves when the panel opens, closes or changes size.
--
-- ONE COPY OF THIS ARITHMETIC, because two would drift, and the way
-- they would drift is the pocket landing on the slot: a control drawn
-- in one place and clicked in another.
--
-- Answers x, y and the SLOT's size in pixels. The pocket reads the
-- height to know how far to drop.
-- ============================================================
-- ============================================================
-- ONE SCRATCH RECTANGLE FOR THE PER-FRAME ANCHOR WORK
--
-- draw_slot, slot_anchor and med_place each allocated a Frect every
-- frame to ask the dialog where it is. They share this one now, under
-- ONE RULE: copy the fields out before calling anything else, because
-- the next user writes over it. All three do - each reads x1/y1 into
-- its own variables on the next line.
--
-- Lazily made, never at chunk scope: Frect is the engine's, and
-- reading the engine while this file is still loading is a documented
-- way for a mod not to load at all.
--
-- ONLY THESE THREE. The other Frect sites in this file are older, some
-- hold their rectangle across calls, and reasoning about aliasing
-- across all of them is how a performance pass ships a bug.
-- ============================================================
local scratch_fr

local function scratch_rect()
	scratch_fr = scratch_fr or Frect()
	return scratch_fr:set(0, 0, 0, 0)
end

function A.slot_anchor(gui, ratio)
	if not (gui and gui.equ_dialog and ratio and ratio > 0) then return nil end

	local cw, ch = A.px(SLOT_CELLS_W, SLOT_CELLS_H)
	local w, h = cw * ratio, ch

	local bag = A.bag_anchor and A.bag_rect()
	local con = bag and A.bag_content()

	if bag then
		-- The corner of the column, with the pockets beside it - the
		-- corner of the CONTENT, which is the corner the first row of
		-- the grid is drawn from and which moves when it is scrolled.
		return (con and con.x1) or bag.x1,
		       (con and con.y1) or bag.y1, w, h
	end

	local fr = scratch_rect()
	gui.equ_dialog:GetAbsoluteRect(fr)
	return fr.x1 + 6 * ratio, fr.y1 + 6, w, h
end

-- ============================================================
-- ...AND THE POCKET, DIRECTLY UNDER IT
--
--   "move the slot directly under the rig slot so it does not flow
--    under magazine slots and expand the inventory for no reaseon."
--
-- Same x, so the two line up without arithmetic: the slot is two cells
-- wide and so is the pocket.
--
-- IT DOES NOT DEPEND ON THE SLOT EXISTING. amp_rig_item is the switch
-- between "a rig is an item you wear" and the older "your armour
-- grants the pockets", and with it off there is no slot - but there is
-- still a rig, and the pocket has nothing to do with that choice. With
-- no slot it takes the corner itself, which is where the slot would
-- have been.
--
-- A SQUARE IS gs + gl ACROSS. The grid metrics are the icon size and
-- the line between two icons, so the step from one column to the next
-- is both of them - the same arithmetic A.px does, read the other way
-- round.
-- ============================================================



function A.draw_slot(gui)
	local xml = A.get_xml()
	if not (xml and gui and gui.equ_dialog) then return end

	if not A.rs_out then
		A.rs_out = A.mkstatic(xml, "amp:rig", gui.equ_dialog)
		A.rs_in  = A.mkstatic(xml, "amp:rig", gui.equ_dialog)
		A.rs_ico = A.mkstatic(xml, "amp:rig", gui.equ_dialog)

		-- AFTER THE ICON, because they are drawn ON it - the same
		-- place and the same order the window puts a condition bar on
		-- an outfit's cell.
		A.rs_bar = A.mkbar(xml, "amp:rigbar", gui.equ_dialog)
	end

	local fr = scratch_rect()
	gui.equ_dialog:GetAbsoluteRect(fr)
	A.org[1], A.org[2] = fr.x1, fr.y1

	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then return end

	-- TWO CELLS BY THREE, the size of a thing rather than a marker.
	-- Everything else in the window is measured in cells and a slot
	-- that is not looks like an accident. Where it goes is
	-- A.slot_anchor, which the med pocket reads too.
	local x, y, w, h = A.slot_anchor(gui, ratio)
	if not x then return end

	A.rlay = { x, y, w, h }

	local ox, oy = x - A.org[1], y - A.org[2]
	local sec = A.rig_sec()

	local scut = A.wclip(A.rs_out, ox, oy, w, h)
	if scut then
		if A.rig_at() then
			A.wtint(A.rs_out, 255, 170, 170, 180)
		elseif sec then
			A.wtint(A.rs_out, 255, 96, 92, 70)
		else
			A.wtint(A.rs_out, 255, 44, 46, 54)
		end
		A.wshow(A.rs_out, true)
	end

	if A.wclip(A.rs_in, ox + 1, oy + 1, w - 2, h - 2) then
		A.wtint(A.rs_in, 255, 14, 15, 19)
		A.wshow(A.rs_in, true)
	end

	-- The rig's own picture, CROPPED at the line rather than taken away
	-- - see A.icon_clip.
	local drew = false
	if sec and scut then
		local ok, err = pcall(A.set_icon, A.rs_ico, sec)
		if ok then
			local iy, ih = oy + 2, h - 4
			local icut, ibot = A.clip_ends(iy, ih)
			if icut then
				A.icon_clip(A.rs_ico, sec, icut, ibot, ih)
				A.wpos(A.rs_ico, ox + 2, iy + icut)
				A.wsize(A.rs_ico, w - 4, ih - icut - ibot)
				A.wtint(A.rs_ico, 255, 255, 255, 255)
				A.wshow(A.rs_ico, true)
				drew = true
			end
		else
			A.rico_bad = A.rico_bad or {}
			if not A.rico_bad[sec] then
				A.rico_bad[sec] = true
				log("!rig icon %s: %s", tostring(sec), tostring(err))
			end
		end
	end
	if not drew then A.wshow(A.rs_ico, false) end

	local okr, errr = pcall(A.draw_slot_wear, gui, ox, oy, w, h)
	if not okr then log("!rig readout: %s", tostring(errr)) end
end

-- ============================================================
-- WHAT THE SLOT SAYS ABOUT THE RIG IN IT
--
--   "add so when rig is in rigslot i can see its durability and dots
--    that represent each part, just like in armours when it is in
--    equipment slot"
--
-- An outfit in its slot gets a condition bar and, above it, one dot per
-- PART - which is the armour's own idea of what it is made of. A rig
-- has no armour parts. It has POCKETS, and this mod has had an idea of
-- which of them are whole since the first release: a rig arrives off a
-- corpse torn, wears from being shot at, tears a pocket at a time at
-- fixed steps, and mends. So the dots are the pockets, whole or torn,
-- in the order they are drawn in the panel.
--
-- That is the same sentence as the armour's - one dot per part of the
-- thing, coloured by the state of that part - said about the parts a
-- rig actually has.
--
-- DRAWN OVER THE ICON, not beside it: the slot is two cells by three
-- and there is no room for a band of its own, which is exactly why the
-- window draws a cell's bar over its picture too.
-- ============================================================
-- A dot is 3 by 4 and they sit a pixel apart, which is Item UI
-- Improvements' own cond_dot at its own size. Shrunk only when a rig
-- has more parts than the slot is wide - which no rig has, and which
-- the code should survive anyway.
local DOT_W, DOT_H, DOT_GAP = 3, 4, 1
local BAR_H = 6

-- The condition ramp, in the numbers the game's own condition bar uses:
-- red at nothing, pale yellow at half, green at whole. Written out
-- rather than read from the mod that draws the dots, because that mod
-- may not be installed and the colours have to be the same either way.
function A.cond_rgb(c)
	if c < 0 then c = 0 elseif c > 1 then c = 1 end

	local r1, g1, b1 = 196, 18, 18        -- 0.0
	local r2, g2, b2 = 255, 255, 118      -- 0.5
	local r3, g3, b3 = 107, 207, 119      -- 1.0

	if c <= 0.5 then
		local t = c / 0.5
		return math.floor(r1 + (r2 - r1) * t + 0.5),
		       math.floor(g1 + (g2 - g1) * t + 0.5),
		       math.floor(b1 + (b2 - b1) * t + 0.5)
	end

	local t = (c - 0.5) / 0.5
	return math.floor(r2 + (r3 - r2) * t + 0.5),
	       math.floor(g2 + (g3 - g2) * t + 0.5),
	       math.floor(b2 + (b3 - b2) * t + 0.5)
end

-- ============================================================
-- THE PARTS OF THE THING IN THE SLOT
--
-- The same list the dots on its icon are drawn from: item_parts owns
-- it, the body-health system fills it in, and every mod that shows
-- part condition asks this. A build without it has no parts to show
-- and no dots, which is exactly what it has in the bag as well.
--
-- The conditions come back 0..99 and by part section. Sorted by NAME
-- so the dots keep their order between frames - the list is a hash and
-- would otherwise shuffle every time it is walked, which is a row of
-- dots that changes colour while you look at it.
-- ============================================================
-- ONCE A FRAME PER OBJECT. The list is rebuilt, its per-part tables
-- made and a comparator closure handed to table.sort, on every frame
-- the rig slot is drawn - for parts whose condition moves when you are
-- shot at, not between two reads in one frame.
function A.parts_of(obj)
	if A.fc_on and A.once then
		return A.once("parts", obj, A.parts_of_now)
	end
	return A.parts_of_now(obj)
end

local function parts_cmp(a, b) return a.sec < b.sec end

function A.parts_of_now(obj)
	local ip = rawget(_G, "item_parts")
	if not (ip and ip.get_parts_con and obj) then return nil end

	local ok, t = pcall(ip.get_parts_con, obj, nil, true)
	if not (ok and type(t) == "table") then return nil end

	local out = {}
	for part, con in pairs(t) do
		if SYS_GetParam(1, part, "cond_part") then
			out[#out + 1] = { sec = part, con = con }
		end
	end
	if #out == 0 then return nil end

	table.sort(out, parts_cmp)
	return out
end

function A.draw_slot_wear(gui, ox, oy, w, h)
	local function off()
		A.wshow(A.rs_bar, false)
		for i = 1, #(A.rs_dot or {}) do A.wshow(A.rs_dot[i], false) end
	end

	-- THE RIG, NOT THE PICTURE OF IT. Whether the icon was drawn is a
	-- different question - a texture that will not resolve leaves the
	-- slot empty-looking and the rig is still in it - and being
	-- scrolled off the list is answered by the clip below, where every
	-- other rectangle in this file answers it.
	local obj = A.rig_obj()
	if not obj then return off() end

	local cond = A.rig_cond(obj)

	-- THE BAR, along the bottom inside edge.
	local bx, bw = ox + 3, w - 6
	local by = oy + h - 3 - BAR_H
	if bw > 4 and A.clip_whole(by, BAR_H) then
		A.wpos(A.rs_bar, bx, by)
		A.wsize(A.rs_bar, bw, BAR_H)
		A.wprog(A.rs_bar, cond)

		local r, g, b = A.cond_rgb(cond)
		A.wbarclr(A.rs_bar, 255, r, g, b)
		A.wshow(A.rs_bar, true)
	else
		A.wshow(A.rs_bar, false)
	end

	-- ...AND ONE DOT PER PART ABOVE IT.
	A.rs_dot = A.rs_dot or {}
	local parts = A.parts_of(obj)
	local n = parts and #parts or 0
	local dy = by - 1 - DOT_H

	if n < 1 or not A.clip_whole(dy, DOT_H) then
		for i = 1, #A.rs_dot do A.wshow(A.rs_dot[i], false) end
		return
	end

	-- AS WIDE AS THEY CAN BE AND STILL ALL FIT. The slot is two cells
	-- across; dots that kept their size past that would be cropped at
	-- the edge, which would say the thing has fewer parts than it has.
	local dw, gap = DOT_W, DOT_GAP
	if n * dw + (n - 1) * gap > bw then
		gap = 0.5
		dw = (bw - (n - 1) * gap) / n
		if dw < 0.5 then dw = 0.5 end
	end

	for i = 1, n do
		if not A.rs_dot[i] then
			A.rs_dot[i] = A.mkstatic(A.get_xml(), "amp:rigdot",
			                         gui.equ_dialog)
		end
		local d = A.rs_dot[i]
		A.wpos(d, bx + (dw + gap) * (i - 1), dy)
		A.wsize(d, dw, DOT_H)

		-- 0..99 IS THE SCALE, and below zero is a part that is not
		-- there at all - which the mod that draws these paints grey
		-- rather than red, because missing and broken are different
		-- things.
		local con = parts[i].con or -1
		if con < 0 then
			A.wtint(d, 235, 120, 120, 120)
		else
			local r, g, b = A.cond_rgb(con / 99)
			A.wtint(d, 255, r, g, b)
		end
		A.wshow(d, true)
	end

	for i = n + 1, #A.rs_dot do A.wshow(A.rs_dot[i], false) end
end

-- ============================================================
-- THE BACKPACK SLOT
--
--   "i want the back pack in the middle collumn where the green icon
--    is. its still next to pda and detector. in equipment collumn"
--
-- The engine's backpack slot is slot 13, and the UI pack draws it
-- inside the equipment block's SCROLLING BOX. That box cuts off
-- anything past its own edge, so no number in the file that positions
-- it can put it in the middle column - and nothing inside it can ever
-- scroll with the bag, which is the other half of what was asked for.
--
-- So the real one is parked off screen - the same trick the UI pack
-- already plays on the artefact cell, which sits at y="-1000" - and
-- this draws one where it was asked for.
--
-- THE ITEM IS STILL IN SLOT 13. This is a picture of that slot with a
-- hit test on it. Putting something in goes through the menu's own
-- Action_Equip and the menu on it is the menu's own InitProperties, so
-- every mod hooked to either sees exactly what it saw before, and
-- nothing here knows what "wearing a backpack" means.
--
-- WHERE it stands is Zone Grid's answer and not this file's: the
-- gutter is its idea, the sections are its idea, and which row the
-- backpack section starts on is a number only it has. Asked through a
-- plain global, the way everything between these two mods is asked -
-- see A.hold_square and zzz_amp_grid.reserve.
-- ============================================================
function A.pack_obj()
	if not db.actor then return nil end
	local ok, obj = pcall(function() return db.actor:item_in_slot(13) end)
	return (ok and obj) or nil
end

function A.pack_sec()
	local obj = A.pack_obj()
	if not obj then return nil end
	local ok, sec = pcall(function() return obj:section() end)
	return ok and sec or nil
end

-- Is this thing a backpack? The game's own answer, from _ITM, rather
-- than a list of sections here that an addon would have to be added to.
function A.is_pack(obj)
	if not obj then return false end
	local ok, r = pcall(function() return IsItem("backpack", nil, obj) end)
	return (ok and r) and true or false
end

-- The square, in absolute screen pixels. Measured from the CONTENT's
-- corner rather than the window's, which is the whole reason it moves
-- when the list is scrolled - the same anchor the rig block stands on.
function A.pack_where()
	local cc = A.bag_cc()
	if not cc then return nil end

	local ok, x, y, w, h = pcall(function()
		return zzz_amp_grid.pack_slot(cc)
	end)
	if not (ok and type(x) == "number" and type(y) == "number"
	        and type(w) == "number" and type(h) == "number"
	        and w > 0 and h > 0) then
		return nil
	end

	local con = A.bag_content()
	if not con then return nil end
	return { con.x1 + x, con.y1 + y, w, h }
end

function A.pack_at()
	-- NOT gated on A.open, for the same reason the rig slot is not: it
	-- is drawn whenever the inventory is. And clipped, so a square that
	-- has scrolled off the top of the list cannot be clicked where it is
	-- no longer drawn.
	if not A.pklay then return false end
	return hit(A.clip_abs(A.pklay)) and true or false
end

function A.hide_pack()
	A.pklay = nil
	if A.bp_out then A.wshow(A.bp_out, false) end
	if A.bp_in then A.wshow(A.bp_in, false) end
	if A.bp_ico then A.wshow(A.bp_ico, false) end
end

function A.draw_pack(gui)
	local xml = A.get_xml()
	if not (xml and gui and gui.equ_dialog) then return A.hide_pack() end

	local at = A.pack_where()
	if not at then return A.hide_pack() end

	if not A.bp_out then
		A.bp_out = A.mkstatic(xml, "amp:rig", gui.equ_dialog)
		A.bp_in  = A.mkstatic(xml, "amp:rig", gui.equ_dialog)
		A.bp_ico = A.mkstatic(xml, "amp:rig", gui.equ_dialog)
	end

	local fr = Frect():set(0, 0, 0, 0)
	gui.equ_dialog:GetAbsoluteRect(fr)
	A.org[1], A.org[2] = fr.x1, fr.y1

	A.pklay = at
	local ox, oy = at[1] - A.org[1], at[2] - A.org[2]
	local w, h = at[3], at[4]
	local sec = A.pack_sec()

	local cut = A.wclip(A.bp_out, ox, oy, w, h)
	if not cut then
		-- Scrolled off one end or the other. wclip has put the outline
		-- away already;
		-- the other two go with it, and A.pklay stays so the hit test
		-- keeps agreeing with the drawing through clip_abs.
		A.wshow(A.bp_in, false)
		A.wshow(A.bp_ico, false)
		return
	end

	if A.pack_at() then
		A.wtint(A.bp_out, 255, 170, 170, 180)
	elseif sec then
		A.wtint(A.bp_out, 255, 96, 92, 70)
	else
		A.wtint(A.bp_out, 255, 44, 46, 54)
	end
	A.wshow(A.bp_out, true)

	if A.wclip(A.bp_in, ox + 1, oy + 1, w - 2, h - 2) then
		A.wtint(A.bp_in, 255, 14, 15, 19)
		A.wshow(A.bp_in, true)
	end

	local drew = false
	local iy, ih = oy + 2, h - 4
	local icut, ibot = A.clip_ends(iy, ih)

	if icut and sec then
		-- WORN: the backpack's own picture, cropped at the line rather
		-- than taken away, the same as the rig's.
		local ok, err = pcall(A.set_icon, A.bp_ico, sec)
		if ok then
			A.bp_glyph = nil
			A.icon_clip(A.bp_ico, sec, icut, ibot, ih)
			A.wpos(A.bp_ico, ox + 2, iy + icut)
			A.wsize(A.bp_ico, w - 4, ih - icut - ibot)
			A.wtint(A.bp_ico, 255, 255, 255, 255)
			A.wshow(A.bp_ico, true)
			drew = true
		else
			A.bico_bad = A.bico_bad or {}
			if not A.bico_bad[sec] then
				A.bico_bad[sec] = true
				log("!backpack icon %s: %s", tostring(sec), tostring(err))
			end
		end

	elseif icut then
		-- EMPTY: WHATEVER ZONE GRID OFFERS, WHICH IS NOTHING TODAY.
		--
		--   "the backpack ill make and provide later now make the slot
		--    empty"
		--
		-- It used to be the backpack section's glyph. The icons are
		-- gone, G.pack_glyph answers nil, and an empty slot is an empty
		-- frame. The branch stays because the player's own picture is
		-- being drawn and this is where it goes: one function on the
		-- other side of the door starts answering, and it appears.
		local ok, tex, x1, y1, x2, y2, ga, gr, gg, gb = pcall(function()
			return zzz_amp_grid.pack_glyph()
		end)
		if ok and type(tex) == "string" and tex ~= "" then
			if A.bp_glyph ~= tex then
				A.bp_glyph = tex
				A.icon_of[A.bp_ico] = nil
				pcall(function()
					A.bp_ico:InitTexture(tex)
					A.bp_ico:SetStretchTexture(true)
					A.bp_ico:SetTextureRect(Frect():set(x1, y1, x2, y2))
				end)
			end
			A.wpos(A.bp_ico, ox + 2, iy + icut)
			A.wsize(A.bp_ico, w - 4, ih - icut - ibot)
			A.wtint(A.bp_ico, ga or 255, gr or 120, gg or 190, gb or 130)
			A.wshow(A.bp_ico, true)
			drew = true
		end
	end

	if not drew then A.wshow(A.bp_ico, false) end
end







-- ============================================================
-- THE POUCH POCKETS, DRAWN AND CLICKED
-- ============================================================
-- A.pk_cells[i][n] is the screen rectangle of entry n in slot i, kept
-- for the hit tests - which is why the draw below fills it even on a
-- frame where nothing is painted.
--
-- A.pkd, THE ICON POOLS, IS DECLARED ONCE AND BELOW. It used to be
-- declared here too, as a bare `A.pkd = A.pkd or {}` left over from
-- the pool this replaced - and being FIRST, it won: the real
-- declaration's `or { ico = {}, cnt = {} }` then found a table already
-- there and kept the empty one. Every draw died on `pairs(A.pkd.ico)`
-- inside a pcall, so nothing in any slot was ever painted and the log
-- said only "!slot contents".
--
-- Two declarations of one field is the whole bug. The audit checks
-- that no A.field is both a function and a table; it did not check
-- that no field is declared twice, and now it does.
-- ============================================================
A.pk_cells = A.pk_cells or {}
-- ============================================================
-- WHAT IS STANDING IN THE SLOTS, DRAWN
--
-- The BORDERS are not here. The panel's own loop in A.draw_body draws
-- one bordered box per slot and the faint divisions inside an empty
-- one, exactly as it always has; this draws what is IN them, over the
-- top, and nothing else. Two passes over the same rectangles would be
-- two statics per slot where one will do, and in a retained UI every
-- window is walked every frame.
--
-- THE POOLS ARE FLAT, not one per slot. A rig can be twenty-six
-- squares and hold at most twenty-six things, so an icon pool indexed
-- by "the nth thing drawn this frame" is bounded by the rig's cells
-- however many slots those cells are divided into - where a pool per
-- slot would be MAX_SLOTS times the biggest slot, most of it never
-- made and all of it walked.
--
-- A.pk_cells[i][n] is the screen rectangle of entry n in slot i, kept
-- for the hit tests, which is why this runs even when nothing draws.
-- ============================================================
A.pkd = A.pkd or { ico = {}, cnt = {} }

-- A window of pool[key][n], made once under the panel dialog. The node
-- is "amp:med" for an icon, but the COUNT must be the game's own
-- counter plate "amp:cnt" (an 18x10 static with a text child), the
-- same node the bag writes its stack numbers on - drawing it on an
-- "amp:med" static was the "buggy stack indicator" the player saw.
local function pkd_win(key, n)
	local t = A.pkd[key]
	if t[n] then return t[n] end
	local parent = A.pk_parent
	if not parent then return nil end
	local node = (key == "cnt") and "amp:cnt" or "amp:med"
	t[n] = A.mkstatic(A.get_xml(), node, parent)
	return t[n]
end

function A.pk_hide()
	for _, w in pairs(A.pkd.ico) do A.wshow(w, false) end
	for _, w in pairs(A.pkd.cnt) do A.wshow(w, false) end
	for i = 1, #A.pk_cells do
		local c = A.pk_cells[i]
		for n = #c, 1, -1 do c[n] = nil end
	end
end

function A.pk_draw()
	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then ratio = 1 end
	local gs, gl = A.metrics()

	-- The running index into the flat pools: "the nth thing drawn".
	local drew = 0

	for i = 1, #A.pk do
		local P = A.pk[i]
		local r = A.pk_lay and A.pk_lay[i]

		-- THE CELLS ARE KEPT WHETHER OR NOT ANYTHING IS DRAWN, because
		-- a hit test asked on a frame the panel was scrolled off would
		-- otherwise answer against last frame's rectangles.
		A.pk_cells[i] = A.pk_cells[i] or {}
		local cells = A.pk_cells[i]

		if P and r then
			-- ============================================================
			-- THE RECTANGLES ARE OVERWRITTEN, NOT REMADE
			--
			-- One four-number table per thing in the rig, thrown away
			-- and built again on every frame the inventory is open. The
			-- numbers change; the tables do not need to.
			--
			-- TRIMMED AFTERWARDS RATHER THAN EMPTIED FIRST, so `#cells`
			-- is exact for the hit tests and a table is only dropped
			-- when the pocket actually holds fewer things than it did.
			-- ============================================================
			local n = 0
			for k = 1, #P.slots do
				local e = P.slots[k]
				local ew, eh = A.px(e.w, e.h)
				local x = r[1] + ((e.c - 1) * (gs + gl)) * ratio
				local y = r[2] + (e.r - 1) * (gs + gl)

				n = n + 1
				local c = cells[n]
				if c then
					c[1], c[2], c[3], c[4] = x, y, ew * ratio, eh
				else
					cells[n] = { x, y, ew * ratio, eh }
				end
			end
			for k = #cells, n + 1, -1 do cells[k] = nil end

			for n = 1, #P.slots do
				local e = P.slots[n]
				local c = cells[n]
				local ico = c and pkd_win("ico", drew + 1)

				if ico then
					local cx, cy = c[1] - A.org[1], c[2] - A.org[2]
					-- THE FREE FORM. `pcall(f, args)` where a closure was
					-- being made per entry per frame for no reason: the
					-- arguments are already values.
					local ok = pcall(A.set_icon, ico, e.sec)

					if ok then
						local iy, ih = cy + 1, c[4] - 2
						local icut, ibot = A.clip_ends(iy, ih)

						if icut then
							drew = drew + 1
							A.icon_clip(ico, e.sec, icut, ibot, ih)

							if e.rot and icut == 0 and ibot == 0 then
								local fw, fh = c[3] - 2, ih
								A.wpos(ico, cx + 1 + (fw - fh) / 2,
								       iy + (fh - fw / ratio) / 2)
								A.wsize(ico, fh, fw / ratio)
								A.wturn(ico, true)
							else
								A.wpos(ico, cx + 1, iy + icut)
								A.wsize(ico, c[3] - 2, ih - icut - ibot)
								A.wturn(ico, false)
							end

							A.wtint(ico, 255, 255, 255, 255)
							A.wshow(ico, true)

							local many = A.pk_show(P, n)
							local cnt = (many > 1) and pkd_win("cnt", drew)
							                        or A.pkd.cnt[drew]
							if cnt and many > 1 and A.wclip(cnt, cx, cy,
								CNT_W * ratio, CNT_H) then
								A.wglyph(cnt, "x" .. tostring(many))
								A.wshow(cnt, true)
							elseif cnt then A.wshow(cnt, false) end
						else
							A.wshow(ico, false)
						end
					else
						A.wshow(ico, false)
					end
				end
			end
		else
			-- NO POCKET OR NOTHING TO DRAW IN IT. The rectangles still
			-- have to go, or a hit test on a frame the panel was
			-- scrolled off would answer against the last good one.
			for k = #cells, 1, -1 do cells[k] = nil end
		end
	end

	-- The tail of the pools. Counted rather than keyed off #A.pk,
	-- because how many things a rig is holding is not how many slots
	-- it has - which is exactly why the pools are flat.
	for n, w in pairs(A.pkd.ico) do
		if n > drew then A.wshow(w, false) end
	end
	for n, w in pairs(A.pkd.cnt) do
		if n > drew then A.wshow(w, false) end
	end
end

-- ============================================================
-- WHERE THE THING IN HAND WOULD LAND IN A POCKET
--
--   "add green/red highlight when dragging items above slots in rigs
--    so its kinda looks like in boxes. i can se the rotation and where
--    the item will go"
--
-- The boxes have had this since they were written and the rig never
-- did, which is the whole of the complaint: in a box you can see the
-- footprint, the rotation and the answer before you let go, and over a
-- rig you let go and hoped.
--
-- THREE ANSWERS, not two, and the third is the one that matters:
--
--   true   it lands on exactly these squares
--   false  it does not go in at all
--   nil    it goes in, but not here - the packer will find it a
--          place, so painting this red would be a lie
--
-- ONE BODY FOR BOTH RIGS. A worn pocket's entries count their objects
-- and a held rig's count a packed pile; everything else about the
-- question - the footprint, the turn, the anchor, the join - is
-- identical, and writing it twice is how the panel and the window
-- would come to disagree about a drop the player can see.
-- ============================================================
local function entry_n(e)
	if not e then return 0 end
	if e.ids then return #e.ids end
	return A.win_pile_n(e)
end

-- ============================================================
-- WHERE A DROP LANDS IN ONE POCKET - THE ONLY ANSWER THERE IS
--
-- ASKED BY BOTH THE HIGHLIGHT AND THE DROP. A green rectangle over a
-- square the drop does not use is worse than no rectangle at all, and
-- the only way to be sure they agree is for there to be one answer.
-- The boxes learned this; the rig has now learned it twice.
--
-- Returns:
--
--   n, r, c, w, h, rot, aimed
--
-- where `n` is the pile it joins or nil for a square of its own, and
-- `aimed` says the answer is THE SQUARE THE PLAYER POINTED AT rather
-- than one the packer chose. A bare nil means it does not go in this
-- pocket at all.
--
-- `aimed` is what the green and the grey are: green when letting go
-- puts it exactly where the block is, grey when it goes in the pocket
-- but somewhere else. There is no second opinion to disagree with,
-- because the highlight and the drop ask this one function.
--
-- IT LIES DOWN IF IT HAS TO.
--
--   "2x2 slots issue if item not rotated but will fit into the 2x2
--    slot when it will be rotated ... item is not autorotating to fit
--    this 2x2 slot"
--
-- The way the thing is being held is tried first, and the other way up
-- second. A 2x2 pocket with a magazine standing down one side has a
-- hole one square wide and two tall, and a wide thing goes in there on
-- its side or not at all - A.rig_spot has always known that and the
-- pocket's own packer did not, so the rig refused things its own
-- tooltip had promised it would take.
--
-- AND THE WAY IT IS BEING HELD IS THE WAY IT WAS LYING. A.turned reads
-- the entry's own footprint - how it lies in the bag, or in the box it
-- came out of - and applies the R key on top of that. Asking the
-- SECTION instead is what lost the rotation crossing from a box into a
-- rig.
-- ============================================================
function A.fit_land(cols, rows, list, cap, it, r, c, skip)
	if not (cols and rows and it and list) then return nil end

	local sec = it.sec
	cap = cap or 1

	local cw, ch = A.cells(sec)
	local function rot_of(w)
		if cw == ch then return nil end
		return (w ~= cw) and true or nil
	end

	-- Both ways up, the way it is held first.
	local w1, h1 = A.turned(it)
	local ways = { { w1, h1 } }
	if w1 ~= h1 then ways[2] = { h1, w1 } end

	-- 1. THE AIMED SQUARE. Centred on the cursor, because that is where
	--    the menu draws the icon it is carrying.
	if r and c then
		for q = 1, #ways do
			local iw, ih = ways[q][1], ways[q][2]
			if iw <= cols and ih <= rows then
				local tr = r - math.floor((ih - 1) / 2)
				local tc = c - math.floor((iw - 1) / 2)
				if tr < 1 then tr = 1 end
				if tc < 1 then tc = 1 end
				if tr + ih - 1 > rows then tr = rows - ih + 1 end
				if tc + iw - 1 > cols then tc = cols - iw + 1 end

				local on = A.pk_on_square(list, tr, tc)
				local e0 = (on and on ~= skip) and list[on] or nil

				if e0 then
					if e0.sec == sec and entry_n(e0) < cap then
						return on, e0.r, e0.c, e0.w, e0.h, e0.rot, true
					end
				elseif A.box_room(list, cols, rows, tr, tc, iw, ih, skip) then
					return nil, tr, tc, iw, ih, rot_of(iw), true
				end
			end
		end
	end

	-- 2. A PILE TO JOIN beats an empty square, the same as everywhere
	--    else: otherwise a second bandage starts a second pile while
	--    the first one has room.
	for q = 1, #list do
		local e = list[q]
		if q ~= skip and e.sec == sec and entry_n(e) < cap then
			return q, e.r, e.c, e.w, e.h, e.rot
		end
	end

	-- 3. ANY SQUARE, either way up.
	for q = 1, #ways do
		local iw, ih = ways[q][1], ways[q][2]
		if iw <= cols and ih <= rows then
			local sr, sc = A.box_spot(list, cols, rows, iw, ih, skip)
			if sr then return nil, sr, sc, iw, ih, rot_of(iw) end
		end
	end

	return nil
end

-- ...and the same answer, painted. Green it lands exactly here, red it
-- does not go in this pocket at all, grey it goes in but somewhere the
-- packer picks - painting that last one red would be a lie.
function A.fit_hover(cols, rows, list, cap, it, r, c, skip)
	if not (cols and rows and r and c) then return nil end
	if not it then return r, c, 1, 1, nil end

	local _, tr, tc, tw, th, _, aimed =
		A.fit_land(cols, rows, list, cap, it, r, c, skip)

	if not tr then
		local w1, h1 = A.turned(it)
		return r, c, w1, h1, false
	end

	return tr, tc, tw, th, aimed and true or nil
end

-- ...and the panel's own: which pocket, and the answer for it.
function A.pk_hover()
	if not A.enabled then return nil end

	local i = A.pk_over()
	if not i then return nil end

	local P = A.pk[i]
	if not P then return nil end

	local r, c = A.pk_rc(i)
	if not r then return nil end

	-- WHAT IS IN HAND. A square dragged out of this rig knows its own
	-- entry, so it is not counted as being in its own way; anything
	-- else comes from the menu's drag.
	local it, skip
	local d = A.pk_drag
	if d then
		local Q = A.pk[d.i]
		it = Q and Q.slots[d.n]
		skip = (d.i == i) and d.n or nil
	else
		local wd = A.win_drag
		if wd and wd.slot then
			local t = A.win_pk(wd.k, wd.slot)
			it = t and t[wd.i]
		elseif wd and wd.box then
			local bw = A.wins[wd.k]
			it = bw and bw.id and (A.boxes[bw.id] or {})[wd.i]
		else
			it = A.hand_entry()
		end
	end

	if not it then return i, r, c, 1, 1, nil end

	-- A TORN POCKET REFUSES EVERYTHING, and it should say so rather
	-- than showing a green footprint over a pocket that will not take
	-- it.
	if A.is_torn(i) or not A.pk_takes(it.sec) then
		local tw, th = A.turned(it)
		return i, r, c, tw, th, false
	end

	local tr, tc, iw, ih, fits =
		A.fit_hover(P.cols, P.rows, P.slots, A.slot_cap(it.sec), it, r, c, skip)

	return i, tr, tc, iw, ih, fits
end

-- Which slot of the worn rig the cursor is over, if any.
function A.pk_over()
	if not A.pk_lay then return nil end
	for i = 1, #A.pk do
		local r = A.pk_lay[i]
		if r and hit(A.clip_abs(r)) then return i end
	end
	return nil
end

-- Which square of slot i, row and column. The grid is the SLOT's own -
-- a 3x1 has three columns and a 2x2 has two - which is why rc_in takes
-- it rather than assuming the med pocket's old fixed 2 by 2.
function A.pk_rc(i)
	local r = A.pk_lay and A.pk_lay[i]
	local P = A.pk[i]
	if not (r and P) then return nil end
	return A.rc_in(A.clip_abs(r), P.cols, P.rows)
end

-- Which ENTRY of pocket i the cursor stands on.
function A.pk_at(i)
	local cells = A.pk_cells and A.pk_cells[i]
	if not cells then return nil end
	for n = 1, #cells do
		if hit(A.clip_abs(cells[n])) then return n end
	end
	return nil
end

-- ============================================================
-- A WHOLE PILE FROM ONE SLOT TO ANOTHER
--
-- Both ends hold real objects, so nothing is created or destroyed -
-- but an id can only be in one pocket at a time, so it comes out of
-- the first before it goes into the second, and ANY that will not fit
-- go straight back where they came from.
--
-- PUT BACK, NOT DROPPED. A pile of five bandages moved onto a square
-- with room for two must not put three of them on the floor: the two
-- move and the three stay, which is what a player would expect and
-- what every stack move in the inventory already does.
-- ============================================================
function A.pk_move(P, n, Q, r, c)
	local e = P and P.slots[n]
	if not (e and Q) then return 0 end

	local sec = e.sec
	local ids = {}
	for k = 1, #e.ids do ids[k] = e.ids[k] end

	local moved = 0
	for k = 1, #ids do
		local id = ids[k]
		if not A.pk_drop(P, id) then break end

		-- The aimed square for the first one, then wherever the pile it
		-- just started will take the rest.
		if A.pk_put(Q, id, sec, (moved == 0) and r or nil,
		                        (moved == 0) and c or nil) then
			moved = moved + 1
		else
			-- It would not go. Back where it was, and stop: the rest
			-- will not fit either.
			A.pk_put(P, id, sec)
			break
		end
	end

	if moved > 0 then A.sfx("in") end
	return moved
end

-- THE OBJECT ON TOP OF PILE n IN SLOT i, which is the one the player
-- can see and therefore the one every gesture is about. With no pile
-- named it is the first one in the slot, which is what a click on an
-- ambiguous rectangle means.
--
-- This replaced A.obj_at, which took a pocket index because a pocket
-- held exactly one thing.
function A.slot_obj(i, n)
	local P = A.pk[i]
	local e = P and P.slots[n or 1]
	if not (e and #e.ids > 0) then return nil end
	return level.object_by_id(e.ids[#e.ids])
end

-- One out of a slot, into the bag.
--
-- pk_take, NOT pk_out: A.pk_out is already the pocket border pool (a
-- table, set in draw_panel), and a function of the same name is
-- silently replaced by that table the first time the panel draws -
-- which is the "attempt to call field 'pk_out' (a table value)" that
-- broke every take-out. The name is the fix.
function A.pk_take(P, n)
	local e = P.slots[n]
	if not (e and #e.ids > 0) then return false end
	local id = e.ids[#e.ids]
	local sec = e.sec
	if not A.pk_drop(P, id) then return false end
	A.uncarry(id)
	A.hold_square(id, sec, e.rot)
	return true
end

function A.pk_out_all(P, n)
	local e = P.slots[n]
	if not e then return 0 end
	local out = 0
	for _ = #e.ids, 1, -1 do
		if not A.pk_take(P, n) then break end
		out = out + 1
	end
	if out > 0 then A.sfx("out") end
	return out
end

-- One off the top of the pouch square in hand, on the split key.
function A.pk_take_one()
	local d = A.pk_drag
	if not d then return false end
	if A.pk_over() then return false end
	local P = A.pk and A.pk[d.i]
	local e = P and P.slots[d.n]
	if not (e and #e.ids > 0) then A.pk_let_go() return false end
	if not A.pk_take(P, d.n) then return false end
	local still = P.slots[d.n]
	if not (still and still.sec == e.sec and #still.ids > 0) then
		A.pk_let_go()
	end
	A.sfx("out")
	return true
end

function A.pk_let_go()
	if not A.pk_drag then return false end
	A.pk_drag = nil
	if A.ghost then pcall(function() A.wshow(A.ghost, false) end) end
	local gui = gui_now()
	if gui and gui.item_in_hold == CC_ID then gui.item_in_hold = false end
	return true
end



function A.hide_slot()

	A.rlay = nil
	if A.rs_out then A.wshow(A.rs_out, false) end
	if A.rs_in then A.wshow(A.rs_in, false) end
	if A.rs_ico then A.wshow(A.rs_ico, false) end
end

-- ============================================================
-- WHAT IS IN THAT RIG, WITHOUT PUTTING IT ON
--
-- A rig now CARRIES its magazines, so a rig in your bag is a container
-- whose contents nothing on screen described. The game's own tooltip
-- has no idea - it reads sections, and the contents are this mod's.
--
-- A LIST OF NAMES WAS NOT WHAT WAS ASKED FOR, and it would not have
-- been much use anyway: the thing you want to know about a rig is its
-- SHAPE - four rifle pockets or two and a drum - which is a picture.
-- So this draws the rig: the pockets where they are, at the size they
-- are, with the icon of whatever is in each one, and the empty ones
-- left empty.
--
-- It is deliberately NOT the panel. The panel is a cell container with
-- a measured correction, drag, hotkeys and a hit test; this is three
-- pooled statics per pocket and no interaction at all, because it has
-- to appear under the cursor over any list in any mode, including a
-- trader's, where the panel does not exist.
-- ============================================================
-- ============================================================
-- ONE POCKET, DRAWN THE SAME WAY IN THREE PLACES
--
-- The panel, the open-rig window and the tooltip all draw the same
-- pockets, and each of them used to carry its own copy of the palette
-- and its own idea of what a pocket looks like. They drifted: the panel
-- had a thin bright border around a dark interior - which is what makes
-- it read as a row of pouches - and the other two were flat blocks of
-- colour.
--
-- So the colours live here and the shape is the same everywhere: a
-- one-pixel border in the class colour, a dark interior inside it. The
-- class is a TINT, never a size; see the note in the panel's draw for
-- why that decision cost three bugs to reach.
--
--   state    "hover"  the cursor is on it
--            "full"   it has a magazine in it
--            "empty"  it does not
--
-- Returns the border colour and then the interior colour.
-- ============================================================
-- ============================================================
-- EVERY POCKET IS THE SAME GREY
--
--   "remove colors so every slot is grey-ish, so colors are the same
--    as 2x1 slot"
--
-- It used to be the size class - small cool and dim, rifle plain, drum
-- warm and bright - and then, when the classes went, the same three
-- tints read off the rectangle instead. Both were saying the one thing
-- the picture already says louder than any tint can: A POCKET IS THE
-- SHAPE IT IS. A 2x2 is visibly four times a 1x1; colouring it as well
-- is a second, quieter statement of the same fact, and it made the
-- panel read as three kinds of thing bolted together instead of one
-- rig.
--
-- So there is one grey - the plain 2x1's, which is the one everything
-- else was measured against - and the states below are the only thing
-- that changes it. The argument is still taken, because torn and hover
-- and empty all still mean something and a caller should not have to
-- know which of them the colour depends on.
-- ============================================================
function A.pocket_clr(cls, state)
	local br, bg, bb, fr, fg, fb = 86, 86, 94, 22, 22, 26

	if state == "torn" then
		-- Not a colour of its own: the same pouch, gone dark and red at
		-- the edge. It is still THAT pocket - the whole point of drawing
		-- it rather than removing it is that you can see what mending
		-- the rig gives back.
		return 96, 40, 40, 20, 12, 12, 34, 24, 24
	elseif state == "hover" then
		br, bg, bb = 170, 170, 180
	elseif state == "empty" then
		-- Dimmer, not a different colour: an empty drum pocket still has
		-- to read as a drum pocket.
		--
		-- 0.45 WAS TOO DIM, and the picture that asked for the cell
		-- divisions is what showed it: at 0.45 a small pocket's border
		-- came out at twenty-six against an inventory that sits at
		-- twenty-eight, so an empty pocket had no edge at all and the
		-- new lines inside it were the only thing you could see. An
		-- empty pocket has to read as a pocket first.
		--
		-- The interior keeps its own 0.7. It was never the problem: an
		-- interior is meant to be nearly black.
		--
		-- ROUNDED, AND THIS IS NOT TIDINESS.
		--
		--   "take out an item so the slot is empty, slots that are to
		--    the right of it loose the item icons"
		--
		-- 86 * 0.7 is 60.199999999999996, and that number goes straight
		-- to GetARGB, which is an engine call that wants whole numbers.
		-- It raises - and every window after the one being tinted is
		-- then never drawn, because the draw pass dies where it stood.
		--
		-- So: emptying a pocket made that pocket ask for a fractional
		-- colour, and the pockets AFTER it in the window lost their
		-- icons, while the hit tests went on working off the rectangles
		-- the previous frame had left behind. Which is exactly what was
		-- reported, down to "it is only a visual bug".
		--
		-- The dim is the only arithmetic in this file that could
		-- produce a fraction, and this is the only state that dims.
		br = math.floor(br * 0.7 + 0.5)
		bg = math.floor(bg * 0.7 + 0.5)
		bb = math.floor(bb * 0.7 + 0.5)
		fr = math.floor(fr * 0.7 + 0.5)
		fg = math.floor(fg * 0.7 + 0.5)
		fb = math.floor(fb * 0.7 + 0.5)
	end

	-- ============================================================
	-- AND THE LINE BETWEEN ONE CELL AND THE NEXT
	--
	--   "even thinner an bearly visible grid"
	--
	-- The interior, lifted just far enough to be seen. NOT a colour of
	-- its own, for the same reason the empty state is not: an empty
	-- pocket dims, so its divisions dim with it, and a drum pouch's
	-- warm interior gives warm lines. One number, applied to whatever
	-- the interior turned out to be.
	--
	-- Fifteen was measured off the picture that was asked for: an
	-- interior of eleven and a division of twenty-six.
	-- ============================================================
	return br, bg, bb, fr, fg, fb, fr + 15, fg + 15, fb + 15
end

-- ============================================================
-- WHICH SQUARES A POCKET IS STANDING ON
--
--   "thin borders and even thinner an bearly visible grid"
--
-- One rectangle per division, in the pocket's own coordinates. A rifle
-- pocket is one cell by two and gets a single line across it; a drum
-- pocket is two by two and gets a cross; a tall pocket is one by three
-- and gets two.
--
-- INSET BY A PIXEL AT EACH END so a division never touches the border.
-- They are different things - one is the edge of the pouch and the
-- other is a fold inside it - and a line running into the frame makes
-- the pocket read as four small boxes instead of one pouch with cells
-- in it.
--
-- The shape comes from SIZE, which is where a pocket's footprint is
-- decided and the only place it should be read from: a rig table that
-- one day gives `large` a different shape must not need this changed
-- too.
-- ============================================================
-- ============================================================
-- A SEAM NEVER RUNS THROUGH ONE PICTURE
--
--   "the grid lines are present in front of the item icons"
--
-- Quite right, and the note that used to be here was wrong about why
-- it could not happen. A seam does sit in the gap between two SQUARES
-- - but an item two squares tall covers that gap, because the gap is
-- inside its own picture, and the line was drawn straight down the
-- middle of a magazine.
--
-- So the seams are cut into per-square segments and a segment is
-- dropped when the SAME entry stands on both sides of it. Where the
-- pocket is empty the segments abut and read as one line, exactly as
-- before; where something is standing they stop at its edge and start
-- again on the far side.
--
-- That also settles the draw order for good. There is no pixel of a
-- seam over any icon any more, so it does not matter which of the two
-- pools was made first - which was the fragile part of drawing these
-- at all.
--
-- `list` is the pocket's entries, in the r,c,w,h shape both halves of
-- this mod use. Without one, every seam is drawn whole: an empty
-- pocket, which is what a caller with nothing to pass has.
-- ============================================================
-- ============================================================
-- AND NOT ONE TABLE A FRAME FOR ANY OF IT
--
-- This runs once per pocket per frame in three different drawings, and
-- it used to build a fresh list, a fresh occupancy map and a fresh
-- four-number table per segment: about fifty tables a frame for a full
-- rig, thrown away immediately. In an engine with one Lua heap and a
-- draw that runs for as long as the inventory is open, that is the
-- single largest thing this file does.
--
-- The buffers are made once and reused. THE COUNT IS RETURNED rather
-- than left to `#`, because the list keeps its old tail: a caller that
-- walked `#split` would draw last pocket's seams as well as its own.
--
-- Nothing holds the answer past the loop that reads it - the panel,
-- the window and the card each walk it and forget it - which is what
-- makes one shared buffer correct rather than merely cheap.
-- ============================================================
local SPLIT, SPLIT_ON = {}, {}

function A.pk_split(cols, rows, w, h, list)
	cols = cols or 1
	rows = rows or 1

	local out, n = SPLIT, 0
	if not (w > 2 and h > 2) then return out, 0 end

	-- Which entry is standing on each square. One pass, then every
	-- question below is a table read.
	local on = SPLIT_ON
	for k in pairs(on) do on[k] = nil end

	for n2 = 1, #(list or {}) do
		local e = list[n2]
		if e and e.r and e.c then
			for r = e.r, e.r + (e.h or 1) - 1 do
				for c = e.c, e.c + (e.w or 1) - 1 do
					on[r * 64 + c] = n2
				end
			end
		end
	end

	local function edge(k, of, span) return math.floor(span * k / of + 0.5) end

	-- One table per segment, kept and overwritten.
	local function put(x, y, sw, sh)
		n = n + 1
		local s = out[n]
		if s then s[1], s[2], s[3], s[4] = x, y, sw, sh
		else out[n] = { x, y, sw, sh } end
	end

	-- Down the seams, a square at a time. INSET BY A PIXEL where the
	-- segment meets the pocket's own border: the border and a fold
	-- inside it are different things, and a line running into the frame
	-- makes the pocket read as four small boxes instead of one pouch.
	for c = 1, cols - 1 do
		local x = edge(c, cols, w)
		for r = 1, rows do
			local a = on[r * 64 + c]
			if not (a ~= nil and a == on[r * 64 + c + 1]) then
				local y0 = edge(r - 1, rows, h)
				local y1 = edge(r, rows, h)
				if r == 1 then y0 = y0 + 1 end
				if r == rows then y1 = y1 - 1 end
				if y1 > y0 then put(x, y0, 1, y1 - y0) end
			end
		end
	end

	for r = 1, rows - 1 do
		local y = edge(r, rows, h)
		for c = 1, cols do
			local a = on[r * 64 + c]
			if not (a ~= nil and a == on[(r + 1) * 64 + c]) then
				local x0 = edge(c - 1, cols, w)
				local x1 = edge(c, cols, w)
				if c == 1 then x0 = x0 + 1 end
				if c == cols then x1 = x1 - 1 end
				if x1 > x0 then put(x0, y, x1 - x0, 1) end
			end
		end
	end

	return out, n
end

A.tip_box = A.tip_box or {}
A.tip_in  = A.tip_in or {}
A.tip_ico = A.tip_ico or {}
-- THE MED POCKET'S ROW on the card: border+interior pairs, icons and
-- counters, occupied squares only. Own pools and own xml nodes -
-- tip_box is "a magazine pocket" to every suite that counts them.
A.tip_med    = A.tip_med or {}
A.tip_medin  = A.tip_medin or {}
A.tip_medico = A.tip_medico or {}
A.tip_medcnt = A.tip_medcnt or {}
-- The pouch fit slots on the card: border+interior pairs and icons.
A.tip_slot    = A.tip_slot or {}
A.tip_slotin  = A.tip_slotin or {}
A.tip_slotico = A.tip_slotico or {}
-- The faint divisions inside each pocket. A FLAT pool with a running
-- count rather than one keyed by pocket, because a pocket needs one,
-- two or none depending on its shape - and a pool with gaps in it is
-- a pool whose tail cannot be found by counting. See A.win_hide.
A.tip_gr  = A.tip_gr or {}

-- The rig this section draws, INCLUDING anything bolted to that
-- particular rig - the pouches are fitted to the object, not to the
-- kind, so two rigs of the same section can be different shapes.
function A.tip_rows(sec, id)
	-- ONLY THE SLOTS THAT RIG IS HOLDING UP. A pouch fitted to a slot
	-- its rig has worn past does not grant slots, so a preview that
	-- drew them would promise room the rig does not have.
	--
	-- A.rig_slots_all reads A.pslot, which is what is FITTED; the live
	-- test is this function's own, because it is the only caller that
	-- draws a rig it is not wearing.
	local slots = A.rig_slots_all(sec, id)
	if not slots then return {} end

	local cond
	pcall(function()
		local o = id and level.object_by_id(id)
		if o then cond = A.rig_cond(o) end
	end)

	local live = A.slots_live(type(cond) == "number" and cond or 1)

	local keep = {}
	for i = 1, #slots do
		if not slots[i].pouch or slots[i].pouch <= live then
			keep[#keep + 1] = slots[i]
		end
	end

	return A.pack_slots(keep) or {}
end

-- Which rig the cursor is on, if any. Read off the menu's own hover
-- record rather than hit-tested here: the cells belong to the game's
-- containers, which know where they are and this mod does not.
-- The name the game shows for a section, or the section itself when
-- there is no string for it.
-- ONCE PER SECTION, EVER. An engine parameter read and a string
-- translation, asked once per open rig window per frame for a name
-- that is a line in a text file. A.ammo_name two hundred lines down
-- memoises for exactly this reason and says so.
A.namememo = A.namememo or {}

function A.tip_name(sec)
	if type(sec) ~= "string" then return sec end

	local had = A.namememo[sec]
	if had ~= nil then return had end

	local out = sec
	local key = SYS_GetParam(0, sec, "inv_name")
	if type(key) == "string" and key ~= "" then
		out = key
		local ok, s = pcall(game.translate_string, key)
		if ok and type(s) == "string" and s ~= "" and s ~= key then out = s end
	end

	A.namememo[sec] = out
	return out
end

-- PUTTING THE POCKETS AWAY.
--
-- For a long time this also cleared a remembered height, and that is
-- what made the pockets go missing now and then: one quiet frame - the
-- magazine mod not answering, the xml not ready, a new dialog - and the
-- next measurement was of a frame this mod had already grown. Nothing
-- is remembered any more (see A.tip_content_bottom), so hiding them is
-- now only hiding them.
function A.tip_hide()
	for i = 1, #A.tip_box do A.wshow(A.tip_box[i], false) end
	for i = 1, #A.tip_in do A.wshow(A.tip_in[i], false) end
	for i = 1, #A.tip_ico do A.wshow(A.tip_ico[i], false) end
	for _, g in pairs(A.tip_gr or {}) do A.wshow(g, false) end
	for i = 1, #A.tip_med do A.wshow(A.tip_med[i], false) end
	for i = 1, #A.tip_medin do A.wshow(A.tip_medin[i], false) end
	for _, w in pairs(A.tip_medico or {}) do A.wshow(w, false) end
	for _, w in pairs(A.tip_medcnt or {}) do A.wshow(w, false) end
	for i = 1, #A.tip_slot do A.wshow(A.tip_slot[i], false) end
	for i = 1, #A.tip_slotin do A.wshow(A.tip_slotin[i], false) end
	for i = 1, #A.tip_slotico do A.wshow(A.tip_slotico[i], false) end
end

-- ============================================================
-- INSIDE THE GAME'S OWN TOOLTIP, NOT BESIDE IT
--
-- The first version drew its own card near the cursor, which meant
-- hovering a rig gave you TWO boxes: the game's description and a
-- second, bigger one next to it. It is one item; it gets one tooltip.
--
-- So the pockets are drawn as children of `item_info.dialog` - the
-- window the description already lives in - and the frame behind it is
-- grown to cover them. They move with it, hide with it, and sit under
-- the description the way the stats block does.
--
-- AND THE FRAME IS GROWN FROM A REMEMBERED HEIGHT, not from whatever
-- it is now. UIInfoItem:Update returns EARLY for the item it is
-- already showing, without resizing anything - so growing "the current
-- height" would add the pockets again on every frame and the tooltip
-- would walk off the bottom of the screen in about a second.
-- ============================================================
-- Of an inventory cell. It is a hint, not a second inventory - but at
-- 0.34 it was small enough that a drum pouch and a rifle pouch were
-- hard to tell apart at a glance, which is the one thing it is for.
local TIP_SCALE = 0.46
local TIP_PAD   = 6

-- WHY THE POCKETS WERE NOT DRAWN.
--
-- Every path out of tip_attach that draws nothing goes through here.
-- There are nine of them and most are perfectly ordinary - the item is
-- not a rig, the tooltip has not laid out yet - so this says nothing at
-- all unless Debug is on. But "sometimes the pockets are missing" was
-- reported with no way to tell WHICH of the nine it was, and nine
-- silent returns is a bug that cannot be read out of a log.
--
-- dbg collapses repeats, so a reason that is true for two hundred
-- frames prints once with a count after it.
-- ============================================================
-- WHERE THE TOOLTIP'S CONTENT ENDS
--
-- Every block the game and its mods lay out is a child window on the
-- UIInfoItem, positioned and sized before the frame is grown around it:
--
--   desc          the description - and everything mods append to it
--   stats_dialog  the stats block
--   ammo          the ammo row (weapons)
--   parts         the components row, added by "Parts in tooltip"
--
-- The lowest edge of the shown ones IS the content, and it is what the
-- game's own Sync_H uses to size the frame. Asking them costs four
-- GetWndPos calls and answers correctly whoever laid out last.
--
-- A name this does not know about is a block this will draw over. That
-- is the one weakness, and it is a far better one than the frame: a
-- block nobody told us about is a bug in a list, not a tooltip that
-- doubles in height every time you hover something.
-- ============================================================
-- ============================================================
-- THE COMPONENTS ROW IS HUNG OFF A WINDOW THAT IS NOT THERE
--
--   "when i hover over the rigs the tooltip is when things ovelap,
--    every time no mmater how many times i hoverover but when then i
--    onve hover over on armour to check its tooltip, the next rig
--    tooltips are tall as fuck"
--
-- Two symptoms, one line, and it is not in this mod:
--
--   zz_parts_in_tooltip.script:196
--   self:Sync_Finale( true, self.ammo:IsShown() and self.ammo
--                     or self.stats_dialog, self.parts, self.frame, 10 )
--
-- It asks whether the AMMO row is shown and then falls back to the
-- stats block WITHOUT asking the same question about it. A rig has no
-- stats table of its own, so the game hides `stats_dialog` for it - and
-- a hidden window keeps the position and height it was last given.
--
-- So the components row is placed under wherever the stats block was
-- for the LAST item that had one:
--
--   nothing hovered yet   stats_dialog is near the top of the tooltip,
--                         so the row is drawn over the description
--   an armour first       eleven stats, so the row is placed hundreds
--                         of pixels down and the frame is grown to
--                         reach it - "tall as fuck"
--
-- Which is exactly the pair reported, and neither of them moves with
-- how many times you hover.
--
-- SO THE SYNC IS CORRECTED, NOT THE OTHER MOD. Sync_Finale is a method
-- on the class: wrapping it lets a hidden reference point be swapped
-- for the lowest block that IS shown, which is what "under everything
-- above me" meant in the first place. It changes nothing for anything
-- else, because it only ever fires when the block being measured is
-- hidden - and it is scoped to rig sections, so no other item's tooltip
-- is touched at all.
--
-- The window cannot be identified by comparing it (fact 2: comparing
-- two engine windows raises), and it does not need to be: "is it
-- shown" is the whole test.
-- ============================================================
local TIP_ABOVE = { "desc", "stats_dialog", "ammo" }

function A.tip_lowest_shown(info)
	local best, low
	for i = 1, #TIP_ABOVE do
		local w = info[TIP_ABOVE[i]]
		if w then
			local oks, shown = pcall(function() return w:IsShown() end)
			if oks and shown then
				local okp, p = pcall(function() return w:GetWndPos() end)
				local okh, wh = pcall(function() return w:GetHeight() end)
				if okp and okh and p and type(wh) == "number" then
					local b = p.y + wh
					if not low or b > low then low, best = b, w end
				end
			end
		end
	end
	return best
end

function A.install_tip_sync_guard()
	local U = rawget(_G, "utils_ui")
	U = U and U.UIInfoItem
	if not (U and type(U.Sync_Finale) == "function") then
		log("no tooltip layout to correct")
		return
	end

	if A.sync_base then return end       -- never wrap twice
	A.sync_base = U.Sync_Finale

	U.Sync_Finale = function(self, cond, syncer, resizer, adapter, offset)
		if A.enabled and syncer and self
		   and A.is_rig_sec(self.section) then
			local oks, shown = pcall(function() return syncer:IsShown() end)
			if oks and not shown then
				local sub = A.tip_lowest_shown(self)
				if sub then
					dbg("tooltip: a hidden block was the reference point")
					syncer = sub
				end
			end
		end
		return A.sync_base(self, cond, syncer, resizer, adapter, offset)
	end

	log("the components row will follow what is actually shown")
end

local TIP_BLOCKS = { "desc", "stats_dialog", "ammo", "parts" }

function A.tip_content_bottom(info)
	if not info then return nil end

	local low
	for i = 1, #TIP_BLOCKS do
		local w = info[TIP_BLOCKS[i]]
		if w then
			-- A hidden block keeps its last position, so asking one is
			-- how the ammo row of the last weapon you hovered decides
			-- where a rig's pockets go.
			local oks, shown = pcall(function() return w:IsShown() end)
			if oks and shown then
				local okp, p = pcall(function() return w:GetWndPos() end)
				local okh, wh = pcall(function() return w:GetHeight() end)
				if okp and okh and p and type(wh) == "number" then
					local b = p.y + wh
					if not low or b > low then low = b end
				end
			end
		end
	end

	return low
end

local function tip_no(why, ...)
	dbg("tooltip pockets not drawn: " .. why, ...)
	A.tip_hide()
end

function A.tip_attach(info, obj, sec)
	if not (A.enabled and info and info.dialog and info.frame) then
		-- Not even the mod being off, usually: the tooltip object is
		-- built once per inventory and this can run before it is whole.
		if A.enabled then
			return tip_no("the tooltip has no %s yet",
			              (not info) and "object" or
			              (not info.dialog) and "dialog" or "frame")
		end
		return A.tip_hide()
	end

	if type(sec) ~= "string" and obj then
		local ok, s = pcall(function() return obj:section() end)
		sec = ok and s or nil
	end

	if not A.is_rig_sec(sec) then return A.tip_hide() end   -- ordinary

	local id = nil
	if obj then
		local ok, i = pcall(function() return obj:id() end)
		id = ok and i or nil
	end

	-- The one on your chest has the panel; this is for the others.
	if id and A.rig_id == id then
		return tip_no("%s is the rig you are wearing - it has the panel",
		              tostring(id))
	end

	-- ------------------------------------------------------------
	-- ONLY ONCE THE TOOLTIP HAS ACTUALLY LAID THIS ITEM OUT
	--
	-- UIInfoItem waits ~700ms before it shows anything, and during that
	-- wait Update RETURNS WITHOUT LAYING ANYTHING OUT - the frame keeps
	-- whatever size it had last time. Drawing then measured the height
	-- WE had grown it to, and grew it again from there.
	--
	-- So the tooltip got a little taller and the pockets a little lower
	-- on every single hover, for ever. It is `self.id` / `self.section`
	-- that say the layout has run, because the base sets them at the
	-- moment it does.
	-- ------------------------------------------------------------
	local laid = (id and info.id == id)
		or (not id and sec and info.section == sec)
	if not laid then
		return tip_no("%s is not laid out yet (tooltip is on %s/%s)",
		              tostring(id or sec), tostring(info.id),
		              tostring(info.section))
	end

	local rows = A.tip_rows(sec, id)
	if #rows == 0 then
		return tip_no("%s has no pockets to draw", tostring(sec))
	end

	local xml = A.get_xml()
	if not xml then return tip_no("the xml is not loaded") end

	-- ------------------------------------------------------------
	-- The pool belongs to ONE dialog. A new inventory builds a new
	-- UIInfoItem, and statics parented to the old one are attached to a
	-- window that is gone.
	-- ------------------------------------------------------------
	-- COMPARED AS THE TOOLTIP, NOT AS ITS WINDOW. info.dialog is a
	-- CUIStatic and comparing two of those raises "No such operator
	-- [__eq]" - which it did, on every hover, so the pockets were never
	-- drawn at all once a second UIInfoItem existed. `info` is the
	-- UIInfoItem itself, a Lua table, and a new one is what a new dialog
	-- arrives inside.
	-- UIInfoItem is an engine class in this build and does not implement Lua's
	-- equality operator. Comparing two instances directly raises __eq on every
	-- tooltip frame. tostring provides a stable identity token without invoking
	-- that operator, while tip_owner still retains the live instance for hiding.
	local info_key = tostring(info)
	if A.tip_owner_key ~= info_key then
		-- Put the old ones away before letting go of them. The window
		-- they hang off is usually gone by now, but "usually" is not a
		-- reason to leave a shown static behind with no way to reach
		-- it again.
		A.tip_hide()
		A.tip_owner = info
		A.tip_owner_key = info_key
		A.tip_box, A.tip_in, A.tip_ico = {}, {}, {}
		A.tip_med, A.tip_medin = {}, {}
		A.tip_medico, A.tip_medcnt = {}, {}
		A.tip_slot, A.tip_slotin, A.tip_slotico = {}, {}, {}
	end

	local gs, gl = A.metrics()
	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then ratio = 1 end

	local function px(cw, ch)
		return (cw * gs + (cw - 1) * gl) * TIP_SCALE * ratio,
		       (ch * gs + (ch - 1) * gl) * TIP_SCALE
	end

	local held = (id and A.hold[id]) or {}

	-- Flattened the same way resolve_rig flattens, because torn_at
	-- answers by index into that order and the draw below walks it.
	local flat, bolted = {}, {}
	for r = 1, #rows do
		for c = 1, #rows[r] do
			local e = rows[r][c]
			flat[#flat + 1] = e
			if e.pouch then bolted[#flat] = true end
		end
	end
	-- WITH the bolted flags: a pouch's pockets do not tear with the
	-- rig, and the panel has said so all along - the card just never
	-- passed the list.
	local torn = A.torn_at(flat, A.rig_cond(obj), bolted)

	-- ============================================================
	-- TWO BLOCKS, THE PANEL'S OWN SHAPE
	--
	--   "tooltip layout shoud mirror the 'real' layout."
	--
	-- The rig's rows on the left; the pockets a pouch grants to their
	-- RIGHT, not underneath; the two fit slots against the right edge.
	-- Same walk for both blocks, so a pouch's rows are measured and
	-- gapped exactly like the rig's - and the same fallback the panel
	-- has: too narrow for side by side means stacked, which is the old
	-- shape and never draws two things in one place.
	--
	-- THE FLAT ORDER SURVIVES. Pouch rows are appended after the
	-- rig's, so walking "not pouch" then "pouch" is the same pocket
	-- order resolve_rig flattens to - which is what torn_at and the
	-- contents are filed against.
	-- ============================================================
	-- On the square grid, exactly as the panel and the window lay it
	-- out - which is what "the tooltip should mirror the real layout"
	-- now means for free: all three read the dx and dy the packer wrote.
	local pitch_x = (gs + gl) * TIP_SCALE * ratio
	local pitch_y = (gs + gl) * TIP_SCALE

	local function tip_block(want_pouch)
		local out, bw, y = {}, 0, 0
		for r = 1, #rows do
			local row = rows[r]
			if (row.pouch and true or false) == want_pouch then
				local rh = 0
				for c = 1, #row do
					local e = row[c]
					local pw, ph = px(e.w, e.h)
					local ex = (e.dx or 0) * pitch_x
					local ey = (e.dy or 0) * pitch_y

					out[#out + 1] = { x = ex, y = y + ey, w = pw, h = ph,
					                  cls = e }

					if ex + pw > bw then bw = ex + pw end
					if ey + ph > rh then rh = ey + ph end
				end
				if #row > 0 then y = y + rh + 1 end
			end
		end
		return out, bw, (y > 0) and (y - 1) or 0
	end

	local main, mw, mh = tip_block(false)
	local pblk, pw2, ph2 = tip_block(true)

	-- The fit slots, one bordered square each, stacked down the right
	-- edge the way the panel stacks them.
	local ssw, ssh = px(1, 1)
	local slot_h = PSLOTS * ssh + (PSLOTS - 1) * 2

	local put, n = {}, 0
	for i = 1, #main do n = n + 1 put[n] = main[i] end

	local need = mw + 4 + (ph2 > 0 and (pw2 + 4) or 0) + ssw
	local fw
	pcall(function() fw = info.frame:GetWidth() end)
	local side = (type(fw) == "number") and (need <= fw - TIP_PAD * 4)

	local w, h, sx, sy, srow
	if side then
		local px0 = mw + 4
		for i = 1, #pblk do
			n = n + 1
			pblk[i].x = pblk[i].x + px0
			put[n] = pblk[i]
		end
		sx, sy, srow = need - ssw, 0, false
		w = need
		h = math.max(mh, ph2, slot_h)
	else
		for i = 1, #pblk do
			n = n + 1
			pblk[i].y = pblk[i].y + mh + 2
			put[n] = pblk[i]
		end
		-- Too narrow for side by side: the pouch rows stack under the
		-- rig's, and the fit slots move below them.
		sx = 0
		sy = mh + (ph2 > 0 and (ph2 + 2) or 0) + 2
		srow = true
		w = math.max(mw, pw2, PSLOTS * (ssw + 2) - 2)
		h = sy + ssh
	end

	if n == 0 or w <= 0 or h <= 0 then
		return tip_no("%s laid out to nothing (%s pockets, %sx%s)",
		              tostring(sec), tostring(n), tostring(w), tostring(h))
	end
	-- ------------------------------------------------------------
	-- WHERE THE DESCRIPTION ENDS. Remembered per item, because the
	-- frame we are about to grow is the thing we would otherwise
	-- measure the next time round.
	-- ------------------------------------------------------------
	-- DO NOT MEASURE THE FRAME. MEASURE WHAT IS IN IT.
	--
	-- The frame is the one thing in the tooltip this mod itself
	-- changes, so every scheme that reads it has to somehow discount
	-- its own last growth - and every one of those has been wrong:
	--
	--   1.33  measured it fresh each frame, added the pockets, and the
	--         tooltip walked off the bottom of the screen in a second
	--   1.36.0 measured it ONCE, on the frame the item was laid out.
	--         Correct until somebody else grew it afterwards, which is
	--         what "Parts in tooltip" does with its row of replaceable
	--         components - and giving the rigs a con_parts_list in
	--         1.36.1 is what made that row appear on a rig for the
	--         first time. The pockets landed in the middle of it.
	--   1.36.2 measured it each frame and took its own growth back off.
	--         One frame where the base has NOT re-laid the item out -
	--         and there are ~40 of them, the tooltip's own delay -
	--         reads the grown frame as somebody else's height, and the
	--         second hover was a screenful.
	--
	-- The frame is not the question anyway. The question is where the
	-- CONTENT ends, and the tooltip's own parts can be asked directly:
	-- the description, the stats block, the ammo block, and the
	-- components row that another mod hangs off the same object. That
	-- is the same set the game's own Sync_H measures to size the frame
	-- in the first place - so this is not a guess about the layout, it
	-- is the layout.
	--
	-- Nothing here reads anything this mod wrote. It cannot accumulate,
	-- there is nothing to remember between frames, and a block that
	-- appears late is simply included the moment it is shown.
	local base_h = A.tip_content_bottom(info) or 0
	if base_h > 0 then base_h = base_h + TIP_PAD end
	if base_h <= 0 then
		-- Not one block of the tooltip would say where it ends. Nothing
		-- can be placed against that, and guessing would put the
		-- pockets somewhere arbitrary.
		return tip_no("the tooltip has laid nothing out for %s", tostring(sec))
	end

	local fx = 0
	local okp, p = pcall(function() return info.frame:GetWndPos() end)
	if okp and p then fx = p.x end

	local ox = fx + TIP_PAD * 2
	local oy = base_h - TIP_PAD

	-- How many divisions and how many icons have been drawn this pass,
	-- across ALL the slots. Both pools are flat, so these are also
	-- where their tails start.
	local gn, icon = 0, 0

	for i = 1, n do
		local pk = put[i]

		local box = A.tip_box[i]
		if not box then
			box = xml:InitStatic("amp:tipbox", info.dialog)
			A.tip_box[i] = box
		end

		local bx, by = ox + pk.x, oy + pk.y

		A.wpos(box, bx, by)
		A.wsize(box, pk.w, pk.h)

		-- THE PANEL'S POCKET, at a third of the size: a thin bright
		-- border in the class colour with a dark interior inside it.
		-- Nothing here is hovered - it is a picture, not a container -
		-- so a pocket is full or it is empty.
		local t = held[pk.cls.key] or {}
		local bare = (#t == 0)

		local br, bg, bb, fr, fg, fb, lr, lg, lb = A.pocket_clr(pk.cls,
			(torn[i] and "torn") or (bare and "empty") or "full")

		A.wtint(box, 255, br, bg, bb)
		A.wshow(box, true)

		local inn = A.tip_in[i]
		if not inn then
			inn = xml:InitStatic("amp:tipfill", info.dialog)
			A.tip_in[i] = inn
		end

		A.wpos(inn, bx + 1, by + 1)
		A.wsize(inn, pk.w - 2, pk.h - 2)
		A.wtint(inn, 255, fr, fg, fb)
		A.wshow(inn, true)

		-- ============================================================
		-- THE SQUARES A POCKET IS STANDING ON, FULL OR EMPTY
		--
		--   "disable that when item is in slot the lines that seperate
		--    the cells disappear, let them be there"
		--
		-- They used to be drawn on an empty pocket only, on the reasoning
		-- that an icon says everything about the squares it covers - and
		-- on a worry that a line made after the icons would be a hairline
		-- across a magazine.
		--
		-- The first is wrong about the squares NEXT to the icon: a 2x2
		-- with one magazine standing in it is the exact moment a player
		-- needs to see that the free half is one square wide and two
		-- tall. And the second cannot happen: A.pk_split puts each
		-- division in the GAP between two squares, where the boxes put
		-- their seams, and an icon is inset inside its own square. The
		-- line and the picture never share a pixel.
		-- ============================================================
		local split, nsplit = A.pk_split(pk.cls.w, pk.cls.h, pk.w, pk.h, t)
		for q = 1, nsplit do
			gn = gn + 1
			local g = A.tip_gr[gn]
			if not g then
				g = xml:InitStatic("amp:tipline", info.dialog)
				A.tip_gr[gn] = g
			end

			local d = split[q]
			A.wpos(g, bx + d[1], by + d[2])
			A.wsize(g, d[3], d[4])
			A.wtint(g, 255, lr, lg, lb)
			A.wshow(g, true)
		end

		-- ============================================================
		-- AND WHAT IS IN IT, SQUARE BY SQUARE
		--
		-- The card shows a rig you are NOT wearing, so these are
		-- records: each one knows its section, its square, its size and
		-- which way it is lying, and nothing has to be looked up.
		--
		-- ICONS FROM A FLAT POOL, because a slot holds several things
		-- and a pool keyed by slot could not hold them.
		-- ============================================================
		for e = 1, #t do
			local ent = t[e]
			icon = icon + 1

			local ico = A.tip_ico[icon]
			if not ico then
				ico = xml:InitStatic("amp:tipico", info.dialog)
				A.tip_ico[icon] = ico
			end

			local ew, eh = px(ent.w or 1, ent.h or 1)
			local cx = bx + ((ent.c - 1) * (gs + gl)) * TIP_SCALE * ratio
			local cy = by + (ent.r - 1) * (gs + gl) * TIP_SCALE

			if pcall(A.set_icon, ico, ent.sec) then
				A.wpos(ico, cx + 1, cy + 1)
				A.wsize(ico, ew - 2, eh - 2)
				A.wtint(ico, 255, 255, 255, 255)
				A.wshow(ico, true)
			else
				A.wshow(ico, false)
			end
		end
	end

	for i = icon + 1, #A.tip_ico do A.wshow(A.tip_ico[i], false) end

	for i = n + 1, #A.tip_box do A.wshow(A.tip_box[i], false) end
	for i = n + 1, #A.tip_in do A.wshow(A.tip_in[i], false) end
	-- pairs, not a count: this pool is dense today because it is filled
	-- by a running counter, and a hide loop that only works while that
	-- stays true is a hide loop that fails the day it does not.
	for i, g in pairs(A.tip_gr) do
		if i > gn then A.wshow(g, false) end
	end

	-- THE FIT SLOTS, drawn as indicators: a bordered square per slot
	-- with the fitted pouch's icon in it, empty when nothing is. The
	-- pouches are fitted to the OBJECT, so two rigs of one section can
	-- carry different bolts - which is exactly what the card is for.
	local pslots = (id and A.pslot and A.pslot[id]) or {}
	for q = 1, PSLOTS do
		local bx = ox + sx + (srow and ((q - 1) * (ssw + 2)) or 0)
		local by = oy + sy + ((not srow) and ((q - 1) * (ssh + 2)) or 0)

		local sb = A.tip_slot[q]
		if not sb then
			sb = xml:InitStatic("amp:tipslot", info.dialog)
			A.tip_slot[q] = sb
		end
		A.wpos(sb, bx, by)
		A.wsize(sb, ssw, ssh)
		A.wtint(sb, 255, 86, 86, 94)
		A.wshow(sb, true)

		local si = A.tip_slotin[q]
		if not si then
			si = xml:InitStatic("amp:tipslot", info.dialog)
			A.tip_slotin[q] = si
		end
		A.wpos(si, bx + 1, by + 1)
		A.wsize(si, ssw - 2, ssh - 2)
		A.wtint(si, 255, 22, 22, 26)
		A.wshow(si, true)

		local so = A.tip_slotico[q]
		if not so then
			so = xml:InitStatic("amp:tipslotico", info.dialog)
			A.tip_slotico[q] = so
		end
		local psec = pslots[q]
		local sdrew = (type(psec) == "string"
			and pcall(A.set_icon, so, psec)) and true or false
		if sdrew then
			A.wpos(so, bx + 1, by + 1)
			A.wsize(so, ssw - 2, ssh - 2)
			A.wtint(so, 255, 255, 255, 255)
		end
		A.wshow(so, sdrew)
	end

	-- And the frame covers them. Nothing is remembered about that: the
	-- next frame asks the content again, and the content does not
	-- include anything on this side of the call.
	pcall(function()
		info.frame:SetWndSize(vector2():set(
			info.frame:GetWidth(), base_h + h + TIP_PAD))
	end)
end

-- ============================================================
-- OPENING A RIG YOU ARE NOT WEARING
--
-- A rig carries its magazines now, and until this there was no way to
-- get at them without putting the rig on. So: an "open rig" entry on
-- any rig in your bag, and a window that lays it out - the pockets as
-- they are, with what is in them - where a magazine can be dragged out
-- into the bag, dragged back in, or moved between pockets.
--
-- WHAT IT IS DRAGGING IS NOT AN OBJECT. A magazine inside an unworn
-- rig does not exist in the world: it is a section, its rounds and its
-- wear, kept against the rig. So "out" MAKES one and "in" DESTROYS
-- one, in that order and never the other way round - the same rule the
-- rest of this file lives by, because it is the one that cannot lose
-- somebody's ammunition.
--
-- It is deliberately NOT the panel. The panel is the loadout on your
-- chest: it feeds the magazine mod's carried set, it answers the
-- hotkeys, it has a slot and a pin. This is a container you are
-- rummaging in, and the two would fight over every one of those.
--
-- ------------------------------------------------------------
-- MORE THAN ONE AT A TIME
--
-- There was one window, and opening a second rig closed the first. It
-- read as a fault rather than a rule - you click, the window you were
-- looking at vanishes, and the new one only turns up on the click after
-- that - and it made the obvious thing you want to do with two rigs,
-- move a magazine from one to the other, impossible.
--
-- So there are SLOTS. Each slot owns its own statics for the life of
-- the session and shows one rig at a time; a closed slot is free for
-- the next rig. Statics cannot be reordered once made, so the stacking
-- order is the slot order and nothing tries to raise a window to the
-- front - instead a new window is CASCADED down and right of the last
-- one, so they do not sit on top of each other in the first place. Hit
-- tests run from the top slot down, so where they do overlap the click
-- goes to the one you can see.
-- ============================================================
local WIN_MAX  = 4                 -- open at once. Four is already more
                                   -- rigs than anyone carries.
local WIN_PAD  = 8
local WIN_HEAD = 22                -- letterica16 needs the room
local WIN_EDGE = 1                 -- how much of the border shows. ONE,
                                   -- which is what "thin" means at this
                                   -- size: two reads as a frame, one
                                   -- reads as an edge.
local WIN_STEP = 26                -- the cascade offset per window

-- ============================================================
-- WHAT A WINDOW IS DRAWN AS
--
--   "can we update the windows for rigs and boxes to look better?"
--    -> one area with faint lines, thin grey on both, quiet it down
--
-- THE SAME GREYS THE GRID SECTIONS USE. A box window sits on top of the
-- backpack it was dragged out of, and the two reading as one piece of
-- furniture is the whole point of doing this at all - see EDGE_CLR and
-- CELL_CLR in the grid script, which are these numbers.
local WIN_LINE = { 74, 77, 82 }    -- the edge round a window
local WIN_RULE = { 44, 46, 50 }    -- the hairline under its title

-- ...and the inside of a box. The interior is the colour a square's
-- interior already was, so nothing about a full box changed shade; the
-- seams are that colour LIFTED, exactly the way a pocket's divisions
-- are lifted off its interior in A.pocket_clr.
local BOX_IN   = { 26, 28, 34 }
local BOX_SEAM = { 41, 43, 49 }
local BOX_EDGE = { 74, 77, 82 }

-- WHERE THE THING IN HAND WOULD GO: green when it fits, red when it
-- does not, grey when there is nothing to judge. The same three pairs
-- the squares were tinted with before, now painted once over the whole
-- footprint instead of square by square.
local HOV_EDGE = {
	ok = { 110, 180, 110 }, no = { 190,  90,  90 }, on = { 120, 126, 146 },
}
local HOV_FILL = {
	ok = {  30,  48,  32 }, no = {  48,  28,  30 }, on = {  38,  42,  52 },
}

-- [k] = { id, pos, rig, lay, rect, xr, bg, ttl, x, box, inn, ico }
--
-- `id` is the rig this slot is showing, and nil means the slot is free.
-- Everything else belongs to the slot and outlives what is in it.
A.wins = A.wins or {}

local function wslot(k)
	local w = A.wins[k]
	if not w then
		-- ba and bl are a BOX's panel and its lines. Empty on a slot
		-- showing a rig, and a rig's box/inn are empty on a slot
		-- showing a box: the two are different pictures and neither
		-- pool is ever asked to draw the other.
		-- fantxt is the document case's: one label per sheet. Pooled
		-- with the rest, so a slot that showed a rig and then a case
		-- reuses what it made and grows the difference.
		-- `cell` is the screen rectangle of every square, per slot, for
		-- the hit tests - the window's twin of A.pk_cells.
		-- `hi` is where the thing in hand would land in a RIG: a fill
		-- and four edges. A box paints the same block out of ba and bl
		-- along with its own panel and seams, and the two pools cannot
		-- be shared, because a box's are counted from the top of its
		-- own draw.
		w = { box = {}, inn = {}, ico = {}, cnt = {}, gr = {}, cell = {},
		      ba = {}, bl = {}, hi = {}, fantxt = {} }
		A.wins[k] = w
	end
	return w
end

for k = 1, WIN_MAX do wslot(k) end

-- Where a magazine is being carried from, if one is: {k, i}.
A.win_drag = A.win_drag or nil

-- Which window is being carried by its header, and by how much:
-- {k, dx, dy}. The offset is the distance from the window's corner to
-- the cursor, so it does not jump when you take hold of it.
A.win_grab_at = A.win_grab_at or nil

-- ============================================================
-- WHAT IS DRAWN ON TOP IS WHAT WAS MADE LAST
--
-- Draw order among siblings is CREATION order, and there is no way to
-- change it once a static exists. That is why windows are cascaded
-- rather than raised, and it is why this mod has to think about the
-- order it BUILDS things in rather than the order it draws them.
--
-- There are three layers, drawn bottom to top:
--
--   1  the panel, the column, the pockets and the readouts on them
--   2  the open-rig windows
--   3  the magazine on the cursor
--
-- Every pool in every layer grows on demand, and a pool that grows
-- LATER lands on top of everything made before it. So:
--
--   * open a rig, then put a magazine into a pocket of the one you are
--     WEARING, and that pocket's ammo readout is newer than the window
--     and is drawn straight through it
--   * open a SECOND rig while carrying a magazine, and the window is
--     newer than the thing on the cursor
--
-- Both were reported and both are this. The rule: each layer counts
-- what it has made, and anything above a layer that has just grown is
-- REBUILT so that it is newer again. It costs one static per pool per
-- growth - bounded by the biggest rig ever opened - and nothing at all
-- on a frame where nothing was created.
-- ============================================================
local LAYER_PANEL, LAYER_WIN, LAYER_GHOST = 1, 2, 3

A.mk = A.mk or { 0, 0, 0 }

function A.mkstatic(xml, path, parent, layer)
	layer = layer or LAYER_PANEL
	A.mk[layer] = A.mk[layer] + 1
	return xml:InitStatic(path, parent)
end

function A.mktext(xml, path, parent, layer)
	layer = layer or LAYER_PANEL
	A.mk[layer] = A.mk[layer] + 1
	return xml:InitTextWnd(path, parent)
end

-- A CUIProgressBar, which is neither of the above: it has a position
-- rather than a texture, and only a node declaring a <progress> child
-- makes one. The rig slot's condition bar is the game's own control
-- and not a rectangle painted to look like it, so it is made the way
-- the game makes one.
function A.mkbar(xml, path, parent, layer)
	layer = layer or LAYER_PANEL
	A.mk[layer] = A.mk[layer] + 1
	return xml:InitProgressBar(path, parent)
end

-- How much has been made BELOW a layer. A change means everything from
-- that layer up is now underneath something it ought to be over.
function A.mk_below(layer)
	local n = 0
	for i = 1, layer - 1 do n = n + A.mk[i] end
	return n
end

-- The one that has to be on top of everything. Deliberately NOT through
-- mkstatic: making one ghost must not invalidate the other.
function A.mkghost(field, xml, path, parent)
	local stamp = A.mk_below(LAYER_GHOST)
	if A[field] and A[field .. "_gen"] == stamp then
		return A[field], false
	end

	if A[field] then A.wshow(A[field], false) end
	A[field] = xml:InitStatic(path, parent)
	A[field .. "_gen"] = stamp
	return A[field], true
end

-- ============================================================
-- PUTTING SOMETHING DOWN IS NOT OPTIONAL
--
-- gui.item_in_hold is the menu's own "something is being carried" flag,
-- and this mod sets it while a magazine is in hand. UICellContainer
-- reads it in On_Scroll:
--
--     if self.hold.idx or self.owner.item_in_hold then ... return end
--
-- so a flag left set STOPS THE WHEEL SCROLLING THE BAG - for the rest
-- of the session, because ui_inventory.GUI is only rebuilt on a net
-- destroy, not when you close the inventory. Dragging the bar still
-- works, which is why it reads as "the wheel broke".
--
-- Every ordinary end of a drag cleared it. The ones that are not
-- ordinary did not: a window closed with a magazine in hand, the
-- inventory shut mid-drag, a draw that threw. So there is one function
-- that puts it down, and win_draw calls it whenever nothing of ours is
-- in hand - which makes it self-healing rather than a list of places to
-- remember.
-- ============================================================
-- The square in hand goes down with everything else: a drag left
-- pointing at an entry after the menu has gone is an index that is
-- wrong about everything.
function A.let_go()
	local gui = gui_now()
	if gui and gui.item_in_hold == CC_ID then
		gui.item_in_hold = false
		return true
	end
	return false
end

-- ============================================================
-- AND THE SAME FOR THE SCROLL WE PAUSED
--
-- A press this mod claims pauses the container's scroll, because the
-- button being down is exactly when the wheel amplifier must not run.
-- The release takes it off again - but "the release" is the ordinary
-- ending, and this file already keeps a list of the ones that are not:
-- a window closed with something in hand, the inventory shut mid-drag,
-- a draw that threw.
--
-- A container left with scrolling paused NEVER SCROLLS AGAIN, and this
-- mod has already lost a release to that. So the pause is taken off the
-- same way item_in_hold is put down: not by remembering every route
-- out, but by asking every frame whether anything of ours is still
-- being held, and undoing it when nothing is.
--
-- A.paused is what makes it safe to sweep every container: only a pause
-- WE put on is taken off, so a player mid-drag of their own is left
-- alone.
-- ============================================================
function A.unpause()
	if not A.paused then return false end
	A.paused = nil

	local gui = gui_now()
	local cc = gui and gui.CC
	if type(cc) ~= "table" then return false end

	local n = 0
	for _, c in pairs(cc) do
		pcall(function()
			if type(c) == "table" and c.scroll_pause then
				c.scroll_pause = false
				n = n + 1
			end
		end)
	end

	return n > 0
end

-- ============================================================
-- WHAT TIER THE RIG IN THE WINDOW IS
--
-- Derived, not tabled. How good a rig is and how many pockets it has
-- are the same fact - which is why the loot tiers and the craft recipes
-- are GENERATED from the pocket counts by the scripts in art/ - so a
-- table here would be a fourth copy of it to keep in step.
--
-- The weights are the loot generator's, and they are the same numbers
-- art/mkloot.py bands the ladder with: a slot is worth its cells plus
-- a premium for what its shape can do, because four 1x1 squares and
-- one 2x2 are four cells each and are not the same thing to a player.
--
--     1x1  1.0    2x1  2.2    3x1  3.4    2x2  4.8
--
-- The bands are where l_amp_rigs.ltx actually divides: the ladder runs
-- from nine cells to twenty-six, which is 12.4 to 30.4 of this.
-- ============================================================
local function slot_worth(s)
	if type(s) ~= "table" then return 0 end
	local w, h = s.w or 1, s.h or 1
	if w == 1 and h == 1 then return 1.0 end
	if w == 3 or h == 3 then return 3.4 end
	if w == 2 and h == 2 then return 4.8 end
	return 2.2
end

-- NO TIER COLOUR. It was the window border, and the window border is
-- one grey now. A.rig_tier stays: the dismantling roll still asks what
-- tier a rig is, and that is the only caller left.
--
-- TAKES A FLAT SLOT LIST, not rows. Its one caller has the list and
-- had to wrap it in a fake row to hand it over.
function A.rig_tier(slots)
	local worth = 0
	for i = 1, #(slots or {}) do
		worth = worth + slot_worth(slots[i])
	end

	if worth <= 17.0 then return 1 end
	if worth <= 26.0 then return 2 end
	return 3
end

-- ============================================================
-- A WINDOW THAT HAD TO MAKE A NEW PIECE OF FURNITURE ASKS TO BE REBUILT
--
-- Statics are drawn in the ORDER THEY WERE MADE, and a window makes its
-- background, then its grid, then the icons standing on the grid. That
-- holds for as long as the grid does not grow.
--
-- It grows when a slot that was showing a four-by-two ammo case is
-- handed a four-by-six armour case: the new grid wants more lines than
-- this slot has ever made, and every one of them is made AFTER the
-- icons and drawn across them.
--
-- Rather than a rule about when that is safe, the window says so, and
-- the next frame rebuilds all four in slot order - the same rebuild
-- that already runs when something underneath them has grown. The cost
-- is one frame with a hairline over an icon, and then it is right.
--
-- Only when there are icons to be drawn over: the first draw of a
-- window makes everything and there is nothing to get in front of.
-- ============================================================
function A.win_grew(w)
	if w and w.ico and #w.ico > 0 then A.win_regrow = true end
end

function A.win_shown()
	for k = 1, WIN_MAX do
		if A.wins[k].id then return true end
	end
	return false
end

-- The slot showing a given rig, if any.
function A.win_of(id)
	if not id then return nil end
	for k = 1, WIN_MAX do
		if A.wins[k].id == id then return k end
	end
	return nil
end

-- The lowest free slot. Lowest rather than next, so the cascade stays
-- tight as windows are opened and closed.
local function win_free()
	for k = 1, WIN_MAX do
		if not A.wins[k].id then return k end
	end
	return nil
end

-- The object in a slot, while it is still ours to look into. A rig
-- that has been sold, dropped or put on is not.
function A.win_obj(k)
	local w = A.wins[k]
	if not (w and w.id) then return nil end

	local obj = level.object_by_id(w.id)
	if not obj then return nil end
	if A.rig_id == w.id then return nil end

	if utils_item and utils_item.in_actor_inv then
		local ok, mine = pcall(utils_item.in_actor_inv, obj)
		if not (ok and mine) then return nil end
	end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and A.win_kind(sec)) then return nil end

	return obj, sec
end

function A.win_open(obj)
	if not obj then return false end

	local ok, sec = pcall(function() return obj:section() end)
	local kind = ok and A.win_kind(sec)
	if not kind then return false end

	local ok2, id = pcall(function() return obj:id() end)
	if not ok2 then return false end

	if A.rig_id == id then
		notify("That rig is on your chest - use the panel")
		return false
	end

	-- Already open. Not an error and not a second window: you asked for
	-- a rig that is on screen, and it is.
	local have = A.win_of(id)
	if have then
		dbg("open rig: %s is already open in slot %s",
		    tostring(id), tostring(have))
		return true
	end

	local k = win_free()
	if not k then
		notify("Four open already - close one first")
		return false
	end

	local w = A.wins[k]
	w.id = id
	-- WHICH OF THE TWO THIS SLOT IS SHOWING, decided once when it opens
	-- rather than asked again on every frame, click and drop. A slot
	-- that showed a rig and now shows a box keeps the statics and
	-- nothing else.
	w.kind = kind
	w.rig, w.lay, w.slots = nil, nil, nil
	w.cols, w.rows, w.sec = nil, nil, nil
	-- w.pos is NOT touched: a slot that has been moved keeps its place,
	-- and one that has not is cascaded by the draw.

	if kind == "box" then
		A.sfx_case(sec, "open")
	else
		A.sfx("out")
	end
	log("opened rig %s (id %s) in slot %s",
	    tostring(sec), tostring(id), tostring(k))
	return true
end

-- WHY, whenever anyone knows. There are six ways one of these shuts and
-- "it did not open" and "it opened and something shut it" look exactly
-- the same from the other side of the screen. Debug only; dbg collapses
-- repeats.
function A.win_close(k, why)
	local w = A.wins[k]
	if not w then return end

	if w.id then
		if w.kind == "box" and w.sec then
			A.sfx_case(w.sec, "close")
		else
			A.sfx("in")
		end
		dbg("open rig: closing %s in slot %s - %s", tostring(w.id),
		    tostring(k), tostring(why or "no reason given"))
	end

	-- w.pos IS KEPT. A slot's place on screen belongs to the slot, not
	-- to whatever rig was last in it: closing one and opening another
	-- puts the new one where you had arranged the old one, and a window
	-- that goes home to the middle every time is a window you move every
	-- time.
	w.id, w.rig, w.lay = nil, nil, nil
	w.rect, w.xr = nil, nil
	w.kind, w.cols, w.rows, w.sec = nil, nil, nil, nil
	w.slots = nil

	-- A magazine in hand from THIS window has nowhere to land now, so
	-- it stays where it is - and the menu is told the hand is empty.
	if A.win_drag and A.win_drag.k == k then
		A.win_drag = nil
		A.let_go()
	end
	if A.win_grab_at and A.win_grab_at.k == k then A.win_grab_at = nil end

	A.win_hide(k)
end

function A.win_close_all(why)
	for k = 1, WIN_MAX do A.win_close(k, why) end
end

function A.win_hide(k)
	local w = A.wins[k]
	if not w then return end

	w.lay = nil
	if w.edge then A.wshow(w.edge, false) end
	if w.bg then A.wshow(w.bg, false) end
	if w.ttl then A.wshow(w.ttl, false) end
	if w.x then A.wshow(w.x, false) end
	if w.rule then A.wshow(w.rule, false) end
	for i = 1, #w.box do A.wshow(w.box[i], false) end
	for i = 1, #w.inn do A.wshow(w.inn[i], false) end
	for i = 1, #w.ico do A.wshow(w.ico[i], false) end
	for i = 1, #(w.ba or {}) do A.wshow(w.ba[i], false) end
	for i = 1, #(w.bl or {}) do A.wshow(w.bl[i], false) end
	for i = 1, #(w.hi or {}) do A.wshow(w.hi[i], false) end
	for i = 1, #(w.fantxt or {}) do A.wshow(w.fantxt[i], false) end
	for _, g in pairs(w.gr or {}) do A.wshow(g, false) end

	-- ============================================================
	-- THE COUNTS ARE WALKED WITH pairs, AND THE REST ARE NOT
	--
	--   "if i close the window the number ammount of parts in stack in
	--    the box stull shows even if i drop the box"
	--
	-- w.cnt is the one pool with HOLES in it. A square gets a count
	-- only when there is more than one thing on it, so a box holding a
	-- single bolt on square one and a stack on square two has
	-- w.cnt = { [2] = ... } - and `#` on a table whose first slot is
	-- empty is ZERO. The loop ran no times and the number stayed on
	-- screen until the whole dialog was thrown away.
	--
	-- Hiding has no order to it, so walking every key costs nothing and
	-- is right whether the pool has gaps or not.
	-- ============================================================
	for _, c in pairs(w.cnt or {}) do A.wshow(c, false) end

	-- ...AND THE MED POCKET, which is four windows and an icon per
	-- square. Walked with pairs like the counts above, and for the same
	-- reason: the icon pool is filled as squares are used, so it can
	-- have holes in it and `#` on a table whose first slot is empty is
	-- ZERO - a loop that runs no times and leaves a picture on screen.
	w.cell = {}
end

function A.win_hide_all()
	for k = 1, WIN_MAX do A.win_hide(k) end
	if A.win_ghost then A.wshow(A.win_ghost, false) end
end

-- ============================================================
-- WHAT THE CURSOR IS ON
--
-- FROM THE TOP SLOT DOWN. The stacking order is the slot order, so
-- where two windows overlap the higher slot is the one you can see and
-- the one the click belongs to. Asking in slot order instead would hand
-- the click to a window that is underneath another.
-- ============================================================
function A.win_hit()
	for k = WIN_MAX, 1, -1 do
		local w = A.wins[k]
		if w.id and w.rect and hit(w.rect) then return k end
	end
	return nil
end

function A.win_over()
	return A.win_hit() ~= nil
end

function A.win_over_close(k)
	k = k or A.win_hit()
	local w = k and A.wins[k]
	return (w and w.xr and hit(w.xr)) and true or false
end

-- The title bar and nothing else: a window you can grab anywhere is a
-- window you move by accident every time you miss a pocket. The close
-- box lives in the header too and is checked first, so clicking the x
-- closes rather than picks the window up.
function A.win_over_head(k)
	k = k or A.win_hit()
	local w = k and A.wins[k]
	if not (w and w.rect) then return false end
	if A.win_over_close(k) then return false end

	local r = w.rect
	return hit({ r[1], r[2], r[3], WIN_HEAD }) and true or false
end

-- Which pocket of a slot the cursor is over, if any.
function A.win_at(k)
	k = k or A.win_hit()
	local w = k and A.wins[k]
	if not (w and w.lay) then return nil end

	for i = 1, #w.lay do
		if hit(w.lay[i]) then return i end
	end

	-- ============================================================
	-- A BOX'S SQUARES TOUCH
	--
	--   "sometims items that are multicell size i try to pick them up
	--    and accidently aim right between the cells, so make the cells
	--    in containers touch eachother ... the same way this works in
	--    normal inventory."
	--
	-- The rectangles above are the DRAWN squares, and between two of
	-- them runs the hairline gap - a dead strip a few pixels wide that
	-- swallowed the press. The normal inventory has no dead strips: a
	-- cell reaches to where the next one begins. So when the walk
	-- misses inside a box, the square is computed by PITCH - origin
	-- from the first rectangle, step measured off its neighbours (the
	-- drawn size plus the gap) - and each gap goes with the square
	-- before it, which is what floor division answers anyway.
	--
	-- BOXES ONLY. A rig's pockets are not a uniform grid, and the gap
	-- between two POCKETS honestly means "neither".
	-- ============================================================
	if w.kind == "box" and w.cols and w.rows and w.lay[1] then
		local first = w.lay[1]
		local sx = (w.cols > 1 and w.lay[2])
		           and (w.lay[2][1] - first[1]) or first[3]
		local sy = (w.rows > 1 and w.lay[w.cols + 1])
		           and (w.lay[w.cols + 1][2] - first[2]) or first[4]

		if sx > 0 and sy > 0 then
			local cx, cy = cursor()
			local c = math.floor((cx - first[1]) / sx) + 1
			local r = math.floor((cy - first[2]) / sy) + 1
			if r >= 1 and r <= w.rows and c >= 1 and c <= w.cols then
				local i = (r - 1) * w.cols + c
				if w.lay[i] then return i end
			end
		end
	end

	return nil
end

function A.win_grab()
	local k = A.win_hit()
	if not (k and A.win_over_head(k)) then return false end

	local cx, cy = cursor()
	local r = A.wins[k].rect
	A.win_grab_at = { k = k, cx - r[1], cy - r[2] }
	return true
end

function A.win_drop_head()
	if not A.win_grab_at then return false end
	A.win_grab_at = nil
	return true
end

-- ============================================================
-- A RIG IN A WINDOW IS THE SAME RIG, IN THE OTHER FORM
--
-- The panel shows the rig on your chest, whose slots hold real
-- objects. A window shows one you are NOT wearing, whose slots hold
-- records - see the note on `wear` and `hold` at the top of this file.
--
-- Everything below is the record half. The geometry, the packer, the
-- stacking and the aim are the SAME functions the worn rig uses:
-- box_spot, box_room, A.pk_on_square, A.pk_aim. Only the thing being
-- moved differs, and that difference is the whole of what these do.
--
-- ============================================================
-- THE SLOT LIST IS THE ONE THE WINDOW DREW
--
--   "items that are inside the rig are not present/visible in the open
--    rig window, and items cannot be put inside"
--
-- BOTH HALVES OF THAT WERE ONE LINE. This asked for `w.sec`, and
-- nothing ever set `w.sec` for a rig - only A.box_draw sets it, for a
-- box. So every window of a rig answered "no slots": nothing to draw
-- the contents of, and nowhere for a drop to land. A window is a lot of
-- code to be defeated by an unset field.
--
-- It is set HERE, from the object, rather than trusted to the draw,
-- because a drop can be handled on a frame the draw has not reached.
--
-- AND THE LIST IS THE DRAWN ONE. w.slots is filled by the draw with the
-- flattened rows it laid out, so `i` means the same slot to the hit
-- test, the contents and the drop. Falling back to A.rig_slots_all
-- would be the raw canonical order - the same "two lists that agree
-- only by luck" that A.resolve_pk exists to prevent on the panel - so
-- the fallback goes through A.rig_flat, which packs exactly as the draw
-- does.
-- ============================================================
function A.rig_flat(sec, id)
	local rows = A.tip_rows(sec, id)
	local out = {}
	for r = 1, #rows do
		for c = 1, #rows[r] do out[#out + 1] = rows[r][c] end
	end
	return out
end

function A.win_slots(k)
	local w = A.wins[k]
	if not (w and w.id) then return {} end

	if not w.sec then
		local _, sec = A.win_obj(k)
		w.sec = sec
	end
	if not w.sec then return {} end

	w.slots = w.slots or A.rig_flat(w.sec, w.id)
	return w.slots
end

-- The record list for slot i, made on read so that every caller can
-- walk it without asking first. A.pk_restore reads these same tables
-- when the rig goes on.
function A.win_pk(k, i)
	local w = A.wins[k]
	local slots = A.win_slots(k)
	local sl = slots[i]
	if not (w and w.id and sl) then return {} end

	local t = A.slot_of(w.id, sl.key)
	if not t then
		t = {}
		A.hold[w.id] = A.hold[w.id] or {}
		A.hold[w.id][sl.key] = t
	end
	return t
end

-- ...and drop a slot the last thing has just left, so an emptied rig
-- does not carry a record of nothing for the rest of the save.
function A.win_sync(k, i)
	local w = A.wins[k]
	local sl = A.win_slots(k)[i]
	if not (w and w.id and sl) then return end

	local by = A.hold[w.id]
	if not by then return end

	local t = by[sl.key]
	if t and #t == 0 then by[sl.key] = nil end
	if not next(by) then A.hold[w.id] = nil end
end

-- How deep a square of this window's rig stacks: the bag's answer, the
-- same one the worn rig uses.
local function win_cap(sec)
	return A.slot_cap(sec)
end

-- ============================================================
-- HOW MANY OBJECTS AN ENTRY STANDS FOR
--
-- The pile is packed into a string, and this used to unpack it - a
-- gmatch building a table of tables - once per square per frame of an
-- open window, to answer a number that only changes when the string
-- does.
--
-- So the string IS the memo key. Same string, same answer; a different
-- string re-counts. The two fields ride on the entry and never reach a
-- save, because save_state copies the entry's named fields and these
-- are not among them.
-- ============================================================
-- ============================================================
-- ...AND THE NUMBER TO WRITE ON THE PLATE
--
--   "stack indicator in the rig shows ammount of items not ammount of
--    uses/bullets like in inventory"
--
-- NOT A.pile_show DIRECTLY, and this is a trap worth naming. pile_show
-- goes through A.pile_norm, which NORMALISES `of` IN PLACE - and a
-- held rig's `of` is a packed string, not a list. Handed one, pile_norm
-- finds no table, builds a pile of one empty record out of fields the
-- entry does not have, and WRITES THAT OVER the packed string. The
-- whole square's contents, gone, from drawing a number.
--
-- So the string is unpacked into a throwaway and pile_show is asked
-- about that. Memoed on the string exactly as A.win_pile_n is: same
-- string, same answer.
-- ============================================================
function A.win_show(ent)
	if not ent then return 0 end
	if type(ent.of) ~= "string" then return A.pile_show(ent) end

	if ent._sof == ent.of then return ent._s or 0 end

	local of = A.pile_unpack(ent.of, ent.sec)
	local val = A.pile_show({ sec = ent.sec, of = of or {} })

	ent._sof, ent._s = ent.of, val
	return val
end

function A.win_pile_n(ent)
	if not (ent and type(ent.of) == "string") then return 0 end
	if ent._nof == ent.of then return ent._n or 0 end

	local of = A.pile_unpack(ent.of, ent.sec)
	ent._nof = ent.of
	ent._n = of and #of or 0
	return ent._n
end

-- ============================================================
-- OUT: MAKE THE THING, THEN DROP THE RECORD
--
-- box_make per object, which is what puts the uses and the wear back
-- on. A make that failed puts the record back on the pile, so the rig
-- is left exactly as it was - the only acceptable way for this to
-- fail.
--
-- The square goes when the pile empties: an entry standing for nothing
-- would leave the rig weighing for things that will never come out.
-- ============================================================
function A.win_take(k, i, n, one_only)
	local w = A.wins[k]
	if w and w.kind == "box" then return A.box_take(w.id, i, w.sec) end

	local t = A.win_pk(k, i)
	local ent = t[n or 1]
	if not ent then return 0 end

	local of = A.pile_unpack(ent.of, ent.sec)
	if not of then
		table.remove(t, n or 1)
		A.win_sync(k, i)
		return 0
	end

	-- A PILE, NOT A LIST. pile_pull and pile_add read `it.sec` and
	-- `it.of`, and handing them the bare array answers nil for
	-- everything - a take that quietly did nothing, which is exactly
	-- what the first version of this did.
	local pile = { sec = ent.sec, of = of }
	local want = one_only and 1 or #of
	local out = 0

	for _ = 1, want do
		local rec = A.pile_pull(pile, #of)
		if not rec then break end

		local made, id = A.box_make({ sec = ent.sec, cond = rec.cond,
		                              uses = rec.uses, ammo = rec.ammo })
		if not made then
			-- PUT IT BACK. It came off the pile before it was made, and
			-- a make that failed is an object that does not exist.
			A.pile_add(pile, rec)
			log("!open rig: could not hand back %s", tostring(ent.sec))
			notify("That could not come out of the rig")
			break
		end

		if id then A.hold_square(id, ent.sec, ent.rot) end
		out = out + 1
	end

	if #of > 0 then
		ent.of = A.pile_pack(pile)
	else
		table.remove(t, n or 1)
		A.win_sync(k, i)
	end

	if out > 0 then A.sfx("out") end
	return out
end

-- ============================================================
-- IN: READ THE THING, THEN DESTROY IT
--
-- Same order as taking a worn rig off, and for the same reason: a
-- capture that failed leaves a real item alone rather than trading it
-- for a record that would rebuild it wrong.
--
-- ONE SQUARE, exactly as the worn rig does it and for the same reason:
-- dropping is aiming.
-- ============================================================
function A.win_put(k, obj, i, from, idx, ar, ac)
	local w = A.wins[k]

	-- A BOX TAKES IT BY THE SQUARE, not by the slot. `i` is a cell
	-- index into the grid when the window is a box, and the row and
	-- column it names are where the item's top-left corner goes.
	if w and w.kind == "box" and w.id and w.cols then
		-- THE SAME ANSWER THE HIGHLIGHT GAVE. `i` is the cell index the
		-- caller found under the cursor; box_hover turns that into the
		-- item's own top-left, and a drop that lands somewhere other
		-- than where the green rectangle was is worse than no rectangle.
		local it = A.box_grab(obj)
		local r, c = A.box_hover(k, nil, it)

		if not r and type(i) == "number" then
			r = math.floor((i - 1) / w.cols) + 1
			c = (i - 1) % w.cols + 1
		end

		if from and idx then
			return A.box_put_all(w.id, w.sec, from, idx, r, c)
		end

		return A.box_put(w.id, w.sec, obj, r, c)
	end

	if not (obj and w and w.id and w.sec) then return 0 end

	local sec
	pcall(function() sec = obj:section() end)
	local ok, why = A.pk_takes(sec)
	if not ok then
		notify("%s", why)
		return 0
	end

	-- A whole cell at once when the caller knows which one it was: a
	-- drag out of the bag hands over the stack it was showing.
	local objs = (from and idx) and A.cell_objs(from, idx) or { obj }
	if #objs == 0 then return 0 end

	local slots = A.win_slots(k)
	local cap = win_cap(sec)

	-- WHICH SLOT, AND WHERE IN IT. The aimed slot if it will have it,
	-- otherwise the first that will; a torn slot is neither.
	--
	-- THE SAME ANSWER THE PANEL USES, and the same one the green block
	-- was drawn from: A.fit_land does the aimed square, the pile to
	-- join and the free square, in that order and both ways up. This
	-- used to be its own copy of all three - with its own idea of which
	-- way up the thing was - and it handed a SLOT to a function that
	-- reads a POCKET, so every comparison in it was against nil.
	local pick, t, target
	-- THE OBJECT, not just its section: a thing lying on its side in
	-- your bag has to arrive lying on its side.
	local oid
	pcall(function() oid = obj:id() end)
	local it = A.item_of(sec, oid)

	local function try(n)
		if w.torn and w.torn[n] then return false end
		local sl = slots[n]
		if not (sl and it) then return false end

		local list = A.win_pk(k, n)

		-- Only the AIMED slot gets the aimed square: carrying (ar, ac)
		-- on to another slot would drop the thing at a square the
		-- player pointed at somewhere else.
		local want_r = (n == i) and ar or nil
		local want_c = (n == i) and ac or nil

		local at, r, c, ww, hh, rot =
			A.fit_land(sl.w, sl.h, list, cap, it, want_r, want_c)
		if not r then return false end

		if not at then
			list[#list + 1] = { sec = sec, r = r, c = c, w = ww, h = hh,
			                    rot = rot, of = "" }
			at = #list
		end

		pick, t, target = n, list, at
		return true
	end

	if not (i and try(i)) then
		for n = 1, #slots do
			if n ~= i and try(n) then break end
		end
	end

	if not pick then
		local cw, ch = A.cells(sec)
		notify("Nothing in that rig has room for a %dx%d",
		       tonumber(cw) or 1, tonumber(ch) or 1)
		return 0
	end

	local ent = t[target]
	local pile = { sec = ent.sec, of = A.pile_unpack(ent.of, ent.sec) or {} }
	local went = 0

	for q = 1, #objs do
		if #pile.of >= cap then break end

		local one_sec
		pcall(function() one_sec = objs[q]:section() end)
		if one_sec ~= sec then break end

		-- READ FIRST, RELEASE SECOND. An object whose record cannot be
		-- read is left in the bag rather than destroyed for a record
		-- that would rebuild it wrong.
		local rec = A.box_grab(objs[q])
		local one = rec and rec.of and rec.of[1]
		if not one then break end

		local oid
		pcall(function() oid = objs[q]:id() end)

		local okr = pcall(function() alife_release(objs[q]) end)
		if not okr then break end

		-- A thing that was in a slot of the WORN rig has just stopped
		-- existing; that slot must not go on pointing at it.
		if oid then
			A.uncarry(oid)
			A.pk_forget(oid)
		end

		A.pile_add(pile, one)
		went = went + 1
	end

	ent.of = A.pile_pack(pile)

	-- A square that swallowed nothing is not a square.
	if went == 0 and A.win_pile_n(ent) == 0 then
		table.remove(t, target)
		A.win_sync(k, pick)
	end

	if went > 0 then A.sfx("in") end
	return went
end

-- ============================================================
-- BETWEEN TWO RIGS, OR TWO SLOTS OF ONE
--
-- Both ends are records, so nothing is created and nothing destroyed
-- and there is no order to get wrong. The entry either JOINS a
-- same-section pile under the aim (only when the whole of it fits -
-- half a pile teleporting is how somebody loses a bandage), lands on
-- the aimed free square, or takes the first free square. A refusal
-- moves nothing and the caller puts the drag back.
-- ============================================================
function A.win_move(fk, fi, fn, tk, ti, r, c)
	local wf, wt = A.wins[fk], A.wins[tk]
	if not (wf and wt and wf.id and wt.id) then return false end
	if fk == tk and fi == ti and not (r and c) then return false end

	local sl = A.win_slots(tk)[ti]
	if not sl then return false end

	if wt.torn and wt.torn[ti] then
		notify("That pouch is torn - mend the rig")
		return false
	end

	local t1 = A.win_pk(fk, fi)
	local t2 = A.win_pk(tk, ti)
	local e = t1[fn]
	if not e then return false end
	if t1 == t2 and not (r and c) then return false end

	local cap = win_cap(e.sec)

	local on = (r and c) and A.pk_on_square(t2, r, c) or nil
	local tgt = on and t2[on]

	if tgt and tgt ~= e then
		if tgt.sec == e.sec
		   and A.win_pile_n(tgt) + A.win_pile_n(e) <= cap then
			local pile = { sec = tgt.sec,
			               of = A.pile_unpack(tgt.of, tgt.sec) or {} }
			local add = A.pile_unpack(e.of, e.sec) or {}
			for q = 1, #add do A.pile_add(pile, add[q]) end
			tgt.of = A.pile_pack(pile)
			table.remove(t1, fn)
			A.win_sync(fk, fi)
			A.sfx("in")
			return true
		end
		return false          -- somebody else's square: a refusal
	end

	-- THE SHAPE HAS TO FIT THE NEW SLOT. A 2x2 drum out of a drum
	-- pocket does not go in a 3x1 row, and the aim cannot make it.
	local ew, eh = e.w or 1, e.h or 1
	if not (ew <= sl.w and eh <= sl.h) then
		if eh <= sl.w and ew <= sl.h then
			ew, eh = eh, ew
		else
			return false
		end
	end

	local skip = (t1 == t2) and fn or nil

	-- THE SAME PACKER THE DROP USES, so a move lands where the block
	-- said it would and lies down if that is the only way it fits.
	--
	-- A CAP OF NOTHING, because a join is not this function's business:
	-- the same-section merge is handled above, in full, with the pile
	-- arithmetic a move needs. Nothing can be under the cap, so
	-- fit_land only ever answers with a square.
	local at, rr, cc2, nw, nh = A.fit_land(sl.w, sl.h, t2, 0,
		{ sec = e.sec, w = ew, h = eh, rot = e.rot }, r, c, skip)
	if not (rr and not at) then return false end

	e.r, e.c = rr, cc2
	if nw ~= (e.w or 1) then
		e.w, e.h, e.rot = nw, nh, not e.rot or nil
	end

	if t1 ~= t2 then
		t2[#t2 + 1] = e
		table.remove(t1, fn)
		A.win_sync(fk, fi)
	end

	A.sfx("in")
	return true
end

-- ============================================================
-- ACROSS THE TWO KINDS OF SLOT
--
-- A slot of the rig ON YOUR CHEST holds a real object, in the world.
-- A slot of a rig in a WINDOW holds a record and no object at all. So
-- a thing crossing between them is not a move - it is a birth or a
-- death, and which way round decides the order.
--
--   window -> chest   MAKE the object, then drop the record
--   chest -> window   READ the object, then destroy it
--
-- Both are the same order the rest of this file lives by: the thing
-- that can fail happens first, so a failure leaves it where it was.
-- ============================================================
function A.win_to_panel(k, i, n, pocket, ar, ac)
	local t = A.win_pk(k, i)
	local ent = t[n or 1]
	if not ent then return false end

	if pocket and A.is_torn(pocket) then
		notify("That pouch is torn - mend the rig")
		return false
	end

	local of = A.pile_unpack(ent.of, ent.sec)
	local rec = of and of[#of]
	if not rec then return false end

	-- ROOM FIRST, and only then the object: a make with nowhere to go
	-- would hand the player something out of a rig they did not ask to
	-- empty.
	if not A.slot_free(ent.sec, pocket) then
		local cw, ch = A.cells(ent.sec)
		notify("Nothing in the rig has room for a %dx%d",
		       tonumber(cw) or 1, tonumber(ch) or 1)
		return false
	end

	local made, id = A.box_make({ sec = ent.sec, cond = rec.cond,
	                              uses = rec.uses, ammo = rec.ammo })
	if not (made and id) then
		log("!open rig: could not hand %s to the panel", tostring(ent.sec))
		notify("That could not come out of the rig")
		return false
	end

	-- The object does not exist for a frame or two, so the slot is
	-- filed against its id and settle_incoming finishes the job when
	-- the engine hands it over.
	A.slot_put(id, ent.sec, pocket, ar, ac)
	A.incoming[id] = time_global() + 10000
	A.pending_item[id] = { sec = ent.sec }

	local pile = { sec = ent.sec, of = of }
	A.pile_pull(pile, #of)

	if #of > 0 then
		ent.of = A.pile_pack(pile)
	else
		table.remove(t, n or 1)
		A.win_sync(k, i)
	end

	A.sfx("in")
	return true
end

-- IN from a slot of the worn rig. The object is real and in the world,
-- so this is win_put's job exactly - it reads it, destroys it, and
-- clears the panel slot that was pointing at it.
function A.panel_to_win(pocket, pn, k, i, ar, ac)
	local P = A.pk[pocket]
	local e = P and P.slots[pn or 1]
	if not (e and #e.ids > 0) then return false end

	local obj = level.object_by_id(e.ids[#e.ids])
	if not obj then return false end

	return A.win_put(k, obj, i, nil, nil, ar, ac) > 0
end

-- ============================================================
-- ...AND A STOWED RIG'S POUCH SLOTS
--
-- The fitted LIVE pouch slots of the rig in window k - the same rule
-- the panel and the tooltip follow: a slot the rig has worn past
-- grants nothing, and its pouch waits, fitted but idle.
-- ============================================================
function A.win_pslots(k)
	local w = A.wins[k]
	local id = w and w.id
	if not id then return {} end

	local t = A.pslot[id]
	if not t then return {} end

	local obj = level.object_by_id(id)
	local live = A.slots_live(A.rig_cond(obj))

	local out = {}
	for q = 1, math.min(PSLOTS, live) do
		if t[q] then out[#out + 1] = q end
	end
	return out
end






function A.win_frame(k, xml, gui, fr, winw, winh, sec)
	local w = A.wins[k]
	if not (w and xml and gui and gui.equ_dialog and fr) then return nil end

	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then ratio = 1 end

	local px, py
	local g = A.win_grab_at

	if g and g.k == k then
		local cx, cy = cursor()
		px, py = cx - g[1], cy - g[2]
		w.pos = { px, py }
	elseif w.pos then
		px, py = w.pos[1], w.pos[2]
	else
		local step = (k - 1) * WIN_STEP
		px = (SCREEN_W - winw) / 2 + step
		py = (SCREEN_H - winh) / 2 + step
	end

	if px > SCREEN_W - winw then px = SCREEN_W - winw end
	if py > SCREEN_H - winh then py = SCREEN_H - winh end
	if px < 0 then px = 0 end
	if py < 0 then py = 0 end

	if w.pos then w.pos[1], w.pos[2] = px, py end

	if not w.bg then
		-- The edge FIRST, so the background lands on top of it and what
		-- shows is a border rather than a slab.
		w.edge = A.mkstatic(xml, "amp:winedge", gui.equ_dialog, LAYER_WIN)
		w.bg = A.mkstatic(xml, "amp:winbg", gui.equ_dialog, LAYER_WIN)
		-- AFTER the background and before the title: it is drawn on the
		-- background, and the title is drawn on it.
		w.rule = A.mkstatic(xml, "amp:winrule", gui.equ_dialog, LAYER_WIN)
		-- A LABEL, so InitTextWnd - the same as the panel's title and the
		-- column's two. The close box stays a static because it is a
		-- tinted box first and a glyph second.
		w.ttl = A.mktext(xml, "amp:wintxt", gui.equ_dialog, LAYER_WIN)
		w.x   = A.mkstatic(xml, "amp:winclose", gui.equ_dialog, LAYER_WIN)
	end

	local ox, oy = px - fr.x1, py - fr.y1

	w.rect = { px, py, winw, winh }

	A.wpos(w.edge, ox - WIN_EDGE, oy - WIN_EDGE)
	A.wsize(w.edge, winw + WIN_EDGE * 2, winh + WIN_EDGE * 2)
	-- ONE GREY, ON RIGS AND BOXES ALIKE. It used to be the rig's tier
	-- colour - white, green, gold - and one quiet grey on both is what
	-- was asked for.
	A.wtint(w.edge, 255, WIN_LINE[1], WIN_LINE[2], WIN_LINE[3])
	A.wshow(w.edge, true)

	A.wpos(w.bg, ox, oy)
	A.wsize(w.bg, winw, winh)
	A.wtint(w.bg, 245, 14, 15, 19)
	A.wshow(w.bg, true)

	-- A HAIRLINE UNDER THE TITLE, so the strip reads as a header
	-- without a bar being painted behind it - the same thing the grid
	-- sections stopped doing when their captions went away.
	if w.rule then
		A.wpos(w.rule, ox + WIN_PAD, oy + WIN_HEAD - 1)
		A.wsize(w.rule, winw - WIN_PAD * 2, 1)
		A.wtint(w.rule, 255, WIN_RULE[1], WIN_RULE[2], WIN_RULE[3])
		A.wshow(w.rule, true)
	end

	A.wpos(w.ttl, ox + WIN_PAD, oy + 2)
	A.wsize(w.ttl, winw - WIN_PAD * 2 - 22, WIN_HEAD - 4)
	A.wtext(w.ttl, A.tip_name(sec))
	A.wshow(w.ttl, true)

	local xw, xh = 16 * ratio, 16
	w.xr = { px + winw - xw - 4, py + 3, xw, xh }
	A.wpos(w.x, ox + winw - xw - 4, oy + 3)
	A.wsize(w.x, xw, xh)
	-- QUIET UNTIL YOU GO NEAR IT. It was a dark red slab in the corner
	-- of every window whether you were reaching for it or not; now it is
	-- a barely-there grey box with an x on it, and it turns red under
	-- the cursor - which is the moment the colour is actually telling
	-- you something.
	if A.win_over_close(k) then
		A.wtint(w.x, 255, 190, 80, 80)
	else
		A.wtint(w.x, 70, 92, 96, 104)
	end
	A.wglyph(w.x, "x")
	A.wshow(w.x, true)

	return ox, oy, px, py
end

-- ============================================================
-- THE BOXES
--
--   "pls now add those 3 boxes to have space like rigs but
--    respectfully for meds, ammo and food. i want so they take 2x2
--    space, the boxes are unstackable, they have lets say 5x5 space
--    inside them. they can be opened like rigs, and items can be moved
--    inside and outside of them with dragging. also they should weight
--    some and get additional weight based whats inside them."
--
-- A box reuses the open-rig WINDOW - the slots, the cascade, the header
-- drag, the close box, the hit order - because all of that is about
-- windows and none of it is about magazines. What it does not reuse is
-- what is inside one.
--
-- A RIG HAS POCKETS; A BOX HAS A GRID.
--
-- A rig's contents are filed by POCKET NUMBER: pocket 3 holds a
-- magazine or it does not, and a magazine is either the right class for
-- that pocket or it is not. A box has no pockets. It has five rows of
-- five squares and things stand on them at their own footprint, so what
-- is stored is not "which pocket" but WHERE and HOW BIG - and two
-- entries clash when their rectangles overlap, which a pocket can never
-- do.
--
-- That is why A.boxes is a separate table from A.stash and not a
-- special case inside it. They answer different questions and every
-- function that touches them is different all the way down.
--
--     A.boxes[box_id] = { { sec, cond, uses, ammo, r, c, w, h }, ... }
--
-- A DENSE ARRAY, and it stays dense: entries are appended and removed
-- with table.remove, so #t is the count and every n from 1 to #t is
-- there. The rig stash is keyed by pocket and has holes in it by
-- design; this one must not, because the save writes it out by index
-- and reads it back by index.
--
-- WHAT IS IN A BOX DOES NOT EXIST ANYWHERE ELSE. Same as the rig: the
-- object is read and destroyed on the way in and rebuilt on the way
-- out, and the entry is the only copy in between. So the order is the
-- same order the whole file lives by - the thing that can fail happens
-- first:
--
--     in    read the item, THEN destroy it
--     out   make the item, THEN drop the entry
-- ============================================================
A.boxes = A.boxes or {}

-- ============================================================
-- THE DOCUMENT CASE'S WINDOW IS NOT A GRID
--
--   "this one have to have a lot of space but cannot be a bigass
--    window 10x10 tho. we need to come up with a different way to
--    handle many 'papers' in small window."
--
-- Papers are the one thing a grid cannot show: every icon is the same
-- folded sheet, so twenty-four of them in squares is twenty-four
-- identical squares. What tells one from another is its NAME.
--
-- So a fan. One sheet per row, each drawn as the edge of a piece of
-- paper with its name along it, and each covering all but the top
-- sliver of the one before - which is how papers actually sit in a
-- case, and why twenty-four of them fit in less height than six
-- squares would take.
--
-- FAN_PITCH is what you can see of a sheet and therefore what you can
-- click; FAN_STRIP is what is drawn. The last sheet has no one over it
-- and shows its whole face.
-- ============================================================
-- EIGHTEEN, BECAUSE THE NAME IS letterica16. The pitch is what you can
-- see of a sheet and therefore what a name has to fit inside; fifteen
-- was chosen when this was set in `small`, which is four pixels
-- shorter and is not used anywhere in this mod any more.
local FAN_PITCH = 18
local FAN_STRIP = 30
local FAN_W     = 226              -- room for a name, in menu units
local FAN_TEXT  = 6                -- the name's inset from the left

-- ============================================================
-- PAPER
--
-- TWO TONES, ALTERNATING. A stack of paper is not one colour - it is
-- dozens of nearly-equal ones, and that is the whole of why a stack
-- reads as a stack rather than as a painted rectangle. Two is enough;
-- a third is noise at eighteen pixels.
--
-- FAN_SHADE is what one sheet casts on the one under it. A line would
-- be a line; a shadow is what says these are separate objects lying on
-- each other.
--
-- WHY THE PAPER IS DARK. It was cream - 186,176,152, the colour paper
-- actually is - until the ink was asked to be white. White on cream is
-- a contrast of about two to one: not a colour scheme, a bug. The ink
-- is what was asked for and is therefore the fixed thing; the sheets
-- are what gave way, and they gave way towards the colour every other
-- panel in this mod is painted, which is where they should probably
-- have been from the start.
-- ============================================================
local FAN_SHEET = {  62,  59,  53 }
local FAN_ALT   = {  53,  50,  45 }
local FAN_SHADE = {  30,  28,  25 }
local FAN_OVER  = {  98,  92,  80 }   -- the one under the cursor
local FAN_INK   = { 255, 255, 255 }
local FAN_SHADOW = 2                  -- how deep the shadow is

-- HOW FAR THE HOVERED SHEET COMES OUT OF THE CASE, to the left, over
-- the window's own frame - the way you push one folder proud of the
-- others with a thumb before pulling it. Paint only: the hit band
-- stays where it was, because a sheet can only be hovered from inside
-- the case, so a jut that moved the band could never flicker itself
-- off and back on.
local FAN_JUT = 7

-- A BOX EITHER SAYS THIS OR IT DOES NOT, read the way amp_box is.
function A.box_fan(sec)
	if type(sec) ~= "string" then return false end
	return SYS_GetParam(1, sec, "amp_box_fan") and true or false
end

local BOX_DEFAULT = 5              -- squares per side when nothing says
local BOX_LIMIT   = 12             -- and the most a section may ask for

-- A FAN'S ROWS ARE FIFTEEN PIXELS, so it may have far more of them
-- than a grid may have squares and still be a smaller window. Thirty
-- sheets is 450 px, which is the rig panel's height.
local FAN_LIMIT   = 30

-- ============================================================
-- AND TWO CEILINGS THAT ARE NOT ABOUT SPACE
--
--   "make now so the boxes can take max of 10kg of Items inside them
--    and also that the Items inside boxes can stack to 99 for now"
--
-- WEIGHT, because a box that is five by five inside and weighs nothing
-- to carry is a bag of holding: twenty-five squares of ammunition is
-- most of a rucksack, in a thing you can also put in your rucksack. The
-- squares say how much FITS; the kilograms say how much you can lift.
--
-- STACKING, because twenty-five squares is not many if every bandage
-- takes one. Identical things share a square and carry a count, the way
-- they do in the inventory - and identical means IDENTICAL: same
-- section, same wear, same uses left, same rounds. Anything else and a
-- full medkit joins a half-used one and the difference is gone.
--
-- Both are read off the section, so a bigger box is an ltx edit.
-- ============================================================
local BOX_KG    = 10               -- kilograms of contents
local BOX_STACK = 99               -- of one thing on one square

function A.is_box_sec(sec)
	if type(sec) ~= "string" or sec == "" then return false end
	return SYS_GetParam(1, sec, "amp_box") and true or false
end

-- "rig", "box" or nil. One question instead of two, asked everywhere a
-- window has to know which of the two it is showing.
function A.win_kind(sec)
	if A.is_rig_sec(sec) then return "rig" end
	if A.is_box_sec(sec) then return "box" end
	return nil
end

-- How many squares across and down. Read off the section so a box with
-- a different inside needs no code, and clamped because a number read
-- out of a config eventually reaches a loop.
-- How deep one square stacks, and how much the whole thing carries.
-- ============================================================
-- ...AND THE ONE BOX THAT HAS NOTHING TO SAY
--
--   "dont put that on wallet as it can contain only patches and they
--    weight nothing so it will always show 0kg"
--
-- A number that is always the same number is the thing this replaced.
-- Which boxes those are is not something the script can work out - it
-- depends on what the family takes and what those things weigh - so it
-- is a key on the box, beside every other key that says how a box
-- behaves, and it defaults to yes.
-- ============================================================
function A.box_wt(sec)
	if type(sec) ~= "string" then return false end
	local v = SYS_GetParam(0, sec, "amp_box_wt")
	if type(v) == "string" and (v == "false" or v == "off" or v == "0") then
		return false
	end
	return true
end

function A.box_cap(sec)
	local n = tonumber(SYS_GetParam(2, sec, "amp_box_stack")) or BOX_STACK

	n = math.floor(n)
	if n < 1 then n = 1 elseif n > 999 then n = 999 end

	-- ============================================================
	-- AND A BOX MAY HAVE NO WEIGHT LIMIT AT ALL
	--
	--   "box is only limited by size not weight like others"
	--
	-- NOT A BIG NUMBER. amp_box_kg = 999 would have done the same thing
	-- for a while and then been wrong once, silently, the first time
	-- somebody filled an armour case with exosuits. A limit that is not
	-- there is answered as nil, and box_lift already says yes to that.
	--
	-- Read the way amp_box is - a flag, not a number - so a section
	-- either says this or it does not.
	-- ============================================================
	if SYS_GetParam(1, sec, "amp_box_noweight") then return n, nil end

	local kg = tonumber(SYS_GetParam(2, sec, "amp_box_kg")) or BOX_KG
	if not (kg > 0) then kg = BOX_KG elseif kg > 999 then kg = 999 end

	return n, kg
end

function A.box_grid(sec)
	local w = SYS_GetParam(2, sec, "amp_box_w")
	local h = SYS_GetParam(2, sec, "amp_box_h")

	w = tonumber(w) or BOX_DEFAULT
	h = tonumber(h) or BOX_DEFAULT

	w = math.floor(w)
	h = math.floor(h)

	-- ============================================================
	-- HOW BIG A WINDOW MAY GET, ASKED OF ITS SHAPE
	--
	-- BOX_LIMIT is twelve because a grid thirteen squares a side is
	-- the window this mod exists to not have. A fan is not that: its
	-- rows are fifteen pixels, so twenty-four of them is shorter than
	-- six rows of squares and narrower than the ammo case.
	--
	-- One number for both would have to be the smaller one, and the
	-- document case would hold twelve papers because a grid may not be
	-- thirteen wide - which is a limit borrowed from a shape this
	-- window does not have.
	-- ============================================================
	local lim = A.box_fan(sec) and FAN_LIMIT or BOX_LIMIT

	if w < 1 then w = 1 elseif w > BOX_LIMIT then w = BOX_LIMIT end
	if h < 1 then h = 1 elseif h > lim then h = lim end

	return w, h
end

-- ============================================================
-- WHAT GOES IN IT, OUT OF items\amp_boxes.ltx
--
-- Read the same way the rig shapes are, through ini_file, and memoised
-- per family: this is asked once per drop and once per hover, and a
-- hover happens every frame.
-- ============================================================
function A.box_ltx()
	if A.bltx == nil then
		local ok, f = pcall(ini_file, "items\\amp_boxes.ltx")
		A.bltx = (ok and f) or false
	end
	return A.bltx or nil
end

local function box_trim(s)
	if type(s) ~= "string" then return nil end
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function box_list(ltx, sec, key)
	local out = {}
	local got, line = pcall(function() return ltx:r_string_ex(sec, key) end)
	if not (got and type(line) == "string") then return out end

	for piece in line:gmatch("[^,]+") do
		local s = box_trim(piece)
		if s and s ~= "" then out[#out + 1] = s end
	end
	return out
end

-- Which family a box belongs to. `amp_box_takes = meds` names the
-- section [amp_box_meds] in the rules file.
function A.box_family(sec)
	local fam = SYS_GetParam(0, sec, "amp_box_takes")
	fam = box_trim(fam)
	return (fam ~= "" and fam) or nil
end

-- ============================================================
-- A BOX WHOSE PILES ARE SORTED
--
--   "it should drop the most full magazine not all of them"
--
-- Two words, because there are two things worth sorting by and they are
-- not the same number:
--
--     fill    how many rounds are in a magazine
--     cond    how worn a thing is, which every item in the game has
--
-- Anything else is no sorting at all, which is what every box said
-- before this and what every box that does not carry the key still
-- says. A misspelt value therefore behaves like the old boxes rather
-- than like a broken new one.
-- ============================================================
function A.box_pick(bsec)
	if type(bsec) ~= "string" or bsec == "" then return nil end

	local how = box_trim(SYS_GetParam(0, bsec, "amp_box_pick"))
	if how == "fill" or how == "cond" then return how end
	return nil
end

-- WHICH BOX THIS IS, from its object. The window knows its own section
-- and passes it in; this is for the paths that only have an id, and for
-- a window whose record was written before the section was on it.
function A.box_sec(id)
	local obj = id and level.object_by_id(id)
	if not obj then return nil end

	local ok, sec = pcall(function() return obj:section() end)
	return (ok and A.is_box_sec(sec)) and sec or nil
end

A.box_rule_memo = A.box_rule_memo or {}

function A.box_rules(fam)
	if type(fam) ~= "string" or fam == "" then return nil end

	local memo = A.box_rule_memo[fam]
	if memo ~= nil then return memo or nil end

	local ltx = A.box_ltx()
	local sec = "amp_box_" .. fam

	local ok, exists = pcall(function() return ltx and ltx:section_exist(sec) end)
	if not (ok and exists) then
		-- NO RULES IS NOT "TAKE NOTHING". A box whose family has no
		-- section is a box nobody has written rules for yet, and a
		-- container that refuses everything reads as broken. It takes
		-- whatever is not a container itself.
		A.box_rule_memo[fam] = false
		dbg("box: no rules for family %s - it will take anything",
		    tostring(fam))
		return nil
	end

	local r = {
		kinds = box_list(ltx, sec, "kinds"),
		also  = box_list(ltx, sec, "also"),
		never = box_list(ltx, sec, "never"),
	}

	local okb, ammo = pcall(function() return ltx:r_bool_ex(sec, "ammo", false) end)
	r.ammo = (okb and ammo) and true or false

	-- MAGAZINES, asked the way ammunition is and for the same reason:
	-- they come from several packs, they do not agree about `kind`, and
	-- is_mag is the section flag the magazine mod itself reads.
	local okm, mags = pcall(function() return ltx:r_bool_ex(sec, "mags", false) end)
	r.mags = (okm and mags) and true or false

	-- WEAPONS, asked by class for the reason written in amp_boxes.ltx:
	-- there is no kind to ask for and no IsItem entry either.
	local okg, guns = pcall(function() return ltx:r_bool_ex(sec, "guns", false) end)
	r.guns = (okg and guns) and true or false

	-- AND CHEST RIGS. This one is not a convenience: a rig carries its
	-- magazines with it, and only a box whose family says this is
	-- written to carry them too. See box_grab.
	local okr, rigs = pcall(function() return ltx:r_bool_ex(sec, "rigs", false) end)
	r.rigs = (okr and rigs) and true or false

	local okn, no = pcall(function() return ltx:r_string_ex(sec, "no") end)
	r.no = (okn and box_trim(no)) or nil

	A.box_rule_memo[fam] = r
	return r
end

local function in_list(list, want)
	for i = 1, #list do
		if list[i] == want then return true end
	end
	return false
end

-- Whether `sec` may go into a box of section `bsec`. Returns
-- true, or false and the sentence to say.
-- ============================================================
-- IS THIS A WEAPON
--
-- THE GAME HAS NO ANSWER TO THIS, which is the surprising part. Its
-- item table - the one behind IsItem - knows ammunition, scopes,
-- silencers, launchers, helmets, outfits, backpacks, artefacts,
-- devices, tools, parts, upgrades, quest items and multi-use food. It
-- has no entry for a gun. And `kind` is no help either: weapons keep
-- theirs inside a .db archive, so a section that certainly has one
-- answers nil to anybody who asks.
--
-- WHAT IS LEFT IS THE CLASS, and it is actually the better question.
-- Every weapon the engine will spawn has a class beginning WP_ -
-- WP_AK74, WP_SHOTG, WP_SVD, WP_KNIFE, WP_BINOC and the fifty a mod
-- pack adds - because the class is what the engine builds the object
-- from. A list of sections would be out of date the day a weapon pack
-- updated; this cannot be.
--
-- MINUS THE THREE THAT ARE NOT WEAPONS. WP_SILEN, WP_SCOPE and
-- WP_GLAUN are the silencer, the sight and the underbarrel launcher.
-- They carry the weapon prefix because they live on a weapon, and
-- without this a weapon case would quietly become the place your
-- scopes went.
-- ============================================================
local NOT_GUNS = { WP_SILEN = true, WP_SCOPE = true, WP_GLAUN = true }

function A.is_gun_sec(sec)
	if type(sec) ~= "string" or sec == "" then return false end

	local cls = SYS_GetParam(0, sec, "class")
	if type(cls) ~= "string" then return false end

	cls = box_trim(cls)
	if NOT_GUNS[cls] then return false end
	return cls:sub(1, 3) == "WP_"
end

function A.box_takes(bsec, sec)
	if type(sec) ~= "string" or sec == "" then return false, "That cannot go in there" end

	-- ABOVE THE RULES FILE AND NOT OVERRIDABLE BY IT. A box holds its
	-- contents in a table keyed by its own object id; put a box inside a
	-- box and the outer one's entry is a promise to rebuild an object
	-- whose own contents are filed against an id that no longer exists.
	-- Nothing is nested, and no file can turn this off.
	if A.is_box_sec(sec) then return false, "A box does not go inside a box" end

	local rules = A.box_rules(A.box_family(bsec))

	-- A RIG IS THE SAME SHAPE OF PROBLEM, AND IT IS ALLOWED ANYWAY
	-- WHERE THE FAMILY SAYS SO.
	--
	--   "items that can be put inside are armours/helmets and
	--    masks/rigs"
	--
	-- What made it refusable is that its magazines are filed against
	-- its object id and the id does not survive the trip. What makes it
	-- allowable is that box_grab now takes them with it. So this is a
	-- door with a lock rather than a wall: a family that has not said
	-- `rigs = true` still gets the old answer, and it gets it HERE,
	-- before the kinds are looked at, because a rig's kind is i_attach
	-- and so is a box's.
	if A.is_rig_sec(sec) and not (rules and rules.rigs) then
		return false, "A rig does not go inside a box"
	end

	if not rules then return true end

	if in_list(rules.never, sec) then
		return false, rules.no or "That does not go in this box"
	end
	if in_list(rules.also, sec) then return true end

	-- Checked after `never`, so a family that takes rigs can still name
	-- one it will not have.
	if rules.rigs and A.is_rig_sec(sec) then return true end

	if rules.ammo and type(IsItem) == "function" then
		local ok, is = pcall(IsItem, "ammo", sec)
		if ok and is then return true end
	end

	-- is_mag, not a kind. See A.box_rules.
	if rules.mags and SYS_GetParam(1, sec, "is_mag") then return true end

	if rules.guns and A.is_gun_sec(sec) then return true end

	local kind = SYS_GetParam(0, sec, "kind")
	if type(kind) == "string" and in_list(rules.kinds, box_trim(kind)) then
		return true
	end

	return false, rules.no or "That does not go in this box"
end

-- ============================================================
-- READING AN ITEM, AND BUILDING IT BACK
--
-- Three numbers, and which of them apply is the GAME'S question, not
-- ours: IsItem("multiuse") and IsItem("ammo") are what _g.script's own
-- item table says, and alife_create_item takes exactly the same three
-- keys back. So a bandage keeps its uses, a box of cartridges keeps its
-- count and a suit keeps its wear, without this file holding a list of
-- what has what.
-- ============================================================
function A.box_grab(obj)
	if not obj then return nil end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and type(sec) == "string" and sec ~= "") then return nil end

	local it = { sec = sec }

	local okc, cond = pcall(function() return obj:condition() end)
	if okc and type(cond) == "number" then it.cond = cond end

	if type(IsItem) == "function" then
		local okm, multi = pcall(IsItem, "multiuse", sec)
		if okm and multi then
			local oku, uses = pcall(function() return obj:get_remaining_uses() end)
			if oku and type(uses) == "number" then it.uses = uses end
		end

		local oka, ammo = pcall(IsItem, "ammo", sec)
		if oka and ammo then
			local okn, n = pcall(function() return obj:ammo_get_count() end)
			if okn and type(n) == "number" then it.ammo = n end
		end
	end

	-- ============================================================
	-- AND A MAGAZINE'S ROUNDS, WHICH ARE NOT ONE OF THE THREE NUMBERS
	--
	-- They live in magazine_binder's store, keyed by object id, and the
	-- id is the one thing about an object that a box cannot keep. Read
	-- here or lost forever - and lost SILENTLY, which is why this is
	-- read through the same A.capture_mag the rig stash uses rather
	-- than a second copy of the same idea.
	--
	-- Only for magazines. capture_mag would answer for anything, and a
	-- table of nothing on every bandage in every box is a table in the
	-- save for every bandage in every box.
	-- ============================================================
	if SYS_GetParam(1, sec, "is_mag") then
		local cap = A.capture_mag(obj)
		it.mag = cap and cap.data or nil
	end

	-- ============================================================
	-- ...AND A RIG'S POCKETS, FOR THE SAME REASON
	--
	--   "items that can be put inside are armours/helmets and
	--    masks/rigs"
	--
	-- A.hold and A.pslot are keyed by the rig's OBJECT ID, and the id
	-- is the one thing about an object a box cannot keep. This is why a
	-- rig used to be refused outright; carrying the two tables in the
	-- entry is what makes the armour case possible.
	--
	-- READ ONLY. Nothing is cleared here, because box_grab is also
	-- called to work out what a drag is HOVERING over, and a hover that
	-- emptied a rig would be the worst bug in this file. box_put clears
	-- them, after the release has actually happened.
	-- ============================================================
	if A.is_rig_sec(sec) then
		local rid
		pcall(function() rid = obj:id() end)

		local st, po = rid and A.hold[rid], rid and A.pslot[rid]
		if st or po then
			-- ONE LEVEL DEEP IS NOT ENOUGH ANY MORE. A.hold[id] is a
			-- map of slot name -> list of entries, so a shallow copy
			-- would hand the box the SAME lists the rig has and the
			-- two would move together. A.pslot[id] is still flat.
			local function copy(t, deep)
				if type(t) ~= "table" then return nil end
				local out = {}
				for k, v in pairs(t) do
					if deep and type(v) == "table" then
						local inner = {}
						for i = 1, #v do inner[i] = v[i] end
						out[k] = inner
					else
						out[k] = v
					end
				end
				return next(out) and out or nil
			end
			it.rig = { stash = copy(st, true), pouch = copy(po) }
		end
	end

	local okg, cw, ch = pcall(A.cells, sec)
	it.w = (okg and tonumber(cw)) or 1
	it.h = (okg and tonumber(ch)) or 1

	-- WHAT IT STANDS FOR: one record per object, and this is one
	-- object. Everything that reads a box reads this list - the weight,
	-- the draw, the save, and what comes back out.
	it.of = { { cond = it.cond, uses = it.uses, ammo = it.ammo,
	            mag = it.mag, rig = it.rig } }
	it.cond, it.uses, it.ammo, it.mag, it.rig = nil, nil, nil, nil, nil

	return it
end

-- ============================================================
-- A PILE HOLDS OBJECTS, NOT A COUNT OF ONE KIND OF OBJECT
--
--   "if item have a 'use' missing then it stacks to seperate cell in
--    the box but in inventory it works ... also in the boxes stacks are
--    showed how many stacked items there are so if i put 2 medkits that
--    both have 3 uses, in inventory it shows 6 on the stack but in the
--    meds box it shows 2."
--
-- It used to be a record and a count - `{sec, cond, uses, ammo, n}` -
-- and that forced everything the player reported. One record standing
-- for two objects is only true when the two are identical in every
-- number it kept, so a part-used anything got a square of its own; and
-- the count was a count of RECORDS, which is why it said 2 where the
-- inventory says 6.
--
--     it.of = { { cond =, uses =, ammo = }, ... }
--
-- Nothing is thrown away now, so nothing has to match.
--
-- AMMUNITION IS ONE RECORD carrying the pile's total rounds. Rounds are
-- fungible - it is why the inventory turns 10 and 9 into 19 - and
-- box_make hands a round count to alife_create_item, which splits it
-- across as many boxes as box_size needs. The pile does not have to
-- remember how many boxes it arrived in.
-- ============================================================

-- An entry from before this, or one built by hand in a test, is turned
-- into its list the first time anything asks. Idempotent, and it takes
-- the old fields away with it so there is one copy of the truth rather
-- than two.
function A.pile_norm(it)
	if not (it and type(it.sec) == "string") then return nil end
	if type(it.of) == "table" then return it.of end

	local n = (type(it.n) == "number" and it.n >= 1) and math.floor(it.n) or 1
	local of = {}

	if type(it.ammo) == "number" then
		-- n boxes of that many rounds is that many rounds.
		of[1] = { cond = it.cond, uses = it.uses, ammo = it.ammo * n }
	else
		for _ = 1, n do
			of[#of + 1] = { cond = it.cond, uses = it.uses }
		end
	end

	it.of = of
	it.n, it.cond, it.uses, it.ammo = nil, nil, nil, nil
	return of
end

-- How many rounds fill one box of this section, or nil when the game
-- does not say - which is every section that is not ammunition.
local function box_size(sec)
	local n = SYS_GetParam(2, sec, "box_size")
	return (type(n) == "number" and n > 0) and n or nil
end

-- HOW MANY OBJECTS THE PILE STANDS FOR. For ammunition that is how many
-- BOXES its rounds fill, because boxes are what come out of it and
-- boxes are what the ceiling counts.
function A.pile_n(it)
	local of = A.pile_norm(it)
	if not of then return 0 end

	local a = of[1] and of[1].ammo
	if type(a) == "number" then
		local box = box_size(it.sec)
		if not box then return (a > 0) and 1 or 0 end
		return math.ceil(a / box)
	end

	return #of
end

-- AND THE NUMBER WRITTEN ON THE SQUARE, which is the one the inventory
-- writes: rounds for ammunition, the uses left for anything that has
-- uses, and the number of things for everything else.
function A.pile_show(it)
	local of = A.pile_norm(it)
	if not of then return 0 end

	local a = of[1] and of[1].ammo
	if type(a) == "number" then return a end

	local uses, any = 0, false
	for i = 1, #of do
		if type(of[i].uses) == "number" then
			uses = uses + of[i].uses
			any = true
		end
	end
	if any then return uses end

	return #of
end

function A.pile_weight(it)
	local of = A.pile_norm(it)
	if not of then return 0 end

	local w = 0
	for i = 1, #of do w = w + A.entry_weight(it.sec, of[i]) end
	return w
end

-- One object's record into a pile. Ammunition adds its rounds to what
-- is already there; everything else joins the list.
function A.pile_add(it, rec)
	local of = A.pile_norm(it)
	if not (of and rec) then return false end

	if type(rec.ammo) == "number" and of[1] and type(of[1].ammo) == "number"
	then
		of[1].ammo = of[1].ammo + rec.ammo
		return true
	end

	of[#of + 1] = { cond = rec.cond, uses = rec.uses, ammo = rec.ammo,
	                mag = rec.mag, rig = rec.rig }
	return true
end

-- ONE OBJECT OUT, as a thing box_make can build. For ammunition that is
-- one BOX's worth of rounds off the total, which is what "one of them"
-- means when you are holding a pile of cartridges.
-- `at` is WHICH one, and it defaults to the first - which is what every
-- caller meant before there was a choice. An index that is not there is
-- the first one too, rather than nothing: a pull that quietly returned
-- nil would empty a hand that is still holding something.
function A.pile_pull(it, at)
	local of = A.pile_norm(it)
	if not (of and of[1]) then return nil end

	if not (type(at) == "number" and of[at]) then at = 1 end

	local a = of[at].ammo
	if type(a) == "number" then
		local box = box_size(it.sec) or a
		local take = math.min(box, a)
		local cond = of[at].cond

		of[at].ammo = a - take
		if of[at].ammo <= 0 then table.remove(of, at) end

		return { sec = it.sec, cond = cond, ammo = take }
	end

	local one = table.remove(of, at)
	return { sec = it.sec, cond = one.cond, uses = one.uses,
	         mag = one.mag, rig = one.rig }
end

-- ============================================================
-- HOW GOOD ONE OBJECT IN A PILE IS
--
-- One number, bigger is better, and it means whatever the box said:
-- rounds for `fill`, wear for `cond`. A magazine with no rounds
-- recorded is empty rather than unknown - which is right, because the
-- only way to be in a pile with no rounds recorded is to have had none.
-- ============================================================
function A.pile_rank(rec, how)
	if not rec then return 0 end

	if how == "fill" then
		local L = rec.mag and rec.mag.loaded
		return (type(L) == "table") and #L or 0
	end

	if how == "cond" then
		return (type(rec.cond) == "number") and rec.cond or 0
	end

	-- NO WORD IS NO SORTING, and it has to be said rather than fallen
	-- through: every object ranking the same is what makes pile_end
	-- answer the FRONT of the pile, which is what an unsorted box has
	-- always handed back. Falling through to wear would have made a
	-- caller that forgot the word quietly sort by something.
	return 0
end

-- WHERE THE BEST ONE IS, or the worst when `worst` is set. Ties go to
-- the earliest, so a pile of identical things behaves exactly as it did
-- before any of this existed: the first one out is of[1].
function A.pile_end(it, how, worst)
	local of = A.pile_norm(it)
	if not (of and of[1]) then return nil end

	local at, far = 1, A.pile_rank(of[1], how)

	for i = 2, #of do
		local r = A.pile_rank(of[i], how)
		if (worst and r < far) or ((not worst) and r > far) then
			at, far = i, r
		end
	end

	return at, far
end

-- Move up to `count` objects from one pile to another. Written in terms
-- of the two above so ammunition needs no special case here: pulling
-- one is pulling a box's worth, and adding it is adding its rounds.
function A.pile_shift(from, to, count)
	local moved = 0
	for _ = 1, (count or 0) do
		local rec = A.pile_pull(from)
		if not rec then break end
		A.pile_add(to, rec)
		moved = moved + 1
	end
	return moved
end

-- ONE STRING PER PILE, for the save. m_data is walked on every save and
-- a nested table per pile is a great deal of walking; this is the same
-- reasoning the grid's squares are stored under.
-- ============================================================
-- A MAGAZINE'S ROUNDS AS A FOURTH FIELD
--
-- mag.loaded is a list of ammo SECTION NAMES, one per round, thirty or
-- sixty of them. Written out one by one it would be the longest thing
-- in the save by a wide margin, so it is run-length coded:
--
--     ammo_5.45x39_ap*28;ammo_5.45x39_fmj*2
--
-- which is one run for a magazine loaded from one box of cartridges,
-- and two for the usual mixed one.
--
-- `;` and `*` because `,` already separates the objects in a pile and
-- `|` already separates one object's fields, and no ammo section name
-- in this game contains any of the four.
--
-- ONLY `loaded` IS KEPT. The store's other two fields are `section`,
-- which is the magazine's own section and is written down beside the
-- pile already, and `is_weapon`, which is false for anything that can
-- be in a box. Both are rebuilt on the way back rather than saved, so
-- what goes into m_data is the rounds and nothing else.
-- ============================================================
local function mag_pack(mag)
	local L = mag and mag.loaded
	if type(L) ~= "table" or #L == 0 then return "" end

	local out, run, n = {}, L[1], 0
	for i = 1, #L do
		if L[i] == run then
			n = n + 1
		else
			out[#out + 1] = tostring(run) .. "*" .. tostring(n)
			run, n = L[i], 1
		end
	end
	out[#out + 1] = tostring(run) .. "*" .. tostring(n)

	return table.concat(out, ";")
end

local function mag_unpack(sec, str)
	if type(str) ~= "string" or str == "" then return nil end

	local L = {}
	for one in string.gmatch(str, "[^;]+") do
		local what, n = string.match(one, "^(.-)%*(%d+)$")
		n = tonumber(n)
		if what and what ~= "" and n then
			for _ = 1, n do L[#L + 1] = what end
		end
	end

	if #L == 0 then return nil end
	return { section = sec, loaded = L, is_weapon = false }
end

-- ============================================================
-- A RIG'S POCKETS, BESIDE THE PILE STRING RATHER THAN IN IT
--
-- Everything else about an object is a number and packs into a field.
-- What is in a rig is a magazine per pocket, each with its own rounds,
-- and there is no honest way to spell that in a `|`-separated line.
--
-- So it goes as two FLAT tables keyed "<object in the pile>:<pocket>",
-- which is the shape m_data already carries A.stash in - a shape this
-- save is known to survive. What would be new is the DEPTH, and there
-- is none.
--
-- Two tables and not one because they hold different things: a stowed
-- magazine is a record, a fitted pouch is a section name, and one table
-- holding both would need a third field to say which.
-- ============================================================
function A.pile_rigs_pack(it)
	local of = A.pile_norm(it)
	if not of then return nil, nil end

	local mt, pt = {}, {}
	local many, pany = false, false

	for i = 1, #of do
		local r = of[i].rig
		if type(r) == "table" then
			for slot, cap in pairs(r.stash or {}) do
				mt[tostring(i) .. ":" .. tostring(slot)] = cap
				many = true
			end
			for slot, ps in pairs(r.pouch or {}) do
				pt[tostring(i) .. ":" .. tostring(slot)] = ps
				pany = true
			end
		end
	end

	return many and mt or nil, pany and pt or nil
end

function A.pile_rigs_unpack(it, mt, pt)
	local of = A.pile_norm(it)
	if not of then return end

	local function into(tbl, which)
		if type(tbl) ~= "table" then return end

		for k, v in pairs(tbl) do
			local i, slot = tostring(k):match("^(%d+):(%d+)$")
			i, slot = tonumber(i), tonumber(slot)

			-- An entry pointing at an object the pile no longer has is
			-- dropped rather than kept somewhere else. It is a promise
			-- about a rig that is not there.
			if i and slot and of[i] then
				of[i].rig = of[i].rig or {}
				of[i].rig[which] = of[i].rig[which] or {}
				of[i].rig[which][slot] = v
			end
		end
	end

	into(mt, "stash")
	into(pt, "pouch")
end

function A.pile_pack(it)
	local of = A.pile_norm(it)
	if not of then return nil end

	local out = {}
	for i = 1, #of do
		local r = of[i]
		out[#out + 1] = string.format("%s|%s|%s|%s",
			tostring(r.cond or ""), tostring(r.uses or ""),
			tostring(r.ammo or ""), mag_pack(r.mag))
	end
	return table.concat(out, ",")
end

-- `sec` is the pile's section, which is what a magazine's store calls
-- itself. THE OLD THREE-FIELD FORM STILL READS: every box in every save
-- written before this is in it, and the fourth field is simply not
-- there.
function A.pile_unpack(str, sec)
	if type(str) ~= "string" or str == "" then return nil end

	local of = {}
	for one in string.gmatch(str, "[^,]+") do
		local c, u, a, m = string.match(one,
			"^([^|]*)|([^|]*)|([^|]*)|?(.*)$")
		if c then
			of[#of + 1] = { cond = tonumber(c), uses = tonumber(u),
			                ammo = tonumber(a),
			                mag = mag_unpack(sec, m) }
		end
	end

	return (#of > 0) and of or nil
end

-- ============================================================
-- WHEN TWO PILES MAY SHARE A SQUARE
--
-- The same thing, and nothing more. It used to mean IDENTICAL - same
-- wear, same uses left, same rounds - because a pile was one record
-- and a count, so any difference between two objects was a difference
-- the pile could not say:
--
--   "if item have a 'use' missing then it stacks to seperate cell in
--    the box but in inventory it works"
--
-- A pile carries its objects now, so nothing is thrown away by putting
-- two of them together and there is nothing left to be strict about.
-- This is the same rule the game's own inventory uses, which is what
-- was asked for.
-- ============================================================
function A.same_stack(a, b)
	if not (a and b) then return false end
	return a.sec == b.sec
end

-- The first entry this one could join, or nil. `at` is the square it was
-- dropped on, which is asked first: dropping something on a stack of the
-- same thing means that stack, not whichever one happens to be first.
function A.box_join(t, it, cap, at)
	if not (t and it) then return nil end

	if at and t[at] and A.same_stack(t[at], it)
	   and A.pile_n(t[at]) < cap
	then
		return at
	end

	for i = 1, #t do
		local e = t[i]
		if e and A.same_stack(e, it) and A.pile_n(e) < cap then return i end
	end
	return nil
end

-- AND A BOX OF CARTRIDGES COMES BACK AS A LIST.
--
-- alife_create_item hands back ONE server object for everything except
-- ammunition, where it splits the count across as many boxes as
-- box_size needs and returns an array of them. Reading `.id` off that
-- array gives nil, which looked exactly like a failed create - and the
-- failure branch keeps the entry, so the cartridges would have been
-- handed out AND kept.
function A.box_make(it)
	if not (it and type(it.sec) == "string") then return false end

	local t
	if type(it.ammo) == "number" and it.ammo > 0 then t = { ammo = it.ammo } end
	if type(it.uses) == "number" then t = t or {}; t.uses = it.uses end
	if type(it.cond) == "number" then t = t or {}; t.cond = it.cond end

	local ok, se = pcall(function()
		return alife_create_item(it.sec, db.actor, t)
	end)

	if not (ok and se) then return false end

	-- The array form - AMMUNITION, split across as many boxes as
	-- box_size needs. Anything in it means something was made; the
	-- first is the one a square can be held for, and EVERY id rides
	-- back to the caller, because the ones this list used to keep to
	-- itself are the ones the packer scattered into the first gaps.
	--
	-- THE ENTRIES ARE ENGINE USERDATA, NOT TABLES. The old guard here
	-- - type(e) == "table" - was the TEST HARNESS leaking into the
	-- design: stub server objects are Lua tables, real ones are
	-- userdata, so every suite passed while a running game filtered
	-- every real entry out and no ammunition id was EVER handed back.
	-- Three releases of downstream fixes sat behind that one line.
	-- The id is read through a pcall and judged by being a NUMBER,
	-- which is a claim about the id and not about the box around it -
	-- and the harness CANNOT catch a regression here (texlua has no
	-- userdata to stub), so the failure is logged instead of silent:
	-- that log line is the whole reason 1.98.4 exists.
	if type(se) == "table" and se.id == nil then
		if next(se) == nil then return false end
		local ids = {}
		for i = 1, #se do
			local e = se[i]
			local ok_id, eid = pcall(function() return e and e.id end)
			if ok_id and type(eid) == "number" then ids[#ids + 1] = eid end
		end
		if #ids == 0 then
			log("!box: %s came back as a list but no id could be read",
			    tostring(it.sec))
			return true, nil
		end
		dbg("box: %s came out as %s object(s)", tostring(it.sec),
		    tostring(#ids))

		-- EVERY ONE OF THEM, not just the one that gets a square. A
		-- pull of cartridges is several boxes and they all arrive; a
		-- second one filed back into the case it came out of is the
		-- same bug with a smaller number on it.
		for i = 1, #ids do A.gave(ids[i]) end

		return true, ids[1], ids
	end

	if not se.id then return false end

	-- THIS OBJECT IS SOMETHING YOU ASKED FOR. Marked before anything
	-- else is done to it, because everything below can fail and the
	-- object exists either way - and the moment it exists it is on its
	-- way to OnItemTake. See A.gave.
	A.gave(se.id)

	-- The wear goes back on when the engine hands the object over, a
	-- frame or two from now. alife_create_item queues the same thing
	-- through its own processor; this is the mod's own route and the two
	-- agree, so whichever lands first is right.
	if type(it.cond) == "number" then A.loose_cond(se.id, it.cond) end

	-- AND THE ROUNDS, ONTO THE NEW ID. The same three lines the rig
	-- stash uses when it hands a magazine back, and read through rawget
	-- for the same reason: this mod runs with no magazine mod installed
	-- and a missing store is not an error, it is a magazine with no
	-- rounds to put back.
	if it.mag then
		local mb = rawget(_G, "magazine_binder")
		if mb and type(mb.set_data) == "function" then
			local okd = pcall(mb.set_data, se.id, it.mag)
			if not okd then
				log("!box: rounds lost on %s", tostring(it.sec))
			end
		end
	end

	-- AND A RIG'S POCKETS, UNDER THE ID IT HAS NOW. Nothing waits for
	-- the client object: A.hold is this mod's own table and the throttle
	-- reweighs whatever is in it once the object turns up.
	if it.rig then
		if type(it.rig.stash) == "table" and next(it.rig.stash) then
			A.hold[se.id] = it.rig.stash
		end
		if type(it.rig.pouch) == "table" and next(it.rig.pouch) then
			A.pslot[se.id] = it.rig.pouch
		end
		dbg("box: %s came out with its pockets", tostring(it.sec))
	end

	return true, se.id
end

-- ============================================================
-- AND WHERE THE PLAYER LET GO OF IT
--
--   "when takeing item out of the box to inventory the items does not
--    go to the slot i hover over but to the first that is free"
--
-- The object does not exist yet - alife_create_item makes a SERVER
-- object and the client one turns up a frame or two later - so there is
-- nothing to place. What there is is an id, and Zone Grid keeps its
-- layout by id: write the square down now and the packer finds an
-- answer waiting when the item arrives.
--
-- SOFT, and read as a PLAIN GLOBAL. Anomaly's loader is lazy: a script
-- is not a field of _G until something asks for it through __index, so
-- rawget answers nil for a mod that is installed and working. This file
-- has lost a release to that twice. Armor Mag Pouches also ships
-- without the grid, where there is no layout to write into and nothing
-- here happens.
--
-- Only the FIRST of a stack. Five bandages coming out of one square
-- cannot all land under the cursor, and the rest going wherever there
-- is room is what the inventory does with them anyway.
-- ============================================================
-- ============================================================
-- ...AND THE REST OF THE STACK RIDES IN THE SAME SQUARE
--
-- The other half of hold_square, and the same shape: one pcall, no type
-- check in front of it, because a grid that is absent, old or broken all
-- come back false through the same door.
--
-- The grid's own note on why this is the only way a stack can survive:
-- "A STACK IS ONE CELL WITH SEVERAL ITEMS IN IT. Each of them gets the
-- same square, or the ones that are not the cell's own id come back
-- homeless and scatter."
-- ============================================================
function A.ride_square(id, like)
	if not (type(id) == "number" and type(like) == "number") then
		return false
	end

	local ok, done = pcall(function()
		return zzz_amp_grid.ride(id, like) and true or false
	end)

	if not ok and not A.ride_said then
		A.ride_said = true
		log("!amp: ride raised: %s", tostring(done))
	end

	return (ok and done) or false
end

function A.hold_square(id, sec, lie)
	if not (type(id) == "number" and type(sec) == "string") then return false end

	-- WHICH WAY IT SHOULD LAND: the entry's own lie, turned once more
	-- if the R key is down over the drag. XOR, spelt ~= on booleans.
	local turn = (lie and true or false) ~= (A.rot_hand and true or false)

	-- THE PCALL IS THE GUARD, and there is deliberately nothing else.
	-- A type check in front of this would be a second way of saying the
	-- same thing: no grid installed, a grid with no such function, or a
	-- grid whose reserve is not callable all raise in here and all come
	-- back false. Two guards where one will do is two things to keep in
	-- step, and a check no mutation can change is a check that says
	-- nothing.
	local ok, done = pcall(function()
		return zzz_amp_grid.reserve(id, sec, turn) and true or false
	end)

	-- SAID, NOT SWALLOWED. The pcall is still the guard - a missing
	-- grid must stay a quiet no - but a grid that IS installed and
	-- still raises is the one thing this log line exists to catch,
	-- and it caught nothing for three releases because it did not
	-- exist. Once per session: an error on every take-out is one
	-- fact, not a hundred lines.
	if not ok and not A.hold_said then
		A.hold_said = true
		log("!amp: reserve raised: %s", tostring(done))
	end

	return (ok and done) or false
end

-- ============================================================
-- THE FIVE BY FIVE
--
-- Rectangles, not cells: an item stands on w x h squares and two items
-- clash when their rectangles overlap. `skip` is the entry being moved,
-- which must not be counted as being in its own way.
-- ============================================================
function A.box_room(t, cols, rows, r, c, w, h, skip)
	if not (t and r and c and w and h) then return false end
	if r < 1 or c < 1 then return false end
	if r + h - 1 > rows or c + w - 1 > cols then return false end

	for n = 1, #t do
		local e = t[n]
		if e and n ~= skip then
			local apart = (c + w - 1 < e.c) or (e.c + e.w - 1 < c)
			            or (r + h - 1 < e.r) or (e.r + e.h - 1 < r)
			if not apart then return false end
		end
	end
	return true
end

-- The first square something of this size will stand on, reading the
-- grid the way anything is read: across, then down.
function A.box_spot(t, cols, rows, w, h, skip)
	for r = 1, rows do
		for c = 1, cols do
			if A.box_room(t, cols, rows, r, c, w, h, skip) then return r, c end
		end
	end
	return nil
end

-- Which entry is standing on a square, if any.
-- ============================================================
-- A BOX THAT GOT SMALLER STILL SHOWS WHAT IS IN IT
--
--   "also change so the normal ammo case gives just 2x4 (wide)"
--
-- The ammo case was five squares by five. It is four by two now, and
-- anybody who has one in a save has things standing on rows that no
-- longer exist.
--
-- NOTHING CLAMPS THEM. box_draw paints each entry at its own r,c, so a
-- pile on row five would be drawn below the window over whatever is
-- behind it, and box_hover works in grid coordinates so it could never
-- be picked up again. In the box, weighing what it weighs, and gone.
--
-- So anything outside the grid is moved into it, once, the first time
-- the box is looked at. Same answer the backpack sections got when they
-- started being different sizes - move it up into whatever room is left
-- - and same reasoning: the arrangement is worth keeping until it
-- cannot be, and then what matters is the CONTENTS.
--
-- WHAT WILL NOT FIT STAYS WHERE IT IS. Twenty-five squares into eight
-- does not go, and the answer to that is a sentence, not a bonfire. It
-- is still in the box and still weighs; empty it into something bigger.
-- ============================================================
A.box_said = A.box_said or {}

function A.box_fit(id, cols, rows)
	local t = id and A.boxes[id]
	if not (t and cols and rows) then return 0, 0 end

	local moved, stuck = 0, 0

	for i = 1, #t do
		local it = t[i]
		local iw = (type(it) == "table" and tonumber(it.w)) or 1
		local ih = (type(it) == "table" and tonumber(it.h)) or 1

		if type(it) == "table"
		   and type(it.r) == "number" and type(it.c) == "number"
		   and (it.r < 1 or it.c < 1
		        or it.r + ih - 1 > rows or it.c + iw - 1 > cols)
		then
			-- SKIPPING ITSELF, because the square it is standing on is
			-- outside the grid and cannot be in the way of anything -
			-- but box_room does not know that and would refuse to
			-- overlap it with itself.
			local r, c = A.box_spot(t, cols, rows, iw, ih, i)

			if r then
				dbg("box %s: %s moved from %s,%s to %s,%s - the box is "
				    .. "smaller than it was", tostring(id), tostring(it.sec),
				    tostring(it.r), tostring(it.c), tostring(r), tostring(c))
				it.r, it.c = r, c
				moved = moved + 1
			else
				stuck = stuck + 1
			end
		end
	end

	-- ONCE PER BOX. This runs on every draw of an open window, and a
	-- line per frame is not a line.
	if stuck > 0 and not A.box_said[id] then
		A.box_said[id] = true
		log("!box %s: %s thing(s) do not fit in it any more",
		    tostring(id), tostring(stuck))
		notify("%s thing(s) will not fit in there any more - "
		       .. "empty it into something bigger", tostring(stuck))
	end

	return moved, stuck
end

-- ============================================================
-- LOOT GOES WHERE ITS OWN KIND ALREADY IS
--
--   "when looting stashes and bodies and picking up items from the
--    ground, items go to containers if the same item is already there.
--    or can be dragged into containers from the body itself."
--
-- Both gestures end at the same moment - an object entering your
-- inventory - so both are answered there. The engine's own road:
--
--     CInventory::Take(...)  ->  m_pOwner->OnItemTake(...)
--
-- which is what sends actor_on_item_take, for a transfer off a corpse
-- exactly as for a pickup off the ground. Read out of Inventory.cpp
-- rather than assumed, because the whole feature rests on it.
-- ============================================================

-- WHERE A DROP WAS AIMED, kept until the thing it was aimed at
-- arrives. Keyed by object id and stamped, because a transfer the game
-- refuses - too heavy, quest-locked, a corpse that despawned - leaves
-- a note for something that is never coming.
A.loot_note = A.loot_note or {}
local NOTE_MS = 10000

function A.note_loot(id, box, r, c)
	if not (type(id) == "number" and type(box) == "number") then
		return false
	end
	A.loot_note[id] = { box = box, r = r, c = c, tg = time_global() }
	return true
end

-- ============================================================
-- WHAT THIS MOD HANDS YOU IS NOT LOOT
--
--   "where the items is in stack inside the box it cannot be taken
--    out. only items that have just one copy can escape the parts box."
--
-- An exact description of two rules meeting each other. Taking
-- something out of a box CREATES an object in your inventory - that is
-- the only way out, because what is in a box is a record and not a
-- thing - and every object entering your inventory goes through
-- OnItemTake, which is where loot is filed.
--
-- So the item came out, arrived, and was filed straight back into the
-- box it had just left, because that box still held its kind. And it
-- only held its kind if there had been MORE THAN ONE:
--
--   one of them   the entry goes with it, the box no longer holds the
--                 kind, nothing files it back - it escapes
--   a stack       one comes out and the rest stay, so the box still
--                 holds the kind, and the one in your hand is put back
--
-- Which is the report, word for word. It is not about the parts box:
-- it is every box, and the parts box is the one people stack things
-- in.
--
-- THE FIX IS NOT A TIMER ON THAT BOX. "Do not file into the box it
-- came from for a second or two" would leave the same item filed into
-- the OTHER box that holds its kind, and would still be wrong the
-- moment two things came out at once. What is actually true is simpler
-- and wider: filing is for things that ARRIVE from the world - a body,
-- a stash, the ground - and an object this mod built and handed you is
-- not one of those. You asked for it.
--
-- STAMPED, LIKE THE NOTES ABOVE, and for the same reason: the object
-- is created now and arrives a frame or two later, and one that never
-- arrives at all must not leave a mark that outlives the id.
-- ============================================================
A.gave_back = A.gave_back or {}
local GAVE_MS = 10000

function A.gave(id)
	if type(id) ~= "number" then return false end
	A.gave_back[id] = time_global()
	return true
end

-- Asked once, and the answer is spent. An id is one object and this is
-- one journey: from the create to the Take that follows it.
function A.was_given(id)
	local tg = A.gave_back[id]
	if not tg then return false end

	A.gave_back[id] = nil
	return (time_global() - tg) <= GAVE_MS
end

-- Every box in your own inventory. Asked fresh each time: this runs
-- once per item taken, and a remembered list would be wrong the moment
-- you picked up or dropped a box.
-- The section of a box you are carrying, by id. A note holds an id
-- because the window it was aimed at may be shut - or the box put away
-- in another box - by the time the item arrives.
function A.box_sec_of(id)
	local actor = db.actor
	if not (actor and type(id) == "number") then return nil end

	local ok, o = pcall(function() return actor:object_id(id) end)
	if not (ok and o) then return nil end

	local oks, sec = pcall(function() return o:section() end)
	if not (oks and A.is_box_sec(sec)) then return nil end
	return sec
end

-- ============================================================
-- WHICH BOXES CAN BE FILED INTO
--
-- The ones this mod is holding contents for, that are in your bag.
--
-- FROM A.boxes, NOT FROM THE INVENTORY, and the direction is the whole
-- point. This runs once per item taken - forty times in the frame a
-- take-all lands - and walking the bag meant two hundred objects and
-- two pcall closures each, forty times over, for an answer about three
-- boxes.
--
-- THE SET IS THE SAME ONE. Filing needs A.box_holds, which is false
-- for every id that is not in A.boxes, so a box the mod has never
-- remembered could never have been filed into however it was found.
--
-- AND IT IS STILL ONLY WHAT YOU ARE CARRYING. object_id answers out of
-- the actor's own inventory and nowhere else, so a case on a shelf
-- whose contents this mod remembers is not somewhere your loot can go.
-- box_sec_of asks exactly that and checks the section besides.
-- ============================================================
function A.box_carried()
	local out = {}
	local actor = db.actor
	if not actor then return out end

	for id in pairs(A.boxes or {}) do
		local sec = A.box_sec_of(id)
		if sec then out[#out + 1] = { id = id, sec = sec } end
	end

	return out
end

-- Does this box already hold one of these? The whole of the rule, and
-- deliberately narrow: a box that took anything it was ALLOWED to take
-- would swallow the loot you meant to look at.
function A.box_holds(id, sec)
	local t = id and A.boxes[id]
	if not (t and type(sec) == "string") then return false end

	for i = 1, #t do
		local e = t[i]
		if e and e.sec == sec then return true end
	end
	return false
end

-- ...and the whole thing, from the one door.
function A.file_loot(obj)
	if not (obj and A.enabled) then return false end

	local oki, id = pcall(function() return obj:id() end)
	local oks, sec = pcall(function() return obj:section() end)
	if not (oki and oks and type(sec) == "string") then return false end

	-- ...AND NOT SOMETHING THIS MOD JUST HANDED YOU. It came out of a
	-- box, or out of a rig's pocket, because you asked for it - and
	-- filing it puts it straight back where it came from. See A.gave.
	--
	-- FIRST, ABOVE THE NOTE. A note is aimed by a drop out of a body
	-- and this mark is put on an object this mod created; no id can
	-- carry both, so the order is a statement about which question is
	-- the more fundamental rather than a tie-break.
	if A.was_given(id) then
		dbg("loot: %s was handed out, not found - left in your bag",
		    tostring(sec))
		return false
	end

	-- A BOX IS NOT PUT INSIDE A BOX, whatever the rules would say about
	-- it: a case that files itself is a case you cannot get back.
	if A.is_box_sec(sec) then return false end

	-- ---- 1. the note, if there is one --------------------------
	local note = A.loot_note[id]
	if note then
		A.loot_note[id] = nil

		if time_global() - (note.tg or 0) <= NOTE_MS then
			local bsec = A.box_sec_of(note.box)
			if bsec and A.box_put(note.box, bsec, obj, note.r, note.c) then
				dbg("loot: %s went where it was dropped, box %s",
				    tostring(sec), tostring(note.box))
				return true
			end
			-- IT STAYS IN YOUR BAG. The transfer happened - the drop
			-- asked for it - so the item is yours either way, and a
			-- box that refused it says so through box_put's own
			-- message.
		end
	end

	-- ---- 2. or a box that already holds its kind ----------------
	if not A.loot_box then return false end

	local boxes = A.box_carried()
	for i = 1, #boxes do
		local b = boxes[i]
		if A.box_holds(b.id, sec) and A.box_takes(b.sec, sec) then
			-- QUIETLY. This is not a gesture the player made, so a
			-- refusal is not a message they asked for - the item is in
			-- the bag, which is where it would have been anyway.
			if A.box_put(b.id, b.sec, obj, nil, nil, true) then
				dbg("loot: %s filed into box %s, which already had one",
				    tostring(sec), tostring(b.id))
				return true
			end
		end
	end

	return false
end

function A.box_on(t, r, c)
	if not t then return nil end
	for n = 1, #t do
		local e = t[n]
		if e and r >= e.r and r <= e.r + e.h - 1
		     and c >= e.c and c <= e.c + e.w - 1
		then
			return n
		end
	end
	return nil
end

-- ============================================================
-- THE BOX UNDER THE CURSOR, IF THE THING UNDER IT IS A BOX
--
--   "items that can be stored i their box can be drag and dropped on
--    the box icon without opening the window"
--
-- GetCell_Focused's THIRD RETURN IS THE OBJECT. Not a cell record -
-- this project has been wrong about that once already, in a build that
-- read an id off it, looked right in the harness and answered nil in
-- game.
--
-- `skip` is the thing being dragged. The cursor sits inside the
-- footprint of what it carries more often than not, and a box that
-- swallowed itself would be an item that simply disappeared.
--
-- Answers the object and its section together, because every caller
-- needs both and asking twice is two chances to disagree.
-- ============================================================
function A.box_under(cc, skip)
	if not cc then return nil end

	local ok, _, _, o = pcall(function() return cc:GetCell_Focused() end)
	if not (ok and o) then return nil end

	local oki, id = pcall(function() return o:id() end)
	if not oki then return nil end

	if skip then
		local oks, sid = pcall(function() return skip:id() end)
		if oks and sid == id then return nil end
	end

	local oks, sec = pcall(function() return o:section() end)
	if not (oks and A.is_box_sec(sec)) then return nil end

	return o, sec, id
end

-- ============================================================
-- IN: READ IT, THEN DESTROY IT
-- ============================================================
function A.box_put(id, bsec, obj, r, c, quiet)
	if not (id and bsec and obj) then return false end

	-- ONE ANSWER PER STACK, not one per item. A stack of twenty going in
	-- asks this twenty times and every refusal has the same reason;
	-- saying it twenty times is not twenty times as helpful.
	local function say(...)
		if not quiet then notify(...) end
	end

	local ok, sec = pcall(function() return obj:section() end)
	if not ok then return false end

	local takes, why = A.box_takes(bsec, sec)
	if not takes then
		say("%s", why or "That does not go in this box")
		return false
	end

	local t = A.boxes[id] or {}
	local cols, rows = A.box_grid(bsec)
	local cap = A.box_cap(bsec)

	local it = A.box_grab(obj)
	if not it then return false end

	-- IN A FAN, A PAPER IS A PAPER. A document's footprint in the bag
	-- is 1x1 or 1x2 depending on the icon somebody drew for it, and a
	-- case that filed the long ones across two slivers would be filing
	-- them by their picture. There is no turning one, either: a sheet
	-- on edge has no orientation to argue about.
	if A.box_fan(bsec) then
		it.w, it.h, it.rot = 1, 1, nil
	elseif A.rot_hand and (it.w or 1) ~= (it.h or 1) then
		-- FRESH FROM THE BAG, SO ANY TURN IS ABSOLUTE: box_grab always
		-- hands back the section's own footprint, never a turned one.
		it.w, it.h, it.rot = it.h, it.w, true
	end

	-- THE WEIGHT FIRST. It is the cheapest of the three refusals and the
	-- only one that does not depend on where the thing would go.
	local lift, kg = A.box_lift(id, bsec, it)
	if not lift then
		say("That would put the %s over %s kg",
		    A.tip_name(bsec), tostring(kg))
		return false
	end

	-- SOMETHING IDENTICAL TO JOIN, or a square to stand on. Joining is
	-- asked first: a square that is taken is not a refusal when what is
	-- on it is the same thing.
	local at = (r and c) and A.box_on(t, r, c) or nil
	local join = A.box_join(t, it, cap, at)

	if not join then
		if not (r and c and A.box_room(t, cols, rows, r, c, it.w, it.h)) then
			r, c = A.box_spot(t, cols, rows, it.w, it.h)
		end

		if not r then
			say("No room in there for %s", A.tip_name(sec))
			return false
		end
	end

	local oid = obj:id()
	A.uncarry(oid)

	local okr = pcall(function() alife_release(obj) end)
	if not okr then
		log("!box: could not take %s in", tostring(sec))
		return false
	end

	-- A thing that was in a slot of the WORN rig has just stopped
	-- existing; the slot must not go on pointing at it.
	A.pk_forget(oid)

	-- AND A RIG'S POCKETS ARE NOW THE BOX'S. They were copied by
	-- box_grab and the object has just gone, so leaving them filed
	-- under its id is leaving a second copy of somebody's kit behind a
	-- key nothing will ever look up again. The destroy callback would
	-- clear them later; doing it here means there is never a moment
	-- when there are two.
	if A.hold[oid] then A.hold[oid] = nil end
	if A.pslot[oid] then A.pslot[oid] = nil end

	if join then
		A.pile_shift(it, t[join], 1)
	else
		it.r, it.c = r, c
		t[#t + 1] = it
	end

	A.boxes[id] = t

	A.box_reweigh(id)
	A.sfx_item(sec)
	return true
end

-- ============================================================
-- A CELL IS NOT ONE ITEM
--
--   "if i puck up a stack and want that to put it in a box then the
--    whole stack should go there not one item"
--
-- The inventory stacks identical things into ONE CELL. GetObj answers
-- the object the cell is named after; `childs` is a MAP KEYED BY OBJECT
-- ID holding all the rest. So a cell of twelve bandages dropped on a
-- box was one bandage going in, and the other eleven were still in the
-- bag - which is exactly what was reported.
--
-- NEVER CountChilds. utils_ui's own copy of it raises: it calls
-- `table_size`, which does not exist, in all seven copies of that file
-- in this install. A pairs loop is the only safe way to read this, and
-- there is an audit rule saying so.
-- ============================================================
function A.cell_objs(cc, idx)
	local out = {}
	if not (cc and idx) then return out end

	local seen = {}

	local ok, main = pcall(function() return cc:GetObj(idx) end)
	if ok and main then
		out[1] = main
		local oki, id = pcall(function() return main:id() end)
		if oki then seen[id] = true end
	end

	local ci = cc.cell and cc.cell[idx]
	local kids = ci and ci.childs
	if type(kids) ~= "table" then return out end

	for cid in pairs(kids) do
		if type(cid) == "number" and not seen[cid] then
			seen[cid] = true
			local o = level.object_by_id(cid)
			if o then out[#out + 1] = o end
		end
	end

	return out
end

-- THE WHOLE CELL, one object at a time, all onto the same square. The
-- first one lands there and the rest join it, because a cell the
-- inventory stacked holds things it considers the same - and box_join
-- asks the square that was pointed at before it asks anywhere else.
--
-- STOPS AT THE FIRST REFUSAL. If the box fills up, or goes over its
-- weight, half a stack going in and half staying in the bag is the
-- right answer and the count says so.
function A.box_put_all(id, bsec, cc, idx, r, c)
	local objs = A.cell_objs(cc, idx)
	if #objs == 0 then return false end

	local went = 0
	for i = 1, #objs do
		if not A.box_put(id, bsec, objs[i], r, c, i > 1) then break end
		went = went + 1
	end

	if went > 0 and went < #objs then
		notify("%s of %s went in", tostring(went), tostring(#objs))
	end

	return went > 0
end

-- ============================================================
-- OUT: MAKE IT, THEN DROP THE ENTRY
-- ============================================================
-- ============================================================
-- OUT OF A SORTED BOX: ONE, AND THE BEST ONE
--
--   "if i take whole stack and drop it in inventory then it should drop
--    the most full magazine not all of them into the inventory"
--
-- The rest stay where they are. This is the whole difference between a
-- magazine box and every other box, and it is here rather than inside
-- box_take's loop because it is not a variation on handing a pile back
-- - it is a different thing to do.
-- ============================================================
function A.box_take_best(id, n, how)
	local t = A.boxes[id]
	local it = t and t[n]
	if not it then return false end

	local at = A.pile_end(it, how, false)
	if not at then return false end

	-- OFF THE PILE FIRST, THEN MADE - the same order as everywhere else
	-- in this file, and the same repair when the make fails: the pile
	-- is the only copy, so it gets the record back.
	local one = A.pile_pull(it, at)
	if not one then return false end

	local made, new, more = A.box_make(one)
	if not made then
		A.pile_add(it, one)
		log("!box: could not hand back %s", tostring(it.sec))
		notify("That could not come out of the box")
		return false
	end

	-- The square for the first, and the SIBLINGS RIDE IN IT - a pull
	-- of ammunition can be several boxes from one make.
	if new and A.hold_square(new, it.sec, it.rot) then
		for i = 2, #(more or {}) do A.ride_square(more[i], new) end
	end

	if A.pile_n(it) <= 0 then
		table.remove(t, n)
		if #t == 0 then A.boxes[id] = nil end
	end

	A.box_reweigh(id)
	A.sfx("out")
	dbg("box: the %s %s came out, %s left",
	    (how == "fill") and "fullest" or "least worn",
	    tostring(it.sec), tostring(A.pile_n(it)))
	return true, new, more or (new and { new } or {})
end

-- `bsec` is the box's own section, so that a box which sorts its piles
-- can be told apart from one that does not. The window has it; anything
-- that does not is read off the object.
function A.box_take(id, n, bsec)
	local t = A.boxes[id]
	local it = t and t[n]
	if not it then return false end

	local how = A.box_pick(bsec or A.box_sec(id))
	if how then return A.box_take_best(id, n, how) end

	-- A STACK COMES OUT AS WHAT IT STANDS FOR: one object per count.
	-- Counted rather than assumed, because a create can fail half way
	-- and what is left in the box must be what was NOT handed out. The
	-- alternative - hand out some and drop the whole entry - is the one
	-- outcome this file exists to prevent.
	local of = A.pile_norm(it)
	local want = of and #of or 0
	local made = 0
	local created = {}

	-- The one that got the square. The others ride in it; see below.
	local first = nil

	for i = 1, want do
		local rec = of[i]

		-- THE RECORD, NOT THREE FIELDS OFF IT. Listing the fields here
		-- meant that the day a fourth one was added - a magazine's
		-- rounds - this door dropped it, silently, on the one route
		-- that hands a whole pile back. `sec` belongs to the pile and
		-- everything else belongs to the object.
		local ok, new, more = A.box_make({ sec = it.sec, cond = rec.cond,
		                             uses = rec.uses, ammo = rec.ammo,
		                             mag = rec.mag, rig = rec.rig })
		if not ok then break end
		made = made + 1
		if type(more) == "table" and #more > 0 then
			for x = 1, #more do created[#created + 1] = more[x] end
		elseif type(new) == "number" then
			created[#created + 1] = new
		end

		-- ============================================================
		-- AND THEY ALL GO TO THE SAME SQUARE
		--
		--   "one item moves when i dropped it and the rest of the stack
		--    goes to first free slot in invnetory instead"
		--
		-- Exactly this line, before: the first one out was given the
		-- square under the cursor and the others were given nothing, so
		-- the packer put them in the first gap it could find.
		--
		-- Asking for a square each would not have helped. The reserve
		-- works out the square under the cursor and checks it is FREE,
		-- and the moment the first one lands it is not - so every call
		-- after the first would answer no and the answer would still be
		-- the first gap.
		--
		-- A STACK IS ONE SQUARE WITH SEVERAL THINGS IN IT. So the first
		-- one takes the square and the rest are told to ride in it,
		-- which is what the grid does with a stack it packed itself.
		-- ============================================================
		if new then
			if made == 1 then
				if A.hold_square(new, it.sec, it.rot) then first = new end
			elseif first then
				A.ride_square(new, first)
			end
			-- ...and the make's own siblings, when it split a round
			-- count into several boxes, ride behind whoever leads.
			local lead = first or nil
			if lead then
				for x = 2, #(more or {}) do
					A.ride_square(more[x], lead)
				end
			end
		end
	end

	if made == 0 then
		log("!box: could not hand back %s", tostring(it.sec))
		notify("That could not come out of the box")
		return false
	end

	A.sfx("out")

	if made < want then
		-- WHAT IS LEFT IN THE BOX IS WHAT WAS NOT HANDED OUT, exactly.
		-- Taken off the front because that is the end they were made
		-- from.
		for _ = 1, made do table.remove(of, 1) end
		log("!box: only %s of %s %s came out",
		    tostring(made), tostring(want), tostring(it.sec))
		notify("Only %s of those came out", tostring(made))
		A.box_reweigh(id)
		return true, first, created
	end

	table.remove(t, n)
	if #t == 0 then A.boxes[id] = nil end

	A.box_reweigh(id)
	return true, first, created
end

-- ============================================================
-- ONE OUT OF THE STACK IN HAND
--
--   "when i want to take out the item from the box, then it should
--    work, like 1 full stack or one item when used with 'drop one item
--    from held stack' (shift default)"
--
-- Letting go takes the whole stack; the split key takes one and leaves
-- the rest in hand, tap after tap. The same gesture Zone Grid already
-- has for splitting a stack inside the inventory, so it is the same
-- KEY: read off the grid when the grid is there, and shift when it is
-- not, because this mod also ships alone.
-- ============================================================
function A.split_key()
	local ok, k = pcall(function() return zzz_amp_grid.split_key end)
	if ok and type(k) == "number" and k > 0 then return k end
	return DIK_keys.DIK_LSHIFT
end

function A.box_take_one()
	local d = A.win_drag
	if not (d and d.box) then return false end

	-- OVER THE INVENTORY, and not over a window. Inside a box the key
	-- would mean something else and there is a drop for it already.
	if A.win_hit() then return false end

	local w = A.wins[d.k]
	local t = w and w.id and A.boxes[w.id]
	local it = t and t[d.i]
	if not it then return false end

	-- ONE OF WHAT THE ENTRY STANDS FOR. Built rather than shared, so
	-- nothing here can write into the entry that is staying behind. No
	-- count on it: box_make reads the fields that describe an object
	-- and makes exactly one, and a number it does not read would be a
	-- number somebody later assumes it does.
	--
	-- AND IN A SORTED BOX IT IS THE WORST ONE.
	--
	--   "if i hold the mags and use 'drop one from stack' button then
	--    the most empty one is dropped into inventory instead"
	--
	-- Which is the other half of the pair: letting go gives you the one
	-- to fight with, this gives you the one to fill up.
	local how = A.box_pick(w.sec or A.box_sec(w.id))
	local one = A.pile_pull(it, how and A.pile_end(it, how, true) or nil)
	if not one then return false end

	local made, new, more = A.box_make(one)
	if not made then
		-- PUT IT BACK. It was taken off the pile before it was made,
		-- and a make that failed is an object that does not exist -
		-- so the pile is the only copy again.
		A.pile_add(it, one)
		log("!box: could not hand back one %s", tostring(it.sec))
		notify("That could not come out of the box")
		return false
	end

	if new and A.hold_square(new, it.sec, it.rot) then
		for i = 2, #(more or {}) do A.ride_square(more[i], new) end
	end

	-- THE LAST ONE EMPTIES THE HAND. There is nothing left to be
	-- holding, and a drag pointing at an entry that has gone is the
	-- state every guard in this file is written to avoid.
	if A.pile_n(it) <= 0 then
		table.remove(t, d.i)
		if #t == 0 then A.boxes[w.id] = nil end
		A.win_drag = nil
		A.let_go()
	end

	A.box_reweigh(w.id)
	A.sfx("out")

	local gui = gui_now()
	if gui then pcall(function() gui:On_Item_Update() end) end

	dbg("box: one %s out, %s left in hand",
	    tostring(it.sec), tostring(A.pile_show(it)))
	return true
end

-- ============================================================
-- WITHIN ONE BOX, OR BETWEEN TWO
--
-- Nothing is created and nothing destroyed, so there is no order to get
-- wrong - the entry leaves one array and joins the other.
--
-- The two cases differ in what happens when it will not fit where you
-- let go. ACROSS two boxes, anywhere in the destination will do: you
-- asked for it to go in there and the square is a detail. WITHIN one
-- box, the square IS what you asked for, and quietly filing it
-- somewhere else is the arrangement coming apart under your hands. So
-- that one simply does not move.
-- ============================================================
function A.box_move(fid, n, tid, tsec, r, c)
	local tf = A.boxes[fid]
	local it = tf and tf[n]
	if not (it and tid and tsec) then return false end

	local cols, rows = A.box_grid(tsec)
	local cap = A.box_cap(tsec)
	local same = (fid == tid)

	if not same then
		local ok, why = A.box_takes(tsec, it.sec)
		if not ok then
			notify("%s", why or "That does not go in this box")
			return false
		end

		local lift, kg = A.box_lift(tid, tsec, it)
		if not lift then
			notify("That would put the %s over %s kg",
			       A.tip_name(tsec), tostring(kg))
			return false
		end
	end

	local tt = same and tf or (A.boxes[tid] or {})
	local skip = same and n or nil

	-- THE HAND MAY BE TURNED. Worked out here, APPLIED ONLY WHERE THE
	-- MOVE SUCCEEDS: a refused move leaves the entry lying exactly as
	-- it was. Writing the swap up front and then failing would leave
	-- it overlapping its neighbours with nothing ever checking again.
	local turn = A.rot_hand and (it.w or 1) ~= (it.h or 1)
	local iw = turn and it.h or it.w
	local ih = turn and it.w or it.h

	-- ============================================================
	-- LET GO ON SOMETHING IDENTICAL AND THE TWO BECOME ONE
	--
	-- Which is the only thing a player can mean by dropping a stack of
	-- bandages onto a stack of bandages. It is checked before the fit,
	-- because a square that is occupied is not "no room" when what is on
	-- it is the same thing.
	--
	-- The ceiling is respected by moving only what will go: the rest
	-- stays where it was, which is the same answer the inventory gives
	-- when two stacks will not fit into one.
	-- ============================================================
	local onto = A.box_on(tt, r, c)
	if onto and not (same and onto == n)
	   and A.same_stack(tt[onto], it) and A.pile_n(tt[onto]) < cap
	then
		local room = cap - A.pile_n(tt[onto])
		A.pile_shift(it, tt[onto], math.min(room, A.pile_n(it)))

		if A.pile_n(it) <= 0 then
			table.remove(tf, n)
			if #tf == 0 then A.boxes[fid] = nil else A.boxes[fid] = tf end
		end

		A.boxes[tid] = tt
		A.box_reweigh(fid)
		A.box_reweigh(tid)
		A.sfx("in")
		return true
	end

	if not A.box_room(tt, cols, rows, r, c, iw, ih, skip) then
		if same then return false end

		local rr, cc = A.box_spot(tt, cols, rows, iw, ih)
		if not rr then
			notify("No room in there for %s", A.tip_name(it.sec))
			return false
		end
		r, c = rr, cc
	end

	if same then
		it.r, it.c = r, c
		if turn then it.w, it.h, it.rot = iw, ih, not it.rot or nil end
		A.sfx("in")
		return true
	end

	table.remove(tf, n)
	it.r, it.c = r, c
	if turn then it.w, it.h, it.rot = iw, ih, not it.rot or nil end
	tt[#tt + 1] = it

	if #tf == 0 then A.boxes[fid] = nil else A.boxes[fid] = tf end
	A.boxes[tid] = tt

	A.box_reweigh(fid)
	A.box_reweigh(tid)
	A.sfx("in")
	return true
end

-- ============================================================
-- WHAT IT WEIGHS
--
-- The same arithmetic the rig uses and for the same reason: those items
-- are not in your inventory any more, so nothing else is weighing them.
--
-- AMMUNITION IS WEIGHED BY THE ROUND. inv_weight on an ammo section is
-- the weight of a FULL BOX, and the engine scales it by how many rounds
-- are actually in it - so a box of five out of thirty must be weighed
-- the same way or a half-empty ammo can weighs as much as a full one.
-- Uses are NOT scaled, because the engine does not scale them either: a
-- half-used medkit weighs what a medkit weighs.
-- ============================================================
-- ONE OBJECT of what this entry holds. Split out of box_weight because
-- the weight ceiling has to ask what ONE MORE would cost before it
-- destroys anything.
-- ONE OBJECT'S WEIGHT, from its section and its own record. A part-box
-- of cartridges weighs its fraction of a full one, which is the only
-- reason this takes the record at all.
function A.entry_weight(sec, rec)
	if type(sec) ~= "string" then return 0 end

	local base = SYS_GetParam(2, sec, "inv_weight")
	base = (type(base) == "number") and base or 0

	-- A LOADED MAGAZINE WEIGHS ITS ROUNDS. inv_weight on a magazine is
	-- the EMPTY one - the magazine mod adds the cartridges to the
	-- object's weight every half second while it exists - so a box full
	-- of full magazines would otherwise weigh what a box of empty ones
	-- does, and its 15 kg would mean nothing.
	--
	-- The same arithmetic as A.stash_weight, which does this for a rig:
	-- inv_weight on an ammo section is the weight of a FULL BOX, so one
	-- round is that over box_size.
	local L = rec and rec.mag and rec.mag.loaded
	if type(L) == "table" and #L > 0 then
		local ammo = L[1]
		local aw = type(ammo) == "string"
			and SYS_GetParam(2, ammo, "inv_weight") or nil
		local abox = type(ammo) == "string"
			and SYS_GetParam(2, ammo, "box_size") or nil

		if type(aw) == "number" and type(abox) == "number" and abox > 0 then
			base = base + aw * (#L / abox)
		end
	end

	-- A RIG WEIGHS WHAT IS IN IT. A.reweigh does this for a rig lying in
	-- your bag, and it exists because a spare rig was otherwise a free
	-- ammo bag; a rig inside a box has to carry the same weight or the
	-- armour case becomes the free ammo bag instead.
	local rig = rec and rec.rig
	if rig then
		for _, t in pairs(rig.stash or {}) do
			base = base + A.slot_kg(t)
		end

		for _, ps in pairs(rig.pouch or {}) do
			local pw = SYS_GetParam(2, ps, "inv_weight")
			if type(pw) == "number" then base = base + pw end
		end
	end

	local a = rec and rec.ammo
	if type(a) == "number" then
		local box = SYS_GetParam(2, sec, "box_size")
		if type(box) == "number" and box > 0 then
			base = base * (a / box)
		end
	end

	return base
end

function A.box_weight(id)
	local t = id and A.boxes[id]
	if not t then return 0 end

	local w = 0
	for n = 1, #t do
		local it = t[n]
		if it then w = w + A.pile_weight(it) end
	end

	return w
end

-- ============================================================
-- WILL IT CARRY ONE MORE
--
-- ASKED BEFORE ANYTHING IS DESTROYED, like every other refusal in this
-- file: a box that says no leaves the item in the world.
--
-- The check is against what the box holds NOW plus what is being added,
-- so a box already over its limit - a save from before the limit
-- existed, an ltx edited downwards - refuses to grow but keeps what it
-- has. Tipping somebody's contents on the floor to enforce a number is
-- not a fix.
-- ============================================================
function A.box_lift(id, bsec, it)
	local _, kg = A.box_cap(bsec)
	if not (kg and kg > 0) then return true end

	local now = A.box_weight(id)
	local more = A.pile_weight(it)

	if now + more <= kg + 0.0001 then return true end

	dbg("box %s: %.2f + %.2f is over its %.2f kg", tostring(id),
	    now, more, kg)
	return false, kg
end

function A.box_reweigh(id)
	if not id then return false end

	local obj = level.object_by_id(id)
	if not obj then return false end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and A.is_box_sec(sec)) then return false end

	local base = SYS_GetParam(2, sec, "inv_weight")
	if type(base) ~= "number" then return false end

	local want = base + A.box_weight(id)

	local okw, now = pcall(function() return obj:weight() end)
	if okw and type(now) == "number" and math.abs(now - want) < 0.001 then
		return false
	end

	local set = pcall(function() obj:set_weight(want) end)

	-- THE SAME NUDGE THE RIGS NEED, and for the same reason - a box
	-- that gains weight is a cached total that has not been told. It
	-- looked right here only because filling a box happens to be full
	-- of the inventory events that make the engine recount anyway; that
	-- is luck, not a mechanism. See A.recount.
	if set then A.recount(obj) end

	if set then
		local was2
		pcall(function() was2 = db.actor:get_total_weight() end)
		dbg("box %s weighs %.2f (%.2f + %.2f inside) | you: %s", tostring(id),
		    want, base, want - base,
		    was2 and string.format("%.2f", was2) or "?")
	end
	return set
end

-- ============================================================
-- WHERE THE THING IN HAND WOULD LAND
--
-- ONE function, used by both the drop and the highlight that previews
-- it. They were two for about ten minutes and that is exactly long
-- enough to make them disagree: a preview that says yes and a drop that
-- says no is worse than no preview.
--
-- GRABBED WHERE IT WAS GRABBED. An item is picked up by the square the
-- cursor was on, and the square under the cursor stays that same square
-- of the item all the way through - so a 2x1 stick taken by its right
-- half does not jump a square left the moment it is lifted.
--
-- Then CLAMPED into the grid rather than refused at the edge: reaching
-- the last column with a two-wide item would otherwise be impossible,
-- because the square you want to point at is off the board.
-- ============================================================
--
-- `d` IS PASSED IN, NOT READ. A.win_drop clears A.win_drag at the top -
-- it must, or a drop that throws leaves the hand full forever - and
-- then asks this where the thing would land. Reading the live drag
-- here meant the drop always saw "nothing in hand", answered "it would
-- not fit", and left every item exactly where it was picked up.
-- Nothing lost and nothing moved, which is the most confusing possible
-- way for a drag to fail.
-- ============================================================
-- WHAT THE INVENTORY IS HOLDING
--
-- The window's own drag, not ours. `item_in_hold` is the ID of whatever
-- container has something in hand, and that container's hold.idx is the
-- cell - which is how the base class finds the thing it is drawing on
-- the cursor. Reading it is the only way a box can know what is being
-- dragged INTO it before the drop happens.
-- ============================================================
function A.in_hand()
	local gui = gui_now()
	if not (gui and gui.CC) then return nil end

	local which = gui.item_in_hold
	if not which or which == CC_ID then return nil end

	local cc = gui.CC[which]
	local idx = cc and cc.hold and cc.hold.idx
	if not idx then return nil end

	local ok, obj = pcall(function() return cc:GetObj(idx) end)
	if not (ok and obj) then return nil end

	local oks, sec = pcall(function() return obj:section() end)
	if not (oks and type(sec) == "string" and sec ~= "") then return nil end

	return obj, sec
end

-- ...READ ONCE PER DRAG, not once per frame. box_grab makes three
-- engine calls and this is asked by the draw pass, so the answer is
-- kept against the object's id and thrown away when the hand changes.
-- The budget suites in this project exist because a per-frame engine
-- call cost a third of the frame rate once already.
function A.hand_entry()
	local obj, sec = A.in_hand()
	if not obj then A.hand_memo = nil return nil end

	local ok, id = pcall(function() return obj:id() end)
	if not ok then return nil end

	local m = A.hand_memo
	if m and m.id == id then return m.it end

	local it = A.box_grab(obj)
	A.hand_memo = it and { id = id, it = it } or nil
	return it
end

-- ============================================================
-- THE HAND CAN BE TURNED - THE ENTRY ONLY AFTER IT LANDS
--
--   "okey build it but keep in mind to add mcm option to change
--    keybind to rotate"
--
-- A.rot_hand is "the player has pressed rotate an odd number of times
-- while holding this". It is RELATIVE to however the held entry
-- already lies: an entry that is already sideways plus one press is
-- upright again. It never touches the entry itself - box_move and
-- box_put write the swap where the drop succeeds, and nowhere else.
--
-- CLEARED WHENEVER THE HAND IS EMPTY, in the poll below, so a turn
-- from an abandoned drag can never leak into the next one.
-- ============================================================
function A.turned(it)
	if not it then return 1, 1 end
	local w, h = it.w or 1, it.h or 1
	if A.rot_hand and w ~= h then return h, w end
	return w, h
end

-- POLLED, NOT CAUGHT. The mouse buttons come to this mod as events
-- because it has to fight other containers for them; a letter key has
-- no such fight, and key_state read once per menu frame is the same
-- price the shift-click unload already pays. Edge-detected so holding
-- the key is one turn, not sixty a second.
function A.rot_poll()
	if not A.enabled then return end

	local d = A.win_drag
	local gui = gui_now()
	local held = (d and (d.box or d.pk)) or A.pk_drag
		or (gui and gui.item_in_hold and gui.item_in_hold ~= CC_ID)

	if not held then
		A.rot_hand, A.rot_down = nil, nil
		return
	end

	local down = (key_state(A.rot_key or 19) or 0) ~= 0
	if down and not A.rot_down then
		A.rot_hand = not A.rot_hand or nil
		dbg("rot: the hand is %s", A.rot_hand and "turned" or "upright")
		A.sfx("rotate")
	end
	A.rot_down = down or nil
end

-- ============================================================
-- WHERE THE THING IN HAND WOULD LAND, AND WHETHER IT WOULD
--
-- THREE ANSWERS, not two, and the third is the one that was missing:
--
--   true   it lands on these squares
--   false  it does not go in at all - wrong sort of thing, over the
--          weight, or there is nowhere in the box for it
--   nil    it goes in, but not here: the square is taken and it cannot
--          join what is on it, so the packer will find it somewhere
--
-- Green, red, and the ordinary hover. Painting the third one red would
-- be a lie, because the item does go in.
--
-- AND IT ANSWERS FOR THE INVENTORY'S DRAG TOO. It used to answer only
-- for an entry being dragged out of a box, so dragging something in
-- from the bag - which is how anything gets into a box in the first
-- place - had no highlight at all. What is in hand comes from
-- A.in_hand when it is not one of ours.
-- ============================================================
function A.box_hover(k, d, given)
	local w = A.wins[k]
	if not (w and w.kind == "box" and w.cols and w.rows) then return nil end

	local cell = A.win_at(k)
	if not cell then return nil end

	local r = math.floor((cell - 1) / w.cols) + 1
	local c = (cell - 1) % w.cols + 1

	d = d or A.win_drag

	local it, dr, dc, skip, ours_now

	if d and d.box then
		-- OURS. Out of a box, and it remembers which square OF ITSELF
		-- the cursor took hold of.
		local dw = A.wins[d.k]
		it = dw and dw.id and (A.boxes[dw.id] or {})[d.i]
		dr, dc = d.dr or 0, d.dc or 0
		skip = (d.k == k) and d.i or nil
		ours_now = true
	else
		-- THEIRS. The window draws the held icon CENTRED on the cursor,
		-- so that is where a two-wide thing is anchored: half its width
		-- back, not its corner. Anchored below, AFTER the turn has had
		-- its say - the centre of a turned thing is the turned centre.
		it = given or A.hand_entry()
	end

	if not it then return r, c, 1, 1, nil end

	-- THE FOOTPRINT TESTED IS THE ONE THE DROP WILL WRITE: turned when
	-- the hand is turned, relative to however the entry already lies.
	local iw, ih = A.turned(it)

	-- ...AND IN A FAN THE DROP WILL WRITE ONE SQUARE. box_put flattens
	-- a paper on the way in, and this did not know: it measured the
	-- 1x2 a folded sheet's ICON happens to be, found the row below
	-- taken, and answered "it goes in the case, but not here" about a
	-- drop that lands exactly under the cursor.
	--
	-- The rule belongs to the WINDOW - a sheet on edge has no
	-- footprint and no orientation - and this is the second of the two
	-- places that work in footprints. There is no step they share to
	-- say it in once.
	if A.box_fan(w.sec) then iw, ih = 1, 1 end

	if ours_now then
		-- The grabbed-square offset was measured before the turn, so a
		-- grip on the far end of something long is walked back inside
		-- the turned footprint rather than anchoring off the end of it.
		if dr > ih - 1 then dr = ih - 1 end
		if dc > iw - 1 then dc = iw - 1 end
	else
		dr = math.floor((ih - 1) / 2)
		dc = math.floor((iw - 1) / 2)
	end

	local tr = r - dr
	local tc = c - dc

	if tr < 1 then tr = 1 end
	if tc < 1 then tc = 1 end
	if tr + ih - 1 > w.rows then tr = w.rows - ih + 1 end
	if tc + iw - 1 > w.cols then tc = w.cols - iw + 1 end

	if tr < 1 or tc < 1 then return r, c, iw, ih, false end

	local t = A.boxes[w.id] or {}
	local cap = A.box_cap(w.sec)

	-- WHAT THIS BOX WOULD SAY, asked in the order the drop asks it.
	-- Coming from another box or from the bag it has to pass the rules
	-- and the weight; moving inside one box it is already in there.
	if not (ours_now and d.k == k) then
		if not A.box_takes(w.sec, it.sec) then return tr, tc, iw, ih, false end
		if not A.box_lift(w.id, w.sec, it) then
			return tr, tc, iw, ih, false
		end
	end

	-- ON THESE SQUARES, either because they are free or because what is
	-- already on them is the same thing with room left in it. A stack
	-- dropped on a stack of the same thing merges, so that is a yes.
	local under = A.box_on(t, tr, tc)
	if under and under ~= skip
	   and A.same_stack(t[under], it) and A.pile_n(t[under]) < cap
	then
		return tr, tc, iw, ih, true
	end

	if A.box_room(t, w.cols, w.rows, tr, tc, iw, ih, skip) then
		return tr, tc, iw, ih, true
	end

	-- NOT HERE. Inside one box that is the end of it - the square is
	-- what was asked for and the item does not move. From anywhere else
	-- the packer will find room, so this is neither yes nor no.
	if ours_now and d.k == k then return tr, tc, iw, ih, false end

	if A.box_join(t, it, cap) or A.box_spot(t, w.cols, w.rows, iw, ih) then
		return tr, tc, iw, ih, nil
	end

	return tr, tc, iw, ih, false
end

-- ============================================================
-- THE DRAW
--
-- The window furniture is the rig window's, line for line - same
-- statics, same cascade, same clamp, same close box - and then a grid
-- instead of a row of pockets.
--
-- The pools are shared with the rig window on purpose: w.box and w.inn
-- are the squares, w.ico is one icon per ITEM. A slot that showed a rig
-- and then a box reuses whatever it already made and grows the rest,
-- which is what a pool is for.
-- ============================================================
function A.box_draw(k, xml, gui, fr)
	local w = A.wins[k]

	local obj, sec = A.win_obj(k)
	if not obj then
		A.win_close(k, "it is no longer a box in your inventory")
		return
	end

	local cols, rows = A.box_grid(sec)
	w.cols, w.rows, w.sec = cols, rows, sec

	-- BEFORE ANYTHING IS DRAWN OR HIT-TESTED. This is the one place
	-- that knows both the box and the size of its grid, and everything
	-- below assumes every entry is standing on a square that exists.
	-- It walks the entries and almost always changes nothing.
	A.box_fit(w.id, cols, rows)

	local gs, gl = A.metrics()
	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then ratio = 1 end

	-- ============================================================
	-- A FAN IS A BOX WITH DIFFERENT-SHAPED ROWS
	--
	-- cw and ch are what every rectangle below is built from, so
	-- changing the two of them changes the whole window and leaves the
	-- arithmetic that places things in it alone.
	--
	-- NO GAP BETWEEN SHEETS. gl is the line between two squares; paper
	-- has no such line, it has an EDGE, and the sheet below draws it.
	-- ============================================================
	local fan = A.box_fan(sec)
	w.fan = fan

	if fan then gl = 0 end

	local cw = fan and (FAN_W * ratio) or (gs * ratio)
	local ch = fan and FAN_PITCH or gs

	local wd = cols * cw + (cols - 1) * gl
	local h  = rows * ch + (rows - 1) * gl

	-- The last sheet has nothing lying over it, so the block is a
	-- pitch taller than the slivers add up to.
	if fan then h = h + (FAN_STRIP - FAN_PITCH) end

	local winw = wd + WIN_PAD * 2
	local winh = h + WIN_PAD * 2 + WIN_HEAD

	local ox, oy, px, py =
		A.win_frame(k, xml, gui, fr, winw, winh, sec)
	if not ox then return A.win_hide(k) end

	-- WHERE THE THING IN HAND WOULD GO, worked out BEFORE the squares
	-- are drawn so each square knows whether it is under it. Only for
	-- the window the cursor is actually in.
	local top = A.win_hit()
	local hr, hc, hw, hh, fits
	if top == k then hr, hc, hw, hh, fits = A.box_hover(k) end

	local t = A.boxes[w.id] or {}

	-- ============================================================
	-- WHERE EVERY SQUARE IS - AND THAT IS ALL THIS LOOP DOES NOW
	--
	-- `lay` is what the hit tests, the drops and the icons are placed
	-- from, and it is the SAME ARITHMETIC it always was. The picture
	-- below changed; the squares did not move by a pixel.
	-- ============================================================
	local lay = {}
	local n = 0

	for r = 1, rows do
		for c = 1, cols do
			n = n + 1
			lay[n] = { px + WIN_PAD + (c - 1) * (cw + gl),
			           py + WIN_PAD + WIN_HEAD + (r - 1) * (ch + gl),
			           cw, ch }
		end
	end

	-- THE LAST SHEET SHOWS ITS WHOLE FACE, so the whole face is what
	-- you can click. Every other row owns the sliver of itself that is
	-- not covered; this one is covered by nothing.
	if fan and lay[rows] then lay[rows][4] = FAN_STRIP end

	-- ============================================================
	-- THE INSIDE OF A BOX IS ONE AREA, NOT TWENTY-FIVE BOXES
	--
	--   "one area with faint lines"
	--
	-- Every square used to be its own bordered rectangle with a gap
	-- round it, so a box drew a box in a box in a box: the window, then
	-- a frame per square, then the thing standing on it. What is drawn
	-- now is what the backpack was changed to - one panel with a thin
	-- grey edge and a barely visible line wherever one square ends and
	-- the next begins.
	--
	-- It is also a great deal less drawing. Five by five was fifty
	-- windows and is fifteen; the biggest grid the ltx may ask for
	-- falls from 288 to 27, and in a retained UI every window that
	-- EXISTS is walked every frame.
	--
	-- TWO POOLS, MADE IN A FIXED ORDER, EVERY FRAME. The panel first,
	-- then its edge and seams, then the block that shows where the
	-- thing in hand would go - and that block is made EVEN WHEN THERE
	-- IS NOTHING IN HAND, hidden, because a static made later is drawn
	-- over the icons and a coloured slab over a magazine is not a
	-- highlight, it is a hole.
	-- ============================================================
	local ln, an = 0, 0

	local function line(x, y, lw, lh, c, vis)
		ln = ln + 1
		local s = w.bl[ln]
		if not s then
			s = A.mkstatic(xml, "amp:boxline", gui.equ_dialog, LAYER_WIN)
			w.bl[ln] = s
			A.win_grew(w)
		end
		if not s then return end
		if vis then
			A.wpos(s, x, y)
			A.wsize(s, lw, lh)
			A.wtint(s, 255, c[1], c[2], c[3])
		end
		A.wshow(s, vis and true or false)
	end

	local function area(x, y, aw, ah, c, vis)
		an = an + 1
		local s = w.ba[an]
		if not s then
			s = A.mkstatic(xml, "amp:boxarea", gui.equ_dialog, LAYER_WIN)
			w.ba[an] = s
			A.win_grew(w)
		end
		if not s then return end
		if vis then
			A.wpos(s, x, y)
			A.wsize(s, aw, ah)
			A.wtint(s, 255, c[1], c[2], c[3])
		end
		A.wshow(s, vis and true or false)
	end

	local gx = ox + WIN_PAD
	local gy = oy + WIN_PAD + WIN_HEAD
	local gw = cols * cw + (cols - 1) * gl
	local gh = rows * ch + (rows - 1) * gl

	-- THE PANEL, with two pixels of margin so the edge is a frame round
	-- the grid rather than a line through the first square.
	local ax, ay = gx - 2, gy - 2
	local aw, ah = gw + 4, gh + 4
	area(ax, ay, aw, ah, BOX_IN, true)

	line(ax, ay, aw, WIN_EDGE, BOX_EDGE, true)
	line(ax, ay + ah - WIN_EDGE, aw, WIN_EDGE, BOX_EDGE, true)
	line(ax, ay, WIN_EDGE, ah, BOX_EDGE, true)
	line(ax + aw - WIN_EDGE, ay, WIN_EDGE, ah, BOX_EDGE, true)

	-- WHICH SHEET IS UNDER THE CURSOR, in scope for the item loop far
	-- below as well as for the paint just here: the sheet slides left
	-- and its name has to slide with it.
	local fanover

	if fan then
		-- ============================================================
		-- THE SHEETS THEMSELVES
		--
		-- One per row, every row, empty or not: it is the paper that is
		-- the furniture in here, and twenty empty pockets is not what a
		-- case with four documents in it looks like. An empty row is a
		-- sheet with nothing written on it.
		--
		-- DRAWN TOP DOWN so each lies over the one before and shows
		-- only its top sliver - which is FAN_PITCH, which is the hit
		-- band in `lay`, so what you can click is what you can see. The
		-- last has nothing over it and shows its whole face.
		--
		-- The dark line under each is the edge of the paper. There is
		-- no seam between rows because paper has no seam; it has an
		-- edge, and the sheet below draws it.
		-- ============================================================
		-- FROM `lay`, WHICH IS IN SCOPE AND CURRENT. w.lay is only
		-- published at the end of this pass, so asking A.win_at here
		-- would highlight where the cursor was last frame - which a 41
		-- px square forgives and a 15 px sliver does not.
		local over
		if A.win_hit() == k then
			for i = 1, #lay do
				if hit(lay[i]) then over = i break end
			end
		end
		fanover = over

		-- ============================================================
		-- A SHEET FOR EVERY PAPER, AND NOT ONE MORE
		--
		-- An empty case is an empty case - the dark inside of it - and
		-- every document you put in adds a sheet to the fan. Drawing a
		-- sheet per ROW instead gave twenty-four of them whatever was
		-- in there, which is one parchment slab with writing at the top
		-- and not a stack of anything.
		--
		-- WHICH ROWS ARE OCCUPIED, not how many entries there are: the
		-- packer fills from the top, but an entry taken out of the
		-- middle leaves a gap and a case that redrew itself solid would
		-- be lying about where the next one goes.
		-- ============================================================
		local sheet = {}
		local last = 0
		for i = 1, #t do
			local e = t[i]
			if e and e.r then
				sheet[e.r] = true
				if e.r > last then last = e.r end
			end
		end
		-- THE ROW BEING DROPPED ONTO IS A SHEET TOO, so the fan grows
		-- under the cursor rather than after the mouse comes up.
		--
		-- ONLY WITH SOMETHING IN HAND. box_hover answers with a row
		-- whenever the cursor is over the window at all - it has to,
		-- the grid draws its square highlight from that - and `fits` is
		-- nil exactly when there is nothing to judge. Without this the
		-- cursor lays a sheet on every row it passes.
		if hr and hr > 0 and fits ~= nil then
			sheet[hr] = true
			if hr > last then last = hr end
		end

		for r = 1, rows do
			if sheet[r] then
				local sy = gy + (r - 1) * FAN_PITCH

				-- THE BOTTOM ONE SHOWS ITS WHOLE FACE. Every other sheet
				-- is covered by the next, so only its top sliver is
				-- drawn - and a gap in the middle means the sheet above
				-- the gap has nothing on it either.
				local covered = sheet[r + 1] and r < rows
				local sh = covered and (FAN_PITCH + FAN_SHADOW) or FAN_STRIP

				-- OUT TO THE LEFT, AND BRIGHTER. Its right edge does
				-- not move, so the sheet gets LONGER rather than
				-- sliding: what you see is one paper pushed proud of
				-- the stack, not the stack shifting under the cursor.
				local jut = (over == r) and FAN_JUT or 0

				local tone = FAN_SHEET
				if over == r then
					tone = FAN_OVER
				elseif r % 2 == 0 then
					tone = FAN_ALT
				end

				area(gx - jut, sy, gw + jut, sh, tone, true)

				-- ============================================================
				-- WHERE THE SHADOW GOES
				--
				-- Not at the bottom of this sheet's rectangle: the sheet
				-- BELOW is drawn afterwards and starts on exactly that
				-- line, so every shadow was painted and then painted
				-- over. Twelve flat bands, separated by nothing.
				--
				-- The sheet lying on this one darkens the strip of it
				-- just before its own top edge - which is inside THIS
				-- sheet's visible sliver, so it is drawn here and
				-- nothing lands on it.
				--
				-- The bottom sheet is lying on leather rather than on
				-- paper, and gets one along its own lower edge.
				-- ============================================================
				local shy = covered and (sy + FAN_PITCH - FAN_SHADOW)
				                    or (sy + FAN_STRIP - FAN_SHADOW)
				line(gx - jut, shy, gw + jut, FAN_SHADOW, FAN_SHADE, true)
			end
		end
	else
		-- A LINE DOWN EVERY SEAM. The squares are still gl apart -
		-- nothing moved - so the line goes in the gap that was already
		-- between them, not through a square.
		local mid = gl > 1 and math.floor(gl / 2) or 0
		for c = 1, cols - 1 do
			line(gx + c * cw + (c - 1) * gl + mid, gy, WIN_EDGE, gh, BOX_SEAM, true)
		end
		for r = 1, rows - 1 do
			line(gx, gy + r * ch + (r - 1) * gl + mid, gw, WIN_EDGE, BOX_SEAM, true)
		end
	end

	-- WHERE THE THING IN HAND WOULD GO: one block over the squares it
	-- would cover, green when it fits, red when it does not, grey when
	-- there is nothing to judge. Five windows, always made, shown only
	-- when there is something to show.
	local hx, hy, hiw, hih = 0, 0, 1, 1
	local hk = "on"
	if hr then
		hx = gx + (hc - 1) * (cw + gl)
		hy = gy + (hr - 1) * (ch + gl)
		hiw = hw * cw + (hw - 1) * gl
		hih = hh * ch + (hh - 1) * gl
		hk = (fits == true) and "ok" or (fits == false) and "no" or "on"
	end
	local hb, hf = HOV_EDGE[hk], HOV_FILL[hk]
	local hv = hr and true or false

	-- ============================================================
	-- IN A FAN THE SHEET IS THE HIGHLIGHT
	--
	--   "when i hoverover the note it highlights makes it dark like
	--    the background."
	--
	-- A literal description of this block. HOV_FILL.on is 38,42,52 and
	-- BOX_IN is 26,28,34 - the "nothing in hand" highlight is the
	-- PANEL's own colour, which over a square reads as the square
	-- lighting up and over a sheet of paper reads as the paper going
	-- out.
	--
	-- So with nothing in hand a fan draws none of it: the sheet has
	-- already brightened and slid out on its own. The green and the red
	-- stay, because those answer a question - does this fit here - and
	-- that answer is worth as much on paper as on squares.
	-- ============================================================
	if fan and fits == nil then hv = false end

	area(hx, hy, hiw, hih, hf, hv)
	line(hx, hy, hiw, WIN_EDGE, hb, hv)
	line(hx, hy + hih - WIN_EDGE, hiw, WIN_EDGE, hb, hv)
	line(hx, hy, WIN_EDGE, hih, hb, hv)
	line(hx + hiw - WIN_EDGE, hy, WIN_EDGE, hih, hb, hv)

	-- ANY LINE THIS GRID DID NOT WANT. The number of seams follows the
	-- grid, so a slot handed a smaller box than the one it drew last has
	-- lines left over - and a seam from a five by five standing on a
	-- four by two is a line across nothing.
	for i = ln + 1, #w.bl do A.wshow(w.bl[i], false) end

	-- ============================================================
	-- ...AND ANY AREA, WHICH USED NOT TO BE POSSIBLE
	--
	-- This said "the two areas need no such loop: the panel and the
	-- highlight are always exactly two, whatever the grid" - and that
	-- was true of every window this file had, right up until one of
	-- them started drawing an area per SHEET.
	--
	-- A fan's count moves with what is in the case, so an area left
	-- over from a fuller frame stays on screen with nothing written on
	-- it. That is a blank sheet of paper in a case that does not
	-- contain it, and it is what "item names are not visible" looked
	-- like: not names that failed to draw, but paper that should not
	-- have been there.
	--
	-- A COMMENT SAYING A LOOP IS UNNECESSARY IS AN INVARIANT, and this
	-- one stopped being true the day the fan was written. It was in the
	-- file, it was correct when it was written, and nothing checks a
	-- sentence.
	-- ============================================================
	for i = an + 1, #w.ba do A.wshow(w.ba[i], false) end

	-- ============================================================
	-- AND THE POCKETS THIS SLOT MAY HAVE BEEN SHOWING
	--
	-- A slot outlives what is in it: the window with a box in it now
	-- may have had a rig in it a moment ago, and a pocket left shown
	-- behind a box's panel is a pocket-shaped hole in the corner of it.
	--
	-- THIS CANNOT FIRE TODAY, and the reason is worth writing down
	-- rather than discovering twice. A slot is only ever freed by
	-- A.win_close, which ends by calling A.win_hide - and win_hide
	-- hides every pocket. win_free hands out slots with no id, so a
	-- slot is always hidden before it is re-used. The mutation that
	-- deletes these two lines is therefore CAUGHT BY NOTHING, and is
	-- retired rather than chased.
	--
	-- It stays because the invariant it depends on lives in another
	-- function: today's "always hidden first" is a property of
	-- win_close, and this is a box's own statement about what a box
	-- draws. Two lines is a cheap price for not having to remember.
	-- ============================================================
	for i = 1, #w.box do A.wshow(w.box[i], false) end
	for i = 1, #w.inn do A.wshow(w.inn[i], false) end

	-- AND THE THINGS STANDING ON IT. One icon per entry, at the entry's
	-- own footprint, drawn after every square so nothing is drawn over.
	local d = A.win_drag
	local shown = 0

	for i = 1, #t do
		local it = t[i]
		local dragged = d and d.box and d.k == k and d.i == i

		if it and not dragged and type(it.sec) == "string" then
			shown = shown + 1

			-- ONE ICON PER ENTRY - EXCEPT IN A FAN, WHICH DRAWS NONE.
			--
			-- It used to be made before anything knew what kind of
			-- window this was, so a case full of documents made a
			-- static per sheet and hid it. That is not merely waste:
			-- A.win_grew fires when #w.ico > 0, the sheets call it as
			-- they are made, and the rebuild it asks for clears the
			-- pools so the sheets are made again next frame - which
			-- asks for another. The fan rebuilt its whole window on
			-- every frame it was open.
			local ico
			if not fan then
				ico = w.ico[shown]
				if not ico then
					ico = A.mkstatic(xml, "amp:winico", gui.equ_dialog, LAYER_WIN)
					w.ico[shown] = ico
				end
			end

			local bx = ox + WIN_PAD + (it.c - 1) * (cw + gl)
			local by = oy + WIN_PAD + WIN_HEAD + (it.r - 1) * (ch + gl)

			-- ============================================================
			-- IN A FAN, THE NAME IS THE PICTURE
			--
			-- Every document's icon is the same folded sheet, so an
			-- icon here would say nothing. The name says everything,
			-- and it goes along the sliver of paper that is showing.
			--
			-- HOW MANY comes on the end of it rather than on a plate in
			-- the corner: a sliver has no corner.
			-- ============================================================
			if fan then
				local txt = w.fantxt[shown]
				if not txt then
					txt = A.mktext(xml, "amp:fantxt", gui.equ_dialog, LAYER_WIN)
					w.fantxt[shown] = txt
					A.win_grew(w)

					-- ============================================================
					-- THE ENGINE CUTS A LONG NAME, NOT US
					--
					--   "some notes have long names and they are
					--    getting out of the box, so cut the name where
					--    it would go out."
					--
					-- CUILines::Draw does exactly that when this flag
					-- is set: GetElipsisText walks the string a
					-- character at a time against the control's width
					-- and ends it in "..". It is off by default and
					-- there is no xml attribute for it, so it is set
					-- once, here, on the window that was just made.
					--
					-- MEASURING IT OURSELVES would mean guessing an
					-- average character width for a proportional font
					-- at every resolution the game runs at, and being
					-- wrong twice. The engine measures the real glyphs
					-- and converts the screen pixels back into the
					-- same client units our width is written in.
					-- ============================================================
					A.wcut(txt, true)
				end

				if txt then
					local nm = A.tip_name(it.sec)
					local many = A.pile_show(it)
					if many > 1 then nm = nm .. "  x" .. tostring(many) end

					-- WITH ITS SHEET, when that sheet is standing
					-- proud. The WIDTH does not change with it, so the
					-- name is cut at the same character hovered or
					-- not - a label that grew a word back on hover
					-- would be a second animation nobody asked for.
					local jut = (fanover == it.r) and FAN_JUT or 0

					A.wpos(txt, bx + FAN_TEXT - jut, by)
					A.wsize(txt, cw - FAN_TEXT * 2, FAN_PITCH)
					A.wtext(txt, nm)
					A.wcolor(txt, 255, FAN_INK[1], FAN_INK[2], FAN_INK[3])
					A.wshow(txt, true)
				end

				local cnt = w.cnt[shown]
				if cnt then A.wshow(cnt, false) end

			elseif pcall(A.set_icon, ico, it.sec) then
				local iw = it.w * cw + (it.w - 1) * gl
				local ih = it.h * ch + (it.h - 1) * gl

				if it.rot then
					-- TURNED. The engine rotates the quad about its
					-- own centre and applies the aspect correction
					-- INSIDE the turn (rotate_pt multiplies x by kx
					-- after the trigonometry, and kx is this ratio).
					-- So a quad that must cover iw x ih once turned is
					-- sized (ih, iw/ratio) and parked with its centre
					-- on the footprint's centre. See A.wturn.
					A.wpos(ico, bx + (iw - ih) / 2,
					       by + (ih - iw / ratio) / 2)
					A.wsize(ico, ih, iw / ratio)
					A.wturn(ico, true)
				else
					A.wpos(ico, bx, by)
					A.wsize(ico, iw, ih)
					A.wturn(ico, false)
				end
				A.wtint(ico, 255, 255, 255, 255)
				A.wshow(ico, true)
			else
				A.wshow(ico, false)
			end

			-- HOW MANY, in the bottom right, and only when there is more
			-- than one. A stack of one is an item, and writing "x1" on
			-- every square of a full box is noise on top of the picture
			-- that already says what is there.
			--
			-- Made on demand and pooled with everything else in the
			-- window: a box that never stacks anything never makes one,
			-- and in a retained UI a window that exists is walked every
			-- frame whether it is shown or not.
			-- THE NUMBER THE INVENTORY WOULD WRITE - rounds, uses, or
			-- things - rather than how many records the pile holds:
			--
			--   "if i put 2 medkits that both have 3 uses, in inventory
			--    it shows 6 on the stack but in the meds box it shows 2"
			local many = not fan and A.pile_show(it) or 0

			-- THE SAME PLATE THE INVENTORY USES, in the same corner.
			-- See the note in A.med_draw: it is a CUIStatic, so it is
			-- written with A.wglyph and its colour comes from the node.
			local cnt = w.cnt[shown]
			if not cnt and many > 1 then
				cnt = A.mkstatic(xml, "amp:wincnt", gui.equ_dialog, LAYER_WIN)
				w.cnt[shown] = cnt
			end

			if cnt then
				A.wpos(cnt, bx, by)
				A.wsize(cnt, CNT_W * ratio, CNT_H)
				A.wglyph(cnt, many > 1 and ("x" .. tostring(many)) or "")
				A.wshow(cnt, many > 1)
			end
		end
	end

	for i = shown + 1, #w.ico do A.wshow(w.ico[i], false) end
	for i = shown + 1, #w.fantxt do A.wshow(w.fantxt[i], false) end

	-- AND THE SAME HERE, for the same reason: a box that had a stack on
	-- square four and now has a single thing there leaves w.cnt[4]
	-- behind, and counting up to it from a pool with a gap in front of
	-- it never reaches it. See A.win_hide.
	for i, c in pairs(w.cnt) do
		if i > shown then A.wshow(c, false) end
	end

	w.lay = lay
end

-- ============================================================
-- THE DRAW
--
-- At inventory cell size - this one IS for handling things, unlike the
-- hint in the tooltip - and drawn from the same table the tooltip
-- reads, so the two can never disagree about what is in there.
-- ============================================================
local function win_draw_one(k, xml, gui, fr)
	local w = A.wins[k]
	if not w.id then return A.win_hide(k) end

	-- A box is a different thing inside the same window, so it is drawn
	-- by its own function rather than by a rig draw with the pockets
	-- taken out of it.
	if w.kind == "box" then return A.box_draw(k, xml, gui, fr) end

	local obj, sec = A.win_obj(k)
	if not obj then
		A.win_close(k, "it is no longer a rig in your inventory")
		return
	end

	local rows = A.tip_rows(sec, w.id)
	local gs, gl = A.metrics()
	local ratio = utils_xml.screen_ratio()
	if not (ratio and ratio > 0) then ratio = 1 end

	local flat, put, n, wd = {}, {}, 0, 0
	local y = 0

	-- On the square grid, exactly as the panel lays it out: the packer
	-- has already said which square each pocket stands on.
	for r = 1, #rows do
		local rh = 0

		for c = 1, #rows[r] do
			local e = rows[r][c]
			local pw, ph = A.px(e.w, e.h)
			pw = pw * ratio

			local ex = (e.dx or 0) * (gs + gl) * ratio
			local ey = (e.dy or 0) * (gs + gl)

			n = n + 1
			flat[n] = e
			put[n] = { x = ex, y = y + ey, w = pw, h = ph, cls = e }

			if ex + pw > wd then wd = ex + pw end
			if ey + ph > rh then rh = ey + ph end
		end

		y = y + rh + gl
	end

	local h = y - gl
	if n == 0 or wd <= 0 or h <= 0 then
		dbg("open rig: %s laid out to nothing (%s pockets)",
		    tostring(sec), tostring(n))
		return A.win_hide(k)
	end

	-- THE LIST EVERY OTHER READER WILL USE. See A.win_slots: the hit
	-- test, the contents and the drop all index by `i`, and `i` means
	-- what this loop just laid out.
	w.rig = flat
	w.sec = sec
	w.slots = flat

	-- ITS OWN condition, not the worn rig's: this window is a different
	-- rig with a different history, and A.hole belongs to the one on
	-- your chest.
	w.torn = A.torn_at(flat, A.rig_cond(obj))

	-- THE MED ROW IS GONE. It was a 2x2 under the pockets, plus one
	-- more per fitted med pouch. Every slot is a grid now and they are
	-- all in the block above, so a window is exactly as wide as the rig
	-- laid out and no wider.
	local winw = wd + WIN_PAD * 2
	local winh = h + WIN_PAD * 2 + WIN_HEAD

	-- ------------------------------------------------------------
	-- WHERE IT GOES. Cascaded from the middle until it has been moved,
	-- then wherever it was put - and while its header is held, under the
	-- cursor at the offset it was grabbed by.
	--
	-- The cascade is what makes four windows usable without any way to
	-- raise one to the front: they are dealt out down and to the right,
	-- so each one's header and most of its pockets are in the clear.
	--
	-- CLAMPED EVERY FRAME, not only while dragging: a window changes
	-- size with the rig, so a position that was on screen for a small
	-- one can hang a big one off the edge, and a header dragged off the
	-- screen cannot be reached again.
	-- ------------------------------------------------------------
	local ox, oy, px, py = A.win_frame(k, xml, gui, fr, winw, winh, sec)
	if not ox then return A.win_hide(k) end

	local lay = {}
	local top = A.win_hit()
	local over = (top == k) and A.win_at(k) or nil

	-- Across all the slots, not per slot: both pools are flat.
	local gn, icon = 0, 0

	-- ============================================================
	-- WHERE THE THING IN HAND WOULD GO
	--
	-- Worked out BEFORE the pockets are drawn so that the block can be
	-- painted inside the loop, with the pocket it belongs to and ahead
	-- of the icons - which is what keeps it under them rather than over
	-- them. Same shape, same colours and the same three answers as a
	-- box: see A.fit_hover.
	-- ============================================================
	local hi, hr, hc, hw2, hh2, hfits = A.win_hover(k)
	local hn = 0

	-- ============================================================
	-- THREE PASSES, AND THE ORDER OF THEM IS THE WHOLE POINT
	--
	--   "take out an item so the slot is empty, slots to the right of
	--    it lose the item icons ... the icons came back after i click
	--    in the open rig window"
	--
	-- Draw order is CREATION order and cannot be changed afterwards, so
	-- a window whose pools grow at different moments has a stacking
	-- order that depends on the history of what the player did. This
	-- loop used to make a pocket, its seams and then its contents, one
	-- pocket at a time - so emptying a pocket, which needs MORE seams
	-- than a full one, made new seam windows ON TOP of every icon
	-- already in the window. Clicking rebuilt the lot and put them
	-- back, which is exactly the "it comes back if I click" in the
	-- report.
	--
	-- So: every frame first, then the block that shows where the thing
	-- in hand would go, then every icon. And the two pools that can
	-- GROW later are grown to their worst case up front - a pocket's
	-- seams are (cols-1)*rows + (rows-1)*cols however full it is, and
	-- the highlight is always five - so neither can ever be created
	-- into the wrong place afterwards.
	--
	-- Only the icon pool still grows on demand, and an icon made after
	-- another icon is on top of a picture it never overlaps.
	-- ============================================================
	local worst = 0
	for i = 1, n do
		local c, r2 = put[i].cls.w, put[i].cls.h
		worst = worst + (c - 1) * r2 + (r2 - 1) * c
	end
	for q = 1, worst do
		if not w.gr[q] then
			w.gr[q] = A.mkstatic(xml, "amp:winline", gui.equ_dialog, LAYER_WIN)
			A.wshow(w.gr[q], false)
		end
	end
	for q = 1, 5 do
		if not w.hi[q] then
			w.hi[q] = A.mkstatic(xml,
				(q == 1) and "amp:boxarea" or "amp:boxline",
				gui.equ_dialog, LAYER_WIN)
			A.wshow(w.hi[q], false)
		end
	end

	-- ------------------------------------------------------------
	-- PASS ONE: the pockets and the squares they stand on.
	-- ------------------------------------------------------------
	local at = {}

	for i = 1, n do
		local pk = put[i]
		lay[i] = { px + WIN_PAD + pk.x, py + WIN_PAD + WIN_HEAD + pk.y,
		           pk.w, pk.h }

		local box = w.box[i]
		if not box then
			box = A.mkstatic(xml, "amp:winbox", gui.equ_dialog, LAYER_WIN)
			w.box[i] = box
		end

		local bx = ox + WIN_PAD + pk.x
		local by = oy + WIN_PAD + WIN_HEAD + pk.y
		at[i] = { bx, by }

		A.wpos(box, bx, by)
		A.wsize(box, pk.w, pk.h)

		-- THE PANEL'S POCKET, exactly: a thin bright border in the class
		-- colour with a dark interior inside it. Shared through
		-- A.pocket_clr so the same rig cannot read one way on your chest
		-- and another in this window.
		local t = A.win_pk(k, i)
		local bare = (#t == 0)

		local br, bg, bb, fr2, fg, fb, lr, lg, lb = A.pocket_clr(pk.cls,
			(w.torn[i] and "torn")
			or (over == i and "hover")
			or (bare and "empty")
			or "full")

		A.wtint(box, 255, br, bg, bb)
		A.wshow(box, true)

		local inn = w.inn[i]
		if not inn then
			inn = A.mkstatic(xml, "amp:winfill", gui.equ_dialog, LAYER_WIN)
			w.inn[i] = inn
		end

		A.wpos(inn, bx + 1, by + 1)
		A.wsize(inn, pk.w - 2, pk.h - 2)
		A.wtint(inn, 255, fr2, fg, fb)
		A.wshow(inn, true)

		-- AND THE SQUARES IT STANDS ON, exactly as the panel draws them:
		-- always, full or empty. See the note in A.draw_body.
		local split, nsplit = A.pk_split(pk.cls.w, pk.cls.h, pk.w, pk.h, t)
		for q = 1, nsplit do
			gn = gn + 1
			local g = w.gr[gn]
			if not g then
				g = A.mkstatic(xml, "amp:winline", gui.equ_dialog, LAYER_WIN)
				w.gr[gn] = g
			end

			local d = split[q]
			A.wpos(g, bx + d[1], by + d[2])
			A.wsize(g, d[3], d[4])
			A.wtint(g, 255, lr, lg, lb)
			A.wshow(g, true)
		end
	end

	-- ------------------------------------------------------------
	-- PASS TWO: where the thing in hand would go. Over the pockets,
	-- under the icons - which is where a box puts its own.
	-- ------------------------------------------------------------
	if hi and hr and at[hi] then
		local bx, by = at[hi][1], at[hi][2]
		local hx = bx + ((hc - 1) * (gs + gl)) * ratio
		local hy = by + (hr - 1) * (gs + gl)
		local aw, ah = A.px(hw2 or 1, hh2 or 1)
		aw = aw * ratio

		local hk = (hfits == true) and "ok"
		        or (hfits == false) and "no" or "on"
		local hb, hf = HOV_EDGE[hk], HOV_FILL[hk]

		local function hput(x, y, pw2, ph2, cl)
			hn = hn + 1
			local s = w.hi[hn]
			if not s then return end
			A.wpos(s, x, y)
			A.wsize(s, pw2, ph2)
			A.wtint(s, 255, cl[1], cl[2], cl[3])
			A.wshow(s, true)
		end

		hput(hx, hy, aw, ah, hf)
		hput(hx, hy, aw, WIN_EDGE, hb)
		hput(hx, hy + ah - WIN_EDGE, aw, WIN_EDGE, hb)
		hput(hx, hy, WIN_EDGE, ah, hb)
		hput(hx + aw - WIN_EDGE, hy, WIN_EDGE, ah, hb)
	end

	-- ------------------------------------------------------------
	-- PASS THREE: what is standing in the pockets.
	--
	-- Records, not objects - see the note on `wear` and `hold` - so
	-- there is nothing to look up: the entry knows its section, its
	-- square, its size and which way it is lying.
	--
	-- THE ICON POOL IS FLAT, indexed by "the nth thing drawn in this
	-- window". A slot holds several things, so a pool keyed by slot
	-- could not have worked; and a rig holds at most as many things as
	-- it has cells, which is what bounds this.
	-- ------------------------------------------------------------
	for i = 1, n do
		local bx, by = at[i][1], at[i][2]
		local t = A.win_pk(k, i)

		w.cell[i] = w.cell[i] or {}
		local cells = w.cell[i]
		for q = #cells, 1, -1 do cells[q] = nil end

		for e = 1, #t do
			local ent = t[e]
			local ew, eh = A.px(ent.w or 1, ent.h or 1)
			ew = ew * ratio

			local cx = bx + ((ent.c - 1) * (gs + gl)) * ratio
			local cy = by + (ent.r - 1) * (gs + gl)

			cells[e] = { lay[i][1] + ((ent.c - 1) * (gs + gl)) * ratio,
			             lay[i][2] + (ent.r - 1) * (gs + gl), ew, eh }

			-- The one in hand is drawn on the cursor, not in its square.
			local d = A.win_drag
			local dragged = d and d.k == k and d.i == e and d.slot == i

			icon = icon + 1
			local ico = w.ico[icon]
			if not ico then
				ico = A.mkstatic(xml, "amp:winico", gui.equ_dialog, LAYER_WIN)
				w.ico[icon] = ico
			end

			if ico and not dragged and pcall(A.set_icon, ico, ent.sec) then
				if ent.rot then
					local fw, fh = ew - 2, eh - 2
					A.wpos(ico, cx + 1 + (fw - fh) / 2,
					       cy + 1 + (fh - fw / ratio) / 2)
					A.wsize(ico, fh, fw / ratio)
					A.wturn(ico, true)
				else
					A.wpos(ico, cx + 1, cy + 1)
					A.wsize(ico, ew - 2, eh - 2)
					A.wturn(ico, false)
				end
				A.wtint(ico, 255, 255, 255, 255)
				A.wshow(ico, true)
			elseif ico then
				A.wshow(ico, false)
			end

			-- THE NUMBER THE BAG WOULD SHOW, not how many objects are
			-- on the square. A.win_pile_n is the COUNT, which is what
			-- the stacking ceiling is about; this is rounds for
			-- cartridges, uses for medicine and the count for
			-- everything else - what the bag and the boxes both put on
			-- the plate. See A.pk_show.
			local many = A.win_show(ent)
			local cnt = w.cnt[icon]
			if not cnt and many > 1 and not dragged then
				cnt = A.mkstatic(xml, "amp:wincnt", gui.equ_dialog, LAYER_WIN)
				w.cnt[icon] = cnt
			end
			if cnt then
				if many > 1 and not dragged then
					A.wpos(cnt, cx, cy)
					A.wsize(cnt, CNT_W * ratio, CNT_H)
					A.wglyph(cnt, "x" .. tostring(many))
					A.wshow(cnt, true)
				else
					A.wshow(cnt, false)
				end
			end
		end
	end

	for q = hn + 1, #w.hi do A.wshow(w.hi[q], false) end

	for q = icon + 1, #w.ico do A.wshow(w.ico[q], false) end
	-- pairs, not a count: w.cnt only gets an entry where a square holds
	-- more than one thing, so it has HOLES - and `#` on a table whose
	-- first slot is empty is zero, a loop that runs no times and leaves
	-- a number on screen. win_hide has had this note for three releases
	-- and this loop never got it.
	for q, c in pairs(w.cnt) do
		if q > icon then A.wshow(c, false) end
	end

	for i = n + 1, #w.box do A.wshow(w.box[i], false) end
	for i = n + 1, #w.inn do A.wshow(w.inn[i], false) end
	for i, g in pairs(w.gr) do
		if i > gn then A.wshow(g, false) end
	end

	w.lay = lay
end



-- ============================================================
-- WHERE THE CURSOR IS INSIDE AN OPEN RIG
--
-- Three answers off one set of rectangles, and they are deliberately
-- separate calls: a DROP wants the slot, because the packer picks the
-- square; an AIM wants the square, because dropping is aiming; a TAKE
-- wants the pile, because it has to name a thing.
--
-- These used to be three functions about the MED POUCH pockets, which
-- were the only grids a window drew. Every slot is a grid now.
-- ============================================================

-- The aimed square of slot i: row and column in that slot's own grid.
function A.win_pk_rc(k, i)
	local w = A.wins[k]
	local rect = w and w.lay and w.lay[i]
	local sl = A.win_slots(k)[i]
	if not (rect and sl) then return nil end
	return A.rc_in(rect, sl.w, sl.h)
end

-- ...and where the thing in hand would land in this window, which is
-- the panel's question asked of the record half. See A.fit_hover.
function A.win_hover(k)
	local w = A.wins[k]
	if not (w and w.id and w.kind ~= "box") then return nil end
	if A.win_hit() ~= k then return nil end

	local i = A.win_at(k)
	if not i then return nil end

	local sl = A.win_slots(k)[i]
	if not sl then return nil end

	local r, c = A.win_pk_rc(k, i)
	if not r then return nil end

	local it, skip
	local d = A.win_drag
	if d and d.slot then
		local t = A.win_pk(d.k, d.slot)
		it = t and t[d.i]
		skip = (d.k == k and d.slot == i) and d.i or nil
	elseif d and d.box then
		local bw = A.wins[d.k]
		it = bw and bw.id and (A.boxes[bw.id] or {})[d.i]
	elseif A.pk_drag then
		local P = A.pk[A.pk_drag.i]
		it = P and P.slots[A.pk_drag.n]
	else
		it = A.hand_entry()
	end

	if not it then return i, r, c, 1, 1, nil end

	if (w.torn and w.torn[i]) or not A.pk_takes(it.sec) then
		local tw, th = A.turned(it)
		return i, r, c, tw, th, false
	end

	local tr, tc, iw, ih, fits = A.fit_hover(sl.w, sl.h, A.win_pk(k, i),
		A.slot_cap(it.sec), it, r, c, skip)

	return i, tr, tc, iw, ih, fits
end

-- ...and the entry under the cursor, for picking a pile up.
function A.win_pk_at(k, i)
	local w = A.wins[k]
	local cl = w and w.cell and w.cell[i]
	if not cl then return nil end

	for e = 1, #cl do
		if hit(cl[e]) then return e end
	end
	return nil
end

function A.win_draw()
	-- THE CATCH-ALL for the flag above: nothing of ours is in hand, so
	-- whatever the menu still believes, the hand is empty. Cheap - one
	-- table read on a frame where nothing is being dragged - and it
	-- covers every way a drag can end that nobody thought of.
	-- A.win_grab_at counts. A window held by its header is something of
	-- ours in hand even though no item is, and it is the case the pause
	-- exists for.
	if not (A.win_drag or A.pk_drag or A.win_grab_at) then
		if A.let_go() then
			dbg("let go of a drag that was never put down")
		end
		if A.unpause() then
			dbg("took the scroll off pause - nothing of ours was in hand")
		end
	end

	-- ============================================================
	-- ONCE, NOT SIXTY TIMES A SECOND
	--
	-- win_hide_all walks every pool of all four window slots - dozens
	-- of table reads a frame to hide things that were hidden last
	-- frame too, which is most frames of the game. The flag says the
	-- put-away already happened; anything that draws a window clears
	-- it, so the next close is put away exactly once again.
	-- ============================================================
	if not A.win_shown() then
		if not A.wins_down then
			A.win_hide_all()
			A.wins_down = true
		end
		return
	end
	A.wins_down = false

	local xml = A.get_xml()
	local gui = gui_now()
	if not (xml and gui and gui.equ_dialog) then
		-- NOT closed: the inventory is between states, and the windows
		-- come back with it. Said out loud because an open rig that
		-- draws nothing looks like one that never opened.
		dbg("open rig: nothing to draw into yet (xml=%s gui=%s)",
		    tostring(xml ~= nil), tostring(gui ~= nil))
		return A.win_hide_all()
	end

	-- ============================================================
	-- A NEW MENU MEANS NEW WINDOWS
	--
	-- The FOURTH thing in this mod to need this guard, and the only one
	-- that did not have it. The panel checks A.gui, the column checks
	-- A.colbg_gui, the tooltip checks A.tip_owner - and each of those
	-- carries the same comment, because each of them was found the same
	-- way: ui_inventory.GUI is nil'd by actor_on_net_destroy and rebuilt
	-- by the next start(), so the equipment dialog is a different window
	-- afterwards and everything made on the old one is drawn onto
	-- something that is never on screen again.
	--
	-- The symptom is exactly what was reported: the entry works, the log
	-- says the rig opened, and nothing appears.
	--
	-- It is checked HERE rather than in the panel's reset because
	-- draw_body has half a dozen early returns above that reset and
	-- these windows are drawn after all of them - they are on top of the
	-- inventory, not part of it.
	-- ============================================================
	-- ============================================================
	-- COMPARED AS THE MENU, NOT AS THE WINDOW
	--
	-- `A.win_owner ~= gui.equ_dialog` looks right and is a trap: those
	-- are CUIStatic userdata, and comparing two of them raises
	--
	--     No such operator [__eq] defined in class [CUIStatic]
	--
	-- ui_inventory.GUI is a plain Lua table and is replaced at exactly
	-- the same moment the dialog is, so it answers the same question
	-- and can actually be asked. The panel and the column already key
	-- off it; this is the third.
	-- ============================================================
	-- ...AND WHEN THE LAYER UNDERNEATH HAS GROWN. A pocket of the worn
	-- rig getting its first magazine makes that pocket's ammo readout,
	-- and a static made now is drawn over everything made before it -
	-- including these windows. Rebuilding them puts them back on top.
	--
	-- Only when it actually moved: the panel's pools grow to the size of
	-- the biggest rig and then stop, so this settles after a few frames
	-- and costs nothing afterwards.
	local under = A.mk_below(LAYER_WIN)

	if A.win_owner ~= gui or A.win_under ~= under or A.win_regrow then
		-- Put the old ones away before letting go of them. The dialog is
		-- usually gone by now, but "usually" is not a reason to leave a
		-- shown static behind with no way to reach it again.
		local why = (A.win_owner ~= gui) and "a new inventory"
		            or A.win_regrow and "a bigger grid needed more lines"
		            or "something below them was drawn later"

		A.win_hide_all()
		A.win_owner = gui
		A.win_ghost = nil
		A.win_regrow = nil
		for k = 1, WIN_MAX do
			local w = A.wins[k]
			w.edge, w.bg, w.ttl, w.x, w.rule = nil, nil, nil, nil, nil
			w.box, w.inn, w.ico, w.cnt, w.gr = {}, {}, {}, {}, {}
			w.ba, w.bl = {}, {}
			-- ...AND THE DROP BLOCK. Left out, it would be the one pool
			-- that survived a rebuild - made once, before the windows
			-- around it were remade, and therefore underneath them for
			-- the rest of the session.
			w.hi = {}
			-- ...AND THE DOCUMENT CASE'S NAMES. Left out of this list,
			-- they were the one pool that survived a rebuild - so the
			-- sheets were remade on top and every name ended up under
			-- the paper it belonged to. Which is what "item names are
			-- not visible" looked like: a case full of blank paper.
			w.fantxt = {}
			-- ...AND THE MED POCKET'S, which hang off the same dialog
			-- and are drawn onto nothing once it has been replaced.
			w.mbox, w.minn, w.mgr, w.mico = nil, nil, {}, {}
			w.mcnt = {}
			w.mlay, w.mcell = nil, {}
		end
		dbg("open rig: rebuilding the windows - %s", why)
	end

	-- Read AFTER the rebuild, which makes statics of its own: the stamp
	-- has to be the one the windows were actually built at.
	A.win_under = A.mk_below(LAYER_WIN)

	local fr = Frect():set(0, 0, 0, 0)
	gui.equ_dialog:GetAbsoluteRect(fr)

	-- IN SLOT ORDER, which is the stacking order: statics draw in the
	-- order they were made and a slot's are made the first time it is
	-- used, so slot 2 lands on top of slot 1 and stays there.
	for k = 1, WIN_MAX do
		win_draw_one(k, xml, gui, fr)
	end

	-- What is in hand, on the cursor. One ghost for all of them: only
	-- one magazine can be carried at a time - and re-made whenever
	-- anything else was, so it stays on top of every window.
	A.mkghost("win_ghost", xml, "amp:winghost", gui.equ_dialog)

	local d = A.win_drag
	local dw = d and A.wins[d.k]

	-- TWO KINDS OF DRAG, not four. A square out of a rig in a window
	-- names its SLOT and its entry - d.slot and d.i - and a square out
	-- of a box names only its entry. The other two were the med pocket
	-- and the med pouches, and both read stores that no longer exist:
	-- A.mstash, A.pkstash and A.stash. `it` came back nil every time,
	-- so a magazine dragged inside an open rig had no picture on the
	-- cursor at all.
	local it
	if dw and dw.id then
		if d.box then
			it = (A.boxes[dw.id] or {})[d.i]
		elseif d.slot then
			it = (A.win_pk(d.k, d.slot) or {})[d.i]
		end
	end

	if it and type(it.sec) == "string" and pcall(A.set_icon, A.win_ghost, it.sec) then
		local okc, cw, ch = pcall(A.cells, it.sec)
		local ratio = utils_xml.screen_ratio()
		if not (ratio and ratio > 0) then ratio = 1 end

		local cx, cy = cursor()

		-- AS IT WILL LAND. Only a box entry can be turned; its ghost
		-- shows the lie the drop will write - the entry's own, turned
		-- again if the rotate key has been pressed over it. The art is
		-- rotated whenever that lie differs from the section's natural
		-- footprint, whichever of the two turns put it there.
		local ew, eh = cw or 1, ch or 2
		if d.box or d.med then ew, eh = A.turned(it) end

		local pw, ph = A.px(ew, eh)
		pw = pw * ratio

		if ew ~= (cw or 1) and ew ~= eh then
			A.wpos(A.win_ghost, cx - fr.x1 - ph / 2,
			       cy - fr.y1 - pw / (2 * ratio))
			A.wsize(A.win_ghost, ph, pw / ratio)
			A.wturn(A.win_ghost, true)
		else
			A.wpos(A.win_ghost, cx - fr.x1 - pw / 2, cy - fr.y1 - ph / 2)
			A.wsize(A.win_ghost, pw, ph)
			A.wturn(A.win_ghost, false)
		end
		A.wtint(A.win_ghost, 190, 255, 255, 255)
		A.wshow(A.win_ghost, true)
	else
		A.wshow(A.win_ghost, false)
	end
end

function A.draw_body(bag_cc)
	-- ============================================================
	-- THE MENU IS OPEN, AND THIS IS THE PROOF OF IT
	--
	-- This function runs from the bag container's Update, which runs
	-- only while the actor menu is on screen. So "is the menu open" is
	-- not a question to ask the engine - it is something this file has
	-- been observing sixty times a second and throwing away.
	--
	-- FIRST IN THE FUNCTION, above every early return: the panel can be
	-- closed, disabled, or have no rig, and the MENU is still open in
	-- every one of those. See A.menu_open, and the quick-use gate that
	-- reads it.
	-- ============================================================
	A.seen_at = time_global()

	-- THE ROTATE KEY IS WATCHED EVERY MENU FRAME - the drags it turns
	-- live and die between these frames, and the flag must die with
	-- them. See A.rot_poll.
	A.rot_poll()

	-- THE SLOT FIRST, and on its own terms. Everything below this can
	-- return early; the slot must not go with it.
	local g = gui_now()

	-- FIRST, and outside every early-out below: it is the thing
	-- everything else in the column is drawn on top of.
	-- Reset installs the layout for every mode; this catches the one
	-- case it cannot - a menu that was built and shown before this hook
	-- existed. Costs one comparison per frame after the first.
	local drawable = A.enabled and g and bag_cc and bag_cc:IsShown()
		and editing_allowed()

	if drawable then
		local ok, err = pcall(A.draw_slot, g)
		if not ok then log("!rig slot: %s", tostring(err)) end
	else
		A.hide_slot()
	end

	-- ============================================================
	-- AND THE MED POCKET, ON ITS OWN TERMS
	--
	-- Not gated on amp_rig_item: that setting decides whether a rig is
	-- an ITEM you wear, and the med pocket belongs to the rig either
	-- way. A.med_place puts it under the slot when there is one and in
	-- the slot's own corner when there is not.
	--
	-- Outside the panel's draw, because it is on screen whenever the
	-- inventory is rather than only while the pouch panel is open.
	-- ============================================================
	-- THE SLOTS ARE HIDDEN WHEN THERE IS NO RIG. The panel redraws them
	-- when one is on; with none, the panel's own pass does not run, so
	-- this is the only place that reaches them - and A.pk being empty,
	-- A.pk_draw hides every pool.
	if drawable then
		local okm, errm = pcall(function()
			if not A.rig_present() then A.pk_draw() end
		end)
		if not okm then log("!slot contents: %s", tostring(errm)) end
	else
		A.pk_hide()
	end

	-- The backpack slot stands IN the grid, so it is drawn on exactly
	-- the terms the rig block is: only while the list it is measured
	-- from is the thing on screen. Not gated on rig_item - it has
	-- nothing to do with rigs, and turning them off must not take the
	-- backpack away with them.
	if A.enabled and g and bag_cc and bag_cc:IsShown() and editing_allowed() then
		local okb, errb = pcall(A.draw_pack, g)
		if not okb then log("!backpack slot: %s", tostring(errb)) end

		-- ...and the device slots hang off it, on the same terms.
		local okw, errw = pcall(A.wd_draw, g)
		if not okw then log("!device slots: %s", tostring(errw)) end
	else
		A.hide_pack()
		A.wd_hide()
	end

	-- ============================================================
	-- DOCKED IN THE COLUMN
	--
	-- With a column to live in the panel stops being a window. It is
	-- the top of that column, always open, with the magazine list
	-- underneath - so there is nothing to open, nothing to close, and
	-- no way to lose it behind the inventory. The close and pin boxes
	-- go with the window they belonged to, further down.
	-- ============================================================
	-- ALWAYS OPEN WHEN IT IS DOCKED, and anchored to the bag column is
	-- docked: the pockets are part of the inventory, not a window you
	-- have to find. Same rule the middle column had, which is what
	-- "mag slots should be always visible like it was in the 3rd
	-- collumn version" asks for.
	if A.bag_docked() then A.open = true end

	if not (A.enabled and A.open) then return A.hide() end
	if not editing_allowed() then return A.hide() end

	-- No rig, no panel. Taking the chest rig off while the panel is
	-- open has to put the panel away too, or it sits there with nothing
	-- in it and no pockets to close it against.
	--
	-- RESOLVE BEFORE BAILING. The draw pass is where the rig is worked
	-- out and where validate hands back what it can no longer hold, so
	-- returning early left every magazine the rig was carrying still
	-- carried, with no pocket anywhere to be in - a loadout full of
	-- magazines the panel could not show and the player could not
	-- reach. resolve_rig early-outs on an unchanged key, so this costs
	-- nothing on the frames after the first.
	if not A.rig_present() then
		A.open = false
		local ok, err = pcall(A.resolve_rig)
		if not ok then log("!resolve on rig removal: %s", tostring(err)) end
		return A.hide()
	end

	local gui = gui_now()
	if not (gui and bag_cc and bag_cc:IsShown()) then return A.hide() end

	-- ui_inventory.GUI is nil'd by actor_on_net_destroy and rebuilt by
	-- the next start(), so a level change hands back a different
	-- equ_dialog and everything created here hangs off the old one.
	-- Keeping them would leave the rig parented to a dialog that is
	-- never drawn again: it would simply stop appearing, with nothing in
	-- the log, and only after a level change.
	if A.gui ~= gui then
		A.gui = gui
		A.cc, A.frame, A.title, A.close_st = nil, nil, nil, nil
		A.pin_st = nil
		A.cellsz, A.cellsig, A.cellhl, A.rounds = {}, {}, {}, {}
		A.icosz = {}
		A.pk_out, A.pk_in, A.pk_gr = nil, nil, nil
		A.ps_out, A.ps_in, A.ps_ico = nil, nil, nil
		A.ov_ammo, A.ov_cnt, A.ov_bar = nil, nil, nil
		A.ghost, A.ghost_sec = nil, nil
		A.hid_from, A.hid_ov = nil, nil
		A.rect, A.lay, A.close_r, A.pin_r = nil, nil, nil, nil

		-- A new container may sit differently: re-measure from scratch.
		A.fix = {}
	end

	-- Everything from here down puts the panel on screen, so A.hide has
	-- work to do again.
	A.shown = true

	-- ============================================================
	-- THE BACKGROUND AND THE POCKETS MUST EXIST BEFORE THE CONTAINER
	--
	-- Draw order is ATTACH order among siblings. The backdrop, the
	-- pocket frames and the cell container all hang off equ_dialog, so
	-- whichever is created last is painted on top.
	--
	-- 0.1.0 built the container first and the backdrop second, and a
	-- 67%-opaque near-black rectangle went over every magazine icon. It
	-- read exactly as the icons being dimmed, which is how it was
	-- reported. The pocket frames would do the same, so the whole pool
	-- is created here, before the cells that sit inside them.
	-- ============================================================
	-- ============================================================
	-- WHY THE POCKET POOL IS STILL MAX_SLOTS DEEP
	--
	-- This engine's UI is RETAINED: every rectangle is a CUIWindow the
	-- engine walks and draws each frame, so the cost is proportional to
	-- how many windows EXIST. Sizing this pool to the rig instead of to
	-- MAX_SLOTS looks like an easy saving, and it was tried.
	--
	-- It is wrong. Draw order is ATTACH order, so a pocket created after
	-- the cell container paints ON TOP of the magazines - the 0.1.0 bug.
	-- Growing the pool therefore means rebuilding the whole panel, and
	-- nothing in the Lua bindings can DESTROY the windows that were
	-- built before: dropping the reference leaves them parented to
	-- equ_dialog, hidden, and still walked. Rebuilding once per larger
	-- armour leaks more windows over a session than the fixed pool costs
	-- in the first place.
	--
	-- So the saving is taken where it does not need re-attachment: cells
	-- and overlays live inside or after the container, and are built only
	-- for pockets that actually hold a magazine.
	-- ============================================================
	if not A.frame then
		local xml = A.get_xml()
		A.frame = A.mkstatic(xml, "amp:bg", gui.equ_dialog)
		A.pk_out, A.pk_in, A.pk_gr = {}, {}, {}

		-- The two pouch slots: a frame, an inner fill, and an icon that
		-- only shows when something is fitted. Three statics each, made
		-- once, exactly like the pockets.
		-- ============================================================
		-- THE MED POCKET'S OWN WINDOWS
		--
		-- A border, an inside, two hairlines dividing it into four
		-- squares, and then four icons with four numbers over them -
		-- four being the most a 2x2 grid can hold, so the pool can
		-- never be too small and never has to grow.
		--
		-- MADE HERE, WITH THE POCKET FRAMES AND BEFORE THE CELL
		-- CONTAINER. Draw order is attach order and cannot be changed
		-- afterwards. This block does not overlap the magazine icons,
		-- so the order does not matter today - and it is kept anyway,
		-- because the day somebody moves this pocket is the day it
		-- would matter and nobody would think to look here.
		--
		-- The numbers are made AFTER the icons, which is the whole of
		-- what puts them on top of their own picture.
		-- ============================================================
		A.ps_out, A.ps_in, A.ps_ico = {}, {}, {}
		for i = 1, PSLOTS do
			A.ps_out[i] = A.mkstatic(xml, "amp:pouch", gui.equ_dialog)
			A.ps_in[i]  = A.mkstatic(xml, "amp:pouch", gui.equ_dialog)
			A.ps_ico[i] = A.mkstatic(xml, "amp:pouch", gui.equ_dialog)
			A.wshow(A.ps_out[i], false)
			A.wshow(A.ps_in[i], false)
			A.wshow(A.ps_ico[i], false)
		end

		for i = 1, MAX_SLOTS do
			A.pk_out[i] = A.mkstatic(xml, "amp:slot", gui.equ_dialog)
			A.pk_in[i]  = A.mkstatic(xml, "amp:slot", gui.equ_dialog)

			-- Through the guard even here, where the memo is empty and a
			-- raw call would be harmless. The rule is worth more than the
			-- two calls: EVERY write goes through it, so the memo and the
			-- screen can never be telling different stories.
			A.wshow(A.pk_out[i], false)
			A.wshow(A.pk_in[i], false)
		end

		-- ============================================================
		-- WHERE THE THING IN HAND WOULD GO: FIVE WINDOWS, MADE HERE
		--
		-- A fill and four edges - the boxes' shape exactly, because the
		-- player asked for the boxes' shape. Only ever one pocket is
		-- under the cursor, so one set does for the whole panel.
		--
		-- MADE WITH THE POCKET FRAMES, BEFORE THE CELL CONTAINER, and
		-- for the reason the whole block above is here: a coloured slab
		-- created afterwards is drawn OVER the magazine icons, and a
		-- highlight over a picture is not a highlight, it is a hole.
		-- The boxes made the same decision in the same words.
		-- ============================================================
		A.pk_hi = { A.mkstatic(xml, "amp:boxarea", gui.equ_dialog) }
		for q = 2, 5 do
			A.pk_hi[q] = A.mkstatic(xml, "amp:boxline", gui.equ_dialog)
		end
		for q = 1, 5 do A.wshow(A.pk_hi[q], false) end

		-- ============================================================
		-- WHERE THE DIVISIONS WILL BE BUILT, WHEN ONE IS FIRST NEEDED
		--
		-- Not built here. Two per pocket up front is sixty-four windows
		-- the engine walks every frame for a decoration, and this panel
		-- is budgeted at a hundred and three for everything - "a rig
		-- holding four magazines must not carry the scaffolding for
		-- twelve".
		--
		-- They are made on demand instead. That used to be safe only
		-- because a division was drawn on an EMPTY pocket, where there
		-- is no icon for a later static to be drawn over; they are
		-- drawn on every pocket now, and it is safe for a better
		-- reason - A.pk_split puts each line in the GAP between two
		-- squares and an icon is inset inside its own square, so the
		-- line and the picture never share a pixel whichever was made
		-- first. See the draw.
		--
		-- The dialog is written down because this is the only place the
		-- panel has one in hand.
		-- ============================================================
		A.pk_parent = gui.equ_dialog
	end

	if not A.cc then
		A.cc = A.build()
		if not A.cc then
			A.enabled = false
			return
		end
	end

	A.prune()

	-- Cheap: it early-outs unless the armour or its kind changed.
	A.resolve_rig()

	-- Not cheap enough to want per frame, and this IS per frame: the
	-- panel's draw runs for as long as the inventory is open. It was
	-- throttled once, in 2.25.0, and put back the same afternoon - a
	-- magazine the reload had just put in the loadout has to get a
	-- pocket on the frame it arrives, and t7 says so in three checks.
	-- What it costs is one engine lookup per magazine in the rig; what
	-- the throttle bought was those lookups and a stale pocket.
	A.reconcile()

	local cc = A.cc
	local gs, gl = A.metrics()
	local ratio = utils_xml.screen_ratio()

	-- One pocket, in pixels. EVERY pocket is this size - that is the
	-- whole point of 0.2.0.
	-- ============================================================
	-- ROWS OF POCKETS, MEASURED FROM THE ROWS THEMSELVES
	--
	-- Rows may hold different classes and therefore different sizes, so
	-- nothing here assumes a uniform grid: each row is as tall as its
	-- tallest pocket, and the panel is as wide as its widest row. The
	-- box is derived from what is IN it, which is the rule that stopped
	-- the backdrop coming up short of the content in 0.1.1.
	-- ============================================================

	-- ============================================================
	-- TWO BLOCKS: THE RIG, AND WHAT IS BOLTED ONTO IT
	--
	-- A pouch's pockets used to be more rows under the rig's own, so
	-- fitting one made the panel taller and pushed the magazine list
	-- down the column. They are laid out separately now: the rig keeps
	-- the left of the panel, the two pouch slots go against the right
	-- border under the rig's picture, and the pockets a pouch grants
	-- are drawn immediately to the LEFT of the slots, in the space that
	-- was empty.
	--
	-- Same walk for both, so a pouch's rows are measured, centred and
	-- gapped exactly like the rig's.
	-- ============================================================
	local function build_lines(want_pouch)
	local lines, rw, rh = {}, 0, 0
	local y = 0

	for r = 1, #A.rows do
		local row = A.rows[r]
		local items, wide, tall = {}, 0, 0

		if (row.pouch and true or false) == want_pouch then
			-- ============================================================
			-- ON THE SQUARE GRID, NOT END TO END
			--
			-- A band used to be laid out by adding widths up as it went,
			-- with a fixed gap between pockets - which was right when a
			-- band was one row of same-sized pockets and nothing was ever
			-- stacked inside it.
			--
			-- The packer answers in SQUARES now, so a pocket is placed at
			-- its own square and every edge in the band lines up with
			-- every other. That is the difference between a row of boxes
			-- and something that looks like a rig. The space between two
			-- pockets is the grid's own line, so a seam inside a pocket
			-- and a seam between two of them are the same width - which
			-- is what makes a band read as one grid.
			-- ============================================================
			for c = 1, #row do
				local e = row[c]
				local cw, ch = A.px(e.w, e.h)
				local ex = (e.dx or 0) * (gs + gl)
				local ey = (e.dy or 0) * (gs + gl)

				items[#items + 1] = { x = ex, y = ey, w = cw, h = ch, cls = e }

				if ex + cw > wide then wide = ex + cw end
				if ey + ch > tall then tall = ey + ch end
			end
		end

		if #items > 0 then
			lines[#lines + 1] = { items = items, w = wide, y = y, tall = tall,
			                      align = row.align }
			if wide > rw then rw = wide end
			y = y + tall + GAP
		end
	end

	rh = (y > 0) and (y - GAP) or 0
	return lines, rw, rh
	end

	-- ============================================================
	-- THE SHAPE IS WORKED OUT WHEN IT CHANGES, NOT WHEN IT IS DRAWN
	--
	-- Everything from here down to `pslot` is arithmetic on A.rows and
	-- the grid metrics, and it came out the same on every frame the
	-- inventory was open - a few dozen tables and two closures a frame
	-- for an answer that changes when you fit a pouch.
	--
	-- THE KEY IS A.rows ITSELF, by identity. A.resolve_rig builds a new
	-- rows table every time it rebuilds and keeps the old one when it
	-- does not, so "is this the same table" IS "is this the same shape"
	-- - exactly, and for one comparison.
	--
	-- IT IS NOT A.rig_key, which was the first attempt and is the wrong
	-- question by a hair: rig_key is what resolve_rig uses to decide
	-- whether to rebuild, so anything that rebuilds the rows without
	-- going through that decision leaves the key equal and the rows
	-- new. A cache keyed on the ANSWER cannot be wrong about the
	-- answer; one keyed on somebody else's reason to recompute it can.
	--
	-- The metrics are in the key too: they come off the equipment
	-- container and a UI pack can change them.
	--
	-- NOT THE ORIGIN, AND NOT THE RATIO. Those move when the list
	-- scrolls and when the window resizes, and everything that depends
	-- on them - `lay`, `play`, `A.rect` - is worked out below, every
	-- frame, from this.
	-- ============================================================
	-- CELLS BECOME PIXELS HERE AND NOWHERE ELSE. A pouch slot is one
	-- grid cell square; reading a cell count as a pixel size drew both
	-- of them one pixel wide, which the hit test agreed with perfectly
	-- and no player could ever click.
	local psw, psh = A.px(1, 1)

	local geo, pslot, inner, rh

	if A.geo and A.geo_rows == A.rows and A.geo_gs == gs and A.geo_gl == gl
	then
		geo, pslot, inner, rh = A.geo, A.geo_ps, A.geo_inner, A.geo_rh
	else

	local lines, rw, prh0 = build_lines(false)
	local plines, prw, prh = build_lines(true)
	rh = prh0

	-- ============================================================
	-- CENTRED, BECAUSE A CHEST RIG IS SYMMETRICAL
	--
	-- Left-aligned rows of different lengths read as a table with a
	-- ragged right edge. Centred, the same pockets read as a rig. This
	-- is the whole difference between "eight slots" and "something you
	-- strap on", and it costs one offset per row.
	-- ============================================================
	local slot_h = PSLOTS * psh + (PSLOTS - 1) * GAP

	inner = rw + GAP * 2 + (prw > 0 and (prw + GAP * 2) or 0) + psw

	-- ============================================================
	-- SIDE BY SIDE, OR STACKED
	--
	-- `stacked` was `need > inner` where the two were the same
	-- expression written twice, so it was FALSE for ever and the three
	-- branches below it had been dead since the day the second one was
	-- typed. The panel has no width to be too narrow FOR - it is as
	-- wide as it needs to be, which is what `inner` says - so the
	-- honest answer is the constant, and the branches go with it.
	-- ============================================================
	local stacked = false

	geo, pslot = {}, {}
	local main_right, pouch_right, slot_x, slot_y

	if stacked then
		-- No room side by side: the old shape, which is tall but never
		-- draws two things in one place.
		main_right = inner
		pouch_right = inner
		slot_x, slot_y = 0, 0
	else
		slot_x = inner - psw
		pouch_right = slot_x - GAP * 2
		main_right = (prw > 0) and (pouch_right - prw - GAP * 2) or pouch_right
		slot_y = 0
	end

	local function place(ls, right, y_off, centred)
		for r = 1, #ls do
			local L = ls[r]

			local off = centred and ((right - L.w) / 2) or (right - L.w)
			if L.align == "<" then off = 0
			elseif L.align == ">" then off = right - L.w end
			if off < 0 then off = 0 end

			for i = 1, #L.items do
				local it = L.items[i]
				geo[#geo + 1] = { x = it.x + off, y = L.y + it.y + y_off,
				                  w = it.w, h = it.h, cls = it.cls }
			end
		end
	end

	-- ORDER MATTERS: geo[i] is pocket i, and the rig's rows come before
	-- the pouch's in A.rows. Laying them out in that order is what keeps
	-- a magazine in the pocket it was put in.
	place(lines, main_right, 0, true)

	if stacked then
		place(plines, pouch_right, rh + GAP * 2, true)
		slot_y = rh + (prh > 0 and (prh + GAP * 2) or 0) + GAP * 3
		rh = slot_y + psh
	else
		place(plines, pouch_right, 0, false)
		rh = math.max(rh, prh, slot_h)
	end

	for i = 1, PSLOTS do
		pslot[i] = { x = stacked and ((i - 1) * (psw + GAP)) or slot_x,
		             y = stacked and slot_y or ((i - 1) * (psh + GAP)) }
	end

	if rh < 0 then rh = 0 end

	A.geo, A.geo_ps, A.geo_inner, A.geo_rh = geo, pslot, inner, rh
	A.geo_rows, A.geo_gs, A.geo_gl = A.rows, gs, gl
	end

	-- THE MED POCKET IS NOT IN HERE ANY MORE.
	--
	--   "move the slot directly under the rig slot so it does not flow
	--    under magazine slots and expand the inventory for no reaseon."
	--
	-- Quite right, and the cost was worse than it looked: rh is the
	-- panel's height, and Zone Grid measures that height to work out
	-- how many rows of the backpack the rig block stands on. A row at
	-- the bottom pushed the whole inventory down by two cells for
	-- everybody, empty or not. It is drawn under the rig slot now -
	-- see A.draw_slot - which is outside the panel entirely.

	local w = PAD * 2 + math.max(inner, 1)
	local h = PAD * 2 + title_h() + math.max(rh, 1)

	local wpx = w * ratio
	local ax, ay = A.origin(wpx, h)

	-- FOUR NUMBERS, OVERWRITTEN. A.rect is read by the hit tests and by
	-- the column, and it is the same table from one frame to the next -
	-- so the only thing that has to change is what is in it.
	local rect = A.rect
	if rect then rect[1], rect[2], rect[3], rect[4] = ax, ay, wpx, h
	else A.rect = { ax, ay, wpx, h } end

	local fr = Frect():set(0, 0, 0, 0)
	gui.equ_dialog:GetAbsoluteRect(fr)
	A.org[1], A.org[2] = fr.x1, fr.y1

	local lx, ly = ax - A.org[1], ay - A.org[2]

	-- THE ONE PLACE A POCKET RECTANGLE IS COMPUTED. Absolute cursor
	-- space, x compressed by ratio, y untouched. Every draw call and
	-- every hit test below reads these and nothing else.
	-- ...AND THE SAME FOR THE POCKETS. One table per pocket per frame,
	-- for four numbers that mostly do not move: the list is kept and
	-- written through, and trimmed only when the rig actually has fewer
	-- pockets than it did.
	local lay = A.laybuf
	if not lay then
		lay = {}
		A.laybuf = lay
	end

	local th = title_h()
	local n = #geo
	for i = 1, n do
		local g = geo[i]
		local x = ax + (PAD + g.x) * ratio
		local y = ay + PAD + th + g.y
		local r = lay[i]
		if r then r[1], r[2], r[3], r[4] = x, y, g.w * ratio, g.h
		else lay[i] = { x, y, g.w * ratio, g.h } end
	end
	for i = #lay, n + 1, -1 do lay[i] = nil end

	A.lay = lay

	-- Same space as the pockets: absolute, x compressed by ratio.
	local play = A.playbuf
	if not play then
		play = {}
		A.playbuf = play
	end

	for i = 1, PSLOTS do
		local px2 = ax + (PAD + pslot[i].x) * ratio
		local py2 = ay + PAD + th + pslot[i].y
		local r = play[i]
		if r then
			r[1], r[2], r[3], r[4] = px2, py2, psw * ratio, psh
		else
		play[i] = {
			px2,
			py2,
			psw * ratio,
			psh,
		}
		end
	end
	A.play = play

	-- ============================================================
	-- ONE RECTANGLE, TWO READERS
	--
	-- A.lay[i] is where slot i is drawn; A.pk_lay is the same table
	-- under the name the contents pass reads. They used to be two
	-- different things - the pockets and the med pocket - laid out in
	-- two different places from two different measurements, and the
	-- med pocket drifting away from the pockets beside it was the
	-- shape of half the layout bugs.
	--
	-- Aliased rather than copied so they cannot come apart at all.
	-- ============================================================
	A.pk_lay = lay
	pcall(A.pk_draw)

	-- ============================================================
	-- THE POCKETS' SCROLL BAR, HIDDEN RAW AND EVERY FRAME
	--
	-- NOT through A.wshow. The guarded setters remember what they wrote
	-- and skip a write that would change nothing, which is right for a
	-- window this mod owns and wrong for one the BASE CLASS also
	-- writes: anything calling Scroll_Pad_Ctrl(true) on every container
	-- shows this pad from outside, the memo still says "already
	-- hidden", and the bar stays on screen for good. That is exactly
	-- the case place_layer's old exemption existed for.
	--
	-- One engine call a frame, on a window that must not appear.
	-- ============================================================
	if A.cc and A.cc.pad then A.cc.pad:Show(false) end

	A.wpos(A.frame, lx, ly)
	A.wsize(A.frame, wpx, h)
	A.wtint(A.frame, 210, 10, 10, 12)

	-- The panel's own backdrop, drawn everywhere EXCEPT the column and
	-- the inventory: in the column the background picture is already
	-- behind it, and in the inventory the pockets ARE part of the
	-- inventory - a dark slab behind them made them look like a window
	-- laid on top of the grid, which is what it stopped being.
	A.wshow(A.frame, not A.bag_docked())

	-- Each pocket is its own box: a light border rectangle with a darker
	-- one inset inside it. Two statics rather than a frame texture,
	-- because a frame needs corner art declared in textures_descr and
	-- this has to work with nothing but ui_inGame2_white_rect.
	local hovered = A.slot_at()
	A.focus_follow(hovered)

	-- Never past the pool: on the one frame after the rig grows, the
	-- pool is still the old size and is rebuilt at the top of the next
	-- draw. Drawing fewer pockets for a frame is fine; indexing a pocket
	-- that does not exist is not.
	-- Across all the pockets: a pocket needs none, one or two divisions
	-- depending on its shape, so the pool cannot be keyed by pocket.
	local gn = 0

	for i = 1, #A.rig do
		local r = lay[i]
		local ox, oy = r[1] - A.org[1], r[2] - A.org[2]

		local out, inn = A.pk_out[i], A.pk_in[i]

		-- ============================================================
		-- THE FRAME IS THE CELL. NO INSET.
		--
		-- Drawing a small pocket's frame inside its cell made it look
		-- smaller, and made three other things wrong: the magazine icon
		-- is sized from the CELL, so it hung over the frame on every
		-- side; the ammo readout is placed from the cell, so it sat
		-- outside the pouch entirely; and the inset was a fraction of a
		-- pixel on the x axis, which cost the frame a border line.
		--
		-- All three were reported at once, and they are one decision.
		-- The class is a tint - that is what the tint is FOR - and the
		-- frame is exactly the cell it belongs to.
		-- ============================================================
		local cut = A.wclip(out, ox, oy, r[3], r[4])
		-- ============================================================
		-- THE CLASS IS A COLOUR, NOT A SIZE
		--
		-- Every magazine in GAMMA is one cell by two, so a small pocket
		-- and a medium one are the same box, and a row of smalls read as
		-- more rifle capacity than it was. Growing the bigger classes
		-- fixed that and broke something worse: three pocket sizes meant
		-- nothing lined up with anything, and beside a real chest rig -
		-- a strict grid, every edge shared - ours had ragged rows with
		-- daylight between them.
		--
		-- So the grid is absolute and the class is a tint. A small pouch
		-- is cool and dim, a rifle pouch is the plain one, a drum pouch
		-- is warm and bright. The ladder is still there; it just no
		-- longer costs the alignment.
		-- ============================================================
		-- A.pocket_clr is the palette, shared with the open-rig window
		-- and the tooltip so one rig cannot read three ways. The panel
		-- draws every pocket at full strength: what is IN them is drawn
		-- over the top, so it needs no dimming to tell them apart.
		local cls = A.rig[i]
		local br, bg, bb, fr, fg, fb, lr, lg, lb = A.pocket_clr(cls,
			(A.is_torn(i) and "torn")
			or (hovered == i and "hover")
			or "full")

		if cut then
			A.wtint(out, 255, br, bg, bb)
			A.wshow(out, true)
		end

		if A.wclip(inn, ox + 1, oy + 1, r[3] - 2, r[4] - 2) then
			A.wtint(inn, 255, fr, fg, fb)
			A.wshow(inn, true)
		end

		-- ============================================================
		-- THE SQUARES A POCKET IS STANDING ON, FULL OR EMPTY
		--
		--   "disable that when item is in slot the lines that seperate
		--    the cells disappear, let them be there"
		--
		-- They used to be drawn on an empty pocket only, on the reasoning
		-- that an icon says everything about the squares it covers - and
		-- on a worry that a line made after the icons would be a hairline
		-- across a magazine.
		--
		-- The first is wrong about the squares NEXT to the icon: a 2x2
		-- with one magazine standing in it is the exact moment a player
		-- needs to see that the free half is one square wide and two
		-- tall. And the second cannot happen: A.pk_split puts each
		-- division in the GAP between two squares, where the boxes put
		-- their seams, and an icon is inset inside its own square. The
		-- line and the picture never share a pixel.
		-- ============================================================
		-- Through A.wclip like everything else in this loop: the panel
		-- lives inside a scrolling list and is cut off at its edges, and
		-- a line that ignored that would be drawn across whatever is
		-- above or below the block.
		local split, nsplit = A.pk_split(cls.w, cls.h, r[3], r[4],
			A.pk[i] and A.pk[i].slots)

		for q = 1, nsplit do
			gn = gn + 1

			local g = A.pk_gr[gn]
			if not g and A.pk_parent then
				g = A.mkstatic(A.get_xml(), "amp:slotline", A.pk_parent)
				A.pk_gr[gn] = g
			end

			if g then
				local d = split[q]
				if A.wclip(g, ox + d[1], oy + d[2], d[3], d[4]) then
					A.wtint(g, 255, lr, lg, lb)
					A.wshow(g, true)
				end
			end
		end
	end

	-- The tail of the divisions pool. NOT keyed off #A.rig like the
	-- pockets are - a rig of four smalls uses four of these and a rig of
	-- four drums uses eight, so the only number that says where the tail
	-- begins is the one this pass just counted.
	for i, g in pairs(A.pk_gr) do
		if i > gn then A.wshow(g, false) end
	end

	-- ============================================================
	-- AND WHERE THE THING IN HAND WOULD GO
	--
	-- Over the squares it would cover, in the footprint it would cover
	-- them in - so the rotation is visible before the button comes up,
	-- which is half of what was asked for. Green it lands here, red it
	-- does not go in, and the plain grey for "it goes in, but the
	-- packer will choose where".
	-- ============================================================
	if A.pk_hi then
		local hi, hr, hc, hw, hh, fits = A.pk_hover()
		local shown = false

		if hi and hr and A.lay[hi] then
			local q = A.lay[hi]
			local hx = q[1] - A.org[1] + ((hc - 1) * (gs + gl)) * ratio
			local hy = q[2] - A.org[2] + (hr - 1) * (gs + gl)
			local hiw, hih = A.px(hw or 1, hh or 1)
			hiw = hiw * ratio

			local k = (fits == true) and "ok"
			       or (fits == false) and "no" or "on"
			local hb, hf = HOV_EDGE[k], HOV_FILL[k]

			local function paint(n, x, y, w2, h2, cl)
				local s = A.pk_hi[n]
				if s and A.wclip(s, x, y, w2, h2) then
					A.wtint(s, 255, cl[1], cl[2], cl[3])
					A.wshow(s, true)
				elseif s then
					A.wshow(s, false)
				end
			end

			paint(1, hx, hy, hiw, hih, hf)
			paint(2, hx, hy, hiw, WIN_EDGE, hb)
			paint(3, hx, hy + hih - WIN_EDGE, hiw, WIN_EDGE, hb)
			paint(4, hx, hy, WIN_EDGE, hih, hb)
			paint(5, hx + hiw - WIN_EDGE, hy, WIN_EDGE, hih, hb)
			shown = true
		end

		if not shown then
			for q = 1, 5 do A.wshow(A.pk_hi[q], false) end
		end
	end

	-- Only when the tail has MOVED. The pool is MAX_SLOTS deep and a
	-- typical rig uses half of it, so re-hiding the unused half every
	-- frame was most of the Show traffic for no change at all.
	-- ============================================================
	-- THE POUCH SLOTS. Dimmer than a pocket when empty, and lit with
	-- the fitted pouch's own inventory icon when full, so what is
	-- bolted on is readable at a glance rather than only in the counts.
	-- ============================================================
	local p_hover = A.pouch_at()
	for i = 1, PSLOTS do
		local r = play[i]
		local ox, oy = r[1] - A.org[1], r[2] - A.org[2]
		local sec = A.pouch_in(i)

		-- A SLOT THE RIG IS TOO WORN TO HOLD UP is drawn in the same
		-- dark red a torn pocket is, because it is the same fact about
		-- the same rig - and whatever is fitted to it stays fitted and
		-- stays visible, dimmed, so it is obvious that mending the rig
		-- gives it back rather than that something was taken away.
		local dead = not A.slot_live(i)

		local pcut = A.wclip(A.ps_out[i], ox, oy, r[3], r[4])
		if pcut then
			if p_hover == i then
				A.wtint(A.ps_out[i], 255, 170, 170, 180)
			elseif dead then
				A.wtint(A.ps_out[i], 255, 96, 40, 40)
			elseif sec then
				A.wtint(A.ps_out[i], 255, 96, 92, 70)
			else
				A.wtint(A.ps_out[i], 255, 44, 46, 54)
			end
			A.wshow(A.ps_out[i], true)
		end

		if A.wclip(A.ps_in[i], ox + 1, oy + 1, r[3] - 2, r[4] - 2) then
			if dead then
				A.wtint(A.ps_in[i], 255, 20, 12, 12)
			else
				A.wtint(A.ps_in[i], 255, 14, 15, 19)
			end
			A.wshow(A.ps_in[i], true)
		end

		-- The picture is cropped at the line, the same as the box it
		-- sits in - see A.icon_clip.
		local pdrew = false
		if sec and pcut then
			local ok = pcall(function()
				A.set_icon(A.ps_ico[i], sec)
			end)
			if ok then
				local iy, ih = oy + 2, r[4] - 4
				local icut, ibot = A.clip_ends(iy, ih)
				if icut then
					A.icon_clip(A.ps_ico[i], sec, icut, ibot, ih)
					A.wpos(A.ps_ico[i], ox + 2, iy + icut)
					A.wsize(A.ps_ico[i], r[3] - 4, ih - icut - ibot)
					if dead then
						A.wtint(A.ps_ico[i], 255, 130, 96, 96)
					else
						A.wtint(A.ps_ico[i], 255, 255, 255, 255)
					end
					A.wshow(A.ps_ico[i], true)
					pdrew = true
				end
			end
		end
		if not pdrew then A.wshow(A.ps_ico[i], false) end
	end



	if A.hid_from ~= #A.rig then
		for i = #A.rig + 1, MAX_SLOTS do
			A.wshow(A.pk_out[i], false)
			A.wshow(A.pk_in[i], false)
		end
		A.hid_from = #A.rig
	end

	if not A.title then
		local xml = A.get_xml()
		A.title = A.mktext(xml, "amp:title", gui.equ_dialog)
		A.close_st = A.mkstatic(xml, "amp:close", gui.equ_dialog)
		A.pin_st = A.mkstatic(xml, "amp:pin", gui.equ_dialog)

		-- Created here, AFTER the cell container, precisely so they are
		-- painted OVER the magazine icons. Draw order is attach order
		-- among siblings - the same rule that put a backdrop on top of
		-- the icons in 0.1.0, used deliberately this time.
		A.ov_ammo, A.ov_cnt, A.ov_bar = {}, {}, {}

		-- Written once. TextControl() is fine for WRITING; it is only
		-- MEASURING through it that silently returns a fallback, because
		-- what it hands back does not carry AdjustWidthToText.
		pcall(function() A.close_st:TextControl():SetText("x") end)
		pcall(function() A.pin_st:TextControl():SetText("*") end)
	end

	-- HOW FULL IT IS, IN SQUARES. It used to be "how many pockets have
	-- something in them", which was the same number when a pocket held
	-- one thing. A slot holds several now, so the honest count is cells
	-- used against cells there are.
	--
	-- THIS LINE READ A.slots, WHICH NO LONGER EXISTS, and it is what
	-- killed the whole draw: the title is written before the slots are
	-- painted, so a nil index here took the rest of the pass with it
	-- and nothing in any pocket was ever drawn.
	local used, cells = 0, 0
	for i = 1, #A.rig do
		cells = cells + (A.rig[i].w or 1) * (A.rig[i].h or 1)
		local P = A.pk[i]
		for n = 1, (P and #P.slots or 0) do
			local e = P.slots[n]
			used = used + (e.w or 1) * (e.h or 1)
		end
	end

	A.wpos(A.title, lx + 4, ly)
	A.wsize(A.title, wpx - 8, TITLE_H)
	A.wtext(A.title, string.format("RIG  %d/%d", used, cells))
	A.wshow(A.title, not A.bag_docked())

	-- Stored in absolute cursor space first, then drawn from it, so the
	-- box cannot be clickable anywhere except where it appears.
	local cw = TITLE_H * ratio
	A.close_r = { ax + wpx - cw, ay, cw, TITLE_H }

	A.wpos(A.close_st, lx + wpx - cw, ly)
	A.wsize(A.close_st, cw, TITLE_H)
	if A.over_close() then
		A.wtint(A.close_st, 255, 210, 60, 60)
	else
		A.wtint(A.close_st, 190, 120, 40, 40)
	end
	A.wshow(A.close_st, true)

	-- ============================================================
	-- PIN
	--
	-- Immediately left of the close box, and stored in absolute cursor
	-- space the same way, because that is the rule that stopped the
	-- close box being clickable somewhere it was not drawn.
	--
	-- Lit when pinned, dim when not, and the only thing it changes is
	-- whether GUI_on_hide is allowed to close the rig.
	-- ============================================================
	A.pin_r = { ax + wpx - cw * 2, ay, cw, TITLE_H }

	A.wpos(A.pin_st, lx + wpx - cw * 2, ly)
	A.wsize(A.pin_st, cw, TITLE_H)
	if A.pinned then
		A.wtint(A.pin_st, 255, 210, 170, 70)
	elseif A.over_pin() then
		A.wtint(A.pin_st, 200, 130, 130, 140)
	else
		A.wtint(A.pin_st, 150, 70, 70, 78)
	end
	A.wshow(A.pin_st, true)

	-- Docked, there is nothing to close and nothing to pin. Drawn and
	-- then put away rather than skipped, so the block above stays one
	-- path with one set of numbers; the guarded setters make the second
	-- write free after the first frame.
	if A.bag_docked() then
		A.close_r, A.pin_r = nil, nil
		A.wshow(A.close_st, false)
		A.wshow(A.pin_st, false)
	end

	-- ============================================================
	-- WHAT THE INVENTORY SHOWS ON A MAGAZINE, KEPT
	--
	-- Ammo type along the top, rounds over capacity along the bottom,
	-- and a fill bar under that. Pooled and lazily created up to the
	-- pocket count rather than to MAX_SLOTS: at most one pocket in
	-- thirty-two is usually filled, and every window costs the engine a
	-- transform every frame whether it is shown or not.
	-- ============================================================
	-- Created on demand, and ONLY for a pocket that has a magazine in
	-- it. An empty pocket has nothing to write on it, and in a retained
	-- UI a window that exists is walked and drawn every frame whether it
	-- is shown or not. A rig with three magazines in twelve pockets used
	-- to carry thirty-six of these; it carries nine.
	local function overlay(pool, node, i, text)
		local t = A[pool]
		if not t[i] then
			-- THE ONES IN THE SCREENSHOT. A readout is made the first
			-- time a pocket has a magazine in it, which can easily be
			-- after a rig window is already open - and then the ammo
			-- name, the count and the bar are drawn straight through it.
			t[i] = text
				and A.mktext(A.get_xml(), node, gui.equ_dialog)
				or  A.mkstatic(A.get_xml(), node, gui.equ_dialog)
		end
		return t[i]
	end

	-- ============================================================
	-- ONE READOUT PER MAGAZINE, NOT PER SLOT
	--
	-- A slot holds several things now, so the pool is indexed by "the
	-- nth magazine drawn this frame" - the same flat scheme A.pk_draw
	-- uses for the icons, and for the same reason: a rig's slots and
	-- the number of magazines in them are different numbers, and the
	-- pool has to follow the second one.
	--
	-- The rectangle is the ENTRY's, out of A.pk_cells, so a readout
	-- lands on the magazine it is about rather than on the slot the
	-- magazine happens to be sharing.
	-- ============================================================
	local ov = 0

	for i = 1, #A.pk do
		local P = A.pk[i]
		local cells = A.pk_cells[i]

		for n = 1, (P and #P.slots or 0) do
			local e = P.slots[n]
			local r = cells and cells[n]

			-- ONLY A MAGAZINE HAS ROUNDS. A bandage with "24/30" on it
			-- would be a readout about nothing.
			local obj
			if r and A.is_mag(e.sec) and #e.ids > 0 then
				obj = level.object_by_id(e.ids[#e.ids])
			end

			if obj then
				ov = ov + 1

				local a = overlay("ov_ammo", "amp:ovl_txt", ov, true)
				local c = overlay("ov_cnt", "amp:ovl_txt", ov, true)
				local b = overlay("ov_bar", "amp:ovl_bar", ov, false)

				local cnt, cap, ammo = A.mag_info(obj)
				local ox, oy = r[1] - A.org[1], r[2] - A.org[2]

				-- THE READOUTS GO ONE AT A TIME, not all three the
				-- moment the pocket is touched. Text cannot be cropped -
				-- half a letter is worse than no letter - so each of the
				-- three is hidden when the line reaches ITS OWN band,
				-- and the ammunition name at the top of a pocket goes a
				-- good deal earlier than the round count at the bottom.
				local nm = ammo and A.ammo_name(ammo)
				A.wpos(a, ox, oy + 1)
				A.wsize(a, r[3], 11)
				A.wtext(a, nm or "")
				A.wcolor(a, 230, 190, 190, 200)
				A.wshow(a, nm ~= nil and A.clip_whole(oy + 1, 11))

				-- "24/30" when the rounds can be read, plain capacity
				-- when no magazine mod is installed to ask.
				local label = cnt and (cnt .. "/" .. cap)
					or (cap > 0 and tostring(cap) or "")
				local frac = (cnt and cap > 0) and (cnt / cap) or nil

				A.wpos(c, ox, oy + r[4] - 15)
				A.wsize(c, r[3], 11)
				A.wtext(c, label)

				if frac == nil then
					A.wcolor(c, 220, 190, 190, 200)
				elseif frac <= 0 then
					A.wcolor(c, 255, 235, 90, 80)
				elseif frac < 0.34 then
					A.wcolor(c, 255, 235, 185, 80)
				else
					A.wcolor(c, 235, 225, 235, 225)
				end
				A.wshow(c, label ~= "" and A.clip_whole(oy + r[4] - 15, 11))

				-- The fill bar. Inset by one pixel so it sits inside the
				-- square's border rather than on it.
				if frac then
					local bw = (r[3] - 2) * clampi(frac, 0, 1)
					A.wpos(b, ox + 1, oy + r[4] - 4)
					A.wsize(b, bw, 3)

					if frac <= 0 then
						A.wtint(b, 255, 200, 70, 60)
					elseif frac < 0.34 then
						A.wtint(b, 255, 220, 170, 60)
					else
						A.wtint(b, 255, 120, 200, 130)
					end
					A.wshow(b, bw > 0.5 and A.clip_whole(oy + r[4] - 4, 3))
				else
					A.wshow(b, false)
				end
			end
		end
	end

	-- The tail of the three pools, counted rather than keyed off the
	-- slot count for the same reason the icons are.
	if A.hid_ov ~= ov then
		for n, w in pairs(A.ov_ammo) do
			if n > ov then A.wshow(w, false) end
		end
		for n, w in pairs(A.ov_cnt) do
			if n > ov then A.wshow(w, false) end
		end
		for n, w in pairs(A.ov_bar) do
			if n > ov then A.wshow(w, false) end
		end
		A.hid_ov = ov
	end

	-- AdjustWnd re-flows the container and everything inside it, and it
	-- was being handed the same four numbers every frame.
	local cm = A.last[cc]
	if not cm then cm = {} A.last[cc] = cm end

	if cm.ax ~= lx or cm.ay ~= ly or cm.aw ~= wpx or cm.ah ~= h then
		cm.ax, cm.ay, cm.aw, cm.ah = lx, ly, wpx, h
		cc:AdjustWnd(lx, ly + title_h(), wpx, h - title_h())
	end

	if cm.gs ~= gs or cm.gl ~= gl then
		cm.gs, cm.gl = gs, gl
		cc:SetGridSpecs(gs, gl)
	end

	A.show_cc(cc, true)

	-- ============================================================
	-- THE CELL CONTAINER DOES NOT DRAW THE CONTENTS ANY MORE
	--
	-- It used to: one UICellItem per pocket, filled with the magazine
	-- in it, and A.correct measuring every frame where the engine had
	-- actually put the icon so the next frame could aim at it. That
	-- whole apparatus - fixk, fix_for, correct, obj_at, the cell pool,
	-- the sizing dance around align_to_center - existed because a cell
	-- lands where the base class decides and this file had to find out
	-- where.
	--
	-- A slot holds several things now, at squares this file chooses, so
	-- a cell per pocket could not have worked anyway. The contents are
	-- statics, placed exactly where A.pk_draw puts them, which is what
	-- the med pocket has done since it shipped and what the boxes and
	-- their windows do. Nothing needs correcting when nothing else is
	-- placing anything.
	--
	-- THE CONTAINER ITSELF STAYS. It is what the menu's drag-and-drop
	-- machinery hands events to - see A.ours and CC_ID - and it is the
	-- window the panel's furniture is parented to. It is simply empty.
	-- ============================================================
	for i, cell in pairs(cc.cell) do
		if cell.ID or A.cellsig[i] then
			cell:Reset()
			cell:Highlight(false)
			A.cellsig[i], A.cellhl[i] = nil, nil
		end
	end

	-- The magazine in hand, if there is one, drawn last so it is on top
	-- of everything the rest of this pass just placed.
	A.draw_ghost(gui, ratio, gs)
end

-- ============================================================
-- THE MAGAZINE IN HAND
--
-- A static of this mod's own, parented to the equipment dialog exactly
-- as the title and the close box are - and NOT the dragged cell moved
-- to the cursor, which was the first idea and is wrong: cells live
-- inside the container's scroll view and are clipped by it, so the
-- magazine would vanish at the panel's edge, which is the one place a
-- drag needs to cross.
--
-- Created on the first drag rather than with the panel. It has to be
-- the LAST child of the dialog to draw over the icons and the ammo
-- readouts, and draw order is attach order among siblings - the same
-- rule that put the overlays on top of the icons.
-- ============================================================
function A.draw_ghost(gui, ratio, gs)
	-- ============================================================
	-- TWO THINGS CAN BE IN HAND, AND THEY LOOK THE SAME
	--
	-- A pile out of a slot of the worn rig, or a cell out of the bag.
	-- One ghost serves both: what is being carried is a PICTURE either
	-- way, and two of them would be two ways for the same drag to
	-- half-work.
	--
	-- A slot square knows its section without looking anything up,
	-- which is the one difference - a bag cell has to resolve its
	-- object first.
	-- ============================================================
	local d = A.pk_drag

	if not d then
		if A.ghost then A.wshow(A.ghost, false) end
		return
	end

	-- A click is not a carry. Nothing is drawn until the press has been
	-- held, so tapping a pocket does not flash a picture across the
	-- screen - the same 100 ms the base class waits.
	if time_global() - d.tg < DRAG_MS then
		if A.ghost then A.wshow(A.ghost, false) end
		return
	end

	local sec

	if A.pk_drag then
		local P = A.pk and A.pk[A.pk_drag.i]
		local e = P and P.slots[A.pk_drag.n]
		sec = e and e.sec
	else
		sec = d.sec
	end

	if not sec then
		if A.ghost then A.wshow(A.ghost, false) end
		return
	end

	-- Same rule, same reason: an open rig's statics are made after this
	-- one and would otherwise be drawn over a magazine dragged out of
	-- the panel. A re-made ghost has no texture yet, so the section is
	-- forgotten with it.
	local _, remade = A.mkghost("ghost", A.get_xml(), "amp:drag",
	                            gui.equ_dialog)
	if remade then A.ghost_sec = nil end

	-- The picture, once per magazine rather than once per frame. If the
	-- texture lookup is unavailable the ghost stays a tinted rectangle:
	-- worse looking, still a thing following the cursor, and the drag
	-- itself does not depend on any of it.
	if A.ghost_sec ~= sec then
		A.ghost_sec = sec

		pcall(function()
			A.ghost:InitTexture(utils_xml.get_icons_texture(sec))
			A.ghost:SetTextureRect(Frect():set(utils_xml.get_item_axis(sec, nil, true)))
			A.ghost:SetStretchTexture(true)
		end)
	end

	local cw, ch = A.cells(sec)

	-- A PILE CAN BE LYING SIDEWAYS - and the R key can be turning it
	-- right now. The ghost shows the lie the drop will write.
	local ew, eh = cw, ch
	if A.pk_drag then
		local P = A.pk and A.pk[A.pk_drag.i]
		local e = P and P.slots[A.pk_drag.n]
		if e then ew, eh = A.turned(e) end
	end

	local w, h = ew * gs * ratio, eh * gs

	-- Centred on the cursor, in the dialog's local space. A.org is that
	-- dialog's absolute origin, which is what every other absolute
	-- measurement in this file is expressed against.
	local cur = GetCursorPosition()

	if ew ~= cw and ew ~= eh then
		A.wpos(A.ghost, cur.x - A.org[1] - h / 2,
		       cur.y - A.org[2] - w / (2 * ratio))
		A.wsize(A.ghost, h, w / ratio)
		A.wturn(A.ghost, true)
	else
		A.wpos(A.ghost, cur.x - A.org[1] - w / 2, cur.y - A.org[2] - h / 2)
		A.wsize(A.ghost, w, h)
		A.wturn(A.ghost, false)
	end
	A.wtint(A.ghost, 200, 255, 255, 255)
	A.wshow(A.ghost, true)
end

-- ============================================================
-- HIDING POUCHED MAGS FROM THE BAG
--
-- ParseInventory is the single choke point that fills actor_bag: every
-- IMode_/LMode_/TMode_ Reset and Refresh goes through it, so one wrapper
-- hides a magazine everywhere at once and keeps hiding it through the
-- incremental refreshes, which diff the parsed list against cc.indx_id
-- and remove whatever is missing.
--
-- Free side effect: a hidden mag has no cell, so LMode_PutAll - which
-- iterates cc.indx_id - cannot stash it.
--
-- Three things to be careful of:
--
-- 1. NOT IN TRADE. Hiding there would mean emptying the rig one pocket
--    at a time before you could sell anything. self.mode is the only
--    thing separating actor_bag from actor_trade_bag here, since both
--    are filled by this same call with db.actor.
--
-- 2. The return shape is TWO different things. With id_list it is
--    [id] = obj; without it, a 1..n array. An array with holes punched
--    in it ends at the first hole for every ipairs and # in the game,
--    so it is rebuilt contiguously.
--
-- 3. Only the ACTOR. NPC and box inventories come through here too.
-- ============================================================
local base_ParseInventory = ui_inventory.UIInventory.ParseInventory

-- ============================================================
-- WHAT COUNTS AS "IN THE RIG" FOR THE GRID
--
-- Not "has a pocket" - "is in the loadout". Those are the same set once
-- reconcile has run, but they are NOT the same set at the first
-- ParseInventory of a session or of an inventory opening, and hiding on
-- pockets alone means the first refresh shows magazines that a later one
-- removes. That is a loadout group that appears and then vanishes, and
-- the grid reflowing under it - which is the flicker.
--
-- carried_mags is the container. It is already correct before this mod
-- does anything, it does not depend on reconcile having run yet, and it
-- is what the magazine mod's own loadout sort is grouping on. Hiding
-- exactly it means the group can never be drawn in the first place.
--
-- Only when the rig IS the loadout. With that off the vanilla loadout
-- can hold more than the rig has pockets, and hiding a magazine with
-- nowhere to reach it would be the worst bug this mod can produce.
-- ============================================================
function A.hidden(id)
	local layers = rawget(_G, "zzz_amp_layers")
	if layers and type(layers.hidden) == "function" then
		local ok, yes = pcall(layers.hidden, id)
		if ok and yes then return true end
	end
	-- THE WORN RIG IS ALWAYS HIDDEN, whatever amp_hide_grid says.
	--
	-- That option is about POUCHED MAGAZINES - whether a magazine filed
	-- in a pocket also shows in the bag. The rig is not a magazine in a
	-- pocket; it is a worn item, and it is in the slot. Tying it to that
	-- setting meant anyone with the option off saw their rig in the slot
	-- and in the inventory at the same time.
	if A.rig_id and id == A.rig_id then return true end

	-- AND SO IS ONE WAITING FOR A POCKET, whatever that option says.
	-- Same reasoning as the rig: amp_hide_grid is about a magazine
	-- FILED IN A POCKET also showing in the bag. This one is in neither
	-- - it is in transit, for about a second, and showing it is the
	-- whole bug. See A.settle_held.
	if A.held[id] then return true end

	-- AND WHAT IS IN THE MED POCKET, WHATEVER amp_hide_grid SAYS.
	--
	-- That option is about POUCHED MAGAZINES showing in the bag as well
	-- as in their pocket, and there is an argument for it: a magazine is
	-- a thing you also sell, load and compare. The med pocket is not
	-- that. Its whole point is that what is in it is IN IT - one place,
	-- countable at a glance, and reachable by a key press - and a
	-- bandage drawn in both places is a bandage the player will drag out
	-- of the bag and wonder why the pocket emptied.
	--
	-- AND THAT NOW COVERS EVERYTHING IN THE RIG, magazines included:
	-- there is one store and one rule, where there used to be an option
	-- for the magazines and a flat "always" for the med pocket.
	if A.pk_holds(id) then return true end

	-- AND WHAT IS ON YOUR ARM. The Wearable Devices pack wears its
	-- bracer, watch and tablet by attachment and leaves the items in
	-- the inventory; they are on your arm, which is a place, and a
	-- square in the bag as well is a square paid twice. Same reasoning
	-- as the worn rig above, and the same answer.
	if A.wd_worn[id] then return true end

	if not A.hide_grid then return false end

	return A.rig_is_all and A.carried_now[id] ~= nil
end

-- ============================================================
-- AND A TRADER'S WINDOW HIDES WHAT EVERY OTHER WINDOW HIDES
--
--   "when i put one of my items to sell it to vendor then the mags
--    that are in the rig showup in the backpack invnentory and are
--    there only in vendor window. outside is fine"
--
-- Trade used to be the one mode that kept pouched magazines in the
-- list, and there was a reason for it:
--
--     hiding those would mean emptying the rig a pocket at a time
--     before you could sell anything, and the middle column is not on
--     screen there to hold them either
--
-- BOTH HALVES OF THAT HAVE EXPIRED. The middle column was removed in
-- 1.64.0, so there is no second list to be missing - a magazine taken
-- out of a pocket lands in the same bag list it lands in anywhere
-- else. And trade is in EDIT_MODES beside inventory, loot and repair,
-- so the rig is drawn in a trader's window with every pocket live:
-- taking one out there is one drag, in the window you are already
-- looking at.
--
-- So there is no special case any more. Trade takes the ordinary path
-- below: the same A.hidden, and the same resolve/reconcile in front of
-- it. THE SYNC IS THE PART THAT MATTERS - A.take clears A.by_id but
-- nothing clears A.carried_now, so with "the rig is the loadout" on, a
-- magazine pulled out of a pocket would stay hidden by the carried half
-- of A.hidden and could never be sold. reconcile re-reads carried_mags,
-- and that is what lets the next refresh show it. Which is how the
-- inventory has always behaved.
--
-- The worn rig is still hidden in trade, by the first line of A.hidden,
-- which has never looked at the mode. Selling the container out from
-- under its own contents is still impossible.
-- ============================================================
local function amp_filter(inv, id_list)
	if id_list then
		-- Clearing fields during a pairs() traversal is explicitly
		-- allowed; adding them is not, and none are added.
		for id, obj in pairs(inv) do
			if A.hidden(id) then inv[id] = nil end
		end
		return inv
	end

	-- ============================================================
	-- NEVER `#` A TABLE SOMEBODY ELSE BUILT
	--
	-- This branch used `local n, len = 0, #inv` and removed NOTHING, on
	-- every single refresh, for five releases. The log settled it:
	--
	--   filter[array]  500 -> 500 | pockets=6 carried=6
	--   filter[idlist] 500 -> 494 | pockets=6 carried=6
	--
	-- Same state, same A.hidden, same ids - the id-keyed branch removed
	-- exactly the six pouched magazines and this one removed none. The
	-- only way that happens is `#inv == 0`, so the loop never ran and
	-- the table went back untouched.
	--
	-- `#` is only defined for a proper sequence, and this table is not
	-- built here: several mods wrap ParseInventory ahead of this one
	-- (SortingPlus, its seax optimiser, Seamless Inventory Sort) and
	-- Reinit consumes the result through spairs, which iterates with
	-- pairs and does not care how it is keyed. So an upstream wrapper
	-- can legitimately hand back a table whose array part is empty, and
	-- everything downstream keeps working - except code that measures it
	-- with `#`.
	--
	-- THIS IS THE FLICKER. The array call is what IMode_ResetInventories
	-- uses when the window opens, so the first thing drawn was the
	-- unfiltered bag - magazines and their Loadout header included - and
	-- the id-keyed refresh a frame later took them out again.
	--
	-- Walking with `inv[i]` instead of `#inv` reads the same entries
	-- whether they live in the array part or the hash part, and keeps
	-- their order. The pairs sweep is the fallback for a table that is
	-- not sequence-keyed at all; order is not preserved there and does
	-- not need to be, because Reinit sorts the list before it draws it.
	-- ============================================================
	local ordered, i = {}, 1
	while inv[i] ~= nil do
		ordered[i] = inv[i]
		i = i + 1
	end

	if #ordered == 0 then
		for k, v in pairs(inv) do
			if type(k) == "number" then ordered[#ordered + 1] = v end
		end
	end

	local keep = {}
	for j = 1, #ordered do
		local obj = ordered[j]
		if not (obj and A.hidden(obj:id())) then
			keep[#keep + 1] = obj
		end
	end

	-- Emptied and refilled rather than rebuilt: the SAME table goes back,
	-- because anything upstream still holding the one base returned would
	-- otherwise be reading a list this mod had already decided to change.
	for k in pairs(inv) do inv[k] = nil end
	for j = 1, #keep do inv[j] = keep[j] end

	return inv
end

function ui_inventory.UIInventory:ParseInventory(npc, all, id_list, ignore_kind)
	local inv = base_ParseInventory(self, npc, all, id_list, ignore_kind)

	-- Runs whenever the mod is on. It used to require hide_grid, which
	-- is the magazine option - so with that off the rig was never
	-- filtered either. A.hidden decides what is hidden; this only
	-- decides whether anything can be.
	if not A.enabled then return inv end
	if not (npc and db.actor and npc:id() == db.actor:id()) then return inv end

	-- The diagnostic that lived here walked the whole inventory on
	-- every refresh to report whether the worn rig was in the list. It
	-- did its job - the answer was "yes, and the early-out below was
	-- returning before the filter ever ran" - and the bug it was
	-- chasing is fixed, so the walk goes with it. filter[array] below
	-- still reports the counts.

	-- ============================================================
	-- WHY RECONCILIATION HAPPENS HERE AND NOT ONLY IN THE DRAW PASS
	--
	-- A magazine ejected during a reload is handed to toggle_carried_mag
	-- by the magazine mod itself, with this panel closed and nothing of
	-- this mod running. Reconciliation used to hang off resolve_rig, and
	-- resolve_rig early-outs unless the ARMOUR changed - so that magazine
	-- was carried, counted against the rig, drawn in the bag under the
	-- loadout sort, and in no pocket at all. Which is what was reported.
	--
	-- This wrapper is the one thing that runs on every inventory refresh
	-- whether the panel is open or not, so this is where it belongs. It
	-- is BEFORE the nothing-pouched early-out, because an empty rig
	-- adopting its first magazine is exactly the case being fixed.
	--
	-- Its own pcall, and the result is ignored: the filter below has to
	-- run whatever happens here. See the note on that pcall.
	-- ============================================================
	local sync_ok, sync_err = pcall(function()
		A.resolve_rig()
		A.reconcile()
	end)
	if not sync_ok then log("!sync failed: %s", tostring(sync_err)) end

	-- Nothing to hide: the hook is completely inert until the rig is
	-- actually used. Worth having on its own, and it also means "is this
	-- mod causing it?" can be answered by emptying the pouches rather
	-- than by uninstalling.
	-- ============================================================
	-- THE RIG COUNTS AS SOMETHING TO HIDE
	--
	-- This early-out means "nothing is pocketed and nothing is carried,
	-- so there is nothing to filter". That was true when the only things
	-- ever hidden were magazines. The WORN RIG is hidden now too, and an
	-- empty rig has no pocketed magazines - so wearing one and opening
	-- the inventory took this exit and the list came back untouched.
	--
	-- Three fixes went into A.hidden and into the guards above it, and
	-- none of them mattered, because the filter was never reached. The
	-- log settled it in one line: the rig was IN the list handed to a
	-- function that then returned it whole.
	-- ============================================================
	--
	if not (#A.pk > 0 or next(A.carried_now) or A.rig_id
	        or next(A.wd_worn)) then
		return inv
	end

	-- ============================================================
	-- THIS RUNS INSIDE THE INVENTORY'S UPDATE LOOP, UNPROTECTED
	--
	-- ParseInventory feeds Reinit, and Reinit calls Reset() BEFORE it
	-- refills. Anything throwing between those two leaves the container
	-- emptied and never repopulated - a blank inventory that stays blank
	-- until the window is reopened, which is the exact shape of the bug
	-- reported against 0.2.0.
	--
	-- Whether or not that was the cause, a filter that fails loudly and
	-- harmlessly beats one merely believed correct: on an error the base
	-- list goes back untouched, so the worst case becomes magazines
	-- staying visible in the grid instead of an inventory that will not
	-- draw.
	-- ============================================================
	-- Counted the same way for both return shapes, because the id_list
	-- form is the one IMode_RefreshInventories uses - the call that ADDS
	-- items to an already-open bag - and it was the one not being logged.
	local function n_of(t)
		local n = 0
		for _ in pairs(t) do n = n + 1 end
		return n
	end

	local before = n_of(inv)
	local len_before = #inv
	local ok, res = pcall(amp_filter, inv, id_list)

	-- `len` is logged next to `n` on purpose: len == 0 with n == 500 is
	-- the exact signature of the bug this branch was rewritten for, and
	-- if it ever comes back the log says so in one line.
	dbg("filter[%s] n=%s len=%s -> %s | pockets=%s carried=%s rig=%s all=%s",
	    id_list and "idlist" or "array",
	    before, len_before, (type(res) == "table") and n_of(res) or "ERR",
	    A.count_slots(), A.count_carried(), #A.rig, tostring(A.rig_is_all))

	if not ok then log("!filter failed: %s", tostring(res)) end

	if not ok then
		if not A.warned then
			A.warned = true
			log("!grid filter failed - magazines will stay visible: %s", tostring(res))
		end
		return inv
	end

	return res
end

-- ============================================================
-- MOUSE
--
-- One hook, and the release is decided by the press. ui_inventory hands
-- each press and release to EVERY shown container in turn and ignores
-- what they return - there is no "consume", an early return only ends
-- this container's handler. So "is the cursor on the rig?" is asked
-- once, on the press, and every container answers the release from that
-- flag.
--
-- Asking again on the release is what made closing a floating window
-- click the item underneath it in the sibling mod: containers iterated
-- before the bag saw the window, those after it did not, and pairs()
-- order is stable per table - so it happened on every close, or never.
--
-- Every early return sets scroll_pause = false. A container left with
-- scrolling paused stops rebuilding its headers.
-- ============================================================
local base_OnKeyboard = utils_ui.UICellContainer.OnKeyboard

-- ============================================================
-- WHOSE CLICK IS IT
--
-- Split out of the wrapper so it can be asked from TWO places: the
-- wrapper installed at load, and the guard installed ahead of everybody
-- else once the game is running. See A.claim_input.
--
-- Returns true when this mod has dealt with the event and nothing else
-- should see it.
-- ============================================================
function A.cc_key(self, dik, keyboard_action)
	-- INPUT IS A NEW LOOK AT THE CURSOR. The per-frame cache is right
	-- for a draw pass, where every rectangle is tested against the same
	-- moment; it is wrong for an event, which is its own moment.
	A.cursor_dirty()

	local m1 = (dik == DIK_keys.MOUSE_1)
	local m2 = (dik == DIK_keys.MOUSE_2)

	-- ============================================================
	-- A PRESS IS ANSWERED BY EXACTLY ONE RELEASE
	--
	-- A.ate says "the press for this button was ours, so the release is
	-- ours too". It used to be written ONLY inside the guard below and
	-- never cleared, and both halves of that were wrong:
	--
	--   * a press that did not reach the guard - the panel shut, no
	--     window, the cursor nowhere near us - left the last answer
	--     standing
	--   * a release never took its answer away
	--
	-- So a `true` from some earlier click on the panel sat there until
	-- something else overwrote it, and then ran our release handler on
	-- a press we never saw. The way to meet that in game is the open-rig
	-- entry: the menu's own click lands with the window not yet open, so
	-- the guard is skipped, and the window opens a moment later - which
	-- makes the guard true just in time for the RELEASE to be taken as
	-- ours and close the window again. Once, twice, and on the third go
	-- the stale flag happened to be false and it stayed open.
	--
	-- The flag is written on every press now, cleared on every release,
	-- and the guard only decides what to DO, never what to remember.
	-- ============================================================
	local press = (keyboard_action == ui_events.WINDOW_KEY_PRESSED)

	if (m1 or m2) and A.enabled then
		-- A.open OR the rig slot: the slot is outside the panel and is
		-- there whenever the inventory is, so a right-click on it has to
		-- be caught with the panel shut - which is the state you are in
		-- before there is a rig to open.
		-- ============================================================
		-- THE MED POCKET IS ONE OF THE PLACES A PRESS CAN BE OURS
		--
		--   "pickup with leftclick does not work for this slot."
		--
		-- It never reached A.press_m1. The pocket used to be inside the
		-- panel, where A.over_panel covered it for free; moving it out
		-- to sit under the rig slot took the claim with it, and a press
		-- on it was decided to be somebody else's before anything here
		-- looked at what was under the cursor.
		--
		-- IT IS ALSO WHAT THE EARLIER REPORT WAS. "works when grabbed
		-- from under the backpack slot" is A.pack_at() answering true
		-- and claiming the press by accident; everywhere else on the
		-- pocket nothing claimed it. Moving the block down stopped the
		-- two overlapping - which was right - and took the accident
		-- away with it.
		--
		-- BOTH LISTS. `ours` is "could this press be ours" and `on` is
		-- "is the cursor on something of ours". In one and not the
		-- other is a press remembered as ours and then handled by
		-- nobody, which is the stale-flag bug the note above describes.
		-- ============================================================
		-- ============================================================
		-- THE DEVICE SLOTS ARE THE SAME KIND OF PLACE AS THE BACKPACK
		--
		--   "right click does not work on bracer, tablet (promin) and
		--    watch."
		--
		-- They hang off the backpack slot, outside the panel, drawn
		-- whenever the inventory is - so like the rig slot and the med
		-- pocket before them they have to be named here or a press on
		-- one is decided to be somebody else's before anything looks at
		-- what is under the cursor. A.ate2 stays nil, and A.release_m2
		-- with its menu branch is never called.
		--
		-- This was true of the LEFT button too, and nobody had said so
		-- yet: taking a device off by clicking its slot never worked
		-- either, because there is another way to do it and that is the
		-- way it was being done.
		-- ============================================================
		local ours = (A.open or A.rig_at() or A.pack_at()
			or A.win_shown() or A.wd_at())

		if press then
			local on = ours and editing_allowed()
				and (A.over_panel() or A.rig_at() or A.pack_at()
				     or A.win_over() or A.wd_at())
			if m1 then A.ate = on or nil else A.ate2 = on or nil end

			if on then
				-- Keyed on the bag for the same reason the release is:
				-- every shown container gets this press, and a drag must
				-- be picked up once, not once per container.
				if m1 and A.ours(self.ID) then
					local ok, err = pcall(A.press_m1)
					if not ok then log("!press: %s", tostring(err)) end
				end

				-- ============================================================
				-- THE BUTTON IS DOWN, SO PAUSE THE SCROLL - WHICH IS WHAT
				-- THE CONTAINER WOULD HAVE DONE IF WE HAD LET IT
				--
				-- This line used to set the flag to FALSE, and that is the
				-- runaway scroll:
				--
				--   "holding container by its header when the mouse moved
				--    above inventory grid, aslo scrolls the ivnentory
				--    rappidly up ... when i move container on the other
				--    side of the screen not above invantory then ivnentoy
				--    does not scroll."
				--
				-- UICellContainer:On_Scroll ends with the WHEEL AMPLIFIER:
				--
				--   local curr_pos = self.scroll:GetCurrentScrollPos()
				--   if (self.scroll_pos ~= curr_pos) then
				--       Scroll_SetPos(self.scroll_pos +/- a row * power)
				--   end
				--
				-- ANY disagreement between where the engine says the view
				-- is and where the container last put it is read as the
				-- player turning the wheel, and answered by moving the list
				-- a whole row - every frame, until they agree. Nobody has
				-- to touch the wheel for that to happen.
				--
				-- Three things turn it off and there is no fourth:
				-- disable_scroll, an item in hand, and `scroll_pause`. A
				-- window dragged by its HEADER is not an item in hand - the
				-- container knows nothing about it - so scroll_pause was the
				-- only guard, and we were the ones switching it off.
				--
				-- Returning true here means the base handler never runs, so
				-- if this mod does not set it, nothing does.
				-- ============================================================
				self.scroll_pause = true
				A.paused = true
				return true
			end
		else
			local ate = m1 and A.ate or (m2 and A.ate2)

			if ate then
				-- ============================================================
				-- CLEARED WHERE IT IS ACTED ON, AND NOWHERE ELSE
				--
				-- EVERY SHOWN CONTAINER GETS THIS EVENT - the bag, the
				-- equipment, the belt, the trade lists, ours. Only the bag
				-- acts on it. Clearing the flag outside this branch meant
				-- whichever container happened to be visited FIRST took the
				-- answer away, and by the time the bag's turn came there was
				-- nothing left to act on. Three things broke at once and they
				-- were all this:
				--
				--   * a window picked up by its header was never put down -
				--     win_drop_head lives in release_m1, which never ran
				--   * right-clicking the rig slot did nothing - same, in
				--     release_m2
				--   * and the event then fell through to the base handler
				--     with the cursor over our own controls
				--
				-- It is safe for this to be the only place it is cleared,
				-- because every PRESS writes the flag afresh: nothing stale
				-- can survive the next click even if the bag is not on
				-- screen to clear it.
				-- ============================================================
				if A.ours(self.ID) then
					if m1 then A.ate = nil else A.ate2 = nil end

					local ok, err = pcall(m1 and A.release_m1 or A.release_m2)
					if not ok then log("!release: %s", tostring(err)) end
				end

				-- And the button is up, so the scroll is theirs again. The
				-- release always reaches every container the press did, so
				-- this is the ordinary way the pause above comes off;
				-- A.unpause is for the ways that are not ordinary.
				self.scroll_pause = false
				A.paused = nil
				return true
			end
		end
	end

	return false
end

-- ============================================================
-- WHETHER THIS PRESS STARTED ON THE SCROLL BAR
--
--   "when holding an item and also draging it above 'scroll bar'
--    scrolls the inventory"
--
-- The bar asks one question - "is the button down and is the cursor
-- over me" - and the window answers yes to the first half for ANY left
-- press anywhere, because that is how it pauses the scroll while you
-- drag. So carrying an item across the bar reads as dragging the bar.
--
-- The missing half is WHERE THE BUTTON WENT DOWN, and only a press can
-- answer it. Written on every press and cleared on every release,
-- against the container it happened to - which is the same shape as
-- A.ate above and for the same reason: a flag that is only written
-- sometimes is a flag that answers for some earlier click.
--
-- pcall, because a container built in MANUAL mode has no pad at all.
-- ============================================================
function A.cc_pad_press(cc, dik, keyboard_action)
	if dik ~= DIK_keys.MOUSE_1 then return end

	if keyboard_action ~= ui_events.WINDOW_KEY_PRESSED then
		cc.amp_pad_grab = nil
		return
	end

	local on
	pcall(function()
		on = cc.pad and cc.pad:IsShown() and cc.pad:IsCursorOverWindow()
	end)
	cc.amp_pad_grab = on or nil
end

function utils_ui.UICellContainer:OnKeyboard(dik, keyboard_action)
	-- FIRST, and outside the swallow. A press this mod deals with
	-- itself is still a press, and the answer to "did it land on the
	-- bar" is no - which is exactly the answer the bar needs.
	A.cc_pad_press(self, dik, keyboard_action)

	if A.cc_key(self, dik, keyboard_action) then return end
	return base_OnKeyboard(self, dik, keyboard_action)
end

-- ============================================================
-- ...AND THE BAR ONLY MOVES FOR A PRESS THAT LANDED ON IT
--
-- Everything else about Scroll_Pad_Ctrl is left alone. Grab the bar
-- and it drags exactly as it did; carry an item across it and the list
-- stays where you left it.
--
-- pd.off and pd.hold are cleared rather than merely skipped, because
-- they are how the base remembers a drag in progress: leaving a stale
-- `hold` behind would hand the bar to the next press whatever that one
-- landed on.
-- ============================================================
local base_Pad = utils_ui.UICellContainer.Scroll_Pad_Ctrl

if base_Pad then
	function utils_ui.UICellContainer:Scroll_Pad_Ctrl(update)
		-- THE RESIZE PASS GOES STRAIGHT THROUGH. It sizes and places
		-- the bar and never reads the cursor, and a bar that stopped
		-- being resized would be the wrong length for the list.
		if update or not A.enabled then return base_Pad(self, update) end

		if not self.amp_pad_grab then
			if self.pd then
				self.pd.off = false
				self.pd.hold = false
			end
			return
		end

		return base_Pad(self, update)
	end
end

-- ============================================================
-- A WINDOW MADE OF STATICS CANNOT SWALLOW A CLICK
--
-- The open-rig windows float over the inventory, and everything they
-- are drawn from is a STATIC - a picture, not a control. The engine
-- does not know they are there, so a click on one also reaches
-- whatever is underneath: a category header's collapse button gets
-- pressed by a magazine being dropped into a pocket on top of it, and
-- hovering a pocket pops the tooltip of the bag cell behind it.
--
-- This mod already stops that for the containers it wraps. What it
-- could not stop is a mod that wrapped the SAME function AFTER it -
-- and script load order is alphabetical, so anything named later is
-- outside us and sees the click first.
--
-- So the guard is installed a second time, once the game is running
-- and everybody has finished wrapping. It captures whatever the chain
-- has become and puts itself in front of it:
--
--   the cursor is on one of ours   deal with it, return, nobody else
--                                  sees it
--   anywhere else                  hand the whole chain the event,
--                                  unchanged
--
-- The wrapper installed at load stays where it is. When this one
-- handles an event the chain never runs; when it does not, the inner
-- one asks the same question, gets the same answer, and passes it on.
--
-- The same for Update, which is where hover comes from: `hide` is the
-- container's own word for "the cursor is not on me", and forcing it
-- through the whole chain is what stops the tooltip of a cell that is
-- behind one of our windows.
-- ============================================================
function A.cursor_claimed()
	if not A.enabled then return false end
	A.cursor_dirty()
	return A.win_over() or A.over_panel() or A.rig_at() or A.pack_at()
		or (A.wd_at() and true) or false
end

function A.claim_input()
	if A.claimed then return end
	A.claimed = true

	local chain_key = utils_ui.UICellContainer.OnKeyboard
	utils_ui.UICellContainer.OnKeyboard = function(self, dik, action)
		if A.enabled and A.cc_key(self, dik, action) then return end
		return chain_key(self, dik, action)
	end

	local chain_upd = utils_ui.UICellContainer.Update
	utils_ui.UICellContainer.Update = function(self, item_info, no_info, hide)
		-- Only the floating windows. The panel and the column are docked
		-- in the middle and overlap nothing, and claiming for them would
		-- take hover away from cells that are not underneath anything.
		if A.enabled and not hide then
			local ok, over = pcall(A.win_over)
			if ok and over then
				hide = true
				-- The base does not touch the tooltip when it is told to
				-- hide, so a tooltip already up would sit there. Put it
				-- away by hand, once, from the bag.
				if item_info and A.ours(self.ID) then
					pcall(function() item_info:Update() end)
				end
			end
		end

		return chain_upd(self, item_info, no_info, hide)
	end

	log("input claimed ahead of %s",
	    tostring(chain_key ~= base_OnKeyboard and "another mod's hook"
	                                          or "nothing else"))
end

-- ============================================================
-- REACHING THE MAGAZINE MOD, IF THERE IS ONE
--
-- Every one of these is a soft lookup through rawget, and every caller
-- below treats a nil as "that feature is not installed" rather than as
-- an error. This mod has worked without a magazine mod loaded since
-- 0.1.0 - the rig is still a rig, it just holds nothing the game
-- recognises as a magazine - and none of what follows changes that.
--
-- Each is looked up at the moment it is used, not cached at load: these
-- modules initialise in an order this file does not control, and a
-- reference taken too early is nil forever.
-- ============================================================
local function mags()
	local m = rawget(_G, "magazines")
	return (type(m) == "table") and m or nil
end

local function mag_busy()
	local m = mags()
	return (m and type(m.action_in_progress) == "function"
	          and m.action_in_progress()) and true or false
end

local function mag_cfg(key)
	local m = rawget(_G, "magazines_mcm")
	if not (type(m) == "table" and type(m.get_config) == "function") then
		return nil
	end

	local ok, v = pcall(m.get_config, key)
	return ok and v or nil
end

-- ============================================================
-- DRAGGING A MAGAZINE OUT OF A POCKET AND ONTO A WEAPON
--
-- In the bag that loads the weapon. Same engine callback as the ammo
-- drop, and the same reason it never happened from the rig: the drag
-- STARTS on a pocket, which is not a cell, so the menu never treats it
-- as a cell-to-cell drop and nothing fires. Dropping a magazine on a
-- rifle simply took it out of the rig and left it in the bag.
--
-- Where it landed comes from the menu's own hover record - the same
-- field the hover hotkeys read - so it works over the bag, the
-- equipment slots and the middle column alike, and needs no geometry of
-- its own.
--
-- The magazine mod's handler is called rather than reimplemented: it
-- owns compatibility, the grenade-launcher case, the reload animation
-- and the timing.
-- ============================================================
function A.give_to_weapon(i, n)
	local mag = i and A.slot_obj(i, n)
	if not mag then return false end

	local m = mags()
	if not (m and type(m.on_item_drag_dropped) == "function") then return false end

	local gui = gui_now()
	if not (gui and gui.hover and gui.hover.bag and gui.hover.idx) then
		return false
	end

	local cc = gui.CC and gui.CC[gui.hover.bag]
	if not cc then return false end

	local ok, target = pcall(function() return cc:GetObj(gui.hover.idx) end)
	if not (ok and target) then return false end

	local isw
	ok, isw = pcall(IsWeapon, target)
	if not (ok and isw) then return false end

	if mag_busy() then
		notify("Busy with another magazine")
		return true
	end

	local edd = EDDListType
	if not edd then return false end

	-- A weapon in a slot is iActorSlot and one in the bag is iActorBag.
	-- The handler tests the pair and returns silently for any other, so
	-- a wrong answer here looks exactly like the bug this fixes.
	local to = (gui.hover.bag == "actor_equ" or gui.hover.bag == "actor_slot")
	           and edd.iActorSlot or edd.iActorBag

	local done, err = pcall(m.on_item_drag_dropped, mag, target,
	                        edd.iActorBag, to)
	if not done then log("!mag to weapon: %s", tostring(err)) end
	return true
end

-- ============================================================
-- HOVERING A POCKET HIGHLIGHTS THE AMMO THAT FITS IT
--
-- Focusing an item in the inventory highlights everything compatible
-- with it: the ammo for a magazine, the magazines for a weapon. That is
-- the engine callback ActorMenu_on_item_focus_receive, and it fires on
-- a CELL. A pocket is not a cell in any container the menu knows, so
-- hovering a magazine in the rig lit nothing up, while the same
-- magazine two inches away in the bag did.
--
-- The callback is SENT rather than the magazine mod being called
-- directly: several mods listen for it - the magazine system, the
-- highlight addons - and picking one of them to notify would light up
-- some of what the bag lights up and not the rest.
--
-- Edge-triggered. These callbacks are a hover CHANGING, not a state,
-- and firing "focus received" every frame would have every listener
-- rebuilding its highlight table sixty times a second.
-- ============================================================
A.focus_id = A.focus_id or nil

function A.focus_follow(i)
	local obj = i and A.slot_obj(i) or nil
	local id = obj and obj:id() or nil

	if id == A.focus_id then return end

	-- The column is ours to light, and it is where the ammunition now
	-- lives. Before the callbacks, so that a listener which reads the
	-- screen sees the finished state.
	-- BARE, not rawget: Anomaly's loader is lazy and rawget answers nil
	-- for a script nothing has touched yet. SendScriptCallback lives in
	-- _g.script, which is always loaded - but the rule in this file is
	-- one rule, and an exception here would be the third time that
	-- mistake shipped.
	local send = SendScriptCallback

	if type(send) ~= "function" then
		A.focus_id = id
		return
	end

	-- The old one loses focus first, exactly as the menu does it: a
	-- listener that clears on lost and sets on receive would otherwise
	-- be left holding both.
	if A.focus_id then
		local was = level.object_by_id(A.focus_id)
		if was then
			pcall(send, "ActorMenu_on_item_focus_lost", was)
		end
	end

	if obj then
		pcall(send, "ActorMenu_on_item_focus_receive", obj)
	end

	-- ============================================================
	-- AND SAY THAT IT WENT
	--
	--   "when hovering over a mag in inventory highlight compatibile
	--    ammo, and that does not work for mags that are in rig"
	--
	-- This is sent, and has been for releases. So either it is not
	-- being sent - which this line settles in one log - or it is, and
	-- something is putting the highlight out again afterwards: the
	-- window calls UnHighlight_All whenever its own hover changes, and
	-- moving the cursor onto a pocket IS its hover changing, to
	-- nothing.
	--
	-- Those two want completely different fixes, and they have looked
	-- identical from outside the game. One line.
	-- ============================================================
	dbg("focus %s -> %s%s", tostring(A.focus_id), tostring(id),
	    obj and (" (" .. tostring(obj:section()) .. ")") or "")

	A.focus_id = id
end

-- ============================================================
-- ...AND THE HIGHLIGHT HAS TO BE DONE HERE TOO
--
-- Sending the callback is not enough, and this is why the first
-- attempt changed nothing on screen. What the magazine mod does with
-- it is
--
--     inventory:highlight_section_in_slot(sec, EDDListType.iActorBag)
--
-- which lights up cells in the game's OWN actor bag list. This mod has
-- moved every magazine and every box of ammo out of that list and into
-- a container of its own - so the callback fired, the game highlighted
-- the bag, and the bag no longer holds the thing being highlighted.
--
-- The callback is still sent, because other mods listen for it and
-- some of them are not about cells at all. This does the part that is
-- ours: the column is our container, so we light it ourselves, through
-- the same UICellItem:Highlight the menu uses on hover.
--
-- Only the cells WE lit are put out again. The container highlights the
-- cell under the cursor on its own, and clearing everything would fight
-- it once a frame.
-- ============================================================
-- ============================================================
-- THE TOOLTIP FOR A POCKET
--
-- Same call the container makes for a hovered cell, with the same
-- three arguments. `flags` is a table the info window reads trade
-- notes out of; a pocket has none, so it gets an empty one that is
-- reused rather than made every frame.
-- ============================================================
A.tip_flags = A.tip_flags or {}

function A.tip_for_pocket(item_info, no_info)
	if no_info then return false end
	if type(item_info) ~= "table" and type(item_info) ~= "userdata" then
		return false
	end
	if type(item_info.Update) ~= "function" then return false end

	local i, n = A.slot_at()
	local obj = i and A.slot_obj(i, n)
	if not obj then return false end

	item_info:Update(obj, obj:section(), A.tip_flags)
	return true
end

-- ============================================================
-- DROPPING AMMO ONTO A MAGAZINE IN A POCKET
--
-- In the bag, dragging a box of ammo onto a magazine loads it. That is
-- the engine's ActorMenu_on_item_drag_drop callback, which fires when
-- one CELL is dropped on another - and a pocket is not a cell in any
-- container the menu knows, so the callback never fired and the drop
-- got "Only magazines go in the pouches" instead. The magazine was
-- reachable in the bag and not in the rig, which is exactly backwards.
--
-- The magazine mod's own handler is CALLED rather than reimplemented:
-- it owns the compatibility test, the three load behaviours, the
-- animation and the timing, and every one of those is a thing to get
-- subtly wrong twice. Both slots are iActorBag because that is what the
-- drop is - one item in the actor's inventory onto another.
--
-- The caliber is checked here first, only so an ammo that does not fit
-- says so rather than doing nothing.
-- ============================================================
-- `i` is the slot and `n` the pile in it; the top of that pile is the
-- magazine being loaded, which is the one the player can see.
function A.load_from_drop(obj, i, n)
	local P = i and A.pk[i]
	local e = P and P.slots[n or 1]
	local id = e and e.ids[#e.ids]
	local into = id and level.object_by_id(id)
	if not (obj and into) then return false end
	return A.load_onto(obj, into)
end

-- ============================================================
-- A BOX OF AMMO, LET GO ON A MAGAZINE
--
-- Split out of the pocket drop because the middle column needs exactly
-- the same thing and must not have its own copy of it: the column is
-- where every magazine that is NOT in the rig now lives, and a drop
-- there was being swallowed whole. See the note in On_CC_DragDrop.
-- ============================================================
function A.load_onto(obj, mag)
	if not (obj and mag) then return false end

	local ok, ammo = pcall(IsAmmo, obj)
	if not (ok and ammo) then return false end

	local okm, msec = pcall(function() return mag:section() end)
	if not (okm and A.is_mag(msec)) then return false end

	local m = mags()
	if not (m and type(m.on_item_drag_dropped) == "function") then return false end

	if mag_busy() then
		notify("Busy with another magazine")
		return true
	end

	-- BARE, for the lazy loader, like every other reach into that mod.
	local mb = magazine_binder
	if mb and type(mb.get_magazine_caliber) == "function" then
		local got, cals = pcall(mb.get_magazine_caliber, mag)
		if got and type(cals) == "table" then
			local sec, takes = obj:section(), false
			for n = 1, #cals do
				if cals[n] == sec then takes = true break end
			end
			if not takes then
				notify("That magazine does not take this ammunition")
				return true
			end
		end
	end

	local edd = EDDListType and EDDListType.iActorBag
	if not edd then return false end

	local done, err = pcall(m.on_item_drag_dropped, obj, mag, edd, edd)
	if not done then log("!load from drop: %s", tostring(err)) end
	return true
end

-- ============================================================
-- SHIFT + CLICK A POCKET UNLOADS IT
--
-- magazines_keybinds gives shift+click on a magazine in the bag or on a
-- corpse straight to func_unload_ammo. It gets there by wrapping
-- On_CC_Mouse1, which the rig never reaches: the rig's cells are not in
-- GUI.CC, and this mod eats the click before the containers see it.
-- So the same gesture is answered here, on the same terms, calling the
-- same function.
--
-- The shift test reads the keyboard directly rather than trusting
-- GUI.holding_shift, because the release that gets here has already
-- passed through UIInventory:OnKeyboard, and a shift released a frame
-- earlier would have cleared that flag.
-- ============================================================
local function shift_held()
	local ok, down = pcall(function()
		return (key_state(DIK_keys.DIK_LSHIFT) or 0) ~= 0
		    or (key_state(DIK_keys.DIK_RSHIFT) or 0) ~= 0
	end)

	return ok and down
end

-- ============================================================
-- PICKING A MAGAZINE UP OUT OF A POCKET
--
-- The press only ARMS the drag: it records the pocket and the moment,
-- and nothing is drawn until DRAG_MS has passed, so a quick click on a
-- pocket is still a click and only a press that is held turns into a
-- carry.
--
-- Shift is excluded on purpose: shift+click over a pocket already means
-- "unload this magazine", and a gesture that both unloaded a magazine
-- and started carrying it would do one of the two by accident every
-- time.
-- ============================================================
function A.press_m1()
	A.cursor_dirty()
	if A.pk_drag then return end
	if shift_held() then return end

	-- ------------------------------------------------------------
	-- THE OPEN RIG FIRST, and on its own terms: it is a window on top
	-- of the inventory, so a press inside it is never a press on the
	-- panel underneath - even where the two overlap.
	-- ------------------------------------------------------------
	local wk = A.win_shown() and A.win_hit()
	if wk then
		-- THE HEADER IS THE HANDLE. Before the pockets, because the
		-- title bar holds none - and after the close box, which
		-- win_over_head already stands aside for.
		if A.win_grab() then
			dbg("open rig: picked window %s up by its header", tostring(wk))
			return
		end

		local w = A.wins[wk]

		-- A BOX IS PICKED UP BY THE SQUARE THE CURSOR IS ON, and which
		-- square of the item that is has to be remembered: it is what
		-- makes a two-wide item stay under the cursor where it was taken
		-- hold of rather than snapping its corner to the pointer.
		if w.kind == "box" and w.cols then
			local cell = A.win_at(wk)
			local t = w.id and A.boxes[w.id]

			if cell and t then
				local r = math.floor((cell - 1) / w.cols) + 1
				local c = (cell - 1) % w.cols + 1
				local n = A.box_on(t, r, c)

				if n then
					A.win_drag = { k = wk, i = n, box = true,
					               dr = r - t[n].r, dc = c - t[n].c,
					               tg = time_global() }
					local gui = gui_now()
					if gui then gui.item_in_hold = CC_ID end
					dbg("box: picked up %s at %s,%s",
					    tostring(t[n].sec), tostring(r), tostring(c))
				end
			end

			return
		end

		-- ONE PRESS, TWO COORDINATES: which slot, and which pile in it.
		-- There used to be three branches here - the med pocket, the
		-- med pouches' pockets and the magazine pockets - and they had
		-- to be asked in an order nobody could see a reason for. Every
		-- slot is a grid now, so there is one.
		local i = A.win_at(wk)
		local e = i and A.win_pk_at(wk, i)
		local t = i and A.win_pk(wk, i)

		if i and e and t and t[e] then
			A.win_drag = { k = wk, slot = i, i = e, tg = time_global() }
			local gui = gui_now()
			if gui then gui.item_in_hold = CC_ID end
			dbg("open rig: picked up pocket %s", tostring(i))
		end

		return
	end

	-- The pin and the close box need no test of their own: both live in
	-- the title bar and A.slot_at only answers for pocket rectangles, so
	-- a press up there finds no pocket and stops here.
	-- A pouch slot is not a pocket and holds no magazine, so a press on
	-- one starts nothing. Without this the press falls through to the
	-- pocket test, finds none, and is merely harmless - but saying so
	-- here is what keeps the two kinds of slot from ever being confused.
	if A.rig_at() then return end
	if A.pouch_at() then return end

	-- ============================================================
	-- A PRESS ON A MED SQUARE PICKS THE WHOLE STACK UP
	--
	--   "those items should be able to be picked up with mouse, like
	--    magazines."
	--
	-- Before the pocket test, and it returns whether or not it found
	-- something: a press anywhere on the med pocket is about the med
	-- pocket, and falling through would have it looked for among the
	-- magazine pockets it is nowhere near.
	-- ============================================================
	local pmi = A.pk_over()
	if pmi then
		local P = A.pk and A.pk[pmi]
		local n = A.pk_at(pmi)
		if P and n and P.slots[n] and #P.slots[n].ids > 0 then
			A.pk_drag = { i = pmi, n = n, tg = time_global() }
			local gui = gui_now()
			if gui then gui.item_in_hold = CC_ID end
		end
		return
	end

	dbg("press: nothing under the cursor")
end

-- ============================================================
-- THERE IS ONE DRAG ON THE PANEL NOW, AND IT IS A SQUARE
--
-- A.drag_end is gone with A.drag. It handled the OTHER kind: one
-- magazine picked up off a whole pocket, which is what a pocket was
-- when it held exactly one thing. A slot holds a grid of squares, so
-- every press on the panel picks up a SQUARE - A.pk_drag - and there
-- is one release path for it, above in A.release_m1.
-- ============================================================



function A.win_drop()
	local d = A.win_drag
	if not d then return false end

	A.win_drag = nil

	local gui = gui_now()
	if gui and gui.item_in_hold == CC_ID then gui.item_in_hold = false end

	-- ------------------------------------------------------------
	-- OUT OF A BOX. Three places, the same three the rig window has,
	-- minus the panel: a rig pocket takes magazines and a box does not
	-- hold any, so there is nothing to hand it.
	--
	-- Letting go over a RIG window is deliberately nothing rather than
	-- an error. The two carry different things; a drop that crosses
	-- between them is a slip, and a slip should leave the item where it
	-- was, not throw it on the floor.
	-- ------------------------------------------------------------
	if d.box then
		local from = A.wins[d.k]
		local tk = A.win_hit()
		local tw = tk and A.wins[tk]

		if from and from.id then
			if tw and tw.kind == "box" and tw.id then
				-- WHETHER IT FITS IS box_move'S QUESTION, not this one.
				-- The two boxes have different answers - inside one box a
				-- square that is taken means the item does not move at
				-- all, between two it means anywhere in the destination
				-- will do - and asking here as well would either impose
				-- one of those answers on both or state the rule twice.
				-- What the hover is for is WHERE, which is the square the
				-- highlight was drawn on.
				local hr, hc = A.box_hover(tk, d)
				if hr then
					A.box_move(from.id, d.i, tw.id, tw.sec, hr, hc)
					dbg("box: %s/%s -> %s at %s,%s", tostring(d.k),
					    tostring(d.i), tostring(tk), tostring(hr), tostring(hc))
				else
					dbg("box: %s/%s was let go over no square",
					    tostring(d.k), tostring(d.i))
				end
			elseif not tk then
				A.box_take(from.id, d.i, from.sec)
				dbg("box: %s/%s -> the bag", tostring(d.k), tostring(d.i))
			else
				dbg("box: %s/%s stayed", tostring(d.k), tostring(d.i))
			end
		end

		-- THE TURN IS SPENT WITH THE DROP, whichever way it went: the
		-- hand is empty now and the poll would clear the flag next
		-- frame anyway, but a flag that outlives its drag even for a
		-- frame is a flag somebody eventually reads stale.
		A.rot_hand = nil

		if gui then pcall(function() gui:On_Item_Update() end) end
		return true
	end

	-- WHICH WINDOW IT WAS LET GO OVER, which need not be the one it came
	-- out of: two rigs open and something moved between them is the
	-- whole reason there are two.
	local tk = A.win_hit()
	local to = tk and A.win_at(tk) or nil

	-- The rig on your chest is a fourth place to let go, and the one
	-- everybody tries first.
	local pocket, pn = nil, nil
	if not tk and A.open then pocket, pn = A.slot_at() end

	if tk and to then
		local r, c = A.win_pk_rc(tk, to)
		A.win_move(d.k, d.slot, d.i, tk, to, r, c)
		dbg("open rig: %s/%s/%s -> %s/%s", tostring(d.k), tostring(d.slot),
		    tostring(d.i), tostring(tk), tostring(to))
	elseif pocket then
		local ar, ac = A.pk_rc(pocket)
		local moved = 0
		while A.win_to_panel(d.k, d.slot, d.i, pocket, ar, ac) do
			moved = moved + 1
			local t = A.win_pk(d.k, d.slot)
			if not t[d.i] then break end
		end
		dbg("open rig: %s/%s/%s -> the panel, slot %s (%s)",
		    tostring(d.k), tostring(d.slot), tostring(d.i),
		    tostring(pocket), tostring(moved))
	elseif not tk then
		A.win_take(d.k, d.slot, d.i)
		dbg("open rig: %s/%s/%s -> the bag", tostring(d.k),
		    tostring(d.slot), tostring(d.i))
	else
		dbg("open rig: %s/%s/%s stayed", tostring(d.k),
		    tostring(d.slot), tostring(d.i))
	end

	if gui then pcall(function() gui:On_Item_Update() end) end
	return true
end

function A.release_m1()
	A.cursor_dirty()

	-- Put the window down first: while it is being carried nothing else
	-- on screen is what this click is about, and a header dragged over
	-- the close box must not close it on the way past.
	if A.win_drop_head() then return end

	-- BEFORE everything else, for the same reason the press is: the
	-- open rig is on top, and a drop that ends inside it belongs to it.
	if A.win_drop() then return end

	-- A CLICK ON A FILLED DEVICE SLOT TAKES IT OFF - if the Wearable
	-- Devices patch is installed. Without it this is a call that
	-- returns false, which is cheaper than a branch somebody has to
	-- remember to write.
	if A.enabled and A.wd_click() then return end

	local xk = A.win_shown() and A.win_hit()
	if xk and A.win_over_close(xk) then
		A.win_close(xk, "you clicked its x")
		return
	end

	-- ============================================================
	-- CLICKING THE SLOT OPENS THE PANEL
	--
	-- The open entry lives on the rig item, and a worn rig is HIDDEN from
	-- the bag - so the moment you put one on, the one thing carrying the
	-- entry became the one thing you could no longer right-click, and
	-- there was no way to open the panel at all.
	--
	-- The slot is always on screen and is where the rig is, so it is the
	-- way in. Before the drag check: nothing can be dragged FROM the
	-- slot, so a click on it is always a click.
	-- ============================================================
	if A.rig_at() then
		-- Docked, the panel is always open and the click does nothing.
		if A.rig_sec() then A.open = not A.open end
		return
	end


	-- ============================================================
	-- LETTING GO OF A SQUARE OUT OF THE RIG
	--
	-- FOUR PLACES AND NO FIFTH:
	--
	--   its own slot        move the pile within it, or turn it in
	--                       place with the R key held
	--   another slot        hand the whole pile across
	--   an open rig window  it crosses from objects to records
	--   anywhere else       the whole square goes into your bag
	--
	-- The last one is deliberately the default rather than "nothing
	-- happened": there is nowhere else for it to go, and a drag that
	-- ended in the air over the inventory obviously meant the bag.
	-- ============================================================
	if A.pk_drag then
		local i, n = A.pk_drag.i, A.pk_drag.n
		local back = A.pk_over()
		local P = A.pk and A.pk[i]

		A.pk_let_go()

		local refresh = function()
			local g = gui_now()
			if g and g.On_Item_Update then
				pcall(function() g:On_Item_Update() end)
			end
		end

		-- AN OPEN RIG IS ON TOP OF THE PANEL, so it is asked first: a
		-- drop that lands inside one belongs to it, not to whatever
		-- slot of the panel is underneath.
		local wk = A.win_shown() and A.win_hit() or nil
		local wi = wk and A.win_at(wk) or nil

		if P and back == i then
			-- Its own slot: move the pile within, or turn it in place.
			local mr, mc = A.pk_rc(i)
			if mr and A.pk_shift(P.slots, P.cols, P.rows, n, mr, mc) then
				dbg("drop: square %s,%s moved to %s,%s",
				    tostring(i), tostring(n), tostring(mr), tostring(mc))
			end

		elseif P and wk and wi then
			-- Across to a rig you are not wearing: object to record.
			local wr, wc = A.win_pk_rc(wk, wi)
			local moved = 0
			while A.panel_to_win(i, n, wk, wi, wr, wc) do
				moved = moved + 1
				local still = P.slots[n]
				if not (still and still.sec and #still.ids > 0) then break end
			end
			dbg("drop: square %s,%s -> window %s slot %s (%s)",
			    tostring(i), tostring(n), tostring(wk), tostring(wi),
			    tostring(moved))
			refresh()

		elseif P and back and A.pk[back] then
			-- Another slot of the same rig.
			local mr, mc = A.pk_rc(back)
			local moved = A.pk_move(P, n, A.pk[back], mr, mc)
			dbg("drop: square %s,%s -> slot %s (%s)",
			    tostring(i), tostring(n), tostring(back), tostring(moved))
			refresh()

		elseif P then
			local out = A.pk_out_all(P, n)
			dbg("drop: square %s,%s -> the bag (%s)",
			    tostring(i), tostring(n), tostring(out))
			refresh()
		end
		return
	end

	if A.over_pin() then
		A.pinned = not A.pinned
		notify(A.pinned and "Rig pinned - it stays open"
		                 or "Rig unpinned - it closes with the inventory")
		return
	end

	if A.over_close() then
		-- Closing it by hand means closing it, pinned or not. The pin
		-- decides what happens when the INVENTORY closes, which is a
		-- different question from what happens when you click the X.
		A.open = false
		A.hide()
		return
	end

	if shift_held() then A.hotkey("unload") end
end

-- ============================================================
-- THE HOVER HOTKEYS
--
-- The magazine mod binds three keys that act on whatever the cursor is
-- over: load, unload, and toggle-loadout. Its handler finds that item
-- through ui_inventory.GUI.hover, and then checks the container name
-- against a list of four - actor_bag, actor_equ, actor_belt,
-- actor_quick. The rig is none of them, so over a pocket the keys did
-- nothing, and a magazine in the rig had to be dragged out before it
-- could be filled.
--
-- Pointing GUI.hover at the rig was the obvious fix and is the wrong
-- one twice over: the container's name would still fail that list of
-- four, and GUI.hover is read by half the inventory as a cell index
-- into GUI.CC[bag] - a table the rig is deliberately not in. (The rig's
-- OWN container keeps its own hover, which is a different field and is
-- what the drag reads.)
--
-- So the three actions are answered here, by the same public functions
-- the magazine mod's own handler calls, on the pocket under the cursor:
--
--   load     the marked ammo, or the auto pick when untagged loading is
--            on - the same choice mag_mark_hotkeys makes, because it is
--            the same two calls into mag_marks
--   unload   func_unload_ammo, unchanged
--   loadout  in the bag this toggles whether a magazine counts toward
--            the loadout. In the rig that question is already answered:
--            it is in a pocket, so it IS the loadout. The honest
--            equivalent is taking it out, which is what the key does
--            here - and which then unsets carried through the ordinary
--            path, so the two mods stay in agreement.
-- ============================================================
function A.hotkey(what)
	A.cursor_dirty()
	if not (A.enabled and A.open and editing_allowed()) then return false end

	local i, n = A.slot_at()
	if not (i and A.pk[i] and A.pk[i].slots[n or 1]) then return false end

	-- Loadout is this mod's own bookkeeping and is answered whether or
	-- not a magazine mod is loaded. The other two ARE the magazine mod.
	if what == "loadout" then
		A.take(i, n)
		local gui = gui_now()
		if gui then pcall(function() gui:On_Item_Update() end) end
		return true
	end

	local m = mags()
	if not m then return false end

	-- A load or unload already running owns the actor's hands. Starting
	-- a second one is how a magazine ends up with rounds in it that the
	-- mod has already counted somewhere else.
	if mag_busy() then return false end

	local obj = A.slot_obj(i, n)
	if not obj then return false end

	if what == "unload" then
		if type(m.func_unload_ammo) ~= "function" then return false end

		local ok, err = pcall(m.func_unload_ammo, obj)
		if not ok then log("!unload: %s", tostring(err)) end
		return ok
	end

	if what == "load" then
		if type(m.begin_mag_load) ~= "function" then return false end

		-- BARE, not rawget. Anomaly's script loader is lazy: a script
		-- is not a field of _G until something asks for it through
		-- __index, so rawget reads nil for a mod that is installed
		-- and working. The column's copy of this always read it
		-- bare; this one did not, and quietly answered "no marks"
		-- until something else had loaded the magazine mod first.
		local mm = mag_marks
		if type(mm) ~= "table" then return false end

		local ammo
		local ok = pcall(function()
			local mark = mm.get_mark and mm.get_mark(obj:id())

			if mark then
				ammo = mm.find_best_ammo and mm.find_best_ammo(obj, mark)
			elseif mag_cfg("untagged_load") then
				ammo = mm.find_auto_ammo and mm.find_auto_ammo(obj)
			end
		end)

		-- No mark and no automatic pick means there is nothing on hand
		-- this magazine takes. Silence is the same answer the bag gives.
		if not (ok and ammo) then return false end

		local started
		ok, started = pcall(m.begin_mag_load, obj, ammo)
		if not ok then log("!load: %s", tostring(started)) end
		return ok and started and true or false
	end

	return false
end

-- ============================================================
--  THE SAME THREE KEYS, OVER THE MIDDLE COLUMN
--
--  mag_mark_hotkeys answers load/unload/loadout for whatever the cursor
--  is over, and gates them on a table of four container names:
--
--      local actor_bags = { actor_bag, actor_equ, actor_belt,
--                           actor_quick }
--
--  It is a file-local in that mod, so it cannot be added to from here -
--  and the column is not one of the four. Moving the magazines into it
--  therefore took the keys away from exactly the items they are for:
--  load, unload, and the loadout key, which with the rig on is how a
--  magazine gets INTO the rig without dragging it.
--
--  So the three actions are answered here for an item in the column,
--  through the same public functions that mod calls - the same approach
--  1.4.0 took for the pockets, for the same reason.
--
--  A.hotkey stays as it is: it acts on the POCKET under the cursor,
--  where "loadout" means take it out. This one acts on a magazine in a
--  list, where "loadout" means the same thing it means in the bag.
-- ============================================================
function A.hotkey_item(what, obj)
	if not (A.enabled and editing_allowed() and obj) then return false end

	-- REACHED AS A PLAIN GLOBAL. Anomaly's script loader is lazy: a
	-- module becomes a field of _G only when something touches it
	-- through __index, so rawget reads nil for an installed, working
	-- framework. That mistake cost this mod two releases against the HD
	-- icon framework; it is not repeated here.
	local mb = magazine_binder
	local m = mags()

	if what == "loadout" then
		if not (mb and type(mb.toggle_carried_mag) == "function") then
			return false
		end

		-- ============================================================
		-- REFUSING OUT LOUD
		--
		-- toggle_carried_mag answers nil for "no room" and the key then
		-- did nothing at all, with no message anywhere - so a magazine
		-- this rig cannot hold looked exactly like a keybind that had
		-- stopped working. Taking one OUT always worked, which is what
		-- made it read as random.
		--
		-- It is a shape question far more often than a full-rig one:
		-- with an icon pack installed, 19 magazines in the reference
		-- install are 1x3 and 19 are 2x2, and a rig takes those only if
		-- it has a pouch that shape.
		--
		-- ONLY AN ADD CAN GET HERE. toggle_carried_mag answers FALSE
		-- for a removal, which is a real answer, and nil only when it
		-- refused to add - so there is no need to ask beforehand which
		-- direction this was, and no risk of refusing to take out a
		-- magazine whose pocket the rig no longer has.
		-- ============================================================
		local sec = obj:section()
		local ok, res = pcall(mb.toggle_carried_mag, obj:id())

		if not (ok and res ~= nil) then
			-- WHY, not just no. Asking this mod's own model first is
			-- what keeps the message true: if the rig has no pocket
			-- this magazine's shape, say so and say which shape,
			-- because that is a fact the player can act on. A refusal
			-- from the magazine system for a reason of its own gets its
			-- own, vaguer line rather than borrowing this one.
			if A.rig_id and not A.slot_free(sec) then
				local cw, ch = A.cells(sec)
				notify("Nothing in the rig has room for a %dx%d",
				       tonumber(cw) or 1, tonumber(ch) or 1)
			else
				notify("That magazine could not be added to the loadout")
			end
			return true
		end

		-- The magazine mod refreshes its own bookkeeping the same way
		-- after the same call.
		if m and type(m.inventory_refresh) == "function" then
			pcall(m.inventory_refresh)
		end

		local gui = gui_now()
		if gui then pcall(function() gui:On_Item_Update() end) end
		return true
	end

	if not m then return false end
	if mag_busy() then return false end

	if what == "unload" then
		if type(m.func_unload_ammo) ~= "function" then return false end
		local ok, err = pcall(m.func_unload_ammo, obj)
		if not ok then log("!unload in column: %s", tostring(err)) end
		return ok
	end

	if what == "load" then
		if type(m.begin_mag_load) ~= "function" then return false end

		local mm = mag_marks
		if type(mm) ~= "table" then return false end

		local ammo
		local ok = pcall(function()
			local mark = mm.get_mark and mm.get_mark(obj:id())
			if mark then
				ammo = mm.find_best_ammo and mm.find_best_ammo(obj, mark)
			elseif mag_cfg("untagged_load") then
				ammo = mm.find_auto_ammo and mm.find_auto_ammo(obj)
			end
		end)
		if not (ok and ammo) then return false end

		local started
		ok, started = pcall(m.begin_mag_load, obj, ammo)
		if not ok then log("!load in column: %s", tostring(started)) end
		return ok and started and true or false
	end

	return false
end

-- Bwais's Magazine UI Overhaul defines this global and owns the hover
-- keys when it is installed; the magazine mod's own handler stands down
-- for it, and so does this one, or one keypress does the job twice.
local function bwais_owns_hotkeys()
	return rawget(_G, "simple_load_magazine") ~= nil
end

local base_InvKeyboard = ui_inventory.UIInventory.OnKeyboard

function ui_inventory.UIInventory:OnKeyboard(dik, keyboard_action)
	A.cursor_dirty()

	-- ONE OUT OF THE STACK IN HAND. Before everything else, because
	-- while a box entry is on the cursor this key means nothing else -
	-- and swallowed only when it did something, so a key that found no
	-- stack still reaches whoever else wants it.
	if A.enabled and keyboard_action == ui_events.WINDOW_KEY_PRESSED
		and dik == A.split_key()
	then
		local ok, did = pcall(A.box_take_one)
		if not ok then log("!box split: %s", tostring(did)) end
		if ok and did then return true end

		-- ...AND THE SAME KEY FOR A SQUARE OUT OF THE RIG. Only one of
		-- the two can be held at a time, so the order between them
		-- decides nothing; they are written one after the other because
		-- they are the same gesture on two kinds of stack.
		--
		-- THERE WERE FOUR OF THESE, and two named functions that no
		-- longer exist - A.med_take_one and A.win_med_take_one, the med
		-- pocket's and the open rig's. `pcall(nil)` is not a crash, so
		-- both sat here writing a line into the log on every press of
		-- the split key and nobody could see why it did nothing.
		local okpm, didpm = pcall(A.pk_take_one)
		if not okpm then log("!rig split: %s", tostring(didpm)) end
		if okpm and didpm then return true end
	end

	if A.enabled and A.open
		and keyboard_action == ui_events.WINDOW_KEY_PRESSED
		and not bwais_owns_hotkeys()
	then
		-- Only when the cursor is actually on a pocket. Everywhere else
		-- the key belongs to whoever else wants it, including the
		-- magazine mod's own handler over the bag.
		local i, n = A.slot_at()

		if i and A.pk[i] and A.pk[i].slots[n or 1] then
			local hit_key =
				  (dik == mag_cfg("key_load_mag")    and "load")
			   or (dik == mag_cfg("key_unload_mag")  and "unload")
			   or (dik == mag_cfg("key_loadout_mag") and "loadout")
			   or nil

			-- Swallowed only when this mod actually did something with
			-- it. A key that found nothing to do falls through, so an
			-- unconfigured or shared bind still reaches the game.
			if hit_key then
				local ok, did = pcall(A.hotkey, hit_key)
				if not ok then log("!hotkey %s: %s", hit_key, tostring(did)) end
				dbg("hotkey %s over pocket %s -> %s", hit_key, tostring(i),
				    tostring(ok and did))
				if ok and did then return true end
			end
		end
	end

	-- WHICH KEY ARRIVED AT ALL. "The bind does nothing" has two causes
	-- that look identical from the game - the key never reached this
	-- window, or it did and there was nothing under the cursor - and
	-- one line here separates them without another round trip.
	if A.enabled and A.debug
		and keyboard_action == ui_events.WINDOW_KEY_PRESSED
	then
		local k = mag_cfg("key_loadout_mag")
		if k and dik == k then
			-- ============================================================
			-- A DIAGNOSTIC MAY NOT TAKE THE GAME DOWN
			--
			--   "i tried to use quickadd to loudout keybind (thet worked
			--    before) and the game crashed"
			--
			--   attempt to call field 'list_hover_obj' (a nil value)
			--
			-- A.list_hover_obj was invented while writing this line and
			-- never written. It appeared once in the file, at this call
			-- site, and nowhere else - and it sat here harmlessly for
			-- releases because it is inside `if A.debug`. The player
			-- turned debug on because I asked them to, pressed the key,
			-- and it took their game down.
			--
			-- WHAT IS UNDER THE CURSOR, read the way everything else in
			-- this file reads it: the menu's own hover record, through
			-- the container's own GetObj. Not a helper of ours - there
			-- is no such helper, which is how this happened.
			--
			-- AND ALL OF IT INSIDE A pcall. The worst this line may now
			-- do is print `over=nil`. The audit checks that every
			-- A.something() call has a definition, which is what should
			-- have caught it the day it was written.
			-- ============================================================
			local over
			pcall(function()
				local g = gui_now()
				local cc = g and g.hover and g.hover.bag
				           and g.CC and g.CC[g.hover.bag]
				over = cc and g.hover.idx and cc:GetObj(g.hover.idx)
			end)

			dbg("loadout key %s seen | pocket=%s over=%s",
			    tostring(dik), tostring(A.slot_at()),
			    tostring(over ~= nil))
		end
	end

	return base_InvKeyboard(self, dik, keyboard_action)
end

-- ============================================================
-- RIGHT-CLICK A POCKET -> THE INVENTORY'S OWN MENU
--
-- NOT a close badge on the cell: a control that removes something on a
-- single click, sitting on top of the thing it removes, is the wrong
-- control for an action you do not want to take by accident.
--
-- Until now this menu had exactly ONE entry, "Take out of rig", which
-- made a magazine in a pocket LESS use than the same magazine in the
-- bag: no Unload ammo, no Retool, no mark, none of it. A pouch you have
-- to empty before you can work with what is in it is not a pouch.
--
-- So the menu is not built here at all. UIInventory:InitProperties is
-- the function the inventory itself calls on every right-click: it
-- walks self.properties, asks each entry whether it applies to this
-- object in this container in this mode, and shows what survives.
-- Handed the magazine, it produces exactly the menu the bag would -
-- including every functor another mod has injected, present and future,
-- without this file knowing one of their names.
--
-- THE CONTAINER IS DECLARED AS actor_equ, and that is worth writing
-- down. The rig is not the bag, and saying "actor_bag" would be a lie
-- with consequences: two entries there, Drop all and Move all, call
-- Cond_Childs, which looks the object up in self.CC[bag] and indexes
-- what it finds - and a pouched magazine is HIDDEN from the bag, so
-- there is no cell to find. actor_equ is the truthful answer anyway
-- (worn gear, not rucksack), every use*_containers line the magazine
-- mod ships names it, and Cont_Custom accepts it - so the whole
-- magazine menu comes through while the two entries that would have
-- indexed a nil cell exclude themselves by their own declarations.
-- ============================================================
function A.release_m2()
	A.cursor_dirty()

	-- ============================================================
	-- THE RIG SLOT'S MENU
	--
	-- Two entries, because the rig item itself is HIDDEN from the bag
	-- while it is worn - so the menu that used to live on it is out of
	-- reach exactly when you need it. Open/close and take-off both have
	-- to be reachable from the slot or they are not reachable at all.
	-- ============================================================
	if A.rig_at() then
		if not A.rig_sec() then return end

		local gui = gui_now()
		if not (gui and gui.item_props) then return end

		local ok, err = pcall(function()
			gui.item_props:Reset(GetCursorPosition(),
				{ "AMP_Toggle", "AMP_Strip" },
				{ A.open and "st_amp_close" or "st_amp_open", "st_amp_strip" },
				{ { 0 }, { 0 } })
		end)
		if not ok then log("!rig menu: %s", tostring(err)) end
		return
	end

	-- ============================================================
	-- THE BACKPACK SLOT'S MENU IS NOT OURS TO WRITE
	--
	-- Unlike the rig, a worn backpack is an ordinary object the menu
	-- already knows about, so the right answer is the menu it would
	-- have shown on the slot this replaces - take off, and whatever
	-- else any other mod has added to it. Writing our own would be a
	-- second, shorter list that quietly went out of date.
	-- ============================================================
	if A.pack_at() then
		local obj = A.pack_obj()
		if not obj then return end

		local gui = gui_now()
		if not gui then return end

		local ok, err = pcall(function() gui:InitProperties(obj, "actor_equ") end)
		if not ok then log("!backpack menu: %s", tostring(err)) end
		return
	end

	-- ============================================================
	-- AND THE DEVICE SLOTS GET THE MENU THEY WOULD HAVE HAD
	--
	--   "add option for those items to be clickable with rightlick to
	--    open their context menu (so add same interactions that they
	--    have when they would be in normal inventory."
	--
	-- Not a menu of ours. A worn device is still an ordinary object in
	-- the actor's inventory - that is the whole reason it is HIDDEN
	-- rather than taken - so the menu it should have is the one the bag
	-- itself would build for it, entries from every other mod included.
	-- Written by hand it would be a shorter list that went out of date.
	--
	-- AS EQUIPMENT, NOT AS BAG, and this is not a detail. A worn device
	-- is HIDDEN from the bag list, so it has no cell there - and the
	-- menu's own Cond_Childs does CC[bag]:GetCell_ID(id).ID, which
	-- indexes nil the moment the cell is missing. The whole menu then
	-- dies inside our pcall and the right-click does nothing at all.
	-- This is the same wall the rig hit, and the same answer: introduce
	-- it the way a worn thing is introduced.
	--
	-- "dont make them be able to be dragged out" needs nothing: a slot
	-- here is a rectangle this file paints and hit-tests, not a cell in
	-- a container, so there has never been anything for a drag to pick
	-- up.
	-- ============================================================
	if A.enabled and A.wd_rclick() then return end

	-- A pouch slot first: right-clicking a fitted pouch takes it out
	-- and hands the item back, which is the only way out of the slot.
	-- ============================================================
	-- A POUCH COMES OUT THROUGH A MENU, NOT A BARE RIGHT-CLICK
	--
	-- A pouch slot is a small target sitting among larger ones, and
	-- right-click used to detach on the press itself - so a miss aimed at
	-- a neighbouring pocket silently took a fitted pouch off the rig with
	-- nothing to confirm and nothing to undo. One entry, named, is the
	-- difference between an action and an accident.
	--
	-- Its own entry rather than InitProperties: a pouch is not in the
	-- actor's inventory while it is fitted (it was consumed on the way
	-- in), so there is no object to hand the stock menu, and every entry
	-- that menu would build is about an object.
	-- ============================================================
	local ps = A.pouch_at()
	if ps then
		if not A.pouch_in(ps) then return end

		local gui = gui_now()
		if not (gui and gui.item_props) then return end

		local ok, err = pcall(function()
			gui.item_props:Reset(GetCursorPosition(),
				{ "AMP_Detach" }, { "st_amp_detach" }, { { ps } })
		end)
		if not ok then log("!pouch menu: %s", tostring(err)) end
		return
	end

	local i, n = A.slot_at()
	local P = i and A.pk[i]
	local e = P and P.slots[n or 1]
	if not (e and #e.ids > 0) then return end

	local gui = gui_now()
	if not (gui and gui.item_props) then return end

	local obj = level.object_by_id(e.ids[#e.ids])
	if not obj then return end

	-- InitProperties reaches a dozen other mods' functors. One of them
	-- throwing must not take the right-click - or the inventory - down
	-- with it, and the fallback is the menu this mod shipped before.
	-- GAMMA exposes the stock Use entry to actor_bag but not actor_equ.
	-- Rig-pocket objects must remain actor_equ because they have no bag cell;
	-- temporarily extend only the Use property while this menu is built.
	local use_prop = gui.properties and gui.properties["use"]
	local use_cont = use_prop and use_prop.cont
	local added_equ = false
	if type(use_cont) == "table" then
		-- Support both the indexed container list used by stock GAMMA and
		-- keyed container sets used by UI/custom-functor revisions.
		if use_cont[EQU] == true then
			-- Already permitted.
		else
			local indexed = false
			for k = 1, #use_cont do
				if use_cont[k] == EQU then indexed = true break end
			end
			if not indexed then
				if #use_cont > 0 then
					use_cont[#use_cont + 1] = EQU
					added_equ = "indexed"
				else
					use_cont[EQU] = true
					added_equ = "keyed"
				end
			end
		end
	end
	-- Publish the exact synchronous menu context for injected functors (QAW
	-- in particular). pk_holds is rebuilt during some UI refreshes, but this
	-- marker remains authoritative for the menu currently being constructed.
	A.menu_item_id = obj:id()
	local ok, err = pcall(function() gui:InitProperties(obj, EQU) end)
	A.menu_item_id = nil
	if added_equ == "indexed" and type(use_cont) == "table" then
		for k = #use_cont, 1, -1 do
			if use_cont[k] == EQU then table.remove(use_cont, k) break end
		end
	elseif added_equ == "keyed" and type(use_cont) == "table" then
		use_cont[EQU] = nil
	end
	if ok then return end

	log("!menu: %s", tostring(err))

	pcall(function()
		gui.item_props:Reset(GetCursorPosition(),
			{ "AMP_Take" }, { "st_amp_unrig" }, { { i } })
	end)
end

function ui_inventory.UIInventory:AMP_Take(i)
	A.take(i)
	self:On_Item_Update()
end

-- Taking the rig off. The object is not touched - it has been in your
-- inventory the whole time and only hidden from the list - so this
-- cannot destroy anything, and the pockets empty through the ordinary
-- resolve.
-- Opening and closing from the slot's own menu, so the panel stays
-- reachable without hunting for an item that is hidden while worn.
function ui_inventory.UIInventory:AMP_Toggle()
	if A.rig_sec() then A.open = not A.open end
	self:On_Item_Update()
end

function ui_inventory.UIInventory:AMP_Strip()
	-- "it cannot be removed until player moves items around to make a
	--  2x3 empty space" - the check refuses HERE, on the menu action,
	--  and nowhere else: every other strip is the rig already leaving.
	if not A.strip_room() then
		self:On_Item_Update()
		return
	end
	A.strip_rig()
	self:On_Item_Update()
end

-- The menu entry a fitted pouch offers. unfit_pouch hands the item back
-- and only clears the slot if that worked, so a failed hand-back leaves
-- the pouch fitted rather than destroying it.
function ui_inventory.UIInventory:AMP_Detach(i)
	A.unfit_pouch(i)
	self:On_Item_Update()
end

-- ============================================================
-- "UNEQUIP" ON A POUCHED MAGAZINE MEANS TAKE IT OUT OF THE RIG
--
-- to_ruck is the one entry in the properties table with no
-- precondition at all: declared for actor_equ and actor_belt, it is
-- offered unconditionally. So handing InitProperties an actor_equ
-- magazine produces an "Unequip" entry whether this mod wants one or
-- not, and Action_UnEquip would move_to_ruck a magazine that is
-- ALREADY in the ruck - an entry that reads like it does something and
-- does nothing.
--
-- Rather than suppress it, it is given the meaning it should have had.
-- For a magazine in a pocket, the thing it is equipped IN is the rig,
-- so unequipping it is precisely taking it out of the rig. The entry
-- the take-out menu used to be is now that entry, and the menu has one
-- way to do it rather than two that look alike.
--
-- Both hooks key on A.by_id, so a magazine anywhere else - in the bag,
-- on a corpse, in a slot - reaches the stock function untouched.
-- ============================================================
local base_NameUnEquip = ui_inventory.UIInventory.Name_UnEquip

function ui_inventory.UIInventory:Name_UnEquip(obj, bag)
	if A.enabled then
		local o = (type(obj) == "number") and level.object_by_id(obj) or obj
		if o and A.pk_holds(o:id()) then return "st_amp_unrig" end
	end

	return base_NameUnEquip(self, obj, bag)
end

local base_ActionUnEquip = ui_inventory.UIInventory.Action_UnEquip

function ui_inventory.UIInventory:Action_UnEquip(obj, bag)
	if A.enabled then
		local o = (type(obj) == "number") and level.object_by_id(obj) or obj
		local id = o and o:id()

		if id and A.pk_holds(id) then
			A.pk_forget(id)
			A.uncarry(id)
			A.sfx("out")
			self:On_Item_Update()
			return
		end
	end

	return base_ActionUnEquip(self, obj, bag)
end

-- ============================================================
-- THE RIG'S POCKETS GO IN THE GAME'S OWN TOOLTIP
--
-- Wrapped rather than reimplemented: this runs after the description,
-- the weight and the stats have been laid out, so the pockets can be
-- put under them and the frame grown to cover the lot.
--
-- It has to run on EVERY call, including the two early returns inside
-- the base - "nothing hovered" and "same item as last frame" - because
-- the pockets are children of a window the base is about to show again
-- for a different item. Anything not hidden here comes back up under
-- somebody's medkit.
-- ============================================================
local base_InfoUpdate = utils_ui.UIInfoItem and utils_ui.UIInfoItem.Update

if base_InfoUpdate then
	function utils_ui.UIInfoItem:Update(obj, sec, flags)
		local r = base_InfoUpdate(self, obj, sec, flags)

		local ok, err = pcall(A.tip_attach, self, obj, sec)
		if not ok then
			log("!rig tooltip: %s", tostring(err))
			pcall(A.tip_hide)
		end

		return r
	end
end

-- ============================================================
-- WHAT A BOX'S ICON SAYS IN ITS CORNER
--
--   "all boxes rn have a 100% i guess durability marker in bottom left
--    corner, this is useless thing. so instead of that in this place
--    put summary of how much things inside weight (without counting
--    weight of the box itself)"
--
-- A box is built on an artefact section, so everything that draws a
-- condition draws one for it: a bar along the bottom and, with Item UI
-- Improvements installed, "100%" above it. A case does not wear out.
-- It is a number that has never been anything but 100 and never will
-- be, sitting in the one corner of the icon worth writing in.
--
-- WHAT GOES THERE INSTEAD IS ALREADY WORKED OUT. A.box_weight is what
-- box_lift asks before it lets one more thing in and what box_reweigh
-- adds to the section's own inv_weight - so this is not a new sum, it
-- is the sum the box has always kept, shown.
--
-- WITHOUT THE BOX ITSELF, as asked: box_weight is the contents alone.
-- The number beside it in the tooltip is the whole thing, and the two
-- disagreeing on purpose is the point - one of them answers "what am I
-- carrying", the other "what would I gain by emptying it".
-- ============================================================
-- A CLASS THIS FILE DOES NOT OWN AND CANNOT ASSUME. Every UI pack in
-- the Zone ships its own utils_ui; the one this is written against has
-- UICellItem, and a build that does not is a build where the corner
-- keeps saying 100% rather than a build that will not start.
local UCI = utils_ui.UICellItem
local base_CI_Update = UCI and UCI.Update
local base_CI_Reset  = UCI and UCI.Reset

function A.box_label_off(ci)
	if ci.amp_wt then A.wshow(ci.amp_wt, false) end
end

-- ============================================================
-- WHAT IT SAYS, AND HOW SHORT IT HAS TO BE
--
-- The plate is the game's count plate - eighteen pixels across at its
-- own size, which holds "x99" and not much more - and the smallest box
-- in the game is two cells wide. So the number is written the way a
-- weight is read rather than the way it is stored: a tenth of a kilo
-- matters when there is under ten of them in the box and stops
-- mattering above that.
--
--     0.4    2.5    12    140
--
-- No unit. The plate it is in is the one the inventory writes counts
-- in, in the corner where a percentage used to be, on a thing whose
-- tooltip says kilograms two lines down.
-- ============================================================
function A.wt_str(kg)
	if kg < 10 then return fmt_safe("%.1f", kg) end
	return fmt_safe("%d", math.floor(kg + 0.5))
end

function A.box_label(ci)
	if not (ci and ci.cell) then return end

	local sec = ci.section
	if not (A.enabled and ci.ID and A.is_box_sec(sec) and A.box_wt(sec)) then
		return A.box_label_off(ci)
	end

	-- THE CONDITION GOES, ALL OF IT. The bar is the base window's and
	-- the percentage belongs to another mod; both are put away here
	-- rather than prevented, because both are decided inside the call
	-- this one wraps and a flag set before it would be a guess about
	-- somebody else's order.
	if ci.bar then pcall(function() ci.bar:Show(false) end) end
	if ci.cond_text then pcall(function() ci.cond_text:Show(false) end) end
	if ci.cond_text_bg then
		pcall(function() ci.cond_text_bg:Show(false) end)
	end

	if not ci.amp_wt then
		ci.amp_wt = A.mkstatic(A.get_xml(), "amp:boxwt", ci.cell)
		if not ci.amp_wt then return end
	end

	local kg = A.box_weight(ci.ID)
	local txt = A.wt_str(kg)
	local ch = ci.cell:GetHeight()

	-- WIDE ENOUGH FOR WHAT IS IN IT. The plate is a texture that
	-- stretches, so a three-character number gets the plate the game
	-- would have drawn and a four-character one gets a slightly wider
	-- one rather than a clipped number.
	local pw = 8 + 5 * #txt
	A.wpos(ci.amp_wt, 1, ch - 11)
	A.wsize(ci.amp_wt, pw, 10)
	A.wglyph(ci.amp_wt, txt)
	A.wshow(ci.amp_wt, true)
end

if base_CI_Update then
	function UCI:Update(obj)
		local res = base_CI_Update(self, obj)
		pcall(A.box_label, self)
		return res
	end
end

-- A cell that has been emptied is not updated again, so what it was
-- last told to say would stay on it.
if base_CI_Reset then
	function UCI:Reset()
		pcall(A.box_label_off, self)
		return base_CI_Reset(self)
	end
end

local base_Update = utils_ui.UICellContainer.Update

function utils_ui.UICellContainer:Update(item_info, no_info, hide)
	local res = base_Update(self, item_info, no_info, hide)

	if A.ours(self.ID) then
		-- Anything that throws here gives an absent panel and an
		-- otherwise clean log, so it says so.
		local ok, err = pcall(A.draw, self)
		if not ok then log("!draw: %s", tostring(err)) end
	end

	-- ============================================================
	-- THE TOOLTIP, FROM EVERY CONTAINER'S UPDATE AND NOT ONE
	--
	-- This is how the bag does it, in the base of this very function:
	--
	--     item_info:Update( obj, ci.section, ci.flags )
	--
	-- for the cell under the cursor, once a frame. Nothing does it for
	-- a pocket, so a magazine in the rig had no description - which is
	-- the whole point of hovering one.
	--
	-- Asserted from EVERY container rather than from the panel's own
	-- draw, because the containers update in an order this mod does not
	-- set, and any of them whose window the cursor happens to be inside
	-- will call `item_info:Update()` with no arguments and put the
	-- tooltip away again. Re-asserting after each one means whichever
	-- runs last leaves the right thing on screen. It costs a call per
	-- container, and only while the cursor is on a pocket.
	-- ============================================================
	if item_info and A.enabled and A.open then
		local ok2, err2 = pcall(A.tip_for_pocket, item_info, no_info)
		if not ok2 then log("!tooltip: %s", tostring(err2)) end
	end

	-- ============================================================
	-- A POCKET UNDER THE CURSOR IS A CELL THE MENU HAS FOUND
	--
	--   "when hovering over a mag in inventory highlight compatibile
	--    ammo, and that does not work for mags that are in rig"
	--
	-- THE CALLBACK WAS NEVER THE PROBLEM. The log says it goes out,
	-- once per pocket the cursor crosses:
	--
	--     [AMP-DBG] focus nil -> 34819 (mag_mp443_9x19_default)
	--
	-- and the magazine mod answers it and highlights the ammunition.
	-- Then the menu puts it out again on the same frame:
	--
	--     self.found_cell = false
	--     for name,cc in pairs(self.CC) do
	--         if cc:IsShown() then
	--             self.found_cell = cc:Update(self.item_info, no_info)
	--                               or self.found_cell
	--         end
	--     end
	--     if (self.found_cell) then
	--         self:SetHint(false) self:Picker_Update() return
	--     else
	--         self.item_info:Update() self:UnHighlight_All()
	--     end
	--
	-- found_cell is "the cursor is over one of my cells". A pocket is
	-- not one of them, so it is false, so every highlight on screen is
	-- wiped - sixty times a second, for as long as you point at a
	-- pocket. Going up and coming down inside one frame looks, from
	-- outside the game, exactly like never going up at all.
	--
	-- SO SAY YES. The cursor IS over a cell; it is one of ours, drawn
	-- inside this very call a few lines up. That is the same answer
	-- this function gives for any cell of the bag's own, and found_cell
	-- is read in three places in the whole of ui_inventory - set false,
	-- set here, tested there - so there is nothing else to disturb.
	--
	-- NOT MERELY "OVER THE PANEL": A.focus_id is the magazine under the
	-- cursor, worked out by the draw above. An empty pocket leaves it
	-- nil and the menu clears highlights as it always has, which is
	-- what pointing at nothing should do.
	--
	-- AND ONLY FROM OUR OWN LISTS - this wrap runs for every container
	-- in every window, and the answer belongs to the ones the panel is
	-- drawn in.
	--
	-- NOT BY RE-SENDING THE CALLBACK EVERY FRAME, which fights the wipe
	-- instead of stopping it, and leans on a guard in the magazine mod
	-- that happens to be dead:
	--
	--     elseif (is_magazine(sec_focus) and sec_focus ~= focus_last_sec)
	--
	-- focus_last_sec is declared in that file and assigned nowhere in
	-- it, so the comparison is always true today. The day somebody
	-- finishes wiring it up, a re-send stops working and nothing says
	-- why.
	-- ============================================================
	if A.focus_id and A.ours(self.ID) then res = true end

	return res
end

-- Dropping a magazine on the rig files it in the pocket under the
-- cursor, or the first free one. Returning before base means the stock
-- handler never runs, so the item is not moved, equipped or dropped.
--
-- If this hook did nothing at all, On_CC_DragDrop's "no object to drop
-- on" branch would search GUI.CC for a container under the cursor, find
-- none (the rig is not in there), leave bag_to nil, and the item would
-- stay exactly where it was. The failure mode is "nothing happened".
-- ============================================================
-- WHERE THE COLUMNS ARE PUT IN ORDER
--
-- Reset is called for every mode - inventory, loot, trade, repair -
-- AFTER self.mode is set and after the UI pack has re-applied its own
-- styling. That last part is why it is here and not in InitControls:
-- this has to be the last word on where those windows are, and a mod
-- that styles the menu on every Reset would otherwise be having it.
--
-- The old three-column layout used exactly this hook for exactly this
-- reason, and the sentence is worth repeating rather than rediscovering.
-- ============================================================
local base_InvReset = ui_inventory.UIInventory.Reset

function ui_inventory.UIInventory:Reset(obj)
	if base_InvReset then base_InvReset(self, obj) end

	-- IN A pcall, like every other call into the menu here: a layout
	-- that cannot be applied must leave the inventory working, not take
	-- the menu down with it.
	pcall(A.cols_apply, self)
end

local base_DragDrop = ui_inventory.UIInventory.On_CC_DragDrop

function ui_inventory.UIInventory:On_CC_DragDrop(bag_from, idx_from)
	-- Where the item was let go, not where the last frame drew.
	A.cursor_dirty()

	-- ============================================================
	-- A DROP ON A DEVICE SLOT PUTS IT ON
	--
	-- First, because the three stand in the gutter where nothing else
	-- is, so the order costs nothing. FROM YOUR OWN LISTS ONLY: a
	-- bracer in a trader's window is not yours to wear.
	--
	-- RETURNING BEFORE THE BASE means the stock handler never runs, so
	-- the item is not moved or dropped - it stays in the inventory,
	-- which is exactly where the pack needs it: its own can_mount looks
	-- for it there, and its unmount_dropped would take the device off
	-- again the moment it left.
	-- ============================================================
	if A.enabled and A.wd_drop(self, bag_from, idx_from) then return end
	-- ============================================================
	-- THE RIG SLOT IS CHECKED FIRST, AND WITHOUT A.open
	--
	-- It lives outside the panel and is drawn whenever the inventory is,
	-- so a drop on it must work with the panel shut - which is the only
	-- state you can be in before there is a rig to open.
	-- ============================================================
	-- ============================================================
	-- A DROP ON THE BACKPACK SLOT PUTS IT ON
	--
	-- Before the rig, because the two are never in the same place and
	-- the order between them costs nothing - and through the menu's own
	-- Action_Equip rather than move_to_slot, so the sound, the
	-- animation hook and every mod wrapped round equipping happen
	-- exactly as they do for the slot this stands in for.
	--
	-- FROM YOUR OWN LISTS ONLY. A backpack in a trader's window is not
	-- yours to put on, and Action_Equip would be being asked to equip
	-- something the actor does not have.
	-- ============================================================
	-- ============================================================
	-- A DROP ON THE MED POCKET PUTS IT IN
	--
	-- Before the backpack slot and the rig, because the three are never
	-- in the same place and the order between them costs nothing.
	--
	-- FROM YOUR OWN LISTS ONLY. Something in a trader's window is not
	-- yours to pocket, and nothing here moves an object between owners
	-- - the whole gesture is "stop drawing it in the bag", which is
	-- meaningless for a bag that is not yours.
	--
	-- RETURNING BEFORE THE BASE means the stock handler never runs, so
	-- the item is not moved, equipped or dropped. It stays exactly
	-- where it is, in the actor's inventory, which is precisely where
	-- the pocket wants it.
	-- ============================================================
	-- ============================================================
	-- A DROP ON AN OPEN RIG
	--
	-- Before the worn rig's, because a window is on TOP of the panel:
	-- a drop that lands inside one belongs to it, whatever is
	-- underneath.
	--
	-- ONE BRANCH, WHERE THERE WERE THREE. The med pocket, the med
	-- pouches' pockets and the magazine pockets each had their own,
	-- asked in an order nobody could see a reason for. Every slot is a
	-- grid now, so there is one question: which slot, and which square
	-- of it.
	-- ============================================================
	if A.enabled and editing_allowed()
		and (bag_from == BAG or A.ours(bag_from))
	then
		local wk = A.win_shown() and A.win_hit()
		local wi = wk and A.wins[wk].kind ~= "box" and A.win_at(wk) or nil

		if wi then
			local cc = self.CC[bag_from]
			local obj = cc and cc:GetObj(idx_from)
			local sec

			if obj then pcall(function() sec = obj:section() end) end

			if type(sec) == "string" then
				local ok, why = A.pk_takes(sec)

				if not ok then
					notify("%s", why)
				else
					local wr, wc = A.win_pk_rc(wk, wi)
					local n = A.win_put(wk, obj, wi, cc, idx_from, wr, wc)

					if n == 0 then
						local cw, ch = A.cells(sec)
						notify("Nothing in that rig has room for a %dx%d",
						       tonumber(cw) or 1, tonumber(ch) or 1)
					else
						local w = A.wins[wk]
						if w and w.id then A.reweigh(w.id) end
						dbg("open rig: %s x%s into slot %s",
						    tostring(sec), tostring(n), tostring(wi))
					end
				end
			end

			self:On_Item_Update()
			return
		end
	end

	-- ============================================================
	-- ...AND A DROP ON THE RIG YOU ARE WEARING
	--
	-- The slot under the cursor if the thing will go there, otherwise
	-- wherever the packer puts it - A.pk_put_all decides, over the
	-- whole cell rather than the one object GetObj hands back, because
	-- a cell showing seven bandages is seven objects and taking them
	-- one drag at a time is what was reported.
	-- ============================================================
	local pmi = A.enabled and editing_allowed()
		and (bag_from == BAG or A.ours(bag_from)) and A.pk_over()

	if pmi then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)
		local sec
		if obj then pcall(function() sec = obj:section() end) end

		local P = A.pk and A.pk[pmi]

		if type(sec) == "string" and P then
			local ok, why = A.pk_takes(sec)

			-- THE DOOR SAYS WHAT THE HAND HELD. In a running game this
			-- drop lands unrotated while every suite says it must turn,
			-- and the log's repeat-collapse hides how often the hand
			-- toggled - so the door logs the one fact the suites cannot
			-- see: rot_hand at the exact moment of the drop.
			local dw, dh, drot = A.pk_turn(P, sec)
			dbg("slot door: %s hand=%s shape=%sx%s rot=%s",
			    tostring(sec), tostring(A.rot_hand), tostring(dw),
			    tostring(dh), tostring(drot))

			if not ok then
				notify("%s", why)
			elseif A.is_torn(pmi) then
				notify("That pouch is torn - mend the rig")
			else
				local mr, mc = A.pk_rc(pmi)
				local n = A.pk_put_all(P, cc, idx_from, mr, mc)

				-- IT DOES NOT HAVE TO BE THAT SLOT. Nothing went into
				-- the aimed one, so the packer is asked about the whole
				-- rig - which is what a drop onto a full pocket means
				-- when there is room two pockets along.
				if n == 0 then
					local objs = A.cell_objs(cc, idx_from)
					for q = 1, #objs do
						local oid
						pcall(function() oid = objs[q]:id() end)
						if not (oid and A.slot_put(oid, sec)) then break end
						n = n + 1
					end
					if n > 0 then A.sfx("in") end
				end

				local left = #A.cell_objs(cc, idx_from) - n
				dbg("slot %s: %s of %s %s put in", tostring(pmi),
				    tostring(n), tostring(n + left), tostring(sec))

				if n == 0 then
					local cw, ch = A.cells(sec)
					notify("Nothing in the rig has room for a %dx%d",
					       tonumber(cw) or 1, tonumber(ch) or 1)
				elseif left > 0 then
					-- SAID ONLY WHEN SOMETHING STAYED BEHIND, because
					-- the ordinary case is the whole stack going in and
					-- a message about that is noise.
					notify("%s went in, %s stayed - the rig is full",
					       tostring(n), tostring(left))
				end
			end
		end

		-- THE BAG IS RE-FILTERED. Without it the objects just put in
		-- the rig stay drawn in the bag - "not actually there, just
		-- shows the icon" - and the same one can be dragged in again
		-- and again.
		self:On_Item_Update()
		return
	end

	if A.enabled and editing_allowed() and A.pack_at()
		and (bag_from == BAG or A.ours(bag_from))
	then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)
		if obj and A.is_pack(obj) then
			local ok, err = pcall(function() self:Action_Equip(obj, bag_from) end)
			if not ok then log("!wear backpack: %s", tostring(err)) end
			self:On_Item_Update()
			return
		end
	end

	if A.enabled and editing_allowed()
		and A.ours(bag_from) and A.rig_at()
	then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)
		if obj then
			A.wear_rig(obj)
			self:On_Item_Update()
			return
		end
	end

	-- ============================================================
	-- AND A DROP OUT OF A BODY'S LIST ONTO AN OPEN BOX
	--
	--   "or can be dragged into containers from the body itself, so
	--    opening containers should be possible when looting."
	--
	-- Opening one already worked: the menu entry has no mode test and
	-- the windows are drawn from every mode's Update. The DROP did not,
	-- because every branch here asks A.ours(bag_from) and a corpse's
	-- list is not ours - and that guard is right. The object is not
	-- yours yet: a box holding something that still belongs to a body
	-- is a bug with a save game in it.
	--
	-- SO IT IS TWO STEPS, IN THE ORDER THE GAME ALREADY DOES THEM. The
	-- square is written down, the menu's own Action_Move transfers the
	-- item exactly as a drop on your bag would - with its weight check,
	-- its callbacks and every mod wrapped round looting - and the note
	-- is spent when the thing arrives. A transfer the game refuses
	-- leaves a note nothing ever collects, which is why notes go stale.
	--
	-- LOOTING ONLY. In trade the other side's list is a shelf and
	-- moving from it is a purchase; a box quietly buying things is a
	-- different feature and a worse one.
	-- ============================================================
	if A.enabled and A.loot_box and editing_allowed() and A.looting()
		and bag_from == "npc_bag" and A.win_shown() and A.win_over()
	then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)
		local dk = obj and A.win_hit()
		local w = dk and A.wins[dk]

		if w and w.kind == "box" and w.id then
			local oki, id = pcall(function() return obj:id() end)
			local r, c = A.box_hover(dk)

			if oki then A.note_loot(id, w.id, r, c) end
			local okm = pcall(function() self:Action_Move(obj, bag_from) end)
			if not okm then A.loot_note[id] = nil end

			self:On_Item_Update()
			return
		end
	end

	-- ============================================================
	-- ...AND ONTO THE CASE ITSELF, WITHOUT OPENING IT
	--
	--   "items from bodies cannot be manualy droped on containers that
	--    they will go into if dropped from inventory"
	--
	-- Dropping onto the icon has worked since the boxes were built, and
	-- so has dropping into the open window from a body - but the two
	-- never met, because the icon branch asks A.ours(bag_from) and a
	-- corpse's list is not ours.
	--
	-- That guard is still right: the object is not yours yet, and a
	-- case holding something that belongs to a body is a bug with a
	-- save game in it. So this is the same two steps the open window
	-- uses - write down which case was pointed at, let the menu's own
	-- Action_Move do the transfer with every check and callback that
	-- hangs off it, and let file_loot spend the note when the thing
	-- arrives.
	--
	-- THE BOX IS LOOKED FOR IN YOUR LIST, not in the one being dragged
	-- out of. box_under reads the cell under the cursor from the
	-- container it is given, and the cursor is over your bag.
	-- ============================================================
	-- ONE SET OF GATES, and they are grid_box_wants'. Enabled, editing
	-- allowed, looting rather than trading, the filing switched on -
	-- every one of those is asked inside it, because the white glow
	-- that appears before this drop asks the same function and a
	-- second copy here is a second chance for the two to differ.
	if bag_from == "npc_bag" then
		local from = self.CC[bag_from]
		local obj  = from and from:GetObj(idx_from)
		local mine = self.CC["actor_bag"]

		if obj and mine then
			-- THE SAME FUNCTION THE HIGHLIGHT ASKS, which is the only
			-- way a white glow that promises a drop and the drop
			-- itself cannot come apart. It answers the box's id when
			-- the whole thing would land - the family, the weight, and
			-- a stack to join or a square to stand on.
			local oks, sec = pcall(function() return obj:section() end)
			local bid = oks and grid_box_wants(mine, sec, obj, bag_from)

			if bid then
				local oki, id = pcall(function() return obj:id() end)
				if oki then A.note_loot(id, bid, nil, nil) end

				local okm = pcall(function()
					self:Action_Move(obj, bag_from)
				end)
				if not okm and oki then A.loot_note[id] = nil end

				self:On_Item_Update()
				return
			end
		end
	end

	-- ============================================================
	-- AND A DROP ON AN OPEN RIG PUTS THE MAGAZINE IN IT
	--
	-- Before the panel, because the window is drawn on top of it: what
	-- you can see under the cursor is what the drop should reach.
	-- ============================================================
	if A.enabled and editing_allowed() and A.win_shown() and A.win_over()
		and A.ours(bag_from)
	then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)

		if obj then
			local dk = A.win_hit()
			if dk then A.win_put(dk, obj, A.win_at(dk), cc, idx_from) end
			self:On_Item_Update()
			return
		end
	end

	if A.enabled and A.open and editing_allowed()
		and A.ours(bag_from) and A.over_panel()
	then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)

		if obj then
			-- A pouch slot under the cursor takes priority: it is a
			-- smaller target sitting inside the same panel, so asking
			-- the pockets first would swallow every drop aimed at it.
			local ps = A.pouch_at()
			if ps then
				A.fit_pouch(obj, ps)
			else
				-- Ammo onto a filled pocket loads the magazine in it;
				-- anything else is a magazine being filed.
				local i = A.slot_at()
				if not A.load_from_drop(obj, i) then
					A.put(obj, i)
				end
			end
			self:On_Item_Update()
			return
		end
	end

	-- ============================================================
	-- AND A DROP ON A BOX'S OWN ICON PUTS IT IN THE BOX
	--
	--   "can we add that the items that can be stored i their box can
	--    be drag and dropped on the box icon without opening the window
	--    and dropping it there, they just take first empty space or go
	--    to existing stack if present"
	--
	-- AFTER the windows and the panel, because those are drawn over the
	-- list and what you can see under the cursor is what the drop should
	-- reach. Before the base, which would otherwise read it as an
	-- ordinary move.
	--
	-- Zone Grid has already stood aside by the time this runs: a square
	-- with a box on it is occupied, and its one rule is that an item
	-- moves only onto squares that are free or its own.
	--
	-- WHERE INSIDE THE BOX IS NOT DECIDED HERE. box_put with no square
	-- joins something identical if there is one and takes the first free
	-- square if there is not, which is the whole of what was asked for -
	-- and it is the same code the open window uses, so the two cannot
	-- drift apart.
	--
	-- THE WHOLE CELL, exactly as a drop into the open window does. It
	-- stops at the first refusal and says how many went in, so a box
	-- that fills up half way through a stack leaves the rest in your
	-- bag rather than on the floor.
	--
	-- OUR OWN LISTS ONLY. A drop from a trader's shelf is a transfer:
	-- the object is not yours yet, and a box taking something that has
	-- not arrived is a different feature from this one.
	-- ============================================================
	if A.enabled and editing_allowed() and A.ours(bag_from) then
		local cc = self.CC[bag_from]
		local obj = cc and cc:GetObj(idx_from)

		if obj then
			local box, bsec, bid = A.box_under(cc, obj)
			if box then
				A.box_put_all(bid, bsec, cc, idx_from)
				self:On_Item_Update()
				return
			end
		end
	end

	-- ============================================================
	-- A DROP ON THE MIDDLE LIST IS A DROP ON THE BAG
	--
	-- The items in that list are in the actor's inventory already, so
	-- there is nothing for a drop to do - and NOTHING MUST HAPPEN,
	-- which is the point. The menu's "you dropped it outside" area now
	-- covers the column, and the stock handler tests it before
	-- anything else: without this, dragging a magazine two cells to
	-- the left inside its own list would throw it on the ground.
	--
	-- ...EXCEPT A BOX OF AMMO ON A MAGAZINE, WHICH IS A LOAD.
	--
	-- That is not "nothing to do", and swallowing it broke the ordinary
	-- way of filling a magazine for anyone whose magazines were not in
	-- a rig - which, with this column on, is every magazine you are not
	-- wearing. It was reported as "magazines cannot be loaded when I
	-- have no rig on", and that is exactly what it was.
	--
	-- The load is done HERE rather than by letting the base run,
	-- because the base tests the trash first and the trash covers this
	-- column: handing it back would throw the ammunition on the ground.
	-- ============================================================
	return base_DragDrop(self, bag_from, idx_from)
end

-- Closes with the inventory. The clean signal, sent from
-- UIInventory:Close() through Unregister_UI.
function A.on_gui_hide(name)
	if name == "UIInventory" then
		-- Pinned, the rig survives the inventory closing and is there
		-- again next time. Everything else is torn down either way -
		-- the window objects belong to the GUI that is going away.
		if not A.pinned then A.open = false end
		A.ate, A.ate2 = nil, nil


		-- A magazine cannot stay in hand across a closed inventory. The
		-- ghost belongs to the dialog that is going away; the drag it
		-- belonged to has to go with it or the next open starts holding
		-- something invisible.
		--
		-- And the MENU has to be told, or its own "something is being
		-- carried" flag stays set and the wheel stops scrolling the bag
		-- for the rest of the session.
		A.ghost, A.ghost_sec = nil, nil
		A.win_drag = nil
		A.win_grab_at = nil

		-- AND A SQUARE OUT OF A SLOT, for the same reason and with the
		-- same consequence: a drag left pointing at an entry after the
		-- menu has gone is an index that is wrong about everything, and
		-- the next open would start holding a stack nobody picked up.
		A.pk_drag = nil

		A.let_go()

		-- ...and the same for the scroll. The inventory closing is one
		-- of the ways a press never gets its release, and this is the
		-- one moment when no draw pass will run to notice.
		A.unpause()

		-- PUT THE WINDOWS AWAY, not just the flag.
		--
		-- A.open going false hides nothing on its own: the statics stay
		-- in whatever state the last draw pass left them, and the draw
		-- pass is driven by UICellContainer:Update on actor_bag. The
		-- inventory shows that container in inventory, loot and repair
		-- mode and HIDES it in trade mode - so opening a trader straight
		-- after the personal inventory ran no draw pass at all, the
		-- statics were still shown from the last one, and they came back
		-- into view with the equipment dialog they hang off. After a
		-- stash or a body it never happened, because loot mode updates
		-- actor_bag and that pass put them away on the way out.
		--
		-- Hiding here means the panel is closed by the same event that
		-- closes the inventory, whatever mode opens next.
		local ok, err = pcall(A.hide)
		if not ok then log("!hide on close: %s", tostring(err)) end

		-- And the rig card, for the same reason again: nothing draws it
		-- away once the container that drives the draw pass has gone.
		local ok3, err3 = pcall(A.tip_hide)
		if not ok3 then log("!rig tooltip hide on close: %s", tostring(err3)) end

		-- The open rig CLOSES with the inventory rather than merely
		-- hiding: it is a window you opened onto one particular item,
		-- and coming back to a different container to find it still
		-- open over the top would be a surprise.
		local ok4, err4 = pcall(A.win_close_all, "the inventory closed")
		if not ok4 then log("!open rig close: %s", tostring(err4)) end

		local gui = gui_now()
		if gui and gui.item_in_hold == CC_ID then gui.item_in_hold = false end
		A.rect, A.lay, A.close_r, A.pin_r = nil, nil, nil, nil
	end
end

-- ============================================================
-- STATE
--
-- Object ids, by pocket. Keys are stringified because a table with
-- integer keys and holes in it is an array with holes to anything that
-- walks it, and pockets 1 and 5 being filled is an ordinary state here.
--
-- Anything read back out of a save file is untrusted - pcall does not
-- protect the engine bindings this eventually reaches - so every element
-- is type-checked at load rather than at the point of use.
-- ============================================================

function save_state(m_data)
	-- ============================================================
	-- THE WORN RIG, SQUARE BY SQUARE
	--
	-- Ids, not records: these objects are real and still in the actor's
	-- inventory, so on the way back in they are still there and
	-- rebuilding them would DOUBLE them.
	--
	-- The key is "<slot name>:<n>" - the slot's own name from
	-- A.rig_slots_all, never its number. Number them and pulling a
	-- pouch renumbers every slot after it, so a save written before and
	-- read after would hand a rig's contents to the wrong pockets. n is
	-- only there to keep the squares of one slot apart, and load reads
	-- them back in that order.
	-- ============================================================
	local t, any = {}, false
	for key, list in pairs(A.wear) do
		for e = 1, #list do
			local ent = list[e]
			local ids = {}
			for i = 1, #ent.ids do ids[#ids + 1] = tostring(ent.ids[i]) end

			if type(ent.sec) == "string" and #ids > 0 then
				t[tostring(key) .. ":" .. tostring(e)] = {
					sec = ent.sec, r = ent.r, c = ent.c,
					w = ent.w, h = ent.h, rot = ent.rot or nil,
					ids = table.concat(ids, ","),
				}
				any = true
			end
		end
	end

	m_data.amp_wear = any and t or nil
	m_data.amp_pinned = A.pinned or nil

	-- Which rig is worn, by object id.
	m_data.amp_rig_id = A.rig_id or nil

	-- Pouches fitted to a rig. Keys are outfit ids and have to survive
	-- as strings, the same as the pocket table above.
	local pt, pany = {}, false
	for id, t in pairs(A.pslot) do
		for i = 1, PSLOTS do
			if t[i] then
				pt[tostring(id) .. ":" .. tostring(i)] = t[i]
				pany = true
			end
		end
	end
	m_data.amp_pslot = pany and pt or nil

	-- ============================================================
	-- AND WHAT IS INSIDE EVERY RIG THAT IS NOT BEING WORN
	--
	-- Not a note about things that exist elsewhere - these ones exist
	-- NOWHERE ELSE, so this table is the only copy and it goes into the
	-- save whole: section, condition, uses and rounds, packed into one
	-- string per square by A.pile_pack.
	--
	-- Keyed "<rig id>|<slot name>:<n>". The bar separates the two names
	-- because a rig id can be negative and a slot name contains no bar;
	-- n keeps the squares of one slot apart and load sorts on it.
	--
	-- ONE TABLE, WHERE THERE WERE THREE. amp_stash held the magazines,
	-- amp_mstash the med pocket and amp_pmstash the med pouches, and
	-- every one of them was written, read and weighed separately.
	-- ============================================================
	local mt, many = {}, false
	for id, by in pairs(A.hold) do
		for key, list in pairs(by) do
			for e = 1, #list do
				local ent = list[e]
				if type(ent) == "table" and type(ent.sec) == "string" then
					mt[tostring(id) .. "|" .. tostring(key)
					   .. ":" .. tostring(e)] = {
						sec = ent.sec, r = ent.r, c = ent.c,
						w = ent.w, h = ent.h, rot = ent.rot or nil,
						of = ent.of,
					}
					many = true
				end
			end
		end
	end
	m_data.amp_hold = many and mt or nil

	-- AND WHAT IS IN EACH BOX. Same reasoning as the stash above - this
	-- is the only copy - but written by POSITION IN THE ARRAY rather
	-- than by pocket, because a box has no pockets. The index is not
	-- meaningful; it is only there to keep the entries apart in a flat
	-- table, and load_state packs them back down in index order.
	local bt, bany = {}, false
	for id, t in pairs(A.boxes or {}) do
		for n = 1, #t do
			local it = t[n]
			if it then
				-- THE PILE'S OBJECTS AS ONE STRING. A table per object
				-- inside a table per pile inside m_data is a great deal
				-- for the engine to walk on every save.
				-- The magazines and pouches of any rig in this pile.
				-- Both nil on every pile that has no rig in it, which
				-- is every pile in every box but the armour case.
				local rigs, pous = A.pile_rigs_pack(it)

				bt[tostring(id) .. ":" .. tostring(n)] = {
					sec = it.sec, r = it.r, c = it.c, w = it.w, h = it.h,
					-- nil on everything upright, so an unturned box
					-- costs the save nothing.
					rot = it.rot or nil,
					of = A.pile_pack(it),
					rigs = rigs, pous = pous,
				}
				bany = true
			end
		end
	end
	m_data.amp_box = bany and bt or nil

	-- ONE STRING, NOT A TABLE OF IDS. A save carrying a few hundred
	-- boolean-keyed entries is a few hundred entries the engine walks
	-- on every save and load; a comma-joined list of ids is one field
	-- and reads back in a single gmatch.
	local roll, mine = {}, {}
	for id in pairs(A.rolled) do roll[#roll + 1] = tostring(id) end
	for id in pairs(A.mine) do mine[#mine + 1] = tostring(id) end

	m_data.amp_rolled = (#roll > 0) and table.concat(roll, ",") or nil
	m_data.amp_mine   = (#mine > 0) and table.concat(mine, ",") or nil
end

-- ============================================================
-- EVERY OLD RIG EMPTIES ITSELF INTO YOUR BAG, ONCE
--
--   "Empty every rig into the bag once, cleanly"
--
-- A 2.x save describes rigs in a shape that no longer exists: pockets
-- numbered 1..N, each holding one magazine of a size CLASS, plus a med
-- pocket and a med pouch pocket of their own. There is no honest way
-- to place those into 2x2 / 3x1 / 2x1 / 1x1 slots - a "medium" pocket
-- was 1x2 and the rig it belonged to may now be a different shape
-- entirely - and a guess would put somebody's drum in a bandage
-- pocket and lose it.
--
-- So nothing is guessed. Everything that was in a rig is handed back
-- as a real item in your inventory and the old tables are dropped.
-- You re-pack your rigs once and the mod never mentions it again.
--
-- WHAT COMES BACK AND WHAT DOES NOT:
--
--   amp_slots  the WORN rig's magazines, by id. Those objects are
--              real and still in your inventory - they were only
--              hidden from the bag - so there is nothing to rebuild.
--              Forgetting the ids is what makes them visible again.
--   amp_med    the same, for the worn rig's med pocket.
--   amp_stash  a spare rig's magazines, as records. REBUILT: the
--              objects were destroyed when they went in.
--   amp_mstash a spare rig's med pocket, as records. Rebuilt.
--   amp_pmstash the med pouches' pockets. Rebuilt.
--
-- THE POUCHES THEMSELVES ARE KEPT. A.pslot survives the change
-- untouched - a pouch fitted to a rig is still a pouch fitted to a
-- rig, and the only thing 3.0 changed about it is what it grants.
--
-- ONE PASS, AND THEN NEVER AGAIN, because the fields it reads are not
-- written any more: the next save carries amp_wear and amp_hold and
-- none of these, so this finds nothing and costs one table lookup.
-- ============================================================
function A.migrate_2x(m_data)
	local old = { "amp_slots", "amp_med", "amp_stash",
	              "amp_mstash", "amp_pmstash" }

	local found = false
	for i = 1, #old do
		if type(m_data[old[i]]) == "table" then found = true end
	end
	if not found then return 0 end

	-- The records, from the three tables that held them. Every one is
	-- "<something>:<n>" -> { sec = ..., of = ... }, which is the only
	-- part of their shape this needs to know.
	local out, freed = 0, 0

	for _, field in ipairs({ "amp_stash", "amp_mstash", "amp_pmstash" }) do
		local t = m_data[field]
		if type(t) == "table" then
			for _, ent in pairs(t) do
				if type(ent) == "table" and type(ent.sec) == "string" then
					-- A magazine record from amp_stash carries its
					-- rounds in `data` and its wear in `cond`; a med
					-- record carries a packed pile in `of`. Both are
					-- rebuilt through the makers that already know how.
					if type(ent.of) == "string" then
						local of = A.pile_unpack(ent.of, ent.sec)
						for k = 1, #(of or {}) do
							local rec = of[k]
							if A.box_make({ sec = ent.sec, cond = rec.cond,
							                uses = rec.uses,
							                ammo = rec.ammo }) then
								out = out + 1
							end
						end
					else
						local ok, se = pcall(function()
							return alife_create_item(ent.sec, db.actor)
						end)
						if ok and se and se.id then
							if ent.data and magazine_binder
							   and type(magazine_binder.set_data) == "function"
							then
								pcall(magazine_binder.set_data, se.id, ent.data)
							end
							if ent.cond then A.loose_cond(se.id, ent.cond) end
							out = out + 1
						else
							log("!3.0 migration: could not rebuild %s",
							    tostring(ent.sec))
						end
					end
				end
			end
		end
	end

	-- The worn rig's own contents are real objects that were only
	-- hidden. Un-carry the magazines so the magazine mod stops
	-- counting them against a rig they are no longer in, and let the
	-- bag show all of it again.
	local t = m_data.amp_slots
	if type(t) == "table" then
		for _, v in pairs(t) do
			local id = tonumber(v)
			if id then A.uncarry(id) freed = freed + 1 end
		end
	end

	local lt = m_data.amp_med
	if type(lt) == "table" then
		for _, ent in pairs(lt) do
			if type(ent) == "table" and type(ent.ids) == "string" then
				for _ in tostring(ent.ids):gmatch("%-?%d+") do
					freed = freed + 1
				end
			end
		end
	end

	for i = 1, #old do m_data[old[i]] = nil end

	log("3.0: the rigs were rebuilt - %d thing(s) handed back, "
	    .. "%d already in your inventory", out, freed)
	if out + freed > 0 then
		notify("The rigs changed shape - everything that was in them "
		       .. "is in your bag. Pack them again.")
	end

	return out + freed
end

function load_state(m_data)
	-- FIRST. Everything read below describes a world that does not
	-- exist yet, and every "is it still there?" test in this file has
	-- to be told to wait for it.
	A.warm_up()

	A.wear, A.hold = {}, {}
	for i = #A.pk, 1, -1 do A.pk[i] = nil end
	A.pinned = m_data.amp_pinned and true or false

	-- The worn rig. Type-checked like everything else read back out of
	-- a save; A.rig_obj drops it on the next question if the object has
	-- gone.
	local rid = m_data.amp_rig_id
	A.rig_id = (type(rid) == "number") and rid or nil
	A.rig_key = nil

	-- TWO INDEPENDENT TABLES, TWO INDEPENDENT READS. Bailing out of the
	-- whole function when there are no slot contents took the fitted
	-- pouches with it - a save with an empty rig and two pouches bolted
	-- on came back with the pouches gone, and A.pslot still holding the
	-- LAST save's, because the reset never ran either.
	local t = m_data.amp_wear

	if type(t) == "table" then
		-- INDEX ORDER WITHIN EACH SLOT, not pairs order: n is only
		-- there to keep the squares apart, and reading them back in a
		-- different order than they were written would shuffle them.
		local by, seen = {}, {}
		for k, ent in pairs(t) do
			local key, e = tostring(k):match("^([%w_]+):(%d+)$")
			e = tonumber(e)
			if key and e and type(ent) == "table"
				and type(ent.sec) == "string" and type(ent.ids) == "string"
			then
				by[key] = by[key] or {}
				by[key][#by[key] + 1] = { at = e, ent = ent }
			end
		end

		for key, list in pairs(by) do
			table.sort(list, function(a, b) return a.at < b.at end)
			local out = {}
			for i = 1, #list do
				local ent = list[i].ent
				local slot = { sec = ent.sec,
				               r = tonumber(ent.r) or 1,
				               c = tonumber(ent.c) or 1,
				               w = tonumber(ent.w) or 1,
				               h = tonumber(ent.h) or 1,
				               rot = ent.rot and true or nil,
				               ids = {} }

				for one in tostring(ent.ids):gmatch("%-?%d+") do
					local mid = tonumber(one)
					-- NOT TWICE, AND NOT INTO TWO SQUARES. An id already
					-- filed is a save written wrong or read twice, and
					-- either way the second copy is the one to drop.
					if mid and not seen[mid] then
						seen[mid] = true
						slot.ids[#slot.ids + 1] = mid
					end
				end

				if #slot.ids > 0 then out[#out + 1] = slot end
			end
			if #out > 0 then A.wear[key] = out end
		end
	end

	-- WHAT THE SAVE ACTUALLY HELD. If this is zero then nothing was
	-- ever written as being in the rig and everything downstream is a
	-- different bug in a different place - which is worth one line to
	-- rule out, because two releases have now been spent on the
	-- downstream half.
	local nwear = 0
	for _, list in pairs(A.wear) do
		for e = 1, #list do nwear = nwear + #list[e].ids end
	end
	log("save: %d thing(s) in the worn rig, rig %s",
	    nwear, tostring(A.rig_id))

	-- AND THE SAME AGAIN FOR EACH TABLE AFTER IT. The note above is not
	-- history: a `return` in the middle of this function skips every
	-- table below it, and the first version of the pocket memory was
	-- read after the pouches and behind their `return`. A save with no
	-- pouches fitted - which is most of them - came back with nothing
	-- remembered. The suite caught it; the shape of the function is what
	-- invited it, so no read below here may return.
	A.pslot = {}
	local pt = m_data.amp_pslot

	if type(pt) == "table" then
		for k, sec in pairs(pt) do
			local id, i = tostring(k):match("^(%-?%d+):(%d+)$")
			id, i = tonumber(id), tonumber(i)
			if id and i and i >= 1 and i <= PSLOTS and type(sec) == "string" then
				A.pslot[id] = A.pslot[id] or {}
				A.pslot[id][i] = sec
			end
		end
	end

	A.rolled, A.mine = {}, {}
	for _, f in ipairs({ "amp_rolled", "amp_mine" }) do
		local into = (f == "amp_rolled") and A.rolled or A.mine
		local str = m_data[f]
		if type(str) == "string" then
			for id in str:gmatch("%-?%d+") do
				local n = tonumber(id)
				if n then into[n] = true end
			end
		end
	end

	-- ============================================================
	-- AND EVERY RIG THAT IS NOT BEING WORN
	--
	-- Read with no `return` anywhere in sight, which is the rule this
	-- function learned the hard way: a read that bails out skips every
	-- table below it, and a save with nothing in one of them came back
	-- with the next one empty.
	-- ============================================================
	local mt = m_data.amp_hold

	if type(mt) == "table" then
		local by = {}
		for k, ent in pairs(mt) do
			local id, key, e =
				tostring(k):match("^(%-?%d+)|([%w_]+):(%d+)$")
			id, e = tonumber(id), tonumber(e)

			-- An entry with no section cannot be rebuilt, and keeping it
			-- would be keeping a promise that cannot be met.
			if id and key and e and type(ent) == "table"
				and type(ent.sec) == "string" and type(ent.of) == "string"
			then
				by[id] = by[id] or {}
				by[id][key] = by[id][key] or {}
				local list = by[id][key]
				list[#list + 1] = { at = e, ent = ent }
			end
		end

		for id, keys in pairs(by) do
			local out = {}
			for key, list in pairs(keys) do
				table.sort(list, function(a, b) return a.at < b.at end)
				local t = {}
				for i = 1, #list do
					local ent = list[i].ent
					t[#t + 1] = { sec = ent.sec,
					              r = tonumber(ent.r) or 1,
					              c = tonumber(ent.c) or 1,
					              w = tonumber(ent.w) or 1,
					              h = tonumber(ent.h) or 1,
					              rot = ent.rot and true or nil,
					              of = ent.of }
				end
				if #t > 0 then out[key] = t end
			end
			if next(out) then A.hold[id] = out end
		end
	end

	-- THE ONE-TIME MOVE OFF THE OLD FORMAT. Read LAST of the three, so
	-- that a save carrying both shapes keeps the new one.
	A.migrate_2x(m_data)

	-- ============================================================
	-- THE BOXES, AND WHY THEY ARE PACKED DOWN
	--
	-- A.boxes[id] is a DENSE array and everything that reads it - the
	-- draw, the hit test, the drop - trusts #t. A save file is a table
	-- with whatever keys are in it, so an entry that failed its type
	-- check would otherwise leave a hole, #t would stop at it, and the
	-- rest of the box would be invisible while still being in the way.
	--
	-- So the entries are collected by index, then appended in index
	-- order. Order is preserved where it can be and gaps close where it
	-- cannot.
	--
	-- An entry with no section, or with nowhere to stand, is dropped:
	-- both are promises that cannot be kept.
	-- ============================================================
	A.boxes = {}
	local bt = m_data.amp_box

	if type(bt) == "table" then
		local by = {}

		for k, it in pairs(bt) do
			local id, n = tostring(k):match("^(%-?%d+):(%d+)$")
			id, n = tonumber(id), tonumber(n)

			if id and n and type(it) == "table"
				and type(it.sec) == "string"
				and type(it.r) == "number" and type(it.c) == "number"
			then
				it.w = (type(it.w) == "number" and it.w >= 1) and it.w or 1
				it.h = (type(it.h) == "number" and it.h >= 1) and it.h or 1
				-- The saved w/h are already the turned pair; the flag
				-- only has to say the PICTURE lies sideways.
				it.rot = it.rot and true or nil

				-- THE OBJECTS, or the count they used to be. A save
				-- written before a pile held objects has an `n` and one
				-- set of numbers; pile_norm turns that into n copies of
				-- it, and ammunition into n boxes' worth of rounds. A
				-- save written before stacks existed at all has neither,
				-- and stands for exactly one object.
				local packed = it.of
				it.of = (type(packed) == "string")
				        and A.pile_unpack(packed, it.sec) or nil
				A.pile_norm(it)

				-- AND BACK ONTO THE OBJECTS THEY BELONG TO. Read off
				-- the saved entry and then taken off it: this table IS
				-- the live entry from here on, and two spellings of the
				-- same rig lying in it is how one of them goes stale.
				A.pile_rigs_unpack(it, it.rigs, it.pous)
				it.rigs, it.pous = nil, nil
				by[id] = by[id] or {}
				by[id][n] = it
			end
		end

		for id, t in pairs(by) do
			local out, most = {}, 0
			for n in pairs(t) do if n > most then most = n end end
			for n = 1, most do
				if t[n] then out[#out + 1] = t[n] end
			end
			if #out > 0 then A.boxes[id] = out end
		end
	end
end

-- ============================================================
-- OPENING IT
--
-- custom_functor_autoinject is the shared API for right-click entries;
-- its DEFAULT bag set is already actor_equ / actor_belt / actor_bag in
-- inventory mode, so no override is needed to reach the armour slot.
--
-- Returning nil from the name function is how an entry is hidden.
-- ============================================================
-- ============================================================
-- WHERE THE ENTRY LIVES NOW
--
-- It used to belong to the armour you were wearing, because that was
-- where the rig was installed. The rig is its own item in its own slot,
-- so the entry belongs to the RIG: right-click the rig - worn or in the
-- bag - and it opens.
--
-- Offered on a rig in the bag as well as the worn one, because that is
-- the natural place to reach for it, and taking it means wearing it if
-- it is not already on.
-- ============================================================
local function on_rig(obj, bag, mode)
	if not (obj and A.enabled and db.actor) then return false end

	local ok, sec = pcall(function() return obj:section() end)
	if not ok then return false end
	if A.is_rig_sec(sec) then return true end

	-- AND NOTHING ELSE. The entry used to fall through to the worn
	-- ARMOUR when the rig-item option was off; there is no such option
	-- and no such mode, so an armour is just an armour.
	return false
end

local function name_open(obj, bag, mode)
	if not on_rig(obj, bag, mode) then return nil end

	-- The one you are wearing opens and closes. Any other one is worn
	-- first, which is a different sentence.
	local ok, id = pcall(function() return obj:id() end)
	if ok and A.rig_id and id == A.rig_id then
		return A.open and "st_amp_close" or "st_amp_open"
	end
	return "st_amp_wear"
end

local function action_open(obj, bag, mode)
	if not name_open(obj, bag, mode) then return end

	local ok, id = pcall(function() return obj:id() end)
	if ok and A.rig_id and id == A.rig_id then
		A.open = not A.open
		return
	end

	if A.wear_rig(obj) then A.open = true end
end

-- ============================================================
-- AND "OPEN RIG", ON ONE YOU ARE NOT WEARING
--
-- Its own entry rather than a second meaning for the open/close one:
-- that entry WEARS an unworn rig, which is what you want almost every
-- time, and quietly turning it into something else would be worse than
-- an extra line in the menu.
-- ============================================================
local function on_spare_rig(obj, bag, mode)
	if not (obj and A.enabled and db.actor) then return false end

	local ok, sec = pcall(function() return obj:section() end)
	if not (ok and A.is_rig_sec(sec)) then return false end

	local ok2, id = pcall(function() return obj:id() end)
	if not ok2 then return false end

	-- The one on your chest has the panel.
	return A.rig_id ~= id
end

-- WHICH RIG, NOT WHETHER A WINDOW IS UP. This asked A.win_shown(),
-- which is true for ANY open rig - so with one rig open, every other
-- rig in the bag offered to "close" it and then opened itself instead.
-- The entry and the action have to be answering the same question.
local function name_openrig(obj, bag, mode)
	if not on_spare_rig(obj, bag, mode) then return nil end

	local ok, id = pcall(function() return obj:id() end)
	return (ok and A.win_of(id)) and "st_amp_shutrig" or "st_amp_openrig"
end

local function action_openrig(obj, bag, mode)
	if not on_spare_rig(obj, bag, mode) then
		dbg("open rig: the menu entry was picked on something that is "
		    .. "not a spare rig")
		return
	end

	local ok, id = pcall(function() return obj:id() end)

	local have = ok and A.win_of(id)

	dbg("open rig: menu picked on %s (bag=%s mode=%s), already open in %s",
	    tostring(ok and id), tostring(bag), tostring(mode), tostring(have))

	if have then
		A.win_close(have, "you picked the entry again")
		return
	end

	A.win_open(obj)
end

-- ============================================================
-- AND "OPEN BOX", WHICH IS THE ONLY THING A BOX DOES
--
-- Its own pair rather than a third meaning for the rig entries: those
-- read "Open rig" / "Wear rig", and a box is neither worn nor a rig.
-- One entry, and it says which way it goes.
-- ============================================================
-- ============================================================
-- WHERE "OPEN BOX" IS OFFERED
--
--   "add 'open box' to context menu when in looting window. so i can
--    open boxes when looting bodies or stashes"
--
-- EVERY MODE, which is the change: this used to be inventory only, not
-- by decision but because add_functor's sixth argument was not passed
-- and the game's default is `mode == "inventory"`. A body open on the
-- left and your ammo case open on the right is the whole point of the
-- request.
--
-- YOUR OWN LISTS ONLY, which is a decision. A box's contents live in a
-- table keyed by that box's object id, and A.box_put has no "are you
-- carrying this" test - it has never needed one, because until now the
-- entry could not be reached from anywhere else. Offer this on a box
-- lying in a corpse and the sequence is: open it, drop your ammunition
-- in, walk away. The rounds are then filed against an id you left on
-- the floor, and they go when it does.
--
-- The trade OFFER pile is out for a smaller reason: a box you are in
-- the middle of selling is not a box to be filling.
--
-- A NIL BAG IS NOT A REFUSAL. The functor API hands the bag over only
-- when override_bags was passed, and this file is not the only thing
-- that decides whether it was.
-- ============================================================
local BOX_MENU_BAGS = {
	actor_bag = true, actor_equ = true, actor_belt = true,
	actor_trade_bag = true,
}

function A.box_menu_here(obj, bag, mode)
	if not (obj and A.enabled and db.actor) then return false end
	if bag ~= nil and not BOX_MENU_BAGS[bag] then return false end

	local ok, sec = pcall(function() return obj:section() end)
	return (ok and A.is_box_sec(sec)) and true or false
end

local function on_box(obj, bag, mode)
	return A.box_menu_here(obj, bag, mode)
end

local function name_openbox(obj, bag, mode)
	if not on_box(obj, bag, mode) then return nil end

	local ok, id = pcall(function() return obj:id() end)
	return (ok and A.win_of(id)) and "st_amp_shutbox" or "st_amp_openbox"
end

local function action_openbox(obj, bag, mode)
	if not on_box(obj, bag, mode) then return end

	local ok, id = pcall(function() return obj:id() end)
	local have = ok and A.win_of(id)

	if have then
		A.win_close(have, "you picked the entry again")
		return
	end

	A.win_open(obj)
end

-- ============================================================
-- GETTING A TEST RIG WITHOUT THE DEBUG SPAWNER
--
-- The rig item did not turn up in the spawner, and there are two very
-- different reasons that can happen: the section never loaded, or it
-- loaded and the spawner did not list it. Those need different fixes,
-- and neither can be worked on while there is no way to hold one.
--
-- So the item is reachable from the armour's own context menu, which
-- is a route this mod already owns and which does not care what the
-- spawner thinks. Only with Debug on: this is scaffolding, not a
-- feature, and an entry that hands you free gear has no business
-- appearing on a normal playthrough.
-- ============================================================
-- Every rig the mod ships, in tier order. The ONLY thing this list is
-- used for is the debug spawn entries and the load-time report - the
-- game itself needs no list, because a rig is anything carrying
-- mag_pouches' use1_functor, and how many pockets it grants is read by
-- section name out of l_amp_rigs.ltx. Adding a rig is two ltx entries
-- and one line here.
local RIGS = {
	-- Progression order - the order they are written in
	-- l_amp_rigs.ltx, which is the balance file and therefore the one
	-- worth following. It is NOT the atlas order any more: the second
	-- eight were cut into the rows below the first eight, so the
	-- pictures are in the order they were drawn and this is in the
	-- order they are worn.
	--
	-- The audit pins this list against the ltx, so a rig added there
	-- and forgotten here is caught rather than quietly missing from
	-- the debug spawn menu.
	"amprig_bandolier",
	"amprig_scout",
	"amprig_barakholka",
	"amprig_harness",
	"amprig_vydra",
	"amprig_warsaw",
	"amprig_nylon",
	"amprig_karkas",
	"amprig_bastion",
	"amprig_smersh",
	"amprig_volya",
	"amprig_chicom",
	"amprig_leshy",
	"amprig_tarzan",
	"amprig_rubezh",
	"amprig_carrier",
}

-- ============================================================
-- WHAT A BODY MIGHT BE CARRYING
--
--   "add mcm subcategory 'rig and pouch drop' and add sliders for rig
--    and mag pouches drops. make it so it can be change from 0 to
--    100 % and per npc rank so you got trainee rank with rig sliders
--    for every tier of the rig and same for pouches"
--
-- Eight ranks, five rig tiers and three pouches: sixty-four numbers,
-- every one of them a percentage the player can set to anything from
-- nothing to certain.
--
-- WHY THIS IS A SCRIPT AND NOT A TABLE ANY MORE. 2.25.2 did this in
-- the Economy fork's own death tables, which is the right mechanism
-- and the wrong place the moment a slider exists: an ltx is read once
-- at load and cannot be moved from a menu. So the roll is ours now,
-- and the ltx keeps only the line that stops a corpse throwing the
-- result away.
--
-- ------------------------------------------------------------
-- EVERY SLIDER IS ITS OWN ROLL, AND MEANS WHAT IT SAYS
--
-- The alternative - roll down the row and stop at the first hit -
-- makes every slider after the first one quietly worth less than the
-- number written on it, and makes 100 not mean 100. So each is rolled
-- independently and every hit spawns. At the defaults a body carries
-- something about one time in twenty and two things almost never; at
-- 100 it carries one of everything, which is what the player asked
-- for by dragging the slider there.
--
-- ------------------------------------------------------------
-- THE TIER COMES OFF THE RIG
--
-- amp_rig_tier is stamped into every rig's section by art/mkloot.py
-- out of its pocket counts, the same arithmetic the stash tiers and
-- the recipes use. So a rig that is made better moves up the drop
-- ladder too, and no list here has to be kept in step by hand.
-- ============================================================
A.DROP_RANKS = { "novice", "trainee", "experienced", "professional",
                 "veteran", "expert", "master", "legend" }

local DROP_TIERS = 5

-- The three pouches, and the two-letter tail of the option that sets
-- each one. The sections are the magazine mod's.
A.DROP_POUCH = { "af_magpouch_s", "af_magpouch_m", "af_magpouch_l" }
A.DROP_PKEY  = { "ps", "pm", "pl" }

-- ============================================================
-- THE DEFAULTS, AND THE TWO SENTENCES BEHIND THEM
--
-- A RIG IS THE ONE HE WAS WEARING. So a rank drops its OWN tier at ten
-- per cent and the tier above it at five - the rank you are fighting is
-- the rank you are equipped for, and the occasional prize is the rig he
-- had no business owning.
--
-- A POUCH IS WHAT HE HAD ON HIM. Those are not a prize, they are
-- kit - the thing a rig is sewn out of - so they are commoner than
-- rigs, and which SIZE he carries climbs with his rank: a rookie has a
-- small pouch or nothing, a legend is carrying the big ones.
--
-- TIER FIVE IS ON A BODY AND IN NO STASH, which is deliberate: rare
-- stashes cap at tier four, so a legend is the only place the best
-- four rigs turn up outside a workbench.
--
-- THE NUMBERS WERE FIVE TIMES SMALLER AND THEY WERE WRONG.
--
--   "the drop % is suuuuper small. make so the rookie stalker have 10%
--    for dropping tier1 rig"
--
-- The old table was built for a durable in a Zone where every second
-- corpse must not wear one - two per cent, so a body carried a rig
-- about one time in fifty. That is a correct sentence about scarcity
-- and a wrong one about PLAYING: a feature you meet twice in a session
-- reads as a feature that does not work. Rigs are ten now and the
-- stretch tier five, the pouches four times what they were, and the
-- shape of the ladder is untouched - every number moved, none of the
-- relationships did.
--
-- AND "novice" IS SPELLED ROOKIE ON THE MENU. Only there: this key is
-- what ranks.get_obj_rank_name answers off a body and what a player's
-- saved slider path contains, so renaming it here would silently reset
-- eight settings. See art/mkstrings.py, RANK_EN.
--
--     rank            t1  t2  t3  t4  t5    s   m   l
-- ============================================================
A.DROP_DEF = {
	novice       = { 10,  0,  0,  0,  0,   12,  0,  0 },
	trainee      = { 10,  5,  0,  0,  0,   12,  4,  0 },
	experienced  = {  0, 10,  5,  0,  0,   12,  8,  0 },
	professional = {  0,  0, 10,  0,  0,    8, 12,  4 },
	veteran      = {  0,  0, 10,  5,  0,    8, 12,  4 },
	expert       = {  0,  0,  0, 10,  0,    4, 12,  8 },
	master       = {  0,  0,  0, 10,  5,    4,  8, 12 },
	legend       = {  0,  0,  0,  0, 10,    4,  8, 12 },
}

-- ============================================================
-- AND WHAT STATE IT IS IN WHEN YOU PICK IT UP
--
--   "rigs drop at full durability not broken, make so the the better
--    the npc the better condition the rig can be. look inside gamma
--    drop condition for outfits. and just almost copy it."
--
-- GAMMA's death_manager keeps [outfit_drop_condition] in
-- death_generic.ltx, a min and a max per rank, and rolls between them
-- with a coefficient built out of rank AND community. This is that
-- table, read off the installed fork:
--
--     novice 0.05-0.15   professional 0.10-0.25   master 0.15-0.30
--     trainee 0.05-0.20  veteran      0.10-0.25   legend 0.15-0.30
--     experienced 0.05-0.20   expert  0.10-0.30
--
-- ALMOST COPIED, AND HERE IS THE ALMOST. Their floor is kept exactly -
-- a rookie's rig comes off a body as junk, which is right. Their
-- CEILING is opened up, because the whole of the ask is "the better the
-- npc the better condition the rig CAN be" and their top rank is only
-- fifteen points better off than their bottom one. A legend's rig can
-- now come off at fifty-five per cent, which is worth carrying home;
-- theirs caps at thirty, which is not.
--
-- IT IS A RIG AND NOT AN OUTFIT, so this is not free repair either:
-- the rig ladder has con_parts_list and repair_part_bonus already, and
-- a tier 5 rig at 25% is a workbench job, not a free upgrade.
--
--     rank             min  max
-- ============================================================
A.DROP_COND = {
	novice       = {  5, 15 },
	trainee      = {  5, 20 },
	experienced  = {  5, 25 },
	professional = { 10, 30 },
	veteran      = { 10, 35 },
	expert       = { 15, 40 },
	master       = { 20, 45 },
	legend       = { 25, 55 },
}

-- WHAT A RIG OFF THIS BODY IS WORTH, as a fraction.
--
-- THE COEFFICIENT IS THEIRS, ASKED FOR RATHER THAN COPIED.
-- death_manager.get_comb_coeff(rank, comm) ^ 0.44 is a number in [0,1]
-- built from the rank ladder AND the community ladder - zombied 1,
-- stalker 17, monolith 30 - so a Monolith legend's gear comes off in
-- better shape than a zombie's. Calling it instead of copying the two
-- tables is the whole point: it is somebody else's balance decision and
-- it stays theirs. If the fork ever drops that function we fall back to
-- the middle of the range rather than to a wrong number.
--
-- utils_data.mean_random(min, max, coef, n) is likewise theirs. It is
-- inside a packed db here and its body has never been read, so nothing
-- in this mod may depend on the SHAPE of what it returns - only on it
-- landing between min and max, which is checked below.
function A.drop_cond(rank, comm)
	local row = A.DROP_COND[rank]
	if not row then return nil end
	local lo, hi = row[1], row[2]

	local coef = 0.5
	local okc, c = pcall(function()
		return death_manager.get_comb_coeff(rank, comm) ^ 0.44
	end)
	if okc and type(c) == "number" and c == c then coef = c end

	local pct
	local okr, v = pcall(function()
		return utils_data.mean_random(lo, hi, coef, 7)
	end)
	if okr and type(v) == "number" then
		pct = v
	else
		-- Flat, because a wrong curve is worse than no curve.
		pct = math.random(lo, hi)
	end

	-- CLAMPED TO THE ROW WE ASKED FOR. A helper we cannot read is a
	-- helper we do not let decide the answer: whatever it hands back,
	-- a rank's rig lands inside that rank's band or the band is a lie.
	if pct < lo then pct = lo elseif pct > hi then pct = hi end
	return pct / 100
end

-- ============================================================
-- AND PUTTING IT ON THE BODY AT THAT CONDITION
--
-- alife_create_item(sec, npc, { cond = c }) is the documented call and
-- it is NOT the one used here. It hands the id to itms_manager's
-- ItemProcessor, which waits for the item to come online and retries
-- ten times - and GAMMA's own note on the alternative says exactly what
-- happens when it does not:
--
--   "no need of time events to wait for item to become online etc.
--    which for me is why sometimes it misfires and we get full
--    condition drops"
--
-- Full condition drops is the bug being fixed. So the packet path is
-- first: build the server object WITHOUT registering it, write the
-- condition into its packet, then register. Same order, same calls, as
-- death_manager.spawn_with_condition.
--
-- THE FALLBACK IS THE DOCUMENTED CALL, because utils_stpk is another
-- mod's file parsing a class it was not written for - our rigs are
-- artefacts (af_base, II_ATTCH), not outfits - and a rig that arrives
-- at the wrong condition is a hundred times better than a rig that does
-- not arrive.
-- ============================================================
function A.drop_spawn(npc, sec, cond)
	if cond then
		local ok, id = pcall(function()
			local se = alife_create(sec, npc:position(), npc:level_vertex_id(),
			                        npc:game_vertex_id(), npc:id(), false)
			if not se then return nil end
			local data = utils_stpk.get_item_data(se)
			data.condition = cond
			utils_stpk.set_item_data(data, se)
			alife():register(se)
			return se.id
		end)
		if ok and id then return true end
		dbg("drops: packet path refused %s, falling back", tostring(sec))
	end

	return (pcall(function()
		alife_create_item(sec, npc, cond and { cond = cond } or nil)
	end))
end

-- The option id one slider is saved under. Written once, here, because
-- the MCM page builds its options from this and the settings read them
-- back - and an id spelled two ways is a slider that saves into
-- nothing.
function A.drop_id(rank, key)
	return "amp_drop_" .. tostring(rank) .. "_" .. tostring(key)
end

-- Every slider on the page, in the order it is drawn: rank, key,
-- default. One list, walked by the menu and by the settings alike.
function A.drop_opts()
	local out = {}
	for _, rank in ipairs(A.DROP_RANKS) do
		local d = A.DROP_DEF[rank] or {}
		for t = 1, DROP_TIERS do
			out[#out + 1] = { rank, "t" .. t, d[t] or 0 }
		end
		for i = 1, #A.DROP_PKEY do
			out[#out + 1] = { rank, A.DROP_PKEY[i], d[DROP_TIERS + i] or 0 }
		end
	end
	return out
end

-- ============================================================
-- AND THE DOOR THE MENU COMES THROUGH
--
--   the sliders were built and the subcategory never appeared
--
-- A .script IS A TABLE IN GAME, AND ITS FIELDS ARE THIS FILE'S
-- TOP-LEVEL GLOBALS. `A` is a local. It is not in that table, it never
-- was, and `zzz_armor_mag_pouches.drop_opts` therefore reads nil - in
-- the game, where the MCM page is built inside a pcall that swallowed
-- it, so the whole subcategory silently did not exist.
--
-- Every other cross-file door in this mod is already a plain top-level
-- function for exactly this reason - grid_keep, grid_files,
-- amp_wd_seam, pouch_no_install. These two are the same door, written
-- the same way, and there is now an audit rule that every name the MCM
-- file reaches on this module is one of them.
-- ============================================================
function amp_drop_id(rank, key)  return A.drop_id(rank, key) end
function amp_drop_opts()         return A.drop_opts() end

-- WHICH RIGS ARE AT THIS TIER. Read off the sections once and kept:
-- this is asked on every death and SYS_GetParam is an ini read.
A.rigs_by_tier = A.rigs_by_tier or nil

function A.rigs_at(tier)
	if not A.rigs_by_tier then
		local by = {}
		for i = 1, #RIGS do
			local sec = RIGS[i]
			local t = tonumber(SYS_GetParam(2, sec, "amp_rig_tier"))
			-- A rig with no tier stamped on it is not guessed at. It
			-- simply never drops, and says so once - because guessing
			-- would put an endgame rig on a novice and nothing would
			-- ever tell anyone.
			if t and t >= 1 and t <= DROP_TIERS then
				by[t] = by[t] or {}
				by[t][#by[t] + 1] = sec
			else
				log("!drops: %s has no amp_rig_tier - it will not drop",
				    tostring(sec))
			end
		end
		A.rigs_by_tier = by
	end
	return A.rigs_by_tier[tier]
end

-- ============================================================
-- AND THE ROLL
--
-- ONE PLACE, so the suite can call it with a rank and count what came
-- out rather than driving a callback and a game object.
-- ============================================================
function A.drop_list(rank)
	local row = A.drop and A.drop[rank]
	if not row then return {} end

	local out = {}

	-- `p > 0` IS NOT A CORRECTNESS GUARD. math.random() answers [0,1)
	-- and the test is `<`, so a slider at zero cannot fire either way.
	-- It is there to spend no dice at all on a player who has turned
	-- the whole thing off - eight of them per body - which is why no
	-- mutation covers it.
	for t = 1, DROP_TIERS do
		local p = row.tier[t] or 0
		if p > 0 and math.random() < p then
			local at = A.rigs_at(t)
			-- ONE OF THEM AT RANDOM. A tier is several rigs and a body
			-- carries one; picking the first would make four of the
			-- five at that tier undroppable.
			if at and #at > 0 then out[#out + 1] = at[math.random(#at)] end
		end
	end

	for i = 1, #A.DROP_POUCH do
		local p = row.pouch[i] or 0
		if p > 0 and math.random() < p then
			out[#out + 1] = A.DROP_POUCH[i]
		end
	end

	return out
end

function A.on_npc_death(npc)
	if not (A.enabled and npc) then return end

	-- NOT THE ACTOR, and not a mutant. Both reach this callback and
	-- neither has a rank the drop table knows.
	local oki, id = pcall(function() return npc:id() end)
	if not oki or id == AC_ID then return end
	if not IsStalker(npc) then return end

	local okr, rank = pcall(function()
		return ranks.get_obj_rank_name(npc)
	end)
	if not (okr and type(rank) == "string") then return end

	-- HIS COMMUNITY, WHICH IS HALF OF THE CONDITION. Monolith gear comes
	-- off a body in better shape than a zombie's, and that is their
	-- ladder, not ours - see A.drop_cond.
	local _, comm = pcall(function() return character_community(npc) end)

	local want = A.drop_list(rank)
	for i = 1, #want do
		local sec = want[i]

		-- A POUCH HAS NO CONDITION WORTH SETTING. It is a pocket made of
		-- fabric with nothing to wear out, it is the CRAFTING MATERIAL a
		-- rig is sewn from, and handing the player three quarters of a
		-- pouch would only be an odd number in a recipe. Rigs are the
		-- durable, so rigs are the thing that arrives worn.
		local cond = A.is_rig_sec(sec) and A.drop_cond(rank, comm) or nil

		if A.drop_spawn(npc, sec, cond) then
			dbg("drops: %s left a %s at %s", tostring(rank), tostring(sec),
			    cond and string.format("%d%%", cond * 100) or "full")
		else
			log("!drops: could not spawn %s", tostring(sec))
		end
	end
end

-- The boxes. Same list, same purpose: the debug spawn entries and the
-- load-time report. The audit pins it against
-- mod_system_amp_boxes.ltx, so a box that is in one and not the other
-- is caught before it ships.
--
-- IN THE ORDER THEY WERE DRAWN, which is the order they went on the
-- sheet. Nothing reads the order; it is here so that this list and
-- art/mkboxdds.py read the same way down the page.
local BOXES = {
	"ampbox_meds",
	"ampbox_ammo",
	"ampbox_food",
	"ampbox_armor",
	"ampbox_food_small",
	"ampbox_mags",
	"ampbox_ammo_big",
	"ampbox_parts",
	-- The two weapon cases, which take what nothing else would: a gun
	-- is not a kind anything can ask for. See A.is_gun_sec.
	"ampbox_weapon",
	"ampbox_weapon_big",
	-- The document case. Its window is a fan of paper edges rather
	-- than a grid, which changes nothing about it being a box.
	"ampbox_docs",
}

-- Whether a section actually exists, asked the way this file already
-- asks everything else. A section that never loaded answers nil for
-- every parameter, including one it certainly sets.
local function rig_exists(sec)
	return SYS_GetParam(0, sec, "icons_texture") ~= nil
end

-- How many of them loaded, and which one is missing if any are. One
-- typo in a section header silently costs a rig, and the symptom is an
-- item that simply cannot be spawned.
function A.rigs_loaded()
	local n, missing = 0, {}
	for i = 1, #RIGS do
		if rig_exists(RIGS[i]) then n = n + 1
		else missing[#missing + 1] = RIGS[i] end
	end
	return n, #RIGS, table.concat(missing, ", ")
end

local function rig_label(sec)
	local nm = SYS_GetParam(0, sec, "inv_name")
	local base = game.translate_string(
		A.is_box_sec(sec) and "st_amp_spawn_box" or "st_amp_spawn_rig")
	if not nm then return base end
	return base .. ": " .. game.translate_string(nm)
end

-- ============================================================
-- THE DEBUG SPAWN ENTRIES
--
-- On ANY item in your own inventory, not only on a worn outfit. The
-- outfit gate was there to keep the menu tidy, and it made the entries
-- almost impossible to find: you need a rig to test rigs, and the one
-- place the entry appeared was a menu you had no reason to open.
--
-- Still gated on Debug, which is off by default - this is scaffolding
-- for playtesting, not a feature. Turn it on in MCM under Armor Mag
-- Pouches and every item's right-click menu grows one entry per rig.
--
-- The crafting recipes are NOT a substitute here: GAMMA's workshop
-- hides a recipe until the matching recipe book has been read
-- (ui_workshop checks is_unlocked_note for it), so a rig whose book you
-- have not found is invisible in the craft menu however correct its
-- recipe is.
-- ============================================================
local function name_spawn_for(sec)
	return function(obj, bag, mode)
		if not A.debug then return nil end
		if not rig_exists(sec) then return nil end
		return rig_label(sec)
	end
end

local function action_spawn_for(sec)
	local name_f = name_spawn_for(sec)
	return function(obj, bag, mode)
		if not name_f(obj, bag, mode) then return end

		local ok, err = pcall(function()
			alife_create_item(sec, db.actor)
		end)

		if ok then
			notify("Spawned %s", sec)
		else
			log("!spawn %s: %s", sec, tostring(err))
			notify("Could not spawn %s - see the log", sec)
		end
	end
end

-- ============================================================
-- THE RIG IS NOT DRAWN ON THE ARMOUR ANY MORE
--
-- It used to be installed onto the worn outfit and painted over the
-- armour's inventory icon through rax_icon_layers. That is gone. Every
-- icon pack draws its armours at a different size and on a different
-- grid - 2x2 for novice suits and 2x3 for the rest in Kos' GRIP alone -
-- so the overlay had to be fitted to whatever pack the player happened
-- to have, and four releases went into size and position alone before
-- the answer turned out to be that the whole idea was fighting the
-- texture packs.
--
-- The rig now lives in a slot of its own beside the inventory. Nothing
-- is painted on anybody else's icon, so there is nothing to fit.
--
-- Removed with it: place_layer, the rax_icon_layers wrapper, and the
-- three MCM settings that existed only to aim the overlay
-- (amp_layer_scale, amp_layer_x, amp_layer_y).
-- ============================================================

-- ============================================================
-- HOW MANY ROWS OF THE GRID THE RIG BLOCK STANDS ON
--
-- Zone Grid keeps this many rows at the top of the inventory empty. The
-- rows are part of the grid, so they scroll with it and take the rig
-- block with them - which is what was asked for:
--
--   "i wanted so the slot is in scrollable space as well as the mag
--    slots from the rig, and they can go out of the visible space when
--    inventory is scrolled down, like in tarkov."
--
-- The previous build moved the bag's panel down instead. That did keep
-- the block still, and still was the wrong answer.
--
-- MEASURED FROM THE CONTENT, NOT THE WINDOW, and measured every frame
-- including the frames where nothing is painted - the draw pass runs
-- blind rather than returning early precisely so that this number does
-- not change the moment you scroll.
--
-- The lower of the two: the pockets panel as laid out, and the slot.
-- With no rig on there is no panel and the slot is the whole block.
-- ============================================================
-- ============================================================
-- WHAT THIS MOD IS HOLDING ON TO
--
--   "unequpping backpack also unequpis the rig"
--
-- It did, and the chain was long. Taking the backpack off makes Zone
-- Grid re-place everything; the rig is an ITEM in the bag rather than
-- something in an engine slot, so it was in the pile being placed; it
-- did not fit; it went on the ground; and this mod, watching for its
-- rig leaving the actor, dutifully took it off.
--
-- A worn rig is EQUIPMENT. It is not cargo and must not be treated as
-- any more droppable than the armour on your back - and neither are the
-- magazines in its pockets, which are in the inventory but hidden from
-- the bag and would have gone the same way.
--
-- Returned as a set, because the caller is answering "may I drop this"
-- one id at a time.
-- ============================================================
function grid_keep()
	local keep = {}
	local layers = rawget(_G, "zzz_amp_layers")
	if layers and type(layers.keep) == "function" then
		local ok, more = pcall(layers.keep)
		if ok and type(more) == "table" then
			for id, yes in pairs(more) do if yes then keep[id] = true end end
		end
	end
	if not A.enabled then return keep end

	if A.rig_id then keep[A.rig_id] = true end

	-- EVERYTHING IN EVERY SLOT of the worn rig. A.pk is the same list
	-- the panel draws from, so this cannot fall out of step with what
	-- is actually in there.
	--
	-- Its contents are real objects that A.hidden keeps out of the bag
	-- window, always - and a grid that counts what the window will not
	-- draw says "56 of 56" over a bag with visible room, and spills
	-- every new pickup onto the ground. That is the gmerc log,
	-- verbatim: nine pocketed things, eleven phantom cells, and the
	-- same medkit thrown back five times. What the window hides, the
	-- grid must not count.
	--
	-- ONE LOOP NOW. This was three - the magazines, the med pocket and
	-- the med pouches - added one release at a time as each new store
	-- turned out to have the same bug.
	for i = 1, #A.pk do
		local P = A.pk[i]
		for id in pairs(P and P.byid or {}) do
			if type(id) == "number" then keep[id] = true end
		end
	end

	-- AND A MAGAZINE WAITING FOR A POCKET. It is hidden from the bag,
	-- so counting it against the grid would say the inventory is fuller
	-- than what is on screen - and putting it on the ground for want of
	-- a square is the last thing to do with something that is about to
	-- be in a pocket. See A.settle_held.
	for id in pairs(A.held or {}) do
		if type(id) == "number" then keep[id] = true end
	end


	-- AND WHAT IS ON YOUR ARM.
	--
	--   "items are getting dropped on the ground when there is visible
	--    space in inventory ... equipped tablet got dropped"
	--
	-- A.hidden has kept worn devices out of the window since 2.6.0 and
	-- this list was never told, so the grid counted five squares of
	-- cargo nobody could see and put the tablet on the ground for want
	-- of room. The same bug as the med pocket, three releases later,
	-- and the invariant that was written down to stop it happening
	-- again was checked against a list of ids that this one was never
	-- added to.
	--
	-- READ OFF A, NOT OFF THE PATCH. A.wd_worn is part of the mod's own
	-- seam and is an empty table without the wearable-devices patch, so
	-- this line is correct in both installs and there is nothing here
	-- that knows the patch exists.
	for id in pairs(A.wd_worn or {}) do
		if type(id) == "number" then keep[id] = true end
	end


	-- AND THE MAGAZINES COUNTED AGAINST THE RIG BUT NOT IN A POCKET,
	-- exactly when the window hides them - the same conjunction
	-- A.hidden tests, so the two lists cannot drift apart again. When
	-- either option is off those magazines are drawn in the bag,
	-- occupy real squares, and are cargo like anything else.
	if A.hide_grid and A.rig_is_all then
		for id in pairs(A.carried_now or {}) do
			if type(id) == "number" then keep[id] = true end
		end
	end

	return keep
end

-- Public compatibility door used by the optional Layered Pouches addon.
-- SquaredAway owns the MCM layout setting, so optional UI modules ask here
-- instead of copying its option reader or guessing from hard-coded X values.
function layer_layout()
	return A.layout or DEFAULTS.amp_layout or "default"
end

function layer_rig_id()
	return A.rig_id
end

function layer_claim(pouch_id)
	local k = type(pouch_id) == "number" and A.win_of(pouch_id)
	if k then A.win_close(k, "pouch fitted to equipment") end
	return true
end

function layer_release(pouch_id)
	local k = type(pouch_id) == "number" and A.win_of(pouch_id)
	if k then A.win_close(k, "pouch removed from equipment") end
	return true
end

-- One-time migration of contents saved by the original floating-box
-- implementation into real actor objects owned by the inline grid.
function layer_drain(pouch_id)
	if type(pouch_id) ~= "number" then return 0 end
	local made, guard, ids, seen = 0, 0, {}, {}
	while A.boxes[pouch_id] and #A.boxes[pouch_id] > 0 and guard < 10000 do
		guard = guard + 1
		local before = A.pile_n(A.boxes[pouch_id][#A.boxes[pouch_id]])
		local ok, _, created = A.box_take(pouch_id, #A.boxes[pouch_id], A.box_sec(pouch_id))
		if not ok then break end
		for i = 1, #(created or {}) do
			local id = tonumber(created[i])
			if id and not seen[id] then
				seen[id], ids[#ids + 1] = true, id
			end
		end
		local after = A.boxes[pouch_id] and A.boxes[pouch_id][#A.boxes[pouch_id]]
			and A.pile_n(A.boxes[pouch_id][#A.boxes[pouch_id]]) or 0
		made = made + math.max(1, before - after)
	end
	return made, ids
end

-- ============================================================
-- WHAT MAY NOT BE PUT ON THE GROUND, EVEN WHEN THERE IS NO ROOM
--
--   "when inventory is full of stuff... the mag that gets unloaded
--    tries to go into invnetory and cant so gets dropped"
--
-- From the log, whole:
--
--   [AMP-DBG] room_in_pouch(37654) -> false
--   [GRID] no square for mag_mp443_9x19_default (1x2)
--   [GRID] 54 of 56 cells, 50 carried, 1 over
--   [GRID] no room: 1 item(s) put on the ground
--
-- No pocket free, so the magazine goes to the bag; the bag has two free
-- cells and the magazine needs two ONE ABOVE THE OTHER; so it is over,
-- and the tick drops it.
--
-- The spill is for a load you CHOSE to carry - things picked up, or a
-- backpack taken off. A magazine that came out of your own weapon when
-- you pressed R is not that: you did not put it there and you cannot
-- decline it. So it is kept, unplaced, exactly as anything over
-- capacity is with the drop switch off, and comes back into view the
-- moment there is room.
--
-- SEPARATE FROM grid_keep ON PURPOSE. grid_keep means "this is not
-- cargo, do not count it and do not show it" - true of a worn rig and
-- of the magazines in its pockets. This one is still ordinary cargo
-- that wants a square like anything else; it just may not be thrown
-- away for want of one.
--
-- A set, because the caller is answering "may I drop this" one id at a
-- time - and pruned as it is built, so nothing has to remember to.
-- ============================================================
function grid_nodrop()
	local safe = {}
	local layers = rawget(_G, "zzz_amp_layers")
	if layers and type(layers.nodrop) == "function" then
		local ok, extra = pcall(layers.nodrop)
		if ok and type(extra) == "table" then
			for id, yes in pairs(extra) do if yes then safe[id] = true end end
		end
	end
	if not A.enabled then return safe end

	for id in pairs(A.from_gun) do
		local obj = level.object_by_id(id)

		local inv = false
		if obj and utils_item and utils_item.in_actor_inv then
			local ok, res = pcall(utils_item.in_actor_inv, obj)
			inv = (ok and res) and true or false
		end

		if obj and inv then
			safe[id] = true
		else
			-- Gone, sold, dropped by hand, or loaded back into a gun.
			-- Assigning nil to a key that is already there is allowed
			-- during a pairs() walk; adding one is not, and none is.
			A.from_gun[id] = nil
		end
	end

	return safe
end

-- ============================================================
-- WHAT WE ARE CARRYING, FOR SOMEBODY ELSE'S HIGHLIGHT
--
--   "the highlight (green and red) is not showing when i drag item
--    from inventory to box or from box to inventory"
--
-- The second half of that. Zone Grid draws the rectangle on its own
-- grid from the MENU'S drag - item_in_hold names a container and that
-- container's hold.idx is the cell - and a magazine or a box entry on
-- this mod's cursor is in neither. It is not in the menu's hands at
-- all; it does not exist as an object yet.
--
-- So this says what is on the cursor, as a section, and the grid asks.
-- Published at file scope beside grid_keep and grid_block_rows, which
-- is how these two mods have always talked.
-- ============================================================
function grid_carrying()
	if not A.enabled then return nil end

	local d = A.win_drag
	if not (d and d.box) then return nil end

	local w = A.wins[d.k]
	local it = w and w.id and (A.boxes[w.id] or {})[d.i]

	if not (it and type(it.sec) == "string") then return nil end

	-- ...and WHICH WAY: the entry's own lie, turned once more when the
	-- R key has been pressed over the drag. The grid swaps its hover
	-- by this and by nothing else.
	return it.sec, (it.rot and true or false) ~= (A.rot_hand and true or false)
end

-- THE HAND ALONE, for the grid's own drags. The rotate key and its
-- MCM binding live in this mod; the grid asks here rather than
-- reading a keyboard of its own, so there is exactly one key.
function grid_hand_turned()
	return (A.enabled and A.rot_hand) and true or false
end

-- ============================================================
-- ...AND WHETHER THE BOX UNDER THE CURSOR WANTS WHAT IS HELD
--
--   "when item that can be put into a box, is hover over the
--    coresponding box and the drop would make this item go into the
--    box, there would be no red highlight but instead the box would
--    get a subtle white highlight and a very thin white border, till
--    the item is dropped into it or moved away."
--
-- The grid draws the highlight; whether the drop would LAND is this
-- mod's knowledge, so the question comes through the door. The answer
-- is the box's object id when it would - the same three refusals
-- box_put gives, asked without moving anything: the family, the
-- weight, and a stack to join or a square to stand on - and nil for
-- everything else, so the grid falls back to its own colours.
--
-- The gates are the DROP'S OWN GATES, copied from the On_CC_DragDrop
-- branch that puts things in boxes: enabled, editing allowed, the
-- player's own list. A highlight that promises what the drop then
-- refuses is worse than red.
-- ============================================================
-- ...AND WHETHER A CASE WOULD SWALLOW IT ON THE WAY IN
--
--   "items that are in containers (example faction patch in wallet)
--    cannot be quicklooted when invetory is full"
--
-- The grid's door refuses a take when there is no square for it. A
-- patch on its way to the wallet never stands on a square: file_loot
-- catches it as it arrives and puts it in the case. So the door asks
-- here first, and this is exactly the question file_loot will ask
-- itself a moment later - the setting, a case you are carrying, a case
-- that already holds one of these, and a case that takes them at all.
--
-- BY SECTION ONLY, because the door has nothing else at the moment it
-- asks: the object still belongs to the body. That is the same key
-- file_loot files by, so the two cannot disagree.
--
-- The NOTE is not asked about here. A note is a square you pointed at,
-- and pointing at a case is a gesture that has already been let
-- through the door.
-- ============================================================
function grid_files(sec)
	if not (A.enabled and A.loot_box) then return false end
	if type(sec) ~= "string" then return false end
	if A.is_box_sec(sec) then return false end

	local boxes = A.box_carried()
	for i = 1, #boxes do
		local b = boxes[i]
		if A.box_holds(b.id, sec) and A.box_takes(b.sec, sec) then
			return true
		end
	end

	return false
end

--
-- `from` IS THE LIST THE DRAG STARTED IN, and there are two of them
-- now. Out of your own bag the drop needs nothing more. Out of a
-- body's list it is the two-step transfer added in 2.21.0, which
-- happens only while looting and only with the filing switched on - so
-- those are asked here, in the same place, rather than left for the
-- highlight to guess at.
-- ============================================================
function grid_box_wants(cc, sec, obj, from)
	if not (A.enabled and editing_allowed() and cc and obj) then return nil end
	if type(sec) ~= "string" then return nil end
	if not A.ours(cc.ID) then return nil end

	if from and from ~= cc.ID then
		if from ~= "npc_bag" then return nil end
		if not (A.loot_box and A.looting()) then return nil end
	end

	local box, bsec, bid = A.box_under(cc, obj)
	if not box then return nil end

	if not A.box_takes(bsec, sec) then return nil end

	-- The drop's own arithmetic, on a reading: box_grab reads the
	-- object, it never takes it.
	local it = A.box_grab(obj)
	if it then
		if A.rot_hand and (it.w or 1) ~= (it.h or 1) then
			it.w, it.h, it.rot = it.h, it.w, true
		end
		if not A.box_lift(bid, bsec, it) then return nil end

		local t = A.boxes[bid] or {}
		local cols, rows = A.box_grid(bsec)
		if not A.box_join(t, it, A.box_cap(bsec)) then
			if not A.box_spot(t, cols, rows, it.w, it.h) then
				return nil
			end
		end
	end

	return bid
end

-- The grid's line to the voice box: a move IT landed - drop_at said
-- mine - plays the same quick shuffle the rotate key does. A door
-- like the others, so the grid alone stays silent rather than broken.
function grid_sfx(kind)
	A.sfx(kind)
end

-- ============================================================
-- MEASURED WHERE BOTH NUMBERS ARE FROM THE SAME FRAME
--
-- The height is (the bottom of the block) minus (the top of the
-- scrolling content), and both of those move together when the list
-- scrolls - so the subtraction should be scroll-proof. It was not,
-- because the two were read in DIFFERENT FRAMES. Zone Grid's per-frame
-- work runs before this mod's draw inside one frame, so when it asked,
-- A.rlay and A.rect were from the previous draw and the content's top
-- was from this one:
--
--     drawn, unscrolled:            3
--     scrolled  43 px, not redrawn: 4
--     scrolled  86 px, not redrawn: 5
--     scrolled 129 px, not redrawn: 6
--     redrawn at 129:               3
--
-- One row per row scrolled, for a block that never changed size. And
-- every square in that grid is a row counted from under this block, so
-- a list that is moving reports a block that is growing and drags the
-- whole arrangement after it. A runaway scroll does not just scroll -
-- it resorts.
--
-- So the draw works it out, holding both numbers at once, and this
-- hands back what the draw last measured. A frame behind while the
-- list moves, which is right: the block's height does not change when
-- you scroll. What it can no longer be is half of one frame and half
-- of another.
-- ============================================================
-- The lowest edge of a rectangle, folded in. A file-local rather than
-- a closure inside measure_block, which allocated one per frame for
-- the pleasure of capturing a single upvalue.
local function block_lower(low, r, on)
	if not r or on == false then return low end
	local b = r[2] + r[4]
	if not low or b > low then return b end
	return low
end

function A.measure_block()
	if not (A.enabled and A.bag_docked()) then return nil end

	local con = A.bag_content()
	if not con then return nil end

	-- ============================================================
	-- EVERYTHING THE BLOCK DRAWS, NOT MOST OF IT
	--
	-- The lowest edge of anything this mod puts in the column. Zone
	-- Grid keeps that many rows clear: nothing is laid out in them, and
	-- the backpack slot is placed at the first row after them.
	--
	-- THE MED POCKET WAS MISSING FROM THIS, and it cost two bugs at
	-- once:
	--
	--   "half of the slot is under backpack slot"
	--   "picking up items does not work when grabbign them from the
	--    upper parth of the slot (so the visible part) but does work
	--    when grabbed from under the backpack slot"
	--
	-- The second is the tell. The half that still looked like a pocket
	-- was the half with GRID CELLS under it, and a cell under the
	-- cursor takes the press - the container gets it and nothing here
	-- ever decides anything. The half hidden under the backpack slot
	-- had no cell beneath it, because the slot stands in the gutter and
	-- the grid never fills that, so the press reached the pocket.
	--
	-- A control drawn where something else owns the clicks is the same
	-- class of mistake as one drawn in one place and clicked in
	-- another. The answer is to stop them overlapping, not to argue
	-- about who gets the press.
	--
	-- ANYTHING ADDED TO THE BLOCK AFTER THIS MUST BE ADDED HERE. That
	-- is the whole rule, and the med pocket is the second thing to
	-- learn it.
	-- ============================================================
	local low
	low = block_lower(low, A.rlay)
	low = block_lower(low, A.rect, A.open)

	if not low then return nil end

	local gs, gl = A.metrics()
	local ch = gs + gl
	if not (ch > 0) then return nil end

	local rows = math.ceil((low - con.y1) / ch)
	if rows < 0 then rows = 0 end
	if rows > 20 then rows = 20 end
	return rows
end

-- ============================================================
-- IS ONE OF OUR WINDOWS UNDER THE CURSOR?
--
--   "when box window is over the inventory grid and i try to put
--    something inside then the item is dropped in the cell that was
--    directly under the window"
--
-- Zone Grid's drop hook runs before this file's - it wraps
-- On_CC_DragDrop when the game starts and this one wraps it at load, so
-- the grid's is the outer wrapper. It asks the CONTAINER whether the
-- cursor is over it, and the container cannot see a window floating on
-- top of itself, so a drop aimed at a box landed in the square behind
-- it.
--
-- This is the answer to that, at file scope beside grid_keep and
-- grid_block_rows because that is how these two mods have always
-- talked. True means: something of ours is under the cursor, do not
-- take this drop - it is coming to us.
--
-- The RIG SLOT AND THE PANEL ARE NOT INCLUDED. They are drawn inside
-- the list's own scrolling content rather than over it, they have
-- always taken their drops through the ordinary path, and claiming them
-- here would take drops away from the squares beside them.
-- ============================================================
function grid_window_over()
	if not (A.enabled and editing_allowed()) then return false end

	local ok, over = pcall(function()
		return (A.win_shown() and A.win_over()) and true or false
	end)

	return (ok and over) or false
end

function grid_panel_over()
	if not (A.enabled and editing_allowed() and A.open) then return false end
	A.cursor_dirty()
	local ok, over = pcall(A.over_panel)
	return (ok and over) and true or false
end

-- Item-on-item bridge independent of panel hit-testing. The actor bag can
-- report the focused object for a magazine whose icon AMP draws in the worn
-- rig. A.by_id is the authoritative answer that this target is such a mag.
function grid_item_put(obj, target)
	if not (A.enabled and editing_allowed() and obj and target) then return false end
	local ok_i, id = pcall(function() return target:id() end)
	if not (ok_i and A.pk_index(id)) then return false end
	return A.load_onto(obj, target) and true or false
end

-- Exact pocket bridge for a sibling inventory view. over_panel describes
-- the clipped panel background and can miss a visible pocket when the panel
-- is docked/scrolled; slot_at uses the same per-pocket rectangles as drawing
-- and is therefore the authoritative hit test. This is the same decision
-- made by On_CC_DragDrop for actor_bag: ammo loads an occupied magazine,
-- otherwise a magazine is filed into the selected/free pocket.
function grid_panel_put(obj, bag_scroll)
	if not (A.enabled and editing_allowed() and A.open and obj) then return false end
	-- On_CC_DragDrop does this before every AMP hit test. A sibling wrapper
	-- runs earlier in the chain, so without the same invalidation slot_at
	-- reads the cursor cache from the previous frame and misses the pocket.
	A.cursor_dirty()
	local i
	local over_cc = false
	local over_native_slot = false
	-- IsCursorOverWindow is affected by UI z-order: the detached pouch view
	-- can own the cursor even where AMP's rig cells remain visibly on top.
	-- GetAbsoluteRect is not. Read the final engine rectangle and compare it
	-- with the global cursor ourselves.
	local function actual_hit(w)
		if not w then return false end
		local r = Frect():set(0, 0, 0, 0)
		local ok = pcall(function() w:GetAbsoluteRect(r) end)
		local x1, y1 = tonumber(r.x1), tonumber(r.y1)
		local x2, y2 = tonumber(r.x2), tonumber(r.y2)
		if not (ok and x1 and y1 and x2 and y2 and x2 > x1 and y2 > y1) then
			return false
		end
		return hit({ x1, y1, x2 - x1, y2 - y1 })
	end

	-- pk_out is the authoritative visible frame for every pocket, including
	-- empty ones. It is clipped and moved by the draw pass before this event.
	if A.pk_out then
		for n = 1, #A.rig do
			if actual_hit(A.pk_out[n]) then
				i = n
				over_native_slot = true
				break
			end
		end
	end
	-- An occupied UICellItem can sit above its frame. Its absolute rectangle
	-- identifies the same pocket and remains useful if a UI theme hides the
	-- frame window instead of merely tinting it.
	if not i and A.cc and A.cc.cell then
		for n = 1, #A.rig do
			local cell = A.cc.cell[n]
			if cell and actual_hit(cell.cell) then
				i = n
				over_native_slot = true
				break
			end
		end
	end
	-- Legacy calculated geometry remains a fallback for UI implementations
	-- whose window bindings do not expose GetAbsoluteRect.
	if not i then i = A.slot_at() end
	-- When AMP is docked into actor_bag, the engine scrolls the parent list but
	-- GetAbsoluteRect for these sibling controls keeps their unscrolled value.
	-- ZoneGrid passes that missing offset. Test both signs because UI forks use
	-- opposite scroll conventions; only a visible pocket-sized rectangle wins.
	local scroll = tonumber(bag_scroll) or 0
	if not i and scroll ~= 0 and A.lay then
		for _, shift in ipairs({ scroll, -scroll }) do
			for n = 1, #A.lay do
				local r = A.lay[n]
				if r and hit({ r[1], r[2] + shift, r[3], r[4] }) then
					i = n
					over_native_slot = true
					break
				end
			end
			if i then break end
		end
	end
	if A.cc then
		local ok_o, over = pcall(function()
			return A.cc:IsShown() and A.cc:IsCursorOverWindow()
		end)
		over_cc = ok_o and over and true or false

		-- Filled AMP pockets are real UICellItems. Their cell index is the
		-- pocket index, so the engine's focused-cell answer is more reliable
		-- than reconstructing its rectangle in Lua.
		if not i and over_cc and type(A.cc.GetCell_Focused) == "function" then
			local ok_f, _, focused_i, focused_obj = pcall(A.cc.GetCell_Focused, A.cc)
			if ok_f and focused_obj then
				i = A.pk_index(focused_obj:id()) or focused_i
			end
		end

		-- Do not infer the position of a filled pocket from the detached
		-- inventory's coordinates. AMP has already placed a real engine UI
		-- cell at the final, clipped screen position; ask that window itself.
		-- This also identifies the exact target magazine for ammo drops.
		if not i and A.cc.cell then
			for n = 1, #A.rig do
				local cell = A.cc.cell[n]
				local ok_h, on = pcall(function()
					return cell and cell.cell and cell.cell:IsShown()
						and cell.cell:IsCursorOverWindow()
				end)
				if ok_h and on then
					i = n
					over_native_slot = true
					break
				end
			end
		end
	end
	-- Empty pockets have no UICellItem by design, but their visible border is
	-- a real static window. Query it directly so dropping a magazine into an
	-- empty rig pocket works even when the shared scroll origin has moved.
	if not i and A.pk_out then
		for n = 1, #A.rig do
			local pocket = A.pk_out[n]
			local ok_h, on = pcall(function()
				return pocket and pocket:IsShown() and pocket:IsCursorOverWindow()
			end)
			if ok_h and on then
				i = n
				over_native_slot = true
				break
			end
		end
	end
	-- The clipped hitbox can be empty/wrong when the detached inventory view
	-- changes the shared scroll bounds. The pocket itself is still drawn from
	-- A.lay, so its un-clipped rectangle is the correct fallback.
	if not i and A.lay then
		for n = 1, #A.lay do
			if hit(A.lay[n]) then i = n break end
		end
	end
	-- Hover focus is maintained by AMP's draw pass and names the magazine in
	-- an occupied pocket. It is independent of the source container and is a
	-- final precise fallback for ammo-on-magazine.
	if not i and A.focus_id then i = A.pk_index(A.focus_id) end
	if not i then
		-- Dropping a magazine anywhere inside the visible panel may use AMP's
		-- normal first-compatible-free-pocket behaviour, just like actor_bag.
		if over_cc or (A.rect and hit(A.rect)) then
			A.put(obj, nil)
			return true, "put"
		end
		local cx, cy = cursor()
		local lr = A.lay and A.lay[1]
		local ar
		if A.pk_out and A.pk_out[1] then
			local fr = Frect():set(0, 0, 0, 0)
			if pcall(function() A.pk_out[1]:GetAbsoluteRect(fr) end) then
				ar = { fr.x1, fr.y1, fr.x2 - fr.x1, fr.y2 - fr.y1 }
			end
		end
		log("side-to-rig bridge missed pocket (open=%s, slots=%s, over=%s, cc=%s, native=%s, focus=%s scroll=%.1f cursor=%.1f,%.1f lay1=%s abs1=%s)",
			tostring(A.open), tostring(A.lay and #A.lay or 0),
			tostring(A.over_panel()), tostring(over_cc), tostring(over_native_slot),
			tostring(A.focus_id), scroll, tonumber(cx) or -1, tonumber(cy) or -1,
			lr and string.format("%.1f,%.1f,%.1f,%.1f", lr[1], lr[2], lr[3], lr[4]) or "nil",
			ar and string.format("%.1f,%.1f,%.1f,%.1f", ar[1], ar[2], ar[3], ar[4]) or "nil")
		return false
	end
	log("side-to-rig bridge targeted pocket %s (native=%s, sec=%s)",
		tostring(i), tostring(over_native_slot), tostring(obj:section()))
	if A.load_from_drop(obj, i) then return true, "load" end
	A.put(obj, i)
	return true, "put"
end

-- Optional bridge for sibling inventory views.  They contain real actor
-- objects but have their own container id, so the stock On_CC_DragDrop gate
-- does not recognise them as BAG/LIST_ID.  Keep the actual box insertion in
-- AMP: it owns filtering, capacity, stacking, serialization and destruction
-- of the source objects.
function grid_window_put(cc, idx, obj)
	if not (A.enabled and editing_allowed() and A.win_shown() and A.win_over()) then
		return false
	end
	local k = A.win_hit()
	if not (k and obj) then return false end
	return A.win_put(k, obj, A.win_at(k), cc, idx) and true or false
end

function grid_block_rows()
	-- NOT RE-MEASURED HERE. See A.measure_block: asking now would mix
	-- this frame's content with the last draw's rectangle, and the
	-- caller is Zone Grid, which runs before that draw.
	if not A.enabled then return 0 end
	return A.block_rows or 0
end

-- ============================================================
-- IN FRONT OF WHATEVER TOOK ITEM USE OVER
--
--   "look log. nothing changed. the items in inventory are still
--    usable by quickuse."
--
-- And the log said why. The refusal was there, the message was there,
-- and the medkit was used anyway:
--
--     [AMP-DBG] med gate: medkit refused - there is none in the pocket
--     [AMP] No AI-2 Medkit in the med pocket
--     [anm_name] => anm_hide
--     ...medkit_use_slow80.ogg
--
-- FDDA Redone does not obey flags.ret_value - it SETS it, to stop the
-- engine using the item, and then plays an animation and consumes the
-- item itself with db.actor:eat, which never comes back through the
-- callback. It runs first, so by the time this mod was asked the
-- decision had already been made somewhere else.
--
-- It gets in front by replacing itms_manager.actor_on_item_before_use,
-- which is the function RegisterScriptCallback captured. So this does
-- the same, over the top, and refusing here means the thing underneath
-- is never called at all.
--
-- AT CHUNK LEVEL, WHICH IS THE PART THAT MATTERS. Every script's chunk
-- runs before ANY on_game_start, and itms_manager registers its
-- function BY VALUE in its own. Wrapping the field from on_game_start
-- would replace something nobody is ever going to call again. This
-- file loads after FDDA - z sorts after l - so this wrapper is
-- outermost.
--
-- A PLAIN GLOBAL AND A PCALL. Anomaly's loader is lazy: a script is not
-- a field of _G until something asks for it, so rawget answers nil for
-- a mod that is installed and working, and this file has lost a
-- release to that twice. The pcall is what makes "not installed" a
-- quiet no.
-- ============================================================
A.itm_base = nil

pcall(function()
	if type(itms_manager) ~= "table" then return end

	local base = itms_manager.actor_on_item_before_use
	if type(base) ~= "function" then return end

	A.itm_base = base

	itms_manager.actor_on_item_before_use = function(obj, flags)
		-- REFUSED MEANS THE BASE IS NEVER CALLED. Not "called and told
		-- no" - the whole failure this replaces is a mod that is told
		-- no and does it anyway.
		if A.med_gate(obj, flags) then return end
		return base(obj, flags)
	end
end)

-- ============================================================
-- THE WEARABLE DEVICES PATCH IS A SEPARATE DOWNLOAD
--
--   "make this to not be in the main mod cuz not everyone uses this
--    new mod."
--
-- Everything about that pack lives in zzz_amp_weardev.script, which
-- the FOMOD installs only if it is asked to. What is left here is a
-- SEAM: eight questions with a no for an answer, which the patch
-- overwrites when it loads.
--
-- NO-OPS RATHER THAN A BRANCH AT EVERY CALL SITE. There are nine of
-- them, and nine branches is nine places to forget one - which is
-- exactly how a whole mouse button went missing on the way in. The
-- call sites call unconditionally and the cost with no patch is a
-- function call that returns immediately.
--
-- A.wd_worn is a TABLE and not a function because the filter reads it
-- per item per refresh, and an empty table's `next` is cheaper than a
-- call. It stays empty for good without the patch.
-- ============================================================
A.wd_worn = {}

function A.wd_at() return nil end        -- which slot the cursor is on
function A.wd_tick() end                 -- ask the pack what is worn
function A.wd_draw(gui) end              -- the three slots
function A.wd_hide() end                 -- ...put away
function A.wd_click() return false end   -- a left release on a slot
function A.wd_rclick() return false end  -- ...a right one
function A.wd_drop(gui, bag_from, idx_from) return false end

-- The whole of what the patch is given: the mod's state, and the
-- file-local helpers it needs that are not on it. A door exactly the
-- width required, rather than making this file's insides public.
--
-- Called once, from the patch's own on_game_start - which runs first,
-- since zzz_amp_ sorts before zzz_armor_. By then this chunk has been
-- loaded and A exists; nothing here needs the game to be running.
function amp_wd_seam()
	return A, {
		GAP = GAP, EQU = EQU, BAG = BAG,
		hit = hit, scratch_rect = scratch_rect,
		gui_now = gui_now, editing_allowed = editing_allowed,
		log = log, dbg = dbg, notify = notify,
	}
end

function on_game_start()
	-- Printed unconditionally, at every load. Three builds in a row were
	-- reported as changing nothing, and there was no way from inside the
	-- game to tell which one was actually running - the MCM page was
	-- blank, so it could not even be read off there. One line in the log
	-- answers that before anything else is investigated.
	log("version %s loading", VERSION)

	-- ============================================================
	-- DID THE ITEM LTX ACTUALLY LOAD?
	--
	-- "I cannot find it in the spawner" has two causes that look
	-- identical from the game: the section is not in system.ltx at all,
	-- or it is and the spawner did not list it. One line here separates
	-- them before anything else is guessed at, the same way the version
	-- line settles which build is running.
	-- ============================================================
	local have, want, missing = A.rigs_loaded()
	if have == want then
		log("rig items: all %s in system.ltx", tostring(want))
	elseif have == 0 then
		log("rig items: NOT LOADED - mod_system_amp_rigs.ltx is not being read")
	else
		log("rig items: %s of %s in system.ltx, missing: %s",
		    tostring(have), tostring(want), missing)
	end

	A.refresh_settings()
	A.install_loadout_override()
	A.install_carry_watch()
	A.install_eject_watch()
	A.install_dismantle_guard()
	A.install_desc_guard()
	A.install_tip_sync_guard()

	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("on_option_change", A.refresh_settings)
	RegisterScriptCallback("GUI_on_hide", A.on_gui_hide)

	-- ============================================================
	-- THE RIG HAS TO CATCH UP WITHOUT THE INVENTORY BEING OPENED
	--
	-- Everything that changes the carried set happens while you are
	-- looking at the world, not at the grid: a reload swaps a magazine
	-- out of the rig and another into it, and the magazine mod's own
	-- keybinds move them too. Reconciling only on an inventory refresh
	-- means the rig is wrong for as long as you do not open it - and the
	-- reload is exactly the case that was reported twice.
	--
	-- actor_on_weapon_reload is the precise moment; the throttled update
	-- is the net under it, for every path nobody has enumerated. Half a
	-- second is far below noticing and far above costing anything: a
	-- table copy and at most one lookup per pocket.
	-- ============================================================
	RegisterScriptCallback("actor_on_weapon_reload", A.on_reload)
	RegisterScriptCallback("on_before_key_press", A.reload_gate)
	RegisterScriptCallback("actor_on_update", A.on_update)

	-- ============================================================
	-- HOW THE RIG COMES OFF
	--
	-- These two, and nothing else. Every version of "has it gone?"
	-- asked by looking - and every look has a moment on a load or a
	-- level change when it says no about something that is right
	-- there. The engine announces both real departures, and neither
	-- announcement fires on a level change.
	-- ============================================================
	RegisterScriptCallback("actor_on_item_drop", A.on_item_drop)
	RegisterScriptCallback("server_entity_on_unregister", A.on_se_unregister)

	-- ============================================================
	-- A RIG ARRIVES TORN, AND WEARS SLOWLY AFTER THAT
	--
	-- actor_on_item_take is the moment a rig becomes yours - off a
	-- corpse, out of a stash, from a trader - and it is the only moment
	-- worth rolling its condition at. Doing it when the object spawns
	-- would age every rig in every unopened stash on the map.
	--
	-- The hit is the slow half, and it is slight on purpose: what stops
	-- you skipping the ladder is the rig you LOOT, not the one you are
	-- standing in.
	-- ============================================================
	RegisterScriptCallback("actor_on_item_take", A.on_item_take)

	-- WHAT A BODY WAS CARRYING. Registered after death_manager's own
	-- handlers by virtue of this file loading later, so the corpse has
	-- already been through decide_items_to_keep by the time anything is
	-- added to it - and what is added is protected by the ![keep_items]
	-- block in mod_death_items_amp.ltx besides.
	RegisterScriptCallback("npc_on_death_callback", A.on_npc_death)
	RegisterScriptCallback("actor_on_before_hit", A.on_actor_hit)

	-- CInventory__eat sends this for every use of anything, and honours
	-- a false in flags.ret_value. It is the only lever there is over
	-- what a quick-use key may reach.
	RegisterScriptCallback("actor_on_item_before_use", A.on_item_before_use)

	log("med gate: %s", A.itm_base
		and "in front of itms_manager"
		or "on the callback only - no itms_manager to wrap")

	if custom_functor_autoinject and custom_functor_autoinject.add_functor then
		custom_functor_autoinject.add_functor(
			"amp_open", on_rig, name_open, on_rig, action_open)

		custom_functor_autoinject.add_functor(
			"amp_openrig", on_spare_rig, name_openrig,
			on_spare_rig, action_openrig)

		-- THE SIXTH ARGUMENT IS THE WHOLE FEATURE. Without it the entry
		-- gets Mode_Custom / Cont_Custom, which are hard-wired to
		-- inventory mode and the three own-bags; with it the entry gets
		-- Mode_Custom_Functor / Cont_Custom_Functor, which allow every
		-- mode and every bag and leave A.box_menu_here as the only
		-- gate. That gate is why passing this is safe - see it.
		custom_functor_autoinject.add_functor(
			"amp_openbox", on_box, name_openbox, on_box, action_openbox,
			true)

		for _, sec in ipairs(RIGS) do
			local nf = name_spawn_for(sec)
			custom_functor_autoinject.add_functor(
				"amp_spawn_" .. sec, nf, nf, nf, action_spawn_for(sec))
		end

		for _, sec in ipairs(BOXES) do
			local nf = name_spawn_for(sec)
			custom_functor_autoinject.add_functor(
				"amp_spawn_" .. sec, nf, nf, nf, action_spawn_for(sec))
		end
	else
		log("!custom_functor_autoinject missing - no way to open the rig")
	end

	-- The kit you start with never passes through a take, so it gets
	-- its first sight here instead - see A.claim_carried.
	RegisterScriptCallback("actor_on_first_update", A.claim_carried)

	-- LAST, and on purpose: see A.claim_input.
	RegisterScriptCallback("actor_on_first_update", A.claim_input)

	-- ============================================================
	-- AND THE SETTINGS FROM WHEN THIS WAS THREE PAGES
	--
	-- Squared Away is one MCM page now, so every option's path lost its
	-- old first component and every saved value would revert. The MCM
	-- file walks its own tree and brings them across, once. Wrapped
	-- because it reads axr_options.ltx and a settings file this mod
	-- cannot parse must not stop the mod loading.
	-- ============================================================
	local okm, movedm = pcall(function()
		return zzz_armor_mag_pouches_mcm.sqa_migrate()
	end)
	if okm and (movedm or 0) > 0 then
		log("brought %s setting(s) across to the Squared Away page", movedm)
	end

	log("version %s ready", VERSION)
end
